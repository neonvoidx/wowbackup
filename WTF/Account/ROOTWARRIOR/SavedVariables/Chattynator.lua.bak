["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Bwonsamdi says: Dem brokers be up ta somethin'. Ya best be keepin' an eye on 'em! NNNGGGG! Now hurry back wit me mojo!",
["id"] = "s51_2679",
["timestamp"] = 1784560908,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
