588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Dprh-Tichondrius|h[|cffa330c9Dprh|r]|h has earned the achievement |cffffff00|Hachievement:61311:Player-11-0EA1AF2F:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Ready to Remodel]|h|r!\",\"id\":\"s20_2771\",\"timestamp\":1772220934},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"WARRIOR\",\"name\":\"Rews-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Rews-Tichondrius|h[|cffc69b6dRews|r]|h has earned the achievement |cffffff00|Hachievement:62191:Player-11-0E6C62AB:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Call of the Light]|h|r!\",\"id\":\"s20_2772\",\"timestamp\":1772220935},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: Starphage, where's Hieron? Is he...?\",\"id\":\"s20_2773\",\"timestamp\":1772220985},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:267082::::::::87:1480::11::1:28:3084:::::|h[Ornate Cosmic Table]|h|r\",\"id\":\"s20_2774\",\"timestamp\":1772220990},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lothraxion says: War is no place for a tender heart, boy.\",\"id\":\"s20_2775\",\"timestamp\":1772220990},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:260865::::::::87:1480::11:2:13573:6652:2:9:87:28:3084:::::|h[Vest of Infinite Gravity]|h|r\",\"id\":\"s20_2776\",\"timestamp\":1772220992},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: Make ready. It's time we claim the Mantle of Predation.\",\"id\":\"s20_2777\",\"timestamp\":1772220994},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lothraxion says: Soon we'll have all we need. We should strike down this wretch before their hunger turns on us.\",\"id\":\"s20_2778\",\"timestamp\":1772221007},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: Stay together. No one fights alone, no one gets left behind.\",\"id\":\"s20_2779\",\"timestamp\":1772221009},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Magisstorm-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Magisstorm-Tichondrius|h[|cff0070ddMagisstorm|r]|h has earned the achievement |cffffff00|Hachievement:61638:Player-11-0EAC3E8E:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Den of Nalorakk]|h|r!\",\"id\":\"s20_2780\",\"timestamp\":1772221020},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Decimus says: Can you feel it? The Mantle is close at hand.\",\"id\":\"s20_2781\",\"timestamp\":1772221023},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lothraxion says: Don't look so eager, beast. You've fooled Alleria, but I see through you.\",\"id\":\"s20_2782\",\"timestamp\":1772221030},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: That look in Lothraxion's eyes is the same I saw in father's.\",\"id\":\"s20_2783\",\"timestamp\":1772221035},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: I wish Turalyon were here. Lothraxion might listen to him.\",\"id\":\"s20_2784\",\"timestamp\":1772221040},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: Claim the Mantle. We'll watch your back.\",\"id\":\"s20_2785\",\"timestamp\":1772221049},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Terminas\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Terminas says: Away for but a moment and the vermin move in. You were right to alert me, Decimus.\",\"id\":\"s20_2786\",\"timestamp\":1772221053},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lothraxion says: I warned you! This was always their plot!\",\"id\":\"s20_2787\",\"timestamp\":1772221063},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Decimus says: Do keep our magnificent lord entertained, friends. I'd so hate for him to lose interest.\",\"id\":\"s20_2788\",\"timestamp\":1772221067},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: What did I miss? Why wait until now to betray us?\",\"id\":\"s20_2789\",\"timestamp\":1772221077},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: Weapons ready. We'll make ourselves an opening and deal with Decimus afterward.\",\"id\":\"s20_2790\",\"timestamp\":1772221083},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lothraxion says: Trusting Decimus was madness!\",\"id\":\"s20_2791\",\"timestamp\":1772221108},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: I don't understand. They could have betrayed us at any time.\",\"id\":\"s20_2792\",\"timestamp\":1772221113},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lothraxion says: I knew you were blind to the Void's schemes!\",\"id\":\"s20_2793\",\"timestamp\":1772221124},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: No, something's not right. Decimus would not miss this spectacle.\",\"id\":\"s20_2794\",\"timestamp\":1772221130},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Terminas\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Terminas says: Such dull camaraderie. You shall learn your place as Decimus has.\",\"id\":\"s20_2795\",\"timestamp\":1772221141},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Terminas\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Terminas says: Fight one another or die. I will cull these weak distractions.\",\"id\":\"s20_2796\",\"timestamp\":1772221150},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: This was Decimus's plan. Keep Terminas's eyes on us, Starphage.\",\"id\":\"s20_2797\",\"timestamp\":1772221161},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lothraxion says: Are you mad, Alleria?\",\"id\":\"s20_2798\",\"timestamp\":1772221167},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: I've seen you fight, Starphage. I know you can do more.\",\"id\":\"s20_2799\",\"timestamp\":1772221188},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"PALADIN\",\"name\":\"Junkhog-Mannoroth\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Junkhog-Mannoroth|h[|cfff48cbaJunkhog-Mannoroth|r]|h has earned the achievement |cffffff00|Hachievement:153:Player-77-0FA81358:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[The Old Gnome and the Sea]|h|r!\",\"id\":\"s20_2800\",\"timestamp\":1772221223},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: Entertained, Terminas? Come down here if you dare.\",\"id\":\"s20_2801\",\"timestamp\":1772221224},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: Not bad, but it's time to end this.\",\"id\":\"s20_2802\",\"timestamp\":1772221260},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ3:|Hitem:256214::::::::87:1480::11:2:13613:6652:2:9:87:28:3084:::::|h[Boots of Infinite Gravity]|h|r\",\"id\":\"s20_2803\",\"timestamp\":1772221361},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Decimus says: If he damages the Nexus-Point, the resulting energy surge will obliterate your precious Silvermoon.\",\"id\":\"s20_2804\",\"timestamp\":1772221362},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: We need to stop him. Maella, get the others back to Howling Ridge.\",\"id\":\"s20_2805\",\"timestamp\":1772221371},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: Damn, he's already torn his way in.\",\"id\":\"s20_2806\",\"timestamp\":1772221385},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Decimus says: Stop that Light-addled fool. Then I will join you and use the Mantle to weaken the storm.\",\"id\":\"s20_2807\",\"timestamp\":1772221387},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Captain Garrick\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Captain Garrick says: Be wary, we have to stop Lothraxion.\",\"id\":\"s20_2808\",\"timestamp\":1772221400},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Crenna Earth-Daughter\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Crenna Earth-Daughter says: Don't forget to buff up.\",\"id\":\"s20_2809\",\"timestamp\":1772221403},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Alleria Windrunner yells: Lothraxion! Give up this foolishness. We have already won!\",\"id\":\"s20_2810\",\"timestamp\":1772221404},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Meredy Huntswell\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Meredy Huntswell says: Anyone peckish? Mage table ready.\",\"id\":\"s20_2811\",\"timestamp\":1772221406},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Shuja Grimaxe\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Shuja Grimaxe says: Check your adventure guide if you need more information about what we'll find here.\",\"id\":\"s20_2812\",\"timestamp\":1772221407},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Arator yells: You put all of Silvermoon in danger. This isn't worth the risk!\",\"id\":\"s20_2813\",\"timestamp\":1772221411},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: There seems to be a few pieces missing. We have to find them if we're going to stop Lothraxion!\",\"id\":\"s20_2814\",\"timestamp\":1772221417},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Gnome\",\"class\":\"MAGE\",\"name\":\"Clearcast-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Clearcast-Tichondrius|h[|cff3fc7ebClearcast|r]|h has earned the achievement |cffffff00|Hachievement:61856:Player-11-0EAE0154:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Explore Zul'Aman]|h|r!\",\"id\":\"s20_2815\",\"timestamp\":1772221473},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"WARRIOR\",\"name\":\"Rews-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Rews-Tichondrius|h[|cffc69b6dRews|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-11-0E6C62AB:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s20_2816\",\"timestamp\":1772221484},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Gnome\",\"class\":\"MAGE\",\"name\":\"Clearcast-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Clearcast-Tichondrius|h[|cff3fc7ebClearcast|r]|h has earned the achievement |cffffff00|Hachievement:41803:Player-11-0EAE0154:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[For Zul'Aman!]|h|r!\",\"id\":\"s20_2817\",\"timestamp\":1772221493},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\"