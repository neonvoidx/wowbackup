["text"] = "You receive loot: |cnIQ3:|T3536198:12|t|Hitem:180118::::::::81:66::22:3:6652:13609:7756:2:9:81:28:5383:::::|h[Anima Field Emitter (Trinket 139)]|h|r",
["timestamp"] = 1784593255,
["id"] = "s51_2861",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["event"] = "CHAT_MSG_MONEY",
["type"] = "MONEY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = -0,
},
["text"] = "You loot 13 Gold, 29 Silver, 13 Copper",
["timestamp"] = 1784593256,
["id"] = "s51_2862",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Devos",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Devos says: As I peered into Uther's memories, what I saw shook me to the core.",
["timestamp"] = 1784593263,
["id"] = "s51_2863",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Devos",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Devos says: But you refused to see the truth. That the path is flawed. That we serve a lie.",
["timestamp"] = 1784593271,
["id"] = "s51_2864",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Devos",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Devos says: And so, I listened to the Jailer's words. I learned of the great injustice you and the others thrust upon him... and upon us all.",
["timestamp"] = 1784593279,
["id"] = "s51_2865",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Devos",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Devos says: He seeks to free us from the prison we have built for ourselves. And for that, he has earned my loyalty.",
["timestamp"] = 1784593291,
["id"] = "s51_2866",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Kyrestia the Firstborne",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kyrestia the Firstborne says: And I mourn your betrayal.",
["timestamp"] = 1784593300,
["id"] = "s51_2867",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Kyrestia the Firstborne",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kyrestia the Firstborne says: Argh!",
["timestamp"] = 1784593335,
["id"] = "s51_2868",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Devos",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Devos says: Accept your defeat, Archon. I serve a far greater power now.",
["timestamp"] = 1784593340,
["id"] = "s51_2869",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
