},
["text"] = "|Hchannel:GUILD|h[Guild]|h |Hplayer:Stewpindus-Tichondrius:88:GUILD:|h[|cffc41e3aStewpindus|r]|h: tyvm",
["id"] = "s51_4651",
["timestamp"] = 1785281847,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Sabellian",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Sabellian says: I will not yield any ground.",
["id"] = "s51_4652",
["timestamp"] = 1785281847,
},
