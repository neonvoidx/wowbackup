},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Kyrestia the Firstborne",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kyrestia the Firstborne says: Devos...",
["timestamp"] = 1784593468,
["id"] = "s51_2885",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Kyrestia the Firstborne",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kyrestia the Firstborne says: The Jailer's schemes have torn a schism in the ranks of the kyrian. One that must be healed.",
["timestamp"] = 1784593475,
["id"] = "s51_2886",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Kyrestia the Firstborne",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kyrestia the Firstborne says: Long have we believed that our mortal lives are burdens to be shed in the name of service. And yet, the deeds of mortals are what won the day.",
["timestamp"] = 1784593486,
["id"] = "s51_2887",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Magistrate Barthilas",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Magistrate Barthilas yells: Intruders at the Service Gate! Lord Rivendare must be warned!",
["id"] = "s51_2888",
["timestamp"] = 1784684538,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
