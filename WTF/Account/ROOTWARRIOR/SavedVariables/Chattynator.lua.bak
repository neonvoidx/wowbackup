},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Kuri says: Chloroceri are so much spookier up close! Thank you for saving me, new friend.",
["id"] = "s27_2973",
["timestamp"] = 1773446193,
},
