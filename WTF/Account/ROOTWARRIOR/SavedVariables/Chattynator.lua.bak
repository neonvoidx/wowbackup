406999588},\"text\":\"|Hplayer:Neonvoid-Tichondrius|h[|cffffffffNeonvoid|r]|h has earned the achievement |cffffff00|Hachievement:18643:Player-11-0EA29727:1:2:12:26:4294967295:4294967295:4294967295:4294967295|h[Community Rumors]|h|r!\",\"timestamp\":1770912348,\"id\":\"s18_3804\"},{\"recordedBy\":\"Neonvoid-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PRIEST\",\"race\":\"VoidElf\",\"name\":\"Neonvoid-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Neonvoid-Tichondrius|h[|cffffffffNeonvoid|r]|h has earned the achievement |cffffff00|Hachievement:18643:Player-11-0EA29727:1:2:12:26:4294967295:4294967295:4294967295:4294967295|h[Community Rumors]|h|r!\",\"timestamp\":1770912348,\"id\":\"s18_3805\"},{\"recordedBy\":\"Neonvoid-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PRIEST\",\"race\":\"VoidElf\",\"name\":\"Neonvoid-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Neonvoid-Tichondrius|h[|cffffffffNeonvoid|r]|h has earned the achievement |cffffff00|Hachievement:18644:Player-11-0EA29727:1:2:12:26:4294967295:4294967295:4294967295:4294967295|h[Community Rumor Mill]|h|r!\",\"timestamp\":1770912348,\"id\":\"s18_3806\"},{\"recordedBy\":\"Neonvoid-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PRIEST\",\"race\":\"VoidElf\",\"name\":\"Neonvoid-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Neonvoid-Tichondrius|h[|cffffffffNeonvoid|r]|h has earned the achievement |cffffff00|Hachievement:18644:Player-11-0EA29727:1:2:12:26:4294967295:4294967295:4294967295:4294967295|h[Community Rumor Mill]|h|r!\",\"timestamp\":1770912348,\"id\":\"s18_3807\"},{\"recordedBy\":\"Neonvoid-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"High Exarch Turalyon says: The Army of the Light has need of you, hero. I know we can rely on you to get the job done.\",\"timestamp\":1770912359,\"id\":\"s18_3808\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lovely Reveler\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lovely Reveler says: Hmmm... I know I left it around here somewhere...\",\"timestamp\":1770912518,\"id\":\"s18_3809\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Human\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Stormclout-Tichondrius|h[|cff00ff98Stormclout|r]|h has earned the achievement |cffffff00|Hachievement:18643:Player-11-0EA29719:1:2:12:26:4294967295:4294967295:4294967295:4294967295|h[Community Rumors]|h|r!\",\"timestamp\":1770912598,\"id\":\"s18_3810\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Human\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Stormclout-Tichondrius|h[|cff00ff98Stormclout|r]|h has earned the achievement |cffffff00|Hachievement:18644:Player-11-0EA29719:1:2:12:26:4294967295:4294967295:4294967295:4294967295|h[Community Rumor Mill]|h|r!\",\"timestamp\":1770912600,\"id\":\"s18_3811\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Human\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Stormclout-Tichondrius|h[|cff00ff98Stormclout|r]|h has earned the achievement |cffffff00|Hachievement:18643:Player-11-0EA29719:1:2:12:26:4294967295:4294967295:4294967295:4294967295|h[Community Rumors]|h|r!\",\"timestamp\":1770912600,\"id\":\"s18_3812\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Human\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Stormclout-Tichondrius|h[|cff00ff98Stormclout|r]|h has earned the achievement |cffffff00|Hachievement:18644:Player-11-0EA29719:1:2:12:26:4294967295:4294967295:4294967295:4294967295|h[Community Rumor Mill]|h|r!\",\"timestamp\":1770912600,\"id\":\"s18_3813\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: Stormclout, rumors suggest that Xal'atath's Twilight's Blade cult has been recruiting in Alliance cities.\",\"timestamp\":1770912603,\"id\":\"s18_3814\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: Meet me in Stormwind so we can conduct an investigation. If the cult is there, then we must stamp it out at once.\",\"timestamp\":1770912613,\"id\":\"s18_3815\"},{\"recordedBy\":\"Reedingo-Mal'Ganis\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Reedingo-Mal'Ganis\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Reedingo-Mal'Ganis|h[|cff0070ddReedingo|r]|h has earned the achievement |cffffff00|Hachievement:18643:Player-3684-0EC26D6E:1:2:12:26:4294967295:4294967295:4294967295:4294967295|h[Community Rumors]|h|r!\",\"timestamp\":1770913460,\"id\":\"s18_3816\"},{\"recordedBy\":\"Reedingo-Mal'Ganis\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Reedingo-Mal'Ganis\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Reedingo-Mal'Ganis|h[|cff0070ddReedingo|r]|h has earned the achievement |cffffff00|Hachievement:18644:Player-3684-0EC26D6E:1:2:12:26:4294967295:4294967295:4294967295:4294967295|h[Community Rumor Mill]|h|r!\",\"timestamp\":1770913460,\"id\":\"s18_3817\"},{\"recordedBy\":\"Reedingo-Mal'Ganis\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Reedingo-Mal'Ganis\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Reedingo-Mal'Ganis|h[|cff0070ddReedingo|r]|h has earned the achievement |cffffff00|Hachievement:42296:Player-3684-0EC26D6E:1:2:12:26:4294967295:4294967295:4294967295:4294967295|h[Hidden Potential of the Farseer]|h|r!\",\"timestamp\":1770913461,\"id\":\"s18_3818\"},{\"recordedBy\":\"Reedingo-Mal'Ganis\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Grand Magister Rommath says: Reedingo, I have heard unsettling rumors that Xal'atath's Twilight's Blade cult is recruiting within Horde cities.\",\"timestamp\":1770913469,\"id\":\"s18_3819\"},{\"recordedBy\":\"Tampacks-Mal'Ganis\",\"typeInfo\":{\"player\":{\"race\":\"KulTiran\",\"class\":\"DEATHKNIGHT\",\"name\":\"Tampacks-Mal'Ganis\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:153726::::::::80:251::62:1:13638::::::|h[Heart-Lesion Blade]|h|r\",\"id\":\"s18_3820\",\"timestamp\":1770913493},{\"recordedBy\":\"Tampacks-Mal'Ganis\",\"typeInfo\":{\"player\":{\"race\":\"KulTiran\",\"class\":\"DEATHKNIGHT\",\"name\":\"Tampacks-Mal'Ganis\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:153717::::::::80:251::62:1:13638::::::|h[Heart-Lesion Greatsword]|h|r\",\"id\":\"s18_3821\",\"timestamp\":1770913493},{\"recordedBy\":\"Tampacks-Mal'Ganis\",\"typeInfo\":{\"player\":{\"race\":\"KulTiran\",\"class\":\"DEATHKNIGHT\",\"name\":\"Tampacks-Mal'Ganis\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:153747::::::::80:251::62:1:13638::::::|h[Heart-Lesion Runeblade]|h|r\",\"id\":\"s18_3822\",\"timestamp\":1770913493},{\"recordedBy\":\"Tampacks-Mal'Ganis\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Umbric says: Tampacks, rumors suggest that Xal'atath's Twilight's Blade cult has been recruiting in Alliance cities.\",\"id\":\"s18_3823\",\"timestamp\":1770913497},{\"recordedBy\":\"Neonvoid-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PRIEST\",\"race\":\"VoidElf\",\"name\":\"Neonvoid-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ0:|Hitem:153164::::::::80:258:::::::::|h[Otherworldly Trophy]|h|r\",\"timestamp\":1772114861,\"id\":\"s18_3824\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Flynn Fairwind\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Flynn Fairwind says: I have a surprise for you later.\",\"id\":\"s18_3825\",\"timestamp\":1772116139},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Flynn Fairwind\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Flynn Fairwind says: You can't... I was just there! How could you possibly know?\",\"id\":\"s18_3826\",\"timestamp\":1772116143},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Daphne Funkybeats\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Daphne Funkybeats yells: Come on everyone, let's get funky!\",\"id\":\"s18_3827\",\"timestamp\":1772116144},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Flynn Fairwind\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Flynn Fairwind says: Spoilsport!\",\"id\":\"s18_3828\",\"timestamp\":1772116149},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ethereal Warpweaver\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ethereal Warpweaver says: My skills in warpweaving can only do so much to help you. But I shall do my best.\",\"id\":\"s18_3829\",\"timestamp\":1772117495},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Image of Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Image of Lady Liadrin says: Starphage, Xal'atath and her Devouring Host lay siege to the Sunwell. The Light has chosen you to defend it.\",\"id\":\"s18_3830\",\"timestamp\":1772150637},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Image of Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Image of Lady Liadrin says: We desperately need your aid. Seek me out and the Light will bear you to Quel'Danas.\",\"id\":\"s18_3831\",\"timestamp\":1772150646},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Unknown\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Unknown says: Sounds good. Take yer time. If ye don't find a new friend, we will be here when ye are ready.\",\"id\":\"s18_3832\",\"timestamp\":1772150690},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Sully \\\"The Pickle\\\" McLeary\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Sully \\\"The Pickle\\\" McLeary says: Thank ye. Do yah have anyone tha's loyal, and brave, and wonderful, and soft, and willin' ta be the best friend a dwarf could have?\",\"id\":\"s18_3833\",\"timestamp\":1772150692},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ1:|Hitem:239151::::::::80:1480::11::1:28:3592:::::|h[Light's Summon]|h|r\",\"id\":\"s18_3834\",\"timestamp\":1772150697},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Image of Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Image of Lady Liadrin says: Even with reinforcements, we cannot hold back the Devouring Host for long. Make haste, Starphage.\",\"id\":\"s18_3835\",\"timestamp\":1772150698},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: Evacuating the civilians must take priority!\",\"id\":\"s18_3836\",\"timestamp\":1772150714},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: We prayed for a miracle, and the Vanguard of Light answered the call. But the battle yet rages on.\",\"id\":\"s18_3837\",\"timestamp\":1772150721},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: Our forces are scattered. The Devouring Host will overwhelm us!\",\"id\":\"s18_3838\",\"timestamp\":1772150738},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"High Priestess Ishanah\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Priestess Ishanah says: By the light, Starphage is with us!\",\"id\":\"s18_3839\",\"timestamp\":1772150743},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: Starphage, find Arator! I will rally the Vanguard and prepare an assault!\",\"id\":\"s18_3840\",\"timestamp\":1772150756},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: Some must remain to guard the Sunwell! If it falls, all is lost!\",\"id\":\"s18_3841\",\"timestamp\":1772150762},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Wroot-Zuluhed\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Wroot-Zuluhed:41:GUILD:|h[|cffff7c0aWroot|r]|h: are quests showing up on ur map but not really there when u go\",\"id\":\"s18_3842\",\"timestamp\":1772150766},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"WARLOCK\",\"name\":\"Shookone-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Shookone-Area52:51:GUILD:|h[|cff8788eeShookone|r]|h: the spawn rates are messed\",\"id\":\"s18_3843\",\"timestamp\":1772150807},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Treesuh-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Treesuh-Tichondrius|h[|cffff7c0aTreesuh|r]|h has earned the achievement |cffffff00|Hachievement:62191:Player-11-0E53603A:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Call of the Light]|h|r!\",\"id\":\"s18_3844\",\"timestamp\":1772150812},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"PRIEST\",\"name\":\"Twìtch-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Twìtch-Tichondrius|h[|cffffffffTwìtch|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-11-0E5A0B07:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s18_3845\",\"timestamp\":1772150821},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: Starphage! Over here!\",\"id\":\"s18_3846\",\"timestamp\":1772150825},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: Let's find the rest of the Vanguard. The High Exarch hates to be disappointed.\",\"id\":\"s18_3847\",\"timestamp\":1772150830},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"SHAMAN\",\"name\":\"Buju-BleedingHollow\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Buju-BleedingHollow|h[|cff0070ddBuju-BleedingHollow|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-73-0E2D145C:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s18_3848\",\"timestamp\":1772150833},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alonsus Faol\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alonsus Faol says: Xal'atath! If only I had found a way to destroy that accursed blade!\",\"id\":\"s18_3849\",\"timestamp\":1772150840},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: Let the Light heal your wounds.\",\"id\":\"s18_3850\",\"timestamp\":1772150841},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alonsus Faol\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alonsus Faol says: Let your inner fires burn bright, my brethren! We are called to assault the Void!\",\"id\":\"s18_3851\",\"timestamp\":1772150842},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Injured Defender\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Injured Defender says: I can make it now. Be careful!\",\"id\":\"s18_3852\",\"timestamp\":1772150844},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"MAGE\",\"name\":\"Mageyuya-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Mageyuya-Tichondrius|h[|cff3fc7ebMageyuya|r]|h has earned the achievement |cffffff00|Hachievement:62191:Player-11-0E97F286:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Call of the Light]|h|r!\",\"id\":\"s18_3853\",\"timestamp\":1772150847},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Magisstorm-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Magisstorm-Tichondrius|h[|cff0070ddMagisstorm|r]|h has earned the achievement |cffffff00|Hachievement:62191:Player-11-0EAC3E8E:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Call of the Light]|h|r!\",\"id\":\"s18_3854\",\"timestamp\":1772150890},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"MAGE\",\"name\":\"Mageyuya-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Mageyuya-Tichondrius:80:GUILD:|h[|cff3fc7ebMageyuya|r]|h: ok new hub city is gorgeous\",\"id\":\"s18_3855\",\"timestamp\":1772150940},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"PALADIN\",\"name\":\"Dinktard-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Dinktard-Tichondrius:84:GUILD:|h[|cfff48cbaDinktard|r]|h: yup\",\"id\":\"s18_3856\",\"timestamp\":1772150948},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Qtlolxdfurry-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Qtlolxdfurry-Tichondrius:87:GUILD:|h[|cffff7c0aQtlolxdfurry|r]|h: I also enjoy the hub\",\"id\":\"s18_3857\",\"timestamp\":1772150955},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Scourge\",\"class\":\"MAGE\",\"name\":\"Parryhadder-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Parryhadder-Tichondrius|h[|cff3fc7ebParryhadder|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-11-0EA2B21A:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s18_3858\",\"timestamp\":1772150955},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"PALADIN\",\"name\":\"Dinktard-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Dinktard-Tichondrius:89:GUILD:|h[|cfff48cbaDinktard|r]|h: even the music is good\",\"id\":\"s18_3859\",\"timestamp\":1772150968},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lothraxion says: Foul spawn of the Void! Prepare to meet your end!\",\"id\":\"s18_3860\",\"timestamp\":1772150973},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lothraxion says: The High Exarch calls us to glory or death!\",\"id\":\"s18_3861\",\"timestamp\":1772150977},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Scourge\",\"class\":\"MONK\",\"name\":\"Barelyrollen-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Barelyrollen-Tichondrius|h[|cff00ff98Barelyrollen|r]|h has earned the achievement |cffffff00|Hachievement:62191:Player-11-0E1483AE:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Call of the Light]|h|r!\",\"id\":\"s18_3862\",\"timestamp\":1772150993},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Faerin Lothar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Faerin Lothar says: The Light will shield the land of my ancestors!\",\"id\":\"s18_3863\",\"timestamp\":1772150996},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Anduin Wrynn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Anduin Wrynn says: Go join the Vanguard, Faerin! I'll escort everyone to the Sunwell.\",\"id\":\"s18_3864\",\"timestamp\":1772151001},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Faerin Lothar\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Faerin Lothar hesitates.\",\"id\":\"s18_3865\",\"timestamp\":1772151004},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Tauren\",\"class\":\"DRUID\",\"name\":\"Jeppcat-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Jeppcat-Tichondrius|h[|cffff7c0aJeppcat|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-11-0E2E0FEA:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s18_3866\",\"timestamp\":1772151050},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: We must strike back while we have the chance!\",\"id\":\"s18_3867\",\"timestamp\":1772151067},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: No! I will not leave my people undefended!\",\"id\":\"s18_3868\",\"timestamp\":1772151070},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:251076::::::::80:1480::11:3:13573:6652:13668:2:9:80:28:3592