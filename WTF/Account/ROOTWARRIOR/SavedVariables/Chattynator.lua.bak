e-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Starphage-Tichondrius|h[|cffa330c9Starphage|r]|h has earned the achievement |cffffff00|Hachievement:61835:Player-11-0EA2971B:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Delves: Tier 2]|h|r!\",\"timestamp\":1772203208,\"id\":\"s19_3702\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ2:|Hitem:251967::::::::84:1480::9::1:28:6070:::::|h[Fungarian Banner]|h|r\",\"timestamp\":1772203213,\"id\":\"s19_3703\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx15\",\"timestamp\":1772203214,\"id\":\"s19_3704\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ2:|Hitem:263036::::::::84:1480::9::1:28:6070:::::|h[Hanging Dawnflower]|h|r\",\"timestamp\":1772203216,\"id\":\"s19_3705\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ2:|Hitem:251792::::::::84:1480::125:1:13564:2:9:84:28:6070:::::|h[Glorious Crusader's Keepsake]|h|r\",\"timestamp\":1772203216,\"id\":\"s19_3706\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:251512::::::::84:1480:::::::::|h[Fragment of Revelation]|h|r\",\"timestamp\":1772203223,\"id\":\"s19_3707\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PRIEST\",\"race\":\"NightElf\",\"name\":\"Hpviagra-Stormrage\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Hpviagra-Stormrage|h[|cffffffffHpviagra-Stormrage|r]|h has earned the achievement |cffffff00|Hachievement:41287:Player-60-0EDB7F92:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Windrunner Spire]|h|r!\",\"timestamp\":1772203241,\"id\":\"s19_3708\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Hagar says: The final mural holds our most sacred memory -- and our most ancient shame. To witness it, you will need a fragment we store away from the rest.\",\"timestamp\":1772203243,\"id\":\"s19_3709\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Hagar says: Ah, you're awake. Welcome to Har'mara.\",\"timestamp\":1772203274,\"id\":\"s19_3710\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ3:|Hitem:249620::::::::84:1480::127:3:13648:6652:13668:2:9:84:28:3087:::::|h[Vibrant Wilderloop]|h|r\",\"timestamp\":1772203293,\"id\":\"s19_3711\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Hagar says: Come below when you're recovered. The others await.\",\"timestamp\":1772203294,\"id\":\"s19_3712\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Orweyna says: Here in Har'mara, you will see a rare glimpse of the rutaani and fungarians at peace.\",\"timestamp\":1772203296,\"id\":\"s19_3713\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Hagar says: If rutaani march on your home, then perhaps their kin know of it. You will find some here.\",\"timestamp\":1772203306,\"id\":\"s19_3714\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ1:|Hitem:238024::::::::84:1480:::::::::|h[Watering Can]|h|r\",\"timestamp\":1772203308,\"id\":\"s19_3715\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Hagar says: Most rutaani are very territorial. This is one of the few places we interact with them in peace.\",\"timestamp\":1772203308,\"id\":\"s19_3716\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Halduron Brightwing\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Halduron Brightwing says: It is strange to see friendly rutaani.\",\"timestamp\":1772203309,\"id\":\"s19_3717\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ2:|Hcurrency:3385:0|h[Luminous Dust]|h|rx1\",\"timestamp\":1772203322,\"id\":\"s19_3718\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Eonka\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Eonka says: This one has not seen this Light-bloom. But the Rift protects us, always.\",\"timestamp\":1772203353,\"id\":\"s19_3719\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Keem\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Keem says: All rutaani bloom in the light. Only the spore-kin bloom in the dark.\",\"timestamp\":1772203369,\"id\":\"s19_3720\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"ZandalariTroll\",\"name\":\"Junkhog-Mannoroth\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Junkhog-Mannoroth|h[|cfff48cbaJunkhog-Mannoroth|r]|h has earned the achievement |cffffff00|Hachievement:62388:Player-77-0FA81358:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Illicit Rain: Five Stars]|h|r!\",\"timestamp\":1772203390,\"id\":\"s19_3721\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hungry Rotling\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Hungry Rotling says: Meal time? Hope it's extra spongy today!\",\"timestamp\":1772203399,\"id\":\"s19_3722\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Baa'lial\"},\"event\":\"CHAT_MSG_MONSTER_WHISPER\",\"type\":\"MONSTER_WHISPER\"},\"color\":{\"r\":1,\"g\":0.7098039388656616,\"b\":0.9215686917304993},\"text\":\"Baa'lial whispers: Blood will flow. Cities will burn. All will be ash and flame.\",\"timestamp\":1772203416,\"id\":\"s19_3723\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Rizam\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Rizam says: This one has seen many blooms. To bloom is good, yes?\",\"timestamp\":1772203458,\"id\":\"s19_3724\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hungry Rotling\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Hungry Rotling says: Finally! What took so long?\",\"timestamp\":1772203478,\"id\":\"s19_3725\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Teetem\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Teetem says: No Light-bloom. This stranger should offer trade or leave.\",\"timestamp\":1772203483,\"id\":\"s19_3726\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_SKILL\",\"type\":\"SKILL\"},\"color\":{\"r\":0.3333333432674408,\"g\":0.3333333432674408,\"b\":1},\"text\":\"Your skill in Midnight Fishing has increased to 2.\",\"timestamp\":1772203696,\"id\":\"s19_3727\"},{\"recordedBy