66865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260672::::::::90:269:::::::::|h[Fetid Eye]|h|r\",\"id\":\"s26_3592\",\"timestamp\":1773165962},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Nadia Brighton\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Nadia Brighton says: Oh no. Not another portal!\",\"id\":\"s26_3593\",\"timestamp\":1773165969},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Nadia Brighton\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Nadia Brighton says: Hello? Is anyone there? I need help!\",\"id\":\"s26_3594\",\"timestamp\":1773165974},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:257216::::::::90:269::31:1:13634:1:28:3320:::::|h[Voidbreaker's Striders]|h|r\",\"id\":\"s26_3595\",\"timestamp\":1773165976},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Nadia Brighton\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Nadia Brighton says: You're not with the Vanguard. Not that I mind the rescue. Who was that woman you were with?\",\"id\":\"s26_3596\",\"timestamp\":1773165982},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Nadia Brighton\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Nadia Brighton says: Was that the High Exarch's wife? I mean girlfriend. I thought she'd be taller. Is it true she has a dark naaru for a heart?\",\"id\":\"s26_3597\",\"timestamp\":1773165989},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Rïll-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Rïll-Tichondrius|h[|cffff7c0aRïll|r]|h has earned the achievement |cffffff00|Hachievement:61684:Player-11-0E4E5095:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[Progressing in Battle]|h|r!\",\"id\":\"s26_3598\",\"timestamp\":1773166012},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_SAY\",\"type\":\"SAY\"},\"color\":{\"b\":1,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Stormclout-Tichondrius:1019:SAY:|h[|cff00ff98Stormclout|r]|h says: holy shit this is buggy\",\"id\":\"s26_3599\",\"timestamp\":1773166032},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Qtlolxdfurry-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Qtlolxdfurry-Tichondrius|h[|cffff7c0aQtlolxdfurry|r]|h has earned the achievement |cffffff00|Hachievement:61800:Player-11-0E914D2C:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Delves: Tier 4 (Season 1)]|h|r!\",\"id\":\"s26_3600\",\"timestamp\":1773166056},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Nadia Brighton\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Nadia Brighton says: That's the big bastard that brought me here.\",\"id\":\"s26_3601\",\"timestamp\":1773166063},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Nadia Brighton\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Nadia Brighton says: Time to light 'im up!\",\"id\":\"s26_3602\",\"timestamp\":1773166067},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout\",\"sex\":3},\"event\":\"CHAT_MSG_RAID_BOSS_WHISPER\",\"type\":\"MONSTER_BOSS_WHISPER\"},\"color\":{\"b\":0,\"g\":0.8666667342185974,\"r\":1},\"text\":\"Ambushed!\",\"id\":\"s26_3603\",\"timestamp\":1773166076},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Phaseblade Talasha\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Phaseblade Talasha says: You've stumbled right into my trap...\",\"id\":\"s26_3604\",\"timestamp\":1773166077},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260672::::::::90:269:::::::::|h[Fetid Eye]|h|r\",\"id\":\"s26_3605\",\"timestamp\":1773166078},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:242639::::::::90:269:::::::::|h[Practically Pork]|h|r\",\"id\":\"s26_3606\",\"timestamp\":1773166078},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:26