},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Neltharion",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Neltharion says: With that mewling wretch dealt with, I can now assist you.",
["id"] = "s51_4769",
["timestamp"] = 1785283711,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Neltharion",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Neltharion says: Enough at least to clear this lava and open the way to Sarkareth.",
["id"] = "s51_4770",
["timestamp"] = 1785283717,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["race"] = "VoidElf",
["class"] = "PRIEST",
["name"] = "Neonvoid",
["sex"] = 3,
},
["event"] = "CHAT_MSG_LOOT",
["type"] = "LOOT",
},
["color"] = {
["b"] = -0,
["g"] = 0.6666666865348816,
["r"] = -0,
},
["text"] = "You receive item: |cnIQ4:|T5007843:12|t|Hitem:202545::::::::90:258::6:6:6652:9231:7981:9382:1498:8767:1:28:1040:::::|h[Command of the Furnace Seraph (Chest 83)]|h|r",
["id"] = "s51_4771",
["timestamp"] = 1785283722,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Sabellian",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Sabellian says: Wrathion, I am beginning to question the wisdom of all of this.",
["id"] = "s51_4772",
["timestamp"] = 1785283722,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Wrathion",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Wrathion says: As am I. But we must stop Sarkareth. Be on your guard.",
["id"] = "s51_4773",
["timestamp"] = 1785283726,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["race"] = "VoidElf",
["class"] = "PRIEST",
["name"] = "Neonvoid",
["sex"] = 3,
},
["event"] = "CHAT_MSG_LOOT",
["type"] = "LOOT",
},
["color"] = {
["b"] = -0,
["g"] = 0.6666666865348816,
["r"] = -0,
},
["text"] = "You receive item: |cnIQ4:|T5007844:12|t|Hitem:202543::::::::90:258::6:6:6652:9230:7981:9381:1495:8767:1:28:1040:::::|h[Grasp of the Furnace Seraph (Hands 83)]|h|r",
["id"] = "s51_4774",
["timestamp"] = 1785283726,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Neltharion",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Neltharion says: Sarkareth used an alternate path to reach the heart of the crucible. One now closed.",
["id"] = "s51_4775",
["timestamp"] = 1785283762,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Neltharion",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Neltharion says: Only one path remains, guarded by a beast whose sole purpose is to devour.",
