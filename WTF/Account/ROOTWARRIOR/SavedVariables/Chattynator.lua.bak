["r"] = -0,
},
["text"] = "Tiemyshoee-Jubei'Thos receives loot: |cnIQ1:|T3528456:12|t|Hitem:173202::::::::80:66:::::::::|h[Shrouded Cloth]|h|rx3.",
["id"] = "s51_2581",
["timestamp"] = 1784560152,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Mueh'zala",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Mueh'zala yells: Where ya be hidin' all dem Zandalari souls, Bwonsamdi? Give 'em ta ya bossmon now, or ya gonna be sorry. Reeeeaaal sorry!",
["id"] = "s51_2582",
["timestamp"] = 1784560155,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Bwonsamdi",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Bwonsamdi yells: So ya can be sendin' dem to da Maw? No, no, no... dem is my people, Mueh'zala. No way I gonna give dem up!",
["id"] = "s51_2583",
["timestamp"] = 1784560166,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Bwonsamdi",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Bwonsamdi says: Now here's a loa ya might remember! Hakkar always be needin' mojo for his rituals... and Bwonsamdi always be willin' ta make a deal.",
["id"] = "s51_2584",
["timestamp"] = 1784560170,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Mueh'zala",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Mueh'zala yells: Ya always be soft, Bwonsamdi. Weak. Sooner or later, ya gonna break. Den da Jailer be getting' his due!",
["id"] = "s51_2585",
["timestamp"] = 1784560177,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Bwonsamdi",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Bwonsamdi says: Well whatcha givin' me dat look for? Sure, Hakkar be a loa of blood. But a deal's a deal, mon! Just get me mojo back.",
["id"] = "s51_2586",
["timestamp"] = 1784560182,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Bwonsamdi",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Bwonsamdi says: Wait... who...? Heroes! Uh... no hard feelins 'bout dat little disagreement dat we had in Zuldazar?",
["id"] = "s51_2587",
["timestamp"] = 1784560194,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Bwonsamdi",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Bwonsamdi says: Mueh'zala got me at a... disadvantage. But if ya collect me mojo from a few of me... business partners... den together, we can turn da tables on him!",
["id"] = "s51_2588",
["timestamp"] = 1784560206,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Atal'ai High Priest",
},
["event"] = "CHAT_MSG_MONSTER_EMOTE",
["type"] = "MONSTER_EMOTE",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.501960813999176,
["r"] = 1,
},
["text"] = "Atal'ai High Priest attempts to run away in fear!",
["id"] = "s51_2589",
["timestamp"] = 1784560213,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Bwonsamdi",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Bwonsamdi says: I be keepin' dis ol' loa distracted. Go on, now. Follow da paths. And don't ya be takin' no for an answer!",
["id"] = "s51_2590",
["timestamp"] = 1784560218,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Atal'ai High Priest",
},
["event"] = "CHAT_MSG_MONSTER_EMOTE",
["type"] = "MONSTER_EMOTE",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.501960813999176,
["r"] = 1,
},
["text"] = "Atal'ai High Priest attempts to run away in fear!",
["id"] = "s51_2591",
["timestamp"] = 1784560245,
},
