["name"] = "Neltharion",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Neltharion says: Always the clever one, Wrathion.",
["id"] = "s51_4797",
["timestamp"] = 1785284102,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Sabellian",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
