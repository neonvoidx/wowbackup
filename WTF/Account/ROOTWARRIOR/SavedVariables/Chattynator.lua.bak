},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Millhouse Manastorm yells: What have we here? That dusty old loa has sent debt collectors already?! But I haven't had his mojo long enough to create my masterpiece!",
["id"] = "s51_2625",
["timestamp"] = 1784560545,
},
