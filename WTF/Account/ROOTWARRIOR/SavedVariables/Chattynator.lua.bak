r\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: You got them all! Thank the Light!\",\"id\":\"s18_3915\",\"timestamp\":1772151400},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Nøv-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Nøv-Tichondrius|h[|cffa330c9Nøv|r]|h|1이;가; 업적을 달성했습니다! |cffffff00|Hachievement:62191:Player-11-0E3ABFF9:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Call of the Light]|h|r!\",\"id\":\"s18_3916\",\"timestamp\":1772151403},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Benbreeze-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Benbreeze-Tichondrius|h[|cffa330c9Benbreeze|r]|h has earned the achievement |cffffff00|Hachievement:62191:Player-11-0EB1FD5D:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Call of the Light]|h|r!\",\"id\":\"s18_3917\",\"timestamp\":1772151404},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: Turalyon forgets that victory means nothing if it costs us everything in return.\",\"id\":\"s18_3918\",\"timestamp\":1772151420},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: Mount up, Starphage. We must get to the gate before the Vanguard attacks!\",\"id\":\"s18_3919\",\"timestamp\":1772151428},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Mehlar Dawnblade\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Mehlar Dawnblade says: Starphage! The Vanguard is gathering at the north gate for a big push!\",\"id\":\"s18_3920\",\"timestamp\":1772151449},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Aponi Brightmane\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Aponi Brightmane says: Starphage, I thank the Light you are with us!\",\"id\":\"s18_3921\",\"timestamp\":1772151454},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Scourge\",\"class\":\"MONK\",\"name\":\"Barelyrollen-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Barelyrollen-Tichondrius|h[|cff00ff98Barelyrollen|r]|h has earned the achievement |cffffff00|Hachievement:1795:Player-11-0E1483AE:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Lunch Lady]|h|r!\",\"id\":\"s18_3922\",\"timestamp\":1772151455},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Nisa Cindersteel\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Nisa Cindersteel says: The Light advances!\",\"id\":\"s18_3923\",\"timestamp\":1772151462},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Gnome\",\"class\":\"MAGE\",\"name\":\"Clearcast-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Clearcast-Tichondrius:199:GUILD:|h[|cff3fc7ebClearcast|r]|h: oh a cutscene, SKIPPP\",\"id\":\"s18_3924\",\"timestamp\":1772151483},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Scourge\",\"class\":\"WARLOCK\",\"name\":\"Claus-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Claus-Tichondrius|h[|cff8788eeClaus|r]|h has earned the achievement |cffffff00|Hachievement:62191:Player-11-0E5CD6EA:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Call of the Light]|h|r!\",\"id\":\"s18_3925\",\"timestamp\":1772151484},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Moistydank-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Moistydank-Tichondrius|h[|cffa330c9Moistydank|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-11-0E9CAA58:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s18_3926\",\"timestamp\":1772151484},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: Lor'themar could have handled the evacuation, Arator. You're needed with the Vanguard!\",\"id\":\"s18_3927\",\"timestamp\":1772151486},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: Vanguard of the Light, form a line! Hold this gate!\",\"id\":\"s18_3928\",\"timestamp\":1772151488},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: My father is eager to vanquish the Host, but charging forward won't be enough. We have to take out that pylon.\",\"id\":\"s18_3929\",\"timestamp\":1772151492},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Quel'Danas Sentinel\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Quel'Danas Sentinel says: Target acquired!\",\"id\":\"s18_3930\",\"timestamp\":1772151523},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: Please forgive my father's tone. We don't always see eye-to-eye on things, to say the least.\",\"id\":\"s18_3931\",\"timestamp\":1772151523},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Quel'Danas Sentinel\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Quel'Danas Sentinel says: Target acquired!\",\"id\":\"s18_3932\",\"timestamp\":1772151526},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Vindicator Xayann\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Vindicator Xayann says: Activating those sentinels could shift the balance in our favor.\",\"id\":\"s18_3933\",\"timestamp\":1772151529},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Quel'Danas Sentinel\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Quel'Danas Sentinel says: Target acquired!\",\"id\":\"s18_3934\",\"timestamp\":1772151533},{\"r