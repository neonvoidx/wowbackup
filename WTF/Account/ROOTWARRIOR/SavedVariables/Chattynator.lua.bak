,\"timestamp\":1772166510},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Dracthyr\",\"class\":\"EVOKER\",\"name\":\"Nazelle\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Nazelle yells: Brawl... with Rook.\",\"id\":\"s19_3118\",\"timestamp\":1772166510},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"ROGUE\",\"name\":\"Buzek-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Buzek-Tichondrius|h[|cfffff468Buzek|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-11-0E8DEF7E:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s19_3119\",\"timestamp\":1772166541},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ritualist Zongha\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ritualist Zongha says: Ya mist not gonna keep us from gainin' unlimited power!\",\"id\":\"s19_3120\",\"timestamp\":1772166550},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ritualist Zongha\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ritualist Zongha says: The sacrifices... dey weren't enough...\",\"id\":\"s19_3121\",\"timestamp\":1772166561},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260651::::::::83:1480:::::::::|h[Lustrous Wildlife Pelt]|h|rx2\",\"id\":\"s19_3122\",\"timestamp\":1772166564},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: While in de crypt, I noticed de Vilebranch were blinded by de mist too. Hmm.\",\"id\":\"s19_3123\",\"timestamp\":1772166587},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:248572::::::::83:1480::11:2:13573:6652:2:9:83:28:3086:::::|h[Spiritwarden's Sash]|h|r\",\"id\":\"s19_3124\",\"timestamp\":1772166590},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:253469::::::::83:1480::11::1:28:3086:::::|h[Ritual-Cursed Sarcophagus]|h|r\",\"id\":\"s19_3125\",\"timestamp\":1772166591},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: What do we do now? This mist is... impenetrable.\",\"id\":\"s19_3126\",\"timestamp\":1772166593},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: We push forward. De hash'ey shrines will lead us to de Temple of Halazzi.\",\"id\":\"s19_3127\",\"timestamp\":1772166599},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: A hash'ey shrine. Like those we lit near the Temple of Akil'zon.\",\"id\":\"s19_3128\",\"timestamp\":1772166605},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Dat means we are close. Do you feel like we bein' watched?\",\"id\":\"s19_3129\",\"timestamp\":1772166608},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Kähl-Stormrage\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Kähl-Stormrage|h[|cffff7c0aKähl-Stormrage|r]|h has earned the achievement |cffffff00|Hachievement:1796:Player-60-0FE11B88:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Short Order Cook]|h|r!\",\"id\":\"s19_3130\",\"timestamp\":1772166643},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"WARLOCK\",\"name\":\"Shookone-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Shookone-Area52|h[|cff8788eeShookone-Area52|r]|h has earned the achievement |cffffff00|Hachievement:61836:Player-3676-0EC012CA:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Delves: Tier 3]|h|r!\",\"id\":\"s19_3131\",\"timestamp\":1772166680},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260651::::::::83:1480:::::::::|h[Lustrous Wildlife Pelt]|h|r\",\"id\":\"s19_3132\",\"timestamp\":1772166703},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260660::::::::83:1480:::::::::|h[Putrid Mushroom Spores]|h|rx2\",\"id\":\"s19_3133\",\"timestamp\":1772166703},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_SKILL\",\"type\":\"SKILL\"},\"color\":{\"b\":1,\"g\":0.3333333432674408,\"r\":0.3333333432674408},\"text\":\"Your skill in Midnight Mining has increased to 12.\",\"id\":\"s19_3134\",\"timestamp\":1772166713},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ2:|Hitem:237364::::::::83:1480::::1:38:13:::::|h[Brilliant Silver Ore |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|rx3\",\"id\":\"s19_3135\",\"timestamp\":1772166713},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ3:|Hitem:236951::::::::83:1480:::::::::|h[Mote of Wild Magic]|h|r\",\"id\":\"s19_3136\",\"timestamp\":1772166713},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: You mean you were saved from de Vilebranch by de mist? Not lost in it?\",\"id\":\"s19_3137\",\"timestamp\":1772166751},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:248575::::::::83:1480::11:2:13573:6652:2:9:83:28:3086:::::|h[Prowlers Shawl]|h|r\",\"id\":\"s19_3138\",\"timestamp\":1772166759},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Tobui\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Tobui says: De lynx loa brought us here and protected us. He has made me his speaker, my sister.\",\"id\":\"s19_3139\",\"timestamp\":1772166760},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Benbreeze-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Benbreeze-Tichondrius|h[|cffa330c9Benbreeze|r]|h has earned the achievement |cffffff00|Hachievement:41287:Player-11-0EB1FD5D:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Windrunner Spire]|h|r!\",\"id\":\"s19_3140\",\"timestamp\":1772166767},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"WARLOCK\",\"name\":\"Goochbandito-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Goochbandito-Tichondrius|h[|cff8788eeGoochbandito|r]|h has earned the achievement |cffffff00|Hachievement:41803:Player-11-0EA5692A:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[For Zul'Aman!]|h|r!\",\"id\":\"s19_3141\",\"timestamp\":1772166793},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"WARRIOR\",\"name\":\"Cabelas-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Cabelas-Tichondrius|h[|cffc69b6dCabelas|r]|h has earned the achievement |cffffff00|Hachievement:62269:Player-11-0E28B0F4:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Altar of Blessings: Amani Curious]|h|r!\",\"id\":\"s19_3142\",\"timestamp\":1772166854},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Then you will help us track an' kill Mor'duun an' de Twilight's Blade, master of de hunt?\",\"id\":\"s19_3143\",\"timestamp\":1772166876},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Halazzi\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Halazzi says: They will be my prey, Amani kit. May the shadows protect you always.\",\"id\":\"s19_3144\",\"timestamp\":1772166883},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260614::::::::83:1480:::::::::|h[Unrecognizable Organ]|h|r\",\"id\":\"s19_3145\",\"timestamp\":1772166896},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Mezmir-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Mezmir-Tichondrius|h[|cff0070ddMezmir|r]|h has earned the achievement |cffffff00|Hachievement:41802:Player-11-0EA2A9CD:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Eversong In Reprise]|h|r!\",\"id\":\"s19_3146\",\"timestamp\":1772166903},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"You sense a nearby Skyriding Glyph.\",\"id\":\"s19_3147\",\"timestamp\":1772166910},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Vun'zarah\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Vun'zarah says: De path of de hash'ey? My grandmother told tales of de hash'ey 'round de fire when I was young.\",\"id\":\"s19_3148\",\"timestamp\":1772166912},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Vun'zarah\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Vun'zarah says: De Witherbark know little of Jan'alai, but their eccentric loa speaker still lives at de temple to de east.\",\"id\":\"s19_3149\",\"timestamp\":1772166916},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Heh. I know all 'bout \\\"eccentric\\\" loa speakers. Thank you, Vun'zarah. Maybe dis trial will be easier.\",\"id\":\"s19_3150\",\"timestamp\":1772166920},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Brek\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Brek says: De livin' flame be gone, burned in many hearts. Purify yaself, an' it will rise!\",\"id\":\"s19_3151\",\"timestamp\":1772166990},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Brek\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Brek says: I see de fire in you, yes. Find more coals, more fire. Renew de livin' flame!\",\"id\":\"s19_3152\",\"timestamp\":1772166998},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: He speaks madness but seems deeply attuned to de loa. Take de coal, Starphage, and see if we can start de trial.\",\"id\":\"s19_3153\",\"timestamp\":1772167005},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: Did he just... hand you that fiery coal with his bare hands?\",\"id\":\"s19_3154\",\"timestamp\":1772167007},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: I am glad to gain Halazzi's favor, but bein' here brings me shame.\",\"id\":\"s19_3155\",\"timestamp\":1772167019},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: Why? We rescued the Witherbark. You found the hash'ey shrines. And you are now closer to becoming hash'ey.\",\"id\":\"s19_3156\",\"timestamp\":1772167025},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"You sense a nearby Skyriding Glyph.\",\"id\":\"s19_3157\",\"timestamp\":1772167031},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:242639::::::::83:1480:::::::::|h[Practically Pork]|h|rx7\",\"id\":\"s19_3158\",\"timestamp\":1772167058},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ2:|Hitem:258922::::::::83:1480::133:2:13573:13578:2:9:83:28:3086:::::|h[Tarnished Dawnlit Corsair's Gloves]|h|r\",\"id\":\"s19_3159\",\"timestamp\":1772167058},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260647::::::::83:1480:::::::::|h[Digested Human Hand]|h|rx3\",\"id\":\"s19_3160\",\"timestamp\":1772167058},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Mvmnt-MoonGuard\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Mvmnt-MoonGuard|h[|cffff7c0aMvmnt-MoonGuard|r]|h has earned the achievement |cffffff00|Hachievement:153:Player-3675-0AC0F600:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[The Old Gnome and the Sea]|h|r!\",\"id\":\"s19_3161\",\"timestamp\":1772167070},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEATHKNIGHT\",\"name\":\"Pleaseclap-WyrmrestAccord\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Pleaseclap-WyrmrestAccord|h[|cffc41e3aPleaseclap-WyrmrestAccord|r]|h has earned the achievement |cffffff00|Hachievement:61832:Player-1171-080405AF:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Delves: Tier 1]|h|r!\",\"id\":\"s19_3162\",\"timestamp\":1772167072},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"DarkIronDwarf\",\"class\":\"SHAMAN\",\"name\":\"Tipride-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Tipride-Tichondrius|h[|cff0070ddTipride|r]|h has earned the achievement |cffffff00|Hachievement:61835:Player-11-0EA6D4F4:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Delves: Tier 2]|h|r!\",\"id\":\"s19_3163\",\"timestamp\":1772167086},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Kähl-Stormrage\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Kähl-Stormrage|h[|cffff7c0aKähl-Stormrage|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-60-0FE11B88:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s19_3164\",\"timestamp\":1772167106},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Ultrafather-MoonGuard\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Ultrafather-MoonGuard|h[|cffff7c0aUltrafather-MoonGuard|r]|h has earned the achievement |cffffff00|Hachievement:40436:Player-3675-0AFC8411:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[You're Getting a Delve!]|h|r!\",\"id\":\"s19_3165\",\"timestamp\":1772167112},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Ultrafather-MoonGuard\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Ultrafather-MoonGuard|h[|cffff7c0aUltrafather-MoonGuard|r]|h has earned the achievement |cffffff00|Hachievement:61832:Player-3675-0AFC8411:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Delves: Tier 1]|h|r!\",\"id\":\"s19_3166\",\"timestamp\":1772167112},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:242639::::::::83:1480:::::::::|h[Practically Pork]|h|rx21\",\"id\":\"s19_3167\",\"timestamp\":1772167120},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260647::::::::83:1480:::::::::|h[Digested Human Hand]|h|r\",\"id\":\"s19_3168\",\"timestamp\":1772167120},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260665::::::::83:1480:::::::::|h[Sizable Tusk]|h|rx6\",\"id\":\"s19_3169\",\"timestamp\":1772167120},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260670::::::::83:1480:::::::::|h[Bloody Broken Beak]|h|r\",\"id\":\"s19_3170\",\"timestamp\":1772167120},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260643::::::::83:1480:::::::::|h[Pile of Feathers]|h|r\",\"id\":\"s19_3171\",\"timestamp\":1772167120},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260692::::::::83:1480:::::::::|h[Chunk of Mystery Meat]|h|r\",\"id\":\"s19_3172\",\"timestamp\":1772167120},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Namoon-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Namoon-Stormrage|h[|cffff7c0aNamoon-Stormrage|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-60-0EFC3DD6:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s19_3173\",\"timestamp\":1772167122},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Brek\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Brek says: Could it be... de spark? De fire we need?\",\"id\":\"s19_3174\",\"timestamp\":1772167126},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:264715::::::::83:1480::11::1:28:3086:::::|h[Zul'Aman Flame Cradle]|h|r\",\"id\":\"s19_3175\",\"timestamp\":1772167130},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Brek\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Brek says: Yes! De flame returns. De fire of Jan'alai burns bright! Fly home, mistress an' master of fire! Fly!\",\"id\":\"s19_3176\",\"timestamp\":1772167131},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Meet me at de shrine. I will take de coal. My spirit's ready for any challenge.\",\"id\":\"s19_3177\",\"timestamp\":1772167141},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: I will stay here with Brek. Just in case he begins to make sense. Or decides to wander off.\",\"id\":\"s19_3178\",\"timestamp\":1772167148},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Unknown\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Unknown says: Let's see what de flames make of my spirit.\",\"id\":\"s19_3179\",\"timestamp\":1772167159},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: I wonder who de next one will be...\",\"id\":\"s19_3180\",\"timestamp\":1772167172},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Manifestation of Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Manifestation of Zul'jan says: Come to point out more of my flaws, sister? Why? Afraid I'm a better Amani than you?\",\"id\":\"s19_3181\",\"timestamp\":1772167175},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"MONK\",\"name\":\"Bombadilo-Gilneas\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Bombadilo-Gilneas|h[|cff00ff98Bombadilo-Gilneas|r]|h has earned the achievement |cffffff00|Hachievement:41802:Player-67-0A795585:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Eversong In Reprise]|h|r!\",\"id\":\"s19_3182\",\"timestamp\":1772167177},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: We are both Amani enough, brother. We only need to give each other more grace.\",\"id\":\"s19_3183\",\"timestamp\":1772167200},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Brek\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Brek says: De flame rises. Rise to the challenge. Cleanse ya spirit!\",\"id\":\"s19_3184\",\"timestamp\":1772167206},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:248577::::::::83:1480::11:3:13573:6652:13668:2:9:83:28:3086:::::|h[Ring of Doubt]|h|r\",\"id\":\"s19_3185\",\"timestamp\":1772167215},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Let me face whatever shame still hidin' in my spirit.\",\"id\":\"s19_3186\",\"timestamp\":1772167216},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Brek\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Brek says: Behold! De last trial. Face to face. Face yaself!\",\"id\":\"s19_3187\",\"timestamp\":1772167224},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Manifestation of Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Zul'jarra yells a bloodcurdling warcry.\",\"id\":\"s19_3188\",\"timestamp\":1772167226},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Manifestation of Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Manifestation of Zul'jarra yells: Weak child! You accept help because you fear standin' alone!\",\"id\":\"s19_3189\",\"timestamp\":1772167232},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: No. Acceptin' help has strengthened us. My pride will not be de downfall of my people.\",\"id\":\"s19_3190\",\"timestamp\":1772167239},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Brek\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Brek says: Place de coal! Watch de flames rise and de fire live again!\",\"id\":\"s19_3191\",\"timestamp\":1772167239},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jan'alai\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jan'alai says: Akil'zon was right to start you on the path of the hash'ey. Your flame burns brightly, Zul'jarra.\",\"id\":\"s19_3192\",\"timestamp\":1772167341},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Mado'ru, Jan'alai. I have learned much of myself from your trials. And hope to learn more in de trials ahead.\",\"id\":\"s19_3193\",\"timestamp\":1772167350},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Magisstorm-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Magisstorm-Tichondrius|h[|cff0070ddMagisstorm|r]|h has earned the achievement |cffffff00|Hachievement:41802:Player-11-0EAC3E8E:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Eversong In Reprise]|h|r!\",\"id\":\"s19_3194\",\"timestamp\":1772167372},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"You sense a nearby Skyriding Glyph.\",\"id\":\"s19_3195\",\"timestamp\":1772167380},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_SKILL\",\"type\":\"SKILL\"},\"color\":{\"b\":1,\"g\":0.3333333432674408,\"r\":0.3333333432674408},\"text\":\"Your skill in Midnight Mining has increased to 13.\",\"id\":\"s19_3196\",\"timestamp\":1772167391},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ2:|Hitem:237364::::::::83:1480::::1:38:13:::::|h[Brilliant Silver Ore |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|rx4\",\"id\":\"s19_3197\",\"timestamp\":1772167392},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3264:0|h[Artisan Miner's Moxie]|h|rx5\",\"id\":\"s19_3198\",\"timestamp\":1772167392},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3158:0|h[Midnight Mining Knowledge]|h|rx1\",\"id\":\"s19_3199\",\"timestamp\":1772167392},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Moistydank-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Moistydank-Tichondrius|h[|cffa330c9Moistydank|r]|h has earned the achievement |cffffff00|Hachievement:61638:Player-11-0E9CAA58:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Den of Nalorakk]|h|r!\",\"id\":\"s19_3200\",\"timestamp\":1772167398},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Unknown\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Unknown says: De blood of those who died today will become de flood that washes de invaders from our lands!\",\"id\":\"s19_3201\",\"timestamp\":1772167505},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: Sister, you return! While you were prostrating yourself before de loa, I secured real power!\",\"id\":\"s19_3202\",\"timestamp\":1772167511},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: And how many warriors did you sacrifice to take this lightwood back from de cult?\",\"id\":\"s19_3203\",\"timestamp\":1772167522},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: Sacrifice? They are heroes. Heroes that fell as true Amani, reclaiming de lightwood at Atal'Aman.\",\"id\":\"s19_3204\",\"timestamp\":1772167528},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Manasia-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Manasia-Tichondrius|h[|cffff7c0aManasia|r]|h has earned the achievement |cffffff00|Hachievement:41803:Player-11-0EA21DE7:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[For Zul'Aman!]|h|r!\",\"id\":\"s19_3205\",\"timestamp\":1772167531},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: And they are dead just de same, Jan!\",\"id\":\"s19_3206\",\"timestamp\":1772167539},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Warriors, you are relieved. Go be with your families. We will care for de dead.\",\"id\":\"s19_3207\",\"timestamp\":1772167543},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: And I swear if you do somethin' stupid while I go to Nalorakk, I'll cut off your head myself.\",\"id\":\"s19_3208\",\"timestamp\":1772167551},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Zul'jan scowls at Zul'jarra.\",\"id\":\"s19_3209\",\"timestamp\":1772167560},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:264480::::::::83:1480::11::1:28:3086:::::|h[Greenvine Amani Tapestry]|h|r\",\"id\":\"s19_3210\",\"timestamp\":1772167576},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"ROGUE\",\"name\":\"Datcu-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Datcu-Tichondrius|h[|cfffff468Datcu|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-11-0B64CE68:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s19_3211\",\"timestamp\":1772167577},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: Are you sure your brother will follow your orders?\",\"id\":\"s19_3212\",\"timestamp\":1772167579},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Woid-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Woid-Tichondrius|h[|cffa330c9Woid|r]|h has earned the achievement |cffffff00|Hachievement:41805:Player-11-0EAEB643:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Arator's Journey]|h|r!\",\"id\":\"s19_3213\",\"timestamp\":1772167584},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: We have no time to worry about Zul'jan. Our focus must be on Nalorakk. Let's go.\",\"id\":\"s19_3214\",\"timestamp\":1772167584},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Climatechang-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Climatechang-Tichondrius|h[|cffff7c0aClimatechang|r]|h has earned the achievement |cffffff00|Hachievement:62388:Player-11-0E90740E:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Illicit Rain: Five Stars]|h|r!\",\"id\":\"s19_3215\",\"timestamp\":1772167596},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: On my life, Lilaju. With Nalorakk's blessin', I will rid Zul'Aman of all dat threaten us.\",\"id\":\"s19_3216\",\"timestamp\":1772167619},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"PRIEST\",\"name\":\"Swagchecked-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Swagchecked-Tichondrius:3963:GUILD:|h[|cffffffffSwagchecked|r]|h: yo am i restarted what do i do on the matching tiles quest\",\"id\":\"s19_3217\",\"timestamp\":1772167625},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lilaju\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lilaju says: Fine. To commune with de sleepin' Loa of War, ya must sit at his fire. But all that have did not come back.\",\"id\":\"s19_3218\",\"timestamp\":1772167628},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"DEATHKNIGHT\",\"name\":\"Bruhface-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Bruhface-Tichondrius|h[|cffc41e3aBruhface|r]|h has earned the achievement |cffffff00|Hachievement:62191:Player-11-0A81F6D6:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Call of the Light]|h|r!\",\"id\":\"s19_3219\",\"timestamp\":1772167636},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lilaju\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lilaju says: I hope ya be successful. But I wouldn't lose sleep if he eats ya face off.\",\"id\":\"s19_3220\",\"timestamp\":1772167639},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Treesuh-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Treesuh-Tichondrius|h[|cffff7c0aTreesuh|r]|h has earned the achievement |cffffff00|Hachievement:41804:Player-11-0E53603A:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[One Does Not Simply Walk Into Harandar]|h|r!\",\"timestamp\":1772167682,\"id\":\"s19_3221\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PRIEST\",\"race\":\"Scourge\",\"name\":\"Blueberryzyn-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Blueberryzyn-Tichondrius|h[|cffffffffBlueberryzyn|r]|h has earned the achievement |cffffff00|Hachievement:41802:Player-11-0E9901D7:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Eversong In Reprise]|h|r!\",\"timestamp\":1772167778,\"id\":\"s19_3222\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Starphage-Tichondrius:3971:GUILD:|h[|cffa330c9Starphage|r]|h: just match the tiles\",\"timestamp\":1772167781,\"id\":\"s19_3223\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Starphage-Tichondrius:3972:GUILD:|h[|cffa330c9Starphage|r]|h: its ok if youre a frog\",\"timestamp\":1772167789,\"id\":\"s19_3224\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Starphage-Tichondrius:3973:GUILD:|h[|cffa330c9Starphage|r]|h: lol\",\"timestamp\":1772167790,\"id\":\"s19_3225\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Moistydank-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Moistydank-Tichondrius|h[|cffa330c9Moistydank|r]|h has earned the achievement |cffffff00|Hachievement:61856:Player-11-0E9CAA58:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Explore Zul'Aman]|h|r!\",\"timestamp\":1772167794,\"id\":\"s19_3226\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Meredy Huntswell\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Meredy Huntswell says: Get ready. We're here to support Zul'Jarra.\",\"timestamp\":1772167816,\"id\":\"s19_3227\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Captain Garrick\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Captain Garrick says: Let's all buff up.\",\"timestamp\":1772167819,\"id\":\"s19_3228\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zul'jarra says: Dis must be de fire Lilaju spoke of.\",\"timestamp\":1772167821,\"id\":\"s19_3229\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Meredy Huntswell\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Meredy Huntswell says: Anyone peckish? Mage table ready.\",\"timestamp\":1772167821,\"id\":\"s19_3230\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Shuja Grimaxe\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Shuja Grimaxe says: Check your adventure guide if you need more information about what we'll find here.\",\"timestamp\":1772167823,\"id\":\"s19_3231\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zul'jarra says: Sit and we will start de ritual--but be ready. Dis is de Loa of War. What ever he dreams of, we must complete de trial.\",\"timestamp\":1772167824,\"id\":\"s19_3232\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Nanea\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Loa Speaker Nanea says: Do not worry about your friend, de would-be hash'ey. Nalorakk, de dreamer, de Loa of War, will test her strength.\",\"timestamp\":1772167835,\"id\":\"s19_3233\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Nanea\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Loa Speaker Nanea says: A hash'ey is only as strong as their warriors. So, you too will be tested in Nalorakk's dream.\",\"timestamp\":1772167846,\"id\":\"s19_3234\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Captain Garrick\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Captain Garrick says: This can be an offering.\",\"timestamp\":1772167847,\"id\":\"s19_3235\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_PING\",\"type\":\"PING\"},\"color\":{\"r\":0.6666666865348816,\"g\":0.6666666865348816,\"b\":1},\"text\":\"[Tank] |Hplayer:Captain Garrick|h[Captain Garrick]: |h|A:ping_chat_nonthreat:0:0:0:0|aLook here\",\"timestamp\":1772167847,\"id\":\"s19_3236\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Nanea\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Loa Speaker Nanea says: The loa dreams of de Amani's past. When de winter was their only foe. Preparin' for it will be your first trial.\",\"timestamp\":1772167856,\"id\":\"s19_3237\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"LightforgedDraenei\",\"name\":\"Sneakybution-Ysondre\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Sneakybution-Ysondre|h[|cfff48cbaSneakybution-Ysondre|r]|h has earned the achievement |cffffff00|Hachievement:41802:Player-78-0FAC896B:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Eversong In Reprise]|h|r!\",\"timestamp\":1772167907,\"id\":\"s19_3238\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"WARLOCK\",\"race\":\"Gnome\",\"name\":\"Darkð-Kel'Thuzad\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Darkð-Kel'Thuzad|h[|cff8788eeDarkð-Kel'Thuzad|r]|h has earned the achievement |cffffff00|Hachievement:40436:Player-3693-0E27B45B:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[You're Getting a Delve!]|h|r!\",\"timestamp\":1772167920,\"id\":\"s19_3239\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"WARLOCK\",\"race\":\"Gnome\",\"name\":\"Darkð-Kel'Thuzad\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Darkð-Kel'Thuzad|h[|cff8788eeDarkð-Kel'Thuzad|r]|h has earned the achievement |cffffff00|Hachievement:61832:Player-3693-0E27B45B:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Delves: Tier 1]|h|r!\",\"timestamp\":1772167920,\"id\":\"s19_3240\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\