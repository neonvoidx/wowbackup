},
["color"] = {
["r"] = 0.250980406999588,
["g"] = 1,
["b"] = 0.250980406999588,
},
["text"] = "|Hchannel:GUILD|h[Guild]|h |Hplayer:Stoow-Tichondrius:1369:GUILD:|h[|cfff48cbaStoow|r]|h: L",
["timestamp"] = 1785200464,
["id"] = "s51_4102",
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Yrel",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Yrel says: With the giant defeated we shouldn't have any more trouble clearing out the area.",
["timestamp"] = 1785200481,
["id"] = "s51_4103",
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Baros Alexston",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Baros Alexston says: Let me know when you are ready to start construction, commander.",
["timestamp"] = 1785200487,
["id"] = "s51_4104",
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
