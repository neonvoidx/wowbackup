},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Skyguard Marine says: For the Alliance!",
["timestamp"] = 1773537126,
["id"] = "s27_3564",
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Master Mathias Shaw",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Master Mathias Shaw says: We've brought our ship around to the center of the island. Collect as much Azerite as you can. It is the key to victory!",
["timestamp"] = 1773537132,
["id"] = "s27_3565",
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
