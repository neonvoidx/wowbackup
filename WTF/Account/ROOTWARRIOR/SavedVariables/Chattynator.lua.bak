},
["text"] = "|Hplayer:Monstrous Behemoth:560:MONSTER_SAY:|h[Monstrous Behemoth]|h says: [Shath'Yar] Yrr Bo'al Uhnish iiqaath!",
["id"] = "s51_3445",
["timestamp"] = 1785176789,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Wrathion",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Wrathion says: To use the chamber's weapons against N'Zoth, we need to get inside his... husk.",
["id"] = "s51_3446",
["timestamp"] = 1785176810,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Wrathion",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Wrathion says: Leave this part to me. After all, dramatic entrances are my specialty.",
["id"] = "s51_3447",
["timestamp"] = 1785176816,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "N'Zoth",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "N'Zoth yells: Insolent whelpling! You desecrate that which you were bred to serve!",
["id"] = "s51_3448",
["timestamp"] = 1785176859,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Wrathion",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Wrathion yells: Angry, are we? And after I tried so hard to impress you with my dagger handiwork.",
["id"] = "s51_3449",
["timestamp"] = 1785176869,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "N'Zoth",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "N'Zoth yells: RRRRRAAAAAGGGHHHHH!",
["id"] = "s51_3450",
["timestamp"] = 1785176874,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "MOTHER",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "MOTHER says: Warning: Corruption levels exceeding measurable parameters. Recalculating...",
["id"] = "s51_3451",
["timestamp"] = 1785176885,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Wrathion",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Wrathion says: That does not sound particularly encouraging, MOTHER.",
["id"] = "s51_3452",
["timestamp"] = 1785176896,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "N'Zoth",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "N'Zoth yells: You will break, like your father before you!",
["id"] = "s51_3453",
["timestamp"] = 1785176900,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Wrathion",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Wrathion says: N'Zoth's rage seems fixated upon me, champions. Perhaps you can turn that to our advantage.",
["id"] = "s51_3454",
["timestamp"] = 1785176907,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["race"] = "Orc",
["class"] = "MONK",
["name"] = "Stormclout",
["sex"] = 3,
},
["event"] = "CHAT_MSG_MONSTER_EMOTE",
["type"] = "MONSTER_EMOTE",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.501960813999176,
["r"] = 1,
},
["text"] = "Stormclout warbles on their Seafarer's Slidewhistle.",
["id"] = "s51_3455",
["timestamp"] = 1785176913,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Lorewalker Cho",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Lorewalker Cho says: This cannot be! The Black Empire itself has invaded the Vale! Act swiftly, before all is lost!",
["id"] = "s51_3456",
["timestamp"] = 1785176933,
},
