},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zealous Adherent says: The master's vision shall be made real!",
["id"] = "s51_3438",
["timestamp"] = 1785176762,
},
