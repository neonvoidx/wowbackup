},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Kyrestia the Firstborne",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kyrestia the Firstborne says: We sacrifice because we must. Mortal burdens would only impede our sacred duty.",
["timestamp"] = 1784592790,
["id"] = "s51_2851",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Devos",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Devos says: No. It was a mortal who exposed the folly of your edicts.",
["timestamp"] = 1784592800,
["id"] = "s51_2852",
},
