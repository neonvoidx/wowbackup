:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[3000 Quests Completed]|h|r!\",\"id\":\"s18_4070\",\"timestamp\":1772152732},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Evohsx-Stormrage\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Evohsx-Stormrage|h[|cffff7c0aEvohsx-Stormrage|r]|h has earned the achievement |cffffff00|Hachievement:61832:Player-60-0F286FF8:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Delves: Tier 1]|h|r!\",\"id\":\"s18_4071\",\"timestamp\":1772152735},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"HUNTER\",\"name\":\"Dexand-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Dexand-Tichondrius|h[|cffaad372Dexand|r]|h has earned the achievement |cffffff00|Hachievement:62191:Player-11-0E2B8100:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Call of the Light]|h|r!\",\"id\":\"s18_4072\",\"timestamp\":1772152756},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"LightforgedDraenei\",\"class\":\"PALADIN\",\"name\":\"Sneakybution-Ysondre\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Sneakybution-Ysondre|h[|cfff48cbaSneakybution-Ysondre|r]|h has earned the achievement |cffffff00|Hachievement:41960:Player-78-0FAC896B:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Murder Row]|h|r!\",\"id\":\"s18_4073\",\"timestamp\":1772152776},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Scourge\",\"class\":\"ROGUE\",\"name\":\"Ironspider-Tichondrius\",\"sex\":