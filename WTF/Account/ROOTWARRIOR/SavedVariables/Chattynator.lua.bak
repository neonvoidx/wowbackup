{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Kul'amara the Fierce",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Kul'amara the Fierce says: With de creature dead an' de Vilebranch gone, we Witherbark all be sleepin' a little safer--for now.",
["id"] = "s51_4571",
["timestamp"] = 1785268761,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zul'jan",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zul'jan says: We haven't had any luck here. Did you succeed in getting Malacrass's notes?",
["id"] = "s51_4572",
["timestamp"] = 1785268780,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zul'jan",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zul'jan says: De key to Ula'tek is hidden in de serpent shrine of Atal'Aman! Let's go!",
["id"] = "s51_4573",
["timestamp"] = 1785268783,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Loa Speaker Kinduru",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Loa Speaker Kinduru says: Zul'jan, wait! We need to tell Zul'jarra!",
["id"] = "s51_4574",
["timestamp"] = 1785268793,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Loa Speaker Kinduru",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Loa Speaker Kinduru says: Zul'jan! Stop!",
["id"] = "s51_4575",
["timestamp"] = 1785268799,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Unknown",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Unknown says: If de key is within, we will have to smash de shrine open.",
["id"] = "s51_4576",
["timestamp"] = 1785268867,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zul'jan",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zul'jan says: Let me know when you're ready.",
["id"] = "s51_4577",
["timestamp"] = 1785268871,
},
