95,\"id\":\"s45_4145\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"MAGE\",\"race\":\"Human\",\"name\":\"Knotweed-Mal'Ganis\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Knotweed-Mal'Ganis receives loot: |cnIQ1:|T610613:12|t|Hitem:265695::::::::90:268:::::::::|h[Elementary Voidcore Shard]|h|r.\",\"timestamp\":1776223696,\"id\":\"s45_4146\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"Orc\",\"name\":\"Relyk-Mal'Ganis\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Relyk-Mal'Ganis receives loot: |cnIQ4:|T342520:12|t|Hitem:50233::::::::90:268::33:5:12795:13440:6652:13577:12699:1:28:1279:::::|h[Spurned Val'kyr Shoulderguards (Shoulder 266)]|h|r.\",\"timestamp\":1776223697,\"id\":\"s45_4147\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 151 Gold, 52 Silver, 45 Copper\",\"timestamp\":1776223699,\"id\":\"s45_4148\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Martin Victus\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Martin Victus yells: Brave champions, we owe you our lives, our freedom.... Though it be a tiny gesture in the face of this enormous debt, I pledge that from this day forth, all will know of your deeds, and the blazing path of light you cut through the shadow of this dark citadel.\",\"timestamp\":1776223700,\"id\":\"s45_4149\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"EVOKER\",\"race\":\"Dracthyr\",\"name\":\"Polarvoker-Mal'Ganis\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348