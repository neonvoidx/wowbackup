4826445,\"id\":\"s36_2596\"},{\"recordedBy\":\"Strathmoan-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Valeera Sanguinar says: I'll take that.\",\"timestamp\":1774826446,\"id\":\"s36_2597\"},{\"recordedBy\":\"Strathmoan-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Valeera Sanguinar says: Won't see me coming.\",\"timestamp\":1774826448,\"id\":\"s36_2598\"},{\"recordedBy\":\"Strathmoan-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Thalassian Professor\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Thalassian Professor says: Strathmoan, my students and I were just discussing the surprisingly welcoming nature of the Twilight's Blade. Would you not agree?\",\"timestamp\":1774826459,\"id\":\"s36_2599\"},{\"recordedBy\":\"Strathmoan-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Thalassian Professor\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Thalassian Professor says: Strathmoan, there is nothing to see here. All is well.\",\"timestamp\":1774826463,\"id\":\"s36_2600\"},{\"recordedBy\":\"Strathmoan-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Valeera Sanguinar says: Your pain, my pleasure.\",\"timestamp\":1774826466,\"id\":\"s36_2601\"},{\"recordedBy\":\"Strathmoan-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Valeera Sanguinar says: Stay here and recover.\",\"timestamp\":1774826470,\"id\":\"s36_2602\"},{\"recordedBy\":\"Strathmoan-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alina Everlark\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alina Everlark says: Strathmoan, thank goodness you're here. Some of our visiting professors are acting quite strange!\",\"timestamp\":1774826471,\"id\":\"s36_2603\"},{\"recordedBy\":\"Strathmoan-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Thalassian Professor\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Thalassian Professor says: You must welcome the Twilight's Blade to present their views at our institute of higher learning.\",\"timestamp\":1774826474,\"id\":\"s36_2604\"},{\"recordedBy\":\"Strathmoan-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Valeera Sanguinar says: Tsk tsk. Pesky magic.\",\"timestamp\":1774826498,\"id\":\"s36_2605\"},{\"recordedBy\":\"Strathmoan-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Valeera Sanguinar says: I'll staunch the bleeding.\",\"timestamp\":1774826501,\"id\":\"s36_2606\"},{\"recordedBy\":\"Strathmoan-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Valeera Sanguinar says: I'll savor this strike.\",\"timestamp\":1774826509,\"id\":\"s36_2607\"},{\"recordedBy\":\"Strathmoan-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"WARLOCK\",\"race\":\"VoidElf\",\"name\":\"Sshlumped-Stormrage