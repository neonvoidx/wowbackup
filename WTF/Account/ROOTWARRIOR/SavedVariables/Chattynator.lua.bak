},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Shan Bu yells: Ahahaha, the great Niuzao, strength of the west, divine celestial, protector of the weak...",
["id"] = "s27_2795",
["timestamp"] = 1773426252,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Shan Bu",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Shan Bu yells: Your charge, the sha of fear, has escaped.",
["id"] = "s27_2796",
["timestamp"] = 1773426264,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Shan Bu",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Shan Bu yells: The mantid besiege you from all sides.",
["id"] = "s27_2797",
["timestamp"] = 1773426272,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Shan Bu",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Shan Bu yells: You wield the powers of a god, but you are beaten!",
["id"] = "s27_2798",
["timestamp"] = 1773426278,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Shan Bu",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Shan Bu yells: You bear the burden of an entire people upon your shoulders. And how have they repaid you?",
["id"] = "s27_2799",
["timestamp"] = 1773426286,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Shan Bu",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Shan Bu yells: You are forgotten. This is what you fear, is it not?",
["id"] = "s27_2800",
["timestamp"] = 1773426295,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Shan Bu",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Shan Bu yells: Lay your duties aside and rest.",
["id"] = "s27_2801",
["timestamp"] = 1773426301,
},
