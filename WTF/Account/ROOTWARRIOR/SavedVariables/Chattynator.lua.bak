["g"] = 0.6666666865348816,
["r"] = 0.6666666865348816,
},
["text"] = "|Hchannel:PARTY|h[Party]|h |Hplayer:Smileclap-Mal'Ganis:1942:PARTY:|h[|cffff7c0aSmileclap-Mal'Ganis|r]|h: |cnIQ4:|Hitem:251156::::::::90:105::23:1:3524:1:28:3025:::::|h[Fallen Speaker's Staff]|h|r",
["id"] = "s28_2801",
["timestamp"] = 1773629528,
},
{
