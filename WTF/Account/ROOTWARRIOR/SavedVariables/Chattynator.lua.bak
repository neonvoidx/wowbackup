age-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"Human\",\"name\":\"Varamithis-Sargeras\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Varamithis-Sargeras|h[|cfff48cbaVaramithis-Sargeras|r]|h has earned the achievement |cffffff00|Hachievement:42045:Player-76-095925CB:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Midnight]|h|r!\",\"timestamp\":1772215981,\"id\":\"s19_4794\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PRIEST\",\"race\":\"NightElf\",\"name\":\"Covalskisiño-Ragnaros\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"¡|Hplayer:Covalskisiño-Ragnaros|h[|cffffffffCovalskisiño-Ragnaros|r]|h ha ganado el logro |cffffff00|Hachievement:42299:Player-1427-0E6ACF81:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Visions of a Shadowed Sun]|h|r!\",\"timestamp\":1772216019,\"id\":\"s19_4795\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PRIEST\",\"race\":\"NightElf\",\"name\":\"Covalskisiño-Ragnaros\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"¡|Hplayer:Covalskisiño-Ragnaros|h[|cffffffffCovalskisiño-Ragnaros|r]|h ha ganado el logro |cffffff00|Hachievement:61498:Player-1427-0E6ACF81:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Ready for Midnight]|h|r!\",\"timestamp\":1772216019,\"id\":\"s19_4796\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Captain Garrick\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Captain Garrick says: I'll keep you safe. Follow me.\",\"timestamp\":1772216054,\"id\":\"s19_4797\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_PING\",\"type\":\"PING\"},\"color\":{\"r\":0.6666666865348816,\"g\":0.6666666865348816,\"b\":1},\"text\":\"[Leader] |Hplayer:Starphage|h[Starphage]: |h|A:ping_chat_nonthreat:0:0:0:0|aLook here\",\"timestamp\":1772216110,\"id\":\"s19_4798\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"DarkIronDwarf\",\"name\":\"Tipride-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Tipride-Tichondrius|h[|cff0070ddTipride|r]|h has earned the achievement |cffffff00|Hachievement:61639:Player-11-0EA6D4F4:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Maisara Caverns]|h|r!\",\"timestamp\":1772216148,\"id\":\"s19_4799\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: Starphage, I know what to do! I'll need to attune the Cynosure to the Voidstorm.\",\"timestamp\":1772216211,\"id\":\"s19_4800\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: What... is that monstrosity? Starphage, you keep it occupied while I channel the spell and end this chaos!\",\"timestamp\":1772216218,\"id\":\"s19_4801\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Degentrius\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Degentrius yells: You... how...\",\"timestamp\":1772216335,\"id\":\"s19_4802\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Starphage-Tichondrius|h[|cffa330c9Starphage|r]|h has earned the achievement |cffffff00|Hachievement:61212:Player-11-0EA2971B:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Magisters' Terrace]|h|r!\",\"timestamp\":1772216335,\"id\":\"s19_4803\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Starphage-Tichondrius|h[|cffa330c9Starphage|r]|h has earned the achievement |cffffff00|Hachievement:61212:Player-11-0EA2971B:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Magisters' Terrace]|h|r!\",\"timestamp\":1772216335,\"id\":\"s19_4804\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ2:|Hitem:263230::::::::86:1480::17::1:28:5117:::::|h[Magister's Bookshelf]|h|r\",\"timestamp\":1772216337,\"id\":\"s19_4805\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 25 Gold, 84 Silver, 80 Copper\",\"timestamp\":1772216338,\"id\":\"s19_4806\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: It is done! We have our way into the Voidstorm. Let us inform Lor'themar.\",\"timestamp\":1772216340,\"id\":\"s19_4807\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: ...and perhaps offer an apology for the near catastrophe.\",\"timestamp\":1772216347,\"id\":\"s19_4808\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Captain Garrick\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Captain Garrick says: Very well. You take point.\",\"timestamp\":1772216353,\"id\":\"s19_4809\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"BloodElf\",\"name\":\"Kalevala-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Kalevala-Tichondrius|h[|cffa330c9Kalevala|r]|h has earned the achievement |cffffff00|Hachievement:61832:Player-11-0E6775FC:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Delves: Tier 1]|h|r!\",\"timestamp\":1772216374,\"id\":\"s19_4810\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lor'themar Theron says: You did what you had to, Umbric. We must enter the Voidstorm if we are to stop it. \",\"timestamp\":1772216414,\"id\":\"s19_4811\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ3:|Hitem:251115::::::::86:1480::17:3:13441:13436:13668:2:9:86:28:3084:::::|h[Bifurcation Band]|h|r\",\"timestamp\":1772216418,\"id\":\"s19_4812\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: Here Starphage, help me align the spell. It will anchor us back to Magisters' Terrace in case of disaster.\",\"timestamp\":1772216419,\"id\":\"s19_4813\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lor'themar Theron says: High Commander Lothraxion has warred on countless far realms, so I have asked him to lead this mission. \",\"timestamp\":1772216428,\"id\":\"s19_4814\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Evohsx-Stormrage\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Evohsx-Stormrage|h[|cffff7c0aEvohsx-Stormrage|r]|h has earned the achievement |cffffff00|Hachievement:61387:Player-60-0F286FF8:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Prey: Normal Mode I]|h|r!\",\"timestamp\":1772216432,\"id\":\"s19_4815\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lor'themar Theron says: And young Arator has more than proven his worth. Together, I hope their Light will balance you within the shadow. \",\"timestamp\":1772216435,\"id\":\"s19_4816\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_RAID_BOSS_WHISPER\",\"type\":\"MONSTER_BOSS_WHISPER\"},\"color\":{\"r\":1,\"g\":0.8666667342185974,\"b\":0},\"text\":\"Pull the energy to another Shadow Focus!\",\"timestamp\":1772216435,\"id\":\"s19_4817\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: You ren'dorei may be our greatest weapon against the Void. I swear to protect you all. \",\"timestamp\":1772216441,\"id\":\"s19_4818\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: The Light is our greatest weapon against the Void. Remember that, or succumb to corruption. \",\"timestamp\":1772216447,\"id\":\"s19_4819\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: The portal is opened. Gather your courage... only darkness awaits us on the other side.\",\"timestamp\":1772216463,\"id\":\"s19_4820\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Grand Magister Rommath says: How DARE you step into the Magisters' Terrace, Umbric! You nearly destroyed us all, just like I knew you would!\",\"timestamp\":1772216467,\"id\":\"s19_4821\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lor'themar Theron says: The fate of Silvermoon, of all of Azeroth, may rest on the outcome of this mission. Anu belore dela'na.\",\"timestamp\":1772216472,\"id\":\"s19_4822\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: I have confidence in the strength of myself and my allies. Something you noticeably lack, Rommath.\",\"timestamp\":1772216474,\"id\":\"s19_4823\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: So much--so much Void!\",\"timestamp\":1772216482,\"id\":\"s19_4824\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: Resist it, Starphage! You control the Shadow, it does not control you!\",\"timestamp\":1772216505,\"id\":\"s19_4825\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"Pandaren\",\"name\":\"Frostyfries-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Frostyfries-Tichondrius|h[|cffc41e3aFrostyfries|r]|h has earned the achievement |cffffff00|Hachievement:41802:Player-11-0E83AB7E:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Eversong In Reprise]|h|r!\",\"timestamp\":1772216527,\"id\":\"s19_4826\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Human\",\"name\":\"Amaragos-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Amaragos-Tichondrius|h[|cff00ff98Amaragos|r]|h has earned the achievement |cffffff00|Hachievement:61855:Player-11-0EB05FFC:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Explore Eversong Woods]|h|r!\",\"timestamp\":1772216611,\"id\":\"s19_4827\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: Eyes forward!\",\"timestamp\":1772216727,\"id\":\"s19_4828\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Voidlight Everdawn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Voidlight Everdawn says: We must scout... yes. Yes, scout ahead...\",\"timestamp\":1772216730,\"id\":\"s19_4829\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"You sense a nearby Skyriding Glyph.\",\"timestamp\":1772216734,\"id\":\"s19_4830\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Maella\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Maella says: Everdawn--No! Curses!\",\"timestamp\":1772216734,\"id\":\"s19_4831\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: Control yourselves!\",\"timestamp\":1772216740,\"id\":\"s19_4832\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Maella\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Maella says: It is like drowning, flailing your arms out... but we will learn to swim. \",\"timestamp\":1772216743,\"id\":\"s19_4833\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lady Darkglen\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lady Darkglen says: Fear not for my sanity, Starphage. My minion and I are well used to such madness. \",\"timestamp\":1772216760,\"id\":\"s19_4834\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:242639::::::::86:1480:::::::::|h[Practically Pork]|h|rx2\",\"timestamp\":1772216779,\"id\":\"s19_4835\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260660::::::::86:1480:::::::::|h[Putrid Mushroom Spores]|h|r\",\"timestamp\":1772216779,\"id\":\"s19_4836\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Astre\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Astre says: It's worse... worse even than when we were first transformed by the Void in Telogrus. But I'll--I'll get through it, Hieron. \",\"timestamp\":1772216790,\"id\":\"s19_4837\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: We must get a lay of the land. Come! \",\"timestamp\":1772216810,\"id\":\"s19_4838\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"You sense a nearby Skyriding Glyph.\",\"timestamp\":1772216811,\"id\":\"s19_4839\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"DarkIronDwarf\",\"name\":\"Tipride-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Tipride-Tichondrius|h[|cff0070ddTipride|r]|h has earned the achievement |cffffff00|Hachievement:41805:Player-11-0EA6D4F4:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Arator's Journey]|h|r!\",\"timestamp\":1772216833,\"id\":\"s19_4840\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:242639::::::::86:1480:::::::::|h[Practically Pork]|h|rx10\",\"timestamp\":1772216843,\"id\":\"s19_4841\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"