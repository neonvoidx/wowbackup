mestamp\":1772813737,\"id\":\"s23_4557\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ2:|Hitem:237362::::::::90:1480::::1:38:13:::::|h[Umbral Tin Ore |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|rx3\",\"timestamp\":1772813738,\"id\":\"s23_4558\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ3:|Hitem:237496::::::::90:1480:::::::::|h[Igneous Rock Specimen]|h|r\",\"timestamp\":1772813738,\"id\":\"s23_4559\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3158:0|h[Midnight Mining Knowledge]|h|rx1\",\"timestamp\":1772813743,\"id\":\"s23_4560\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3264:0|h[Artisan Miner's Moxie]|h|rx5\",\"timestamp\":1772813743,\"id\":\"s23_4561\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:235912::::::::90:1480:::::::::|h[Bloodweed Branch]|h|rx3\",\"timestamp\":1772813752,\"id\":\"s23_4562\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Warlord Akutu\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Warlord Akutu says: Give me dat liver. I'll try anythin'.\",\"timestamp\":1772813775,\"id\":\"s23_4563\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Sij'ta\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Loa Speaker Sij'ta says: I want answers. And I will get dem from Kulzi himself!\",\"timestamp\":1772813778,\"id\":\"s23_4564\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Warlord Akutu\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Warlord Akutu says: Kulzi! I sacrifice dis part of ya flesh to heal me and reject death. I demand your healin' power!\",\"timestamp\":1772813784,\"id\":\"s23_4565\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kulzi\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kulzi says: You are a friend to the loa.\",\"timestamp\":1772813796,\"id\":\"s23_4566\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kulzi\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kulzi says: We will speak.\",\"timestamp\":1772813800,\"id\":\"s23_4567\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kulzi\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kulzi says: They do know the reality, deep down. Whether they can face it--that is their challenge.\",\"timestamp\":1772813804,\"id\":\"s23_4568\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kulzi\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kulzi says: Find the shattered staff at the healing altar, and you will learn more.\",\"timestamp\":1772813811,\"id\":\"s23_4569\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Unrepentant Spirit\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Unrepentant Spirit says: De loa's healin' is ours alone!\",\"timestamp\":1772813812,\"id\":\"s23_4570\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:246210::::::::90:1480:::::::::|h[Shattered Staff]|h|r\",\"timestamp\":1772813814,\"id\":\"s23_4571\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Memory of Loa Speaker Sij'ta\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Memory of Loa Speaker Sij'ta says: We insulted Kulzi with our demands, Warlord. He says death already claim you--\",\"timestamp\":1772813817,\"id\":\"s23_4572\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Memory of Warlord Akutu\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Memory of Warlord Akutu says: Dat loa will do as I say. Here. Take dis hexlord staff. We take Kulzi's power for de glory of Zul'jin!\",\"timestamp\":1772813824,\"id\":\"s23_4573\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Memory of Loa Speaker Sij'ta\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Memory of Loa Speaker Sij'ta says: Hexlord staff? But anyone who use de staff... it is a dark ting--\",\"timestamp\":1772813831,\"id\":\"s23_4574\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 3 Gold, 29 Silver, 29 Copper\",\"timestamp\":1772813833,\"id\":\"s23_4575\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Memory of Warlord Akutu\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Memory of Warlord Akutu says: You are a \\\"Loa Speaker,\\\" right? So speak to it! Make Kulzi work for us! You made de oath!\",\"timestamp\":1772813836,\"id\":\"s23_4576\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Forgetful Ghost\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Forgetful Ghost says: De loa is evil, holding us here.\",\"timestamp\":1772813858,\"id\":\"s23_4577\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Forgetful Ghost\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Forgetful Ghost says: That's de staff! When it broke, burnin' magic spewed out. I don't want to remember dis.\",\"timestamp\":1772813865,\"id\":\"s23_4578\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"BloodElf\",\"name\":\"Northernmist-BlackwaterRaiders\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Northernmist-BlackwaterRaiders:1786:GUILD:|h[|cfff48cbaNorthernmist|r]|h: good morning  these|cnIQ4:|Hitem:253307::::::::84:70:::::::::|h[Infused Heliotrope]|h|rcan be bought at the pvp vendor 2500 honor\",\"timestamp\":1772813867,\"id\":\"s23_4579\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Forgetful Ghost\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Forgetful Ghost says: De loa is evil, holding us here.\",\"timestamp\":1772813871,\"id\":\"s23_4580\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Forgetful Ghost\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Forgetful Ghost says: Loa Speaker Sij'ta said de loa couldn't heal de warlord. But why not?\",\"timestamp\":1772813877,\"id\":\"s23_4581\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Forgetful Ghost\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Forgetful Ghost says: I won't face dis. You can't make me.\",\"timestamp\":1772813880,\"id\":\"s23_4582\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Forgetful Ghost\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Forgetful Ghost says: Wait--it's a hexlord staff. Why would de warlord have one?\",\"timestamp\":1772813884,\"id\":\"s23_4583\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Unrepentant Spirit\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Unrepentant Spirit says: If de warlord can't be saved, no one can!\",\"timestamp\":1772813893,\"id\":\"s23_4584\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Forgetful Ghost\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Forgetful Ghost says: I won't face dis. You can't make me.\",\"timestamp\":1772813895,\"id\":\"s23_4585\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Forgetful Ghost\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Forgetful Ghost says: De loa is evil, holding us here.\",\"timestamp\":1772813899,\"id\":\"s23_4586\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Unrepentant Spirit\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Unrepentant Spirit says: Was I... already dead?\",\"timestamp\":1772813903,\"id\":\"s23_4587\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Pangopup\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Pangopup attempts to run away in fear!\",\"timestamp\":1772813905,\"id\":\"s23_4588\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Forgetful Ghost\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Forgetful Ghost says: We swore an oath to de warlord. Is dat holding us here?\",\"timestamp\":1772813908,\"id\":\"s23_4589\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Forgetful Ghost\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Forgetful Ghost says: That's de staff! When it broke, burnin' magic spewed out. I don't want to remember dis.\",\"timestamp\":1772813908,\"id\":\"s23_4590\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Forgetful Ghost\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Forgetful Ghost says: I won't face dis. You can't make me.\",\"timestamp\":1772813912,\"id\":\"s23_4591\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Forgetful Ghost\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Forgetful Ghost says: De loa is evil, holding us here.\",\"timestamp\":1772813915,\"id\":\"s23_4592\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Forgetful Ghost\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Forgetful Ghost says: I remember dis magic burnin' my eyes. De staff broke. We... died.\",\"timestamp\":1772813926,\"id\":\"s23_4593\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Forgetful Ghost\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Forgetful Ghost says: That's de staff! When it broke, burnin' magic spewed out. I don't want to remember dis.\",\"timestamp\":1772813930,\"id\":\"s23_4594\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Forgetful Ghost\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Forgetful Ghost says: If de loa won't heal him, de warlord was right to use the staff to punish it!\",\"timestamp\":1772813937,\"id\":\"s23_4595\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Forgetful Ghost\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Forgetful Ghost says: I remember dying. At least it was swift. De staff must've had somethin' evil inside.\",\"timestamp\":1772813947,\"id\":\"s23_4596\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Warlord Akutu\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Warlord Akutu says: I can't be dead. It is a trick. You are wrong!\",\"timestamp\":1772813966,\"id\":\"s23_4597\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Warlord Akutu\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Warlord Akutu says: De loa put you up to dis. He's up there, isn't he? I'll kill 'im!\",\"timestamp\":1772813970,\"id\":\"s23_4598\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Sij'ta\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Loa Speaker Sij'ta says: I just want de truth.\",\"timestamp\":1772813976,\"id\":\"s23_4599\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Warlord Akutu\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Warlord Akutu yells: You'll pay for dis, Kulzi!\",\"timestamp\":1772813980,\"id\":\"s23_4600\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kulzi\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kulzi says: You know what this staff means now, Sij'ta?\",\"timestamp\":1772813981,\"id\":\"s23_4601\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"WARRIOR\",\"race\":\"Pandaren\",\"name\":\"Hhyyzzll-Mal'Ganis\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Hhyyzzll-Mal'Ganis:1815:GUILD:|h[|cffc69b6dHhyyzzll|r]|h: good morning yall\",\"timestamp\":1772813983,\"id\":\"s23_4602\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Sij'ta\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Loa Speaker Sij'ta says: Yes. It's a hexlord staff made to harm loa. When I broke it, it... backfired dark magic. I didn't mean to be harmin' anyone.\",\"timestamp\":1772813986,\"id\":\"s23_4603\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Warlord Akutu\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Warlord Akutu says: You shoulda used it, Sij'ta! Oathbreaker!\",\"timestamp\":1772813993,\"id\":\"s23_4604\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Sij'ta\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Loa Speaker Sij'ta says: Give me de broken staff, Starphage.\",\"timestamp\":1772813997,\"id\":\"s23_4605\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Raiding Rogue\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Raiding Rogue says: Healer! Healer?!\",\"timestamp\":1772814032,\"id\":\"s23_4606\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Budd Nedreck\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Budd Nedreck says: I can only assume that you know who I am, and yet you insist on disturbing me?\",\"timestamp\":1772814039,\"id\":\"s23_4607\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"BloodElf\",\"name\":\"Northernmist-BlackwaterRaiders\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Northernmist-BlackwaterRaiders:1821:GUILD:|h[|cfff48cbaNorthernmist|r]|h: Friday is the Best \",\"timestamp\":1772814057,\"id\":\"s23_4608\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Budd Nedreck\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Budd Nedreck says: Oh come now, don't be ridiculous! I'm the one and only Budd Nedreck!\",\"timestamp\":1772814060,\"id\":\"s23_4609\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"You sense a nearby Skyriding Glyph.\",\"timestamp\":1772814064,\"id\":\"s23_4610\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Harrison Jones\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Harrison Jones says: A word to the wise, stranger: go back to wherever you're from!\",\"timestamp\":1772814069,\"id\":\"s23_4611\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Harrison Jones\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Harrison Jones says: Are you here to train in Archaeology?\",\"timestamp\":1772814078,\"id\":\"s23_4612\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:258138::::::::90:1480:::::::::|h[Potent Healing Potion]|h|rx2\",\"timestamp\":1772814096,\"id\":\"s23_4613\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx4\",\"timestamp\":1772814097,\"id\":\"s23_4614\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"WARRIOR\",\"race\":\"Pandaren\",\"name\":\"Hhyyzzll-Mal'Ganis\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Hhyyzzll-Mal'Ganis:1828:GUILD:|h[|cffc69b6dHhyyzzll|r]|h: its bis\",\"timestamp\":1772814101,\"id\":\"s23_4615\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Torundo the Grizzled\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Torundo the Grizzled says: Admit it, Doru. You love how all dis reminds you of de old days.\",\"timestamp\":1772814108,\"id\":\"s23_4616\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Elder Doru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Elder Doru says: Hah! All it reminds me of is draggin' your sorry, beaten self off de battlefield over and over again.\",\"timestamp\":1772814114,\"id\":\"s23_4617\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Torundo the Grizzled\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Torundo the Grizzled says: Though they shamed us in life, your work today may provide honor to those who stole the loa's power long ago.\",\"timestamp\":1772814115,\"id\":\"s23_4618\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Raiding Warrior\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Raiding Warrior says: We won't wipe this time!\",\"timestamp\":1772814153,\"id\":\"s23_4619\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Raiding Warrior\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Raiding Warrior says: But my gear was perfect...\",\"timestamp\":1772814161,\"id\":\"s23_4620\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Raiding Rogue\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Raiding Rogue says: Healer! Healer?!\",\"timestamp\":1772814198,\"id\":\"s23_4621\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Raiding Rogue\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Raiding Rogue says: Healer! Healer?!\",\"timestamp\":1772814198,\"id\":\"s23_4622\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Raiding Warrior\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Raiding Warrior says: Healer! Healer?!\",\"timestamp\":1772814198,\"id\":\"s23_4623\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Soreloser-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Soreloser-Tichondrius:1845:GUILD:|h[|cffff7c0aSoreloser|r]|h: |cffff80ff|Hcustomset:Lw*>V>NQALwY&D[)O/NPuLzQLw0LwMLwC*mH&&&&j5&&&&&&>V>|h[|T1598183:13:13:-1:0|tCustom Set]|h|r or |cffff80ff|Hcustomset:Lw(>V>0ME42@&D[)O/42B'Ay1GC&Q-'Aw*mH&&&&U?&&&&&&>V>|h[|T1598183:13:13:-1:0|tCustom Set]|h|r\",\"timestamp\":1772814207,\"id\":\"s23_4624\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Soreloser-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Soreloser-Tichondrius:1846:GUILD:|h[|cffff7c0aSoreloser|r]|h: which one is best 1st or 2nd\",\"timestamp\":1772814221,\"id\":\"s23_4625\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Raiding Warrior\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Raiding Warrior says: Should have left this party months ago...\",\"timestamp\":1772814229,\"id\":\"s23_4626\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Gnome\",\"name\":\"Wankge-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Wankge-Tichondrius:1848:GUILD:|h[|cff00ff98Wankge|r]|h: 2nd one\",\"timestamp\":1772814238,\"id\":\"s23_4627\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Raiding Warrior\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Raiding Warrior says: Take out the trash first!\",\"timestamp\":1772814250,\"id\":\"s23_4628\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Raid Leader\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Raid Leader says: Another one? There was nothing in my adventure journal about you!\",\"timestamp\":1772814251,\"id\":\"s23_4629\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Nøçht-Area52\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Nøçht-Area52:1851:GUILD:|h[|cfffff468Nøçht|r]|h: agreed, 2nd\",\"timestamp\":1772814255,\"id\":\"s23_4630\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Nøçht-Area52\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Nøçht-Area52:1854:GUILD:|h[|cfffff468Nøçht|r]|h: thats clean af\",\"timestamp\":1772814262,\"id\":\"s23_4631\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"BloodElf\",\"name\":\"Northernmist-BlackwaterRaiders\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Northernmist-BlackwaterRaiders:1855:GUILD:|h[|cfff48cbaNorthernmist|r]|h: second one is Bis\",\"timestamp\":1772814279,\"id\":\"s23_4632\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Raiding Warrior\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Raiding Warrior says: Healer! Healer?!\",\"timestamp\":1772814290,\"id\":\"s23_4633\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Raiding Rogue\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Raiding Rogue says: Healer! Healer?!\",\"timestamp\":1772814293,\"id\":\"s23_4634\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Raid Leader\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Raid Leader says: That's minus fifty... troll killing... points...\",\"timestamp\":1772814293,\"id\":\"s23_4635\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 5 Gold, 31 Silver, 89 Copper\",\"timestamp\":1772814298,\"id\":\"s23_4636\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Torundo the Grizzled\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Torundo the Grizzled says: Even from here, I can see de tide of battle swayin' back to our favor.\",\"timestamp\":1772814305,\"id\":\"s23_4637\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:264184::::::::90:1480::11::1:28:3321:::::|h[Arsenal: Heirlooms of Atal'Aman]|h|r\",\"timestamp\":1772814306,\"id\":\"s23_4638\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Torundo the Grizzled\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Torundo the Grizzled says: You have de forest tribes' thanks yet again, hash'ura.\",\"timestamp\":1772814306,\"id\":\"s23_4639\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Torundo the Grizzled\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Torundo the Grizzled says: On our lives, we will see dat Atal'Aman returns to its past glory!\",\"timestamp\":1772814311,\"id\":\"s23_4640\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Elder Doru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Elder Doru says: Hah! Hard to take such a bold statement seriously when it's coming from such an old man!\",\"timestamp\":1772814317,\"id\":\"s23_4641\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Torundo the Grizzled\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Torundo the Grizzled says: Speak for ya self, old bat! I'll show ya age means nothin' once a berserker enters de battle!\",\"timestamp\":1772814323,\"id\":\"s23_4642\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Elder Doru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Elder Doru says: That man...\",\"timestamp\":1772814331,\"id\":\"s23_4643\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Elder Doru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Elder Doru says: I appreciate you, hash'ura. For remindin' ol' Grizzled dat dis fight wasn't to shame his past failures.\",\"timestamp\":1772814332,\"id\":\"s23_4644\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"BloodElf\",\"name\":\"Northernmist-BlackwaterRaiders\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"t