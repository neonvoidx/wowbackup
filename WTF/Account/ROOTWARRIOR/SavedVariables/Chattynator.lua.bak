["b"] = -0,
},
["text"] = "Thangge-MoonGuard receives loot: |cnIQ3:|T3536201:12|t|Hitem:178861::::::::81:66::22:3:6652:13609:7756:2:9:25:28:2044:::::|h[Decanter of Anima-Charged Winds (Trinket 28)]|h|r.",
["timestamp"] = 1784592271,
["id"] = "s51_2796",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Kyrestia the Firstborne",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kyrestia the Firstborne says: We are vastly outnumbered, mortals. The Forsworn have cut a swath through most of our forces.",
["timestamp"] = 1784592327,
["id"] = "s51_2797",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Kyrestia the Firstborne",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kyrestia the Firstborne says: Vanquish their rear guard while I confront Devos. Go in service.",
["timestamp"] = 1784592337,
["id"] = "s51_2798",
},
