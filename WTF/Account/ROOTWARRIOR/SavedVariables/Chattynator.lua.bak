ing out! Light bless you!\",\"id\":\"s26_3549\",\"timestamp\":1773165616},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260639::::::::90:269:::::::::|h[Fractured Bone]|h|r\",\"id\":\"s26_3550\",\"timestamp\":1773165617},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:237827::::::::90:269:::::::::|h[Fallen Vanguard's Memento]|h|r\",\"id\":\"s26_3551\",\"timestamp\":1773165626},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:257207::::::::90:269::31:1:13634:1:28:3320:::::|h[Voidbreaker's Cord]|h|r\",\"id\":\"s26_3552\",\"timestamp\":1773165630},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: Heal within the protection of my Light! We will defend you!\",\"id\":\"s26_3553\",\"timestamp\":1773165632},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout\",\"sex\":3},\"event\":\"CHAT_MSG_RAID_BOSS_WHISPER\",\"type\":\"MONSTER_BOSS_WHISPER\"},\"color\":{\"b\":0,\"g\":0.8666667342185974,\"r\":1},\"text\":\"Ambushed!\",\"id\":\"s26_3554\",\"timestamp\":1773165646},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Phaseblade Talasha\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Phaseblade Talasha says: You've stumbled right into my trap...\",\"id\":\"s26_3555\",\"timestamp\":1773165648},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Phaseblade Talasha\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Phaseblade Talasha says: A momentary setback.\",\"id\":\"s26_3556\",\"timestamp\":1773165654},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Vanguard Scout\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Vanguard Scout says: We would have died if not for you!\",\"id\":\"s26_3557\",\"timestamp\":1773165657},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260673::::::::90:269:::::::::|h[Partially Digested Bracers]|h|r\",\"id\":\"s26_3558\",\"timestamp\":1773165671},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260659::::::::90:269:::::::::|h[Stellar Vortex Residue]|h|rx5\",\"id\":\"s26_3559\",\"timestamp\":1773165671},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260638::::::::90:269:::::::::|h[Fine Void Residue]|h|r\",\"id\":\"s26_3560\",\"timestamp\":1773165671},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260639::::::::90:269:::::::::|h[Fractured Bone]|h|r\",\"id\":\"s26_3561\",\"timestamp\":1773165671},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3392:0|h[Remnant of Anguish]|h|rx9\",\"id\":\"s26_3562\",\"timestamp\":1773165688},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260673::::::::90:269:::::::::|h[Partially Digested Bracers]|h|r\",\"id\":\"s26_3563\",\"timestamp\":1773165690},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Vanguard Scout\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Vanguard Scout says: Thank you! We'll regroup for the next assault.\",\"id\":\"s26_3564\",\"timestamp\":1773165703},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260655::::::::90:269:::::::::|h[Decaying Humanoid Flesh]|h|r\",\"id\":\"s26_3565\",\"timestamp\":1773165703},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:257210::::::::90:269::31:1:13634:1:28:3320:::::|h[Voidbreaker's Pants]|h|r\",\"id\":\"s26_3566\",\"timestamp\":1773165705},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: Thank you for all you've done, Stormclout. For the Vanguard, for Silvermoon... and for me.\",\"id\":\"s26_3567\",\"timestamp\":1773165706},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"War Chaplain Senn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"War Chaplain Senn says: Champion! Alleria had scarcely arrived before she left to track down our missing officers.\",\"id\":\"s26_3568\",\"timestamp\":1773165759},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: Stormclout, a word. I ask that you not mention anything to my mother about what happened at the Amani Pass.\",\"id\":\"s26_3569\",\"timestamp\":1773165771},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: I assume Arator sent you to help me? I could use another pair of hands.\",\"id\":\"s26_3570\",\"timestamp\":1773165785},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: Scraps of a Vanguard uniform... officer emblem... just as I thought.\",\"id\":\"s26_3571\",\"timestamp\":1773165789},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: They're abducting the Vanguard's officers, Stormclout. Is this just the hunger of the beasts, or is Xal'atath gathering intelligence?\",\"id\":\"s26_3572\",\"timestamp\":1773165798},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: Stay alert, Stormclout. These creatures can come from anywhere.\",\"id\":\"s26_3573\",\"timestamp\":1773165812},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: This was one of the soldiers from the Vanguard. They must've been dragged from their cot, then feasted upon here in the gorge.\",\"id\":\"s26_3574\",\"timestamp\":1773165821},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: This body is half-eaten, torn apart by those scavengers.\",\"id\":\"s26_3575\",\"timestamp\":1773165837},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: This blood is fresh... wait, Stormclout. Do you hear that?\",\"id\":\"s26_3576\",\"timestamp\":1773165848},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Nadia Brighton\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Nadia Brighton says: By the Light--get off me, you beast!\",\"id\":\"s26_3577\",\"timestamp\":1773165854},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: A survivor! We're not too late!\",\"id\":\"s26_3578\",\"timestamp\":1773165859},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout\",\"sex\":3},\"event\":\"CHAT_MSG_RAID_BOSS_WHISPER\",\"type\":\"MONSTER_BOSS_WHISPER\"},\"color\":{\"b\":0,\"g\":0.8666667342185974,\"r\":1},\"text\":\"Ambushed!\",\"id\":\"s26_3579\",\"timestamp\":1773165871},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Phaseblade Talasha\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Phaseblade Talasha says: You've stumbled right into my trap...\",\"id\":\"s26_3580\",\"timestamp\":1773165872},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Phaseblade Talasha\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Phaseblade Talasha says: A momentary setback.\",\"id\":\"s26_3581\",\"timestamp\":1773165881},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"r