ds\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Cousin Slowhands says: I'll update my journal.\",\"id\":\"s44_3087\",\"timestamp\":1775748074},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: Not even the Farstriders are immune to corruption and treachery.\",\"id\":\"s44_3088\",\"timestamp\":1775748217},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: Your target is harvesting power here. Destroy the sources and evade their little guards.\",\"id\":\"s44_3089\",\"timestamp\":1775748378},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: We simply cannot have them gaining the upper hand, can we?\",\"id\":\"s44_3090\",\"timestamp\":1775748430},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\" says: \",\"id\":\"s44_3091\",\"timestamp\":1775748454},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"ROGUE\",\"name\":\"Manyfaced-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|T7082306:12|t|Hitem:258852::::::::80:260:::1:13611:2:9:80:28:3322:::::|h[Stained Greaves (Legs 120)]|h|r\",\"id\":\"s44_3092\",\"times