},
["text"] = "You receive currency: |cnIQ3:|T7639517:12|t|Hcurrency:3383:0|h[Adventurer Dawncrest]|h|rx5",
["id"] = "s47_2970",
["timestamp"] = 1776880172,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Grand Magister Rommath",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Grand Magister Rommath says: Catalogue every newcomer. I want no secrets among these latest arrivals.",
["id"] = "s47_2971",
["timestamp"] = 1776880189,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Ranger Telenus",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Ranger Telenus says: Look at this mess!",
["id"] = "s47_2972",
["timestamp"] = 1776880190,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Hagar",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Hagar says: Some meddlesome miscreants have spread acorns around the Cradle. Clean them up, won't you?",
["id"] = "s47_2973",
["timestamp"] = 1776880198,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zur'ashar Kassameh",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zur'ashar Kassameh says: A rare honor is yours, Stormclout: to discover the secret behind this fungarian spear. I look forward to what you uncover.",
["id"] = "s47_2974",
["timestamp"] = 1776880232,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["race"] = "Human",
["class"] = "MONK",
["name"] = "Stormclout",
["sex"] = 3,
},
["event"] = "CHAT_MSG_MONSTER_EMOTE",
["type"] = "MONSTER_EMOTE",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.501960813999176,
["r"] = 1,
},
["text"] = "You sense a nearby Skyriding Glyph.",
["id"] = "s47_2975",
["timestamp"] = 1776880252,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zur'ashar Kassameh",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zur'ashar Kassameh says: Fungarian tenacity meets rutaani thorns, and all of Harandar bleeds. We haranir step in, not to win a war, but to prune it before the rot consumes all.",
["id"] = "s47_2976",
["timestamp"] = 1776880266,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["race"] = "Human",
["class"] = "MONK",
["name"] = "Stormclout",
["sex"] = 3,
},
["event"] = "CHAT_MSG_MONSTER_EMOTE",
["type"] = "MONSTER_EMOTE",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.501960813999176,
["r"] = 1,
},
["text"] = "Stormclout just won a game of Hearthstone!",
["id"] = "s47_2977",
["timestamp"] = 1776880278,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Fungarian Brawler",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Fungarian Brawler says: My cap broken... Russula will avenge...",
["id"] = "s47_2978",
["timestamp"] = 1776880279,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Rutaani Skirmisher",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Rutaani Skirmisher says: We will grow back!",
["id"] = "s47_2979",
["timestamp"] = 1776880283,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Fungarian Brawler",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Fungarian Brawler says: Russula will snap you twigs!",
["id"] = "s47_2980",
["timestamp"] = 1776880285,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Rutaani Skirmisher",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Rutaani Skirmisher says: Fungal rot... must be cleansed...",
["id"] = "s47_2981",
["timestamp"] = 1776880286,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["race"] = "Human",
["class"] = "MONK",
["name"] = "Stormclout-Tichondrius",
["sex"] = 3,
},
["event"] = "CHAT_MSG_LOOT",
["type"] = "LOOT",
},
["color"] = {
["b"] = -0,
["g"] = 0.6666666865348816,
["r"] = -0,
},
["text"] = "You receive loot: |cnIQ2:|T1500968:12|t|Hitem:265800::::::::90:269:::::::::|h[Earthy Garnish]|h|r",
["id"] = "s47_2982",
["timestamp"] = 1776880286,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["event"] = "CHAT_MSG_MONEY",
["type"] = "MONEY",
},
["color"] = {
["b"] = -0,
["g"] = 1,
["r"] = 1,
},
["text"] = "You loot 1 Gold, 90 Silver, 45 Copper",
["id"] = "s47_2983",
["timestamp"] = 1776880287,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zur'ashar Kassameh",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zur'ashar Kassameh says: The first skirmish is halted, yet anger still simmers. The leaders of both sides refuse to reason except for one.",
["id"] = "s47_2984",
["timestamp"] = 1776880293,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Roonek",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Roonek says: This one hears... but the petals have fallen. Only thorns remain.",
["id"] = "s47_2985",
["timestamp"] = 1776880300,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Pustulehelm",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Pustulehelm says: Boring! No deal! They snap stalks, we snap back harder! Tell rutaani no cry when spores fly next!",
["id"] = "s47_2986",
["timestamp"] = 1776880312,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Russula",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Russula yells: You! Fighter with brain! Come quick, want peace words!",
["id"] = "s47_2987",
["timestamp"] = 1776880313,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zur'ashar Kassameh",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zur'ashar Kassameh says: Behold Russula, an advocate for mercy whose plea was drowned by the drums of war. But Russula knew how to make their voice heard over the din.",
["id"] = "s47_2988",
["timestamp"] = 1776880321,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zur'ashar Kassameh",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zur'ashar Kassameh says: Grown to a size that none could ignore, the fungarian used their might to put an end to the battle. Their actions were to separate the combatants, not break them.",
["id"] = "s47_2989",
["timestamp"] = 1776880363,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Warbound Rutaani",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Warbound Rutaani says: This one bleeds... but from pride. It is shorn.",
["id"] = "s47_2990",
["timestamp"] = 1776880369,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Warbound Fungarian",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Warbound Fungarian says: I not lose, just... resting.",
["id"] = "s47_2991",
["timestamp"] = 1776880371,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Warbound Fungarian",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Warbound Fungarian says: Stop! You bash sense in us. Big ouch, bigger lesson!",
["id"] = "s47_2992",
["timestamp"] = 1776880373,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Warbound Rutaani",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Warbound Rutaani says: This one's petals... tremble. Roots unsure.",
["id"] = "s47_2993",
["timestamp"] = 1776880374,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Warbound Rutaani",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Warbound Rutaani says: Thorns bent. No more cutting. Enough said.",
["id"] = "s47_2994",
["timestamp"] = 1776880379,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Warbound Rutaani",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Warbound Rutaani says: This one bleeds... but from pride. It is shorn.",
["id"] = "s47_2995",
["timestamp"] = 1776880381,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Warbound Fungarian",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Warbound Fungarian says: Stop! You bash sense in us. Big ouch, bigger lesson!",
["id"] = "s47_2996",
["timestamp"] = 1776880386,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Warbound Fungarian",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Warbound Fungarian says: Okay, okay! Peace talk! No more bonks!",
["id"] = "s47_2997",
["timestamp"] = 1776880389,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zur'ashar Kassameh",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zur'ashar Kassameh says: With the fighting ended, they lay down their spear and asked the haranir to stop the killing. This is Russula's lesson: strength can bring victory, but tempered with mercy, it brings a greater victory.",
["id"] = "s47_2998",
["timestamp"] = 1776880390,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["race"] = "Human",
["class"] = "MONK",
["name"] = "Stormclout",
["sex"] = 3,
},
["event"] = "CHAT_MSG_MONSTER_EMOTE",
["type"] = "MONSTER_EMOTE",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.501960813999176,
["r"] = 1,
},
["text"] = "You sense a nearby Skyriding Glyph.",
["id"] = "s47_2999",
["timestamp"] = 1776880399,
},
