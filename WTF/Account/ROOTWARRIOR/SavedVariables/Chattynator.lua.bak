},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Silvermoon Guard",
},
["event"] = "CHAT_MSG_MONSTER_EMOTE",
["type"] = "MONSTER_EMOTE",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.501960813999176,
["r"] = 1,
},
["text"] = "The nearby guard glares at you and the void energy that you surround yourself with.",
["id"] = "s51_4955",
["timestamp"] = 1785288001,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Projected Image of Decimus",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Projected Image of Decimus says: Your clever little Riftwalkers have found our... your target, Riftblade. Why do you insist on waiting?",
["id"] = "s51_4956",
["timestamp"] = 1785288042,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Riftblade Maella",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Riftblade Maella says: Use discretion when recruiting our... allies. Umbric cannot afford upset tensions here in Silvermoon.",
["id"] = "s51_4957",
["timestamp"] = 1785288049,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Riftblade Maella",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Riftblade Maella says: We are not charging in through another portal blind, Decimus. We need a few experts before we mobilize, starting with our champion here.",
["id"] = "s51_4958",
["timestamp"] = 1785288053,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["event"] = "CHAT_MSG_BG_SYSTEM_NEUTRAL",
["type"] = "BG_NEUTRAL",
},
["color"] = {
["r"] = 1,
["g"] = 0.4705882668495178,
["b"] = 0.03921568766236305,
},
["text"] = "Thirty seconds until the Arena battle begins!",
["timestamp"] = 1785288424,
["id"] = "s51_4959",
},
