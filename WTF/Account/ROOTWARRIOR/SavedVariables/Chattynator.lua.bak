{
["startTimestamp"] = 1765463208,
["data"] = "[{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: Now entering the arena: a returning champion. Our Rank 7 monk, Stormclout!\",\"timestamp\":1765463208,\"id\":\"s16_4999\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: Now entering the Arena, the only Brawler that dresses like a pirate: The Renegade Swabbie!\",\"timestamp\":1765463211,\"id\":\"s16_5000\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Renegade Swabbie\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Renegade Swabbie yells: The Storm has you!\",\"timestamp\":1765463212,\"id\":\"s17_2502\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Renegade Swabbie\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Renegade Swabbie yells: I can see my house from here!\",\"timestamp\":1765463226,\"id\":\"s17_2503\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Renegade Swabbie\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Renegade Swabbie yells: You're supposed to defend the tower!\",\"timestamp\":1765463238,\"id\":\"s17_2504\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Renegade Swabbie\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Renegade Swabbie yells: Second place...again...\",\"timestamp\":1765463245,\"id\":\"s17_2505\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: Brilliant victory, Stormclout! Now get back in line.\",\"timestamp\":1765463245,\"id\":\"s17_2506\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Human\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ1:|Hitem:92718::::::::80:269:::::::::|h[Brawler's Purse]|h|r\",\"timestamp\":1765463246,\"id\":\"s17_2507\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo's Brawlpub Bouncer\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Bizmo's Brawlpub Bouncer says: If you want to join the brawl, just let me know.\",\"timestamp\":1765463248,\"id\":\"s17_2508\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Human\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:92914::::::::80:269:::::::::|h[Sealed Stormstout Brew]|h|r\",\"timestamp\":1765463250,\"id\":\"s17_2509\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:1299:0|h[Brawler's Gold]|h|rx105\",\"timestamp\":1765463250,\"id\":\"s17_2510\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: Here's our challenger. Today, we welcome a Rank 4 human paladin, Gingiboi!\",\"timestamp\":1765463263,\"id\":\"s17_2511\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: What could that odious stench be, slime? Watch out everyone, it's Glorping time!\",\"timestamp\":1765463266,\"id\":\"s17_2512\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: Gingiboi wins! Gingiboi wins!\",\"timestamp\":1765463280,\"id\":\"s17_2513\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Brawl Enthusiast\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Brawl Enthusiast yells: That's my Gingiboi!\",\"timestamp\":1765463280,\"id\":\"s17_2514\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:1299:0|h[Brawler's Gold]|h|rx1\",\"timestamp\":1765463281,\"id\":\"s17_2515\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Brawl Enthusiast\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Brawl Enthusiast yells: Gingiboi! Gingiboi! Gingiboi!\",\"timestamp\":1765463281,\"id\":\"s17_2516\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Brawl Enthusiast\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Brawl Enthusiast yells: That's my Gingiboi!\",\"timestamp\":1765463281,\"id\":\"s17_2517\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Brawl Enthusiast\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Brawl Enthusiast yells: That's my Gingiboi!\",\"timestamp\":1765463282,\"id\":\"s17_2518\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Brawl Enthusiast\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Brawl Enthusiast yells: Congratulations!\",\"timestamp\":1765463282,\"id\":\"s17_2519\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Brawl Enthusiast\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Brawl Enthusiast yells: Bah! I had my whole paycheck riding on that one!\",\"timestamp\":1765463286,\"id\":\"s17_2520\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: Now entering the arena: a Rank 1 void elf warrior, Solastro! Solastro is pretty new around here, so go easy!\",\"timestamp\":1765463297,\"id\":\"s17_2521\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: Also entering the arena: Goredome! He WILL attempt to gore you. With his dome.\",\"timestamp\":1765463300,\"id\":\"s17_2522\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: Keep 'em comin', Solastro.\",\"timestamp\":1765463341,\"id\":\"s17_2523\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:1299:0|h[Brawler's Gold]|h|rx1\",\"timestamp\":1765463342,\"id\":\"s17_2524\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: Now entering the arena: an up-and-coming Rank 2 priest, Windturns!\",\"timestamp\":1765463357,\"id\":\"s17_2525\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: And their challenger, Bill, the custodial engineer of death! Wait... what? Bill! What are you doing in there?\",\"timestamp\":1765463360,\"id\":\"s17_2526\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: Do you smell smoke?\",\"timestamp\":1765463470,\"id\":\"s17_2527\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: Honestly, Windturns... were you even trying?\",\"timestamp\":1765463490,\"id\":\"s17_2528\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:1299:0|h[Brawler's Gold]|h|rx1\",\"timestamp\":1765463491,\"id\":\"s17_2529\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: Now entering the arena: a returning champion. Our Rank 7 monk, Stormclout!\",\"timestamp\":1765463507,\"id\":\"s17_2530\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: And in the other corner, it's that terrible trio... Hudson, Stuffshrew, and Dole Dastardly from the Ogrewatch Team!\",\"timestamp\":1765463510,\"id\":\"s17_2531\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: Ouch... sorry, Stormclout. Get back in line and try again.\",\"timestamp\":1765463544,\"id\":\"s17_2532\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: Now entering the arena, we have a very talented paladin. Say hello to Gingiboi, a Rank 5 brawler!\",\"timestamp\":1765463561,\"id\":\"s17_2533\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: In the other corner, a golem with a magnetic personality. Watch out, this golem's gonna Klunk you up!\",\"timestamp\":1765463564,\"id\":\"s17_2534\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: Brilliant victory, Gingiboi! Now get back in line.\",\"timestamp\":1765463610,\"id\":\"s17_2535\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:1299:0|h[Brawler's Gold]|h|rx1\",\"timestamp\":1765463611,\"id\":\"s17_2536\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: Now entering the arena: a Rank 1 void elf warrior, Solastro! Solastro is pretty new around here, so go easy!\",\"timestamp\":1765463626,\"id\":\"s17_2537\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: He'll peck your eyes out if you give him a chance. It's Dippy!\",\"timestamp\":1765463629,\"id\":\"s17_2538\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: Solastro is our victor!\",\"timestamp\":1765463674,\"id\":\"s17_2539\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:1299:0|h[Brawler's Gold]|h|rx1\",\"timestamp\":1765463675,\"id\":\"s17_2540\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Brawl Enthusiast\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Brawl Enthusiast yells: Alright Solastro!\",\"timestamp\":1765463675,\"id\":\"s17_2541\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Brawl Enthusiast\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Brawl Enthusiast yells: Congratulations!\",\"timestamp\":1765463676,\"id\":\"s17_2542\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Brawl Enthusiast\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Brawl Enthusiast yells: Alright Solastro!\",\"timestamp\":1765463677,\"id\":\"s17_2543\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: Now entering the arena, we have a very talented paladin. Say hello to Gingiboi, a Rank 5 brawler!\",\"timestamp\":1765463691,\"id\":\"s17_2544\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bizmo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bizmo yells: All the way from the gloomy roads o