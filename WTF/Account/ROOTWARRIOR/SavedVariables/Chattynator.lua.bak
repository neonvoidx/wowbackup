["g"] = 0.6666666865348816,
["b"] = -0,
},
["text"] = "Dhranos-MoonGuard receives loot: |cnIQ1:|T3528456:12|t|Hitem:173202::::::::81:66:::::::::|h[Shrouded Cloth]|h|r.",
["timestamp"] = 1784591634,
["id"] = "s51_2731",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Grand Proctor Beryllia",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Grand Proctor Beryllia says: Ah, so you do feel pain. How intriguing.",
["timestamp"] = 1784591640,
["id"] = "s51_2732",
},
