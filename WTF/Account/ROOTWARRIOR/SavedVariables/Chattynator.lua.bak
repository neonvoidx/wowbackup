AGE\",\"name\":\"Nnethir-Stormrage\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Nnethir-Stormrage|h[|cff3fc7ebNnethir-Stormrage|r]|h has earned the achievement |cffffff00|Hachievement:4848:Player-60-0FA2652E:1:4:6:26:4294967295:4294967295:4294967295:4294967295|h[Lost City of the Tol'vir]|h|r!\",\"id\":\"s42_3460\",\"timestamp\":1775524014},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Kul'amara the Fierce says: Starphage. Oraka'zul! I am blessed ya be here to prowl with me.\",\"id\":\"s42_3461\",\"timestamp\":1775524102},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"DEATHKNIGHT\",\"name\":\"Luscipher-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Luscipher-Tichondrius|h[|cffc41e3aLuscipher|r]|h has earned the achievement |cffffff00|Hachievement:41216:Player-11-0E29E537:1:4:6:26:4294967295:4294967295:4294967295:4294967295|h[Adventurer of Undermine]|h|r!\",\"id\":\"s42_3462\",\"timestamp\":1775524103},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Kul'amara the Fierce says: I have used de shadows to see inside de cavern. I have seen my people--dead, alive, or... both.\",\"id\":\"s42_3463\",\"timestamp\":1775524107},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Kul'amara the Fierce says: I fear they be sacrificed for some dark purpose. Come. I will guide you. We gonna rescue my people.\",\"id\":\"s42_3464\",\"timestamp\":1775524116},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Katy Stampwhistle\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Katy Stampwhistle says: When there's mail to declare, you bet I'll be there!\",\"id\":\"s42_3465\",\"timestamp\":1775524170},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"WARRIOR\",\"race\":\"Gnome\",\"name\":\"Typow-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Typow-Tichondrius|h[|cffc69b6dTypow|r]|h has earned the achievement |cffffff00|Hachievement:9036:Player-11-0EB34F5A:1:4:6:26:4294967295:4294967295:4294967295:4294967295|h[Monomania]|h|r!\",\"timestamp\":1775524287,\"id\":\"s42_3466\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"WARRIOR\",\"race\":\"Gnome\",\"name\":\"Typow-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Typow-Tichondrius|h[|cffc69b6dTypow|r]|h has earned the achievement |cffffff00|Hachievement:8843:Player-11-0EB34F5A:1:4:6:26:4294967295:4294967295:4294967295:4294967295|h[Skyreach]|h|r!\",\"timestamp\":1775524287,\"id\":\"s42_3467\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"Human\",\"name\":\"Moistylich-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Moistylich-Tichondri