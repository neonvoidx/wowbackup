["g"] = 0.6666666865348816,
["r"] = -0,
},
["text"] = "You receive currency: |cnIQ3:|T463446:12|t|Hcurrency:1166:0|h[Timewarped Badge]|h|rx10",
["id"] = "s51_2595",
["timestamp"] = 1784560332,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["race"] = "Human",
["class"] = "PALADIN",
["name"] = "Praisesun",
["sex"] = 3,
},
["event"] = "CHAT_MSG_LOOT",
["type"] = "LOOT",
},
["color"] = {
["b"] = -0,
["g"] = 0.6666666865348816,
["r"] = -0,
},
["text"] = "You receive loot: |cnIQ3:|T3395742:12|t|Hitem:179326::::::::80:66::22:4:6652:8811:13609:7756:2:9:80:28:5383:::::|h[Girdle of the Soulflayer (Waist 126)]|h|r",
["id"] = "s51_2596",
["timestamp"] = 1784560333,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["event"] = "CHAT_MSG_MONEY",
["type"] = "MONEY",
},
["color"] = {
["b"] = -0,
["g"] = 1,
["r"] = 1,
},
["text"] = "You loot 14 Gold, 37 Silver, 98 Copper",
["id"] = "s51_2597",
["timestamp"] = 1784560334,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Bwonsamdi",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Bwonsamdi says: Ol' Hakkar, him a nasty one. But ya be makin' him pay him debt. Sooner or later, him gonna be back. Ya can't keep a bad loa down!",
["id"] = "s51_2598",
["timestamp"] = 1784560336,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Mueh'zala",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Mueh'zala yells: Me want dem souls, Bwonsamdi! Me want Rastakhan and all da other Zandalari! It ain't wise ta be holdin' out on Mueh'zala!",
["id"] = "s51_2599",
["timestamp"] = 1784560359,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Bwonsamdi",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Bwonsamdi yells: Ya gone and forgot what it mean ta be a loa! Ya bond wit da people... da power ya share... NNNNGGGG!",
["id"] = "s51_2600",
["timestamp"] = 1784560373,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Mueh'zala",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Mueh'zala yells: Da only power dat counts be Death! And Death be comin' for dem all!",
["id"] = "s51_2601",
["timestamp"] = 1784560384,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Bwonsamdi",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Bwonsamdi says: Ya know, it don't just be trolls who be comin' ta ask for ol' Bwonsamdi's help. All kinds be makin' deals wit da loa of death!",
["id"] = "s51_2602",
["timestamp"] = 1784560392,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Bwonsamdi",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Bwonsamdi says: Like dese two crazy little gnomes here. Dey both be hungry for power, so me were more than happy to oblige.",
["id"] = "s51_2603",
["timestamp"] = 1784560402,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Bwonsamdi",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Bwonsamdi says: But now, uh... me be needin' dat mojo back!",
["id"] = "s51_2604",
["timestamp"] = 1784560413,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
