:1772805907},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Grand Magister Rommath says: You have much to learn, but that was a surprisingly good showing.\",\"id\":\"s23_3815\",\"timestamp\":1772805907},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx35 (You've earned the maximum amount of |cnIQ3:|Hcurrency:3383:0|h[Adventurer Dawncrest]|h|r)\",\"id\":\"s23_3816\",\"timestamp\":1772805907},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magistrix Zaedana\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magistrix Zaedana says: There! There he is--he's headed for the teleporter to the Bazaar!\",\"id\":\"s23_3817\",\"timestamp\":1772805961},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Drathen\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Drathen says: They won't last long out of the water--hurry!\",\"id\":\"s23_3818\",\"timestamp\":1772805976},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"PALADIN\",\"name\":\"Xzaelpal-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Xzaelpal-Tichondrius|h[|cfff48cbaXzaelpal|r]|h has earned the achievement |cffffff00|Hachievement:61219:Player-11-0EB22723:1:3:6:26:4294967295:4294967295:4294967295:4294967295|h[No Time to Paws]|h|r!\",\"id\":\"s23_3819\",\"timestamp\":1772805990},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Drathen\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Drathen says: Wait, there he goes! Get that little monster!\",\"id\":\"s23_3820\",\"timestamp\":1772806000},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ3:|Hitem:267456::::::::90:1480::11::1:28:3321:::::|h[Lil' Scoots' Pillow]|h|r\",\"id\":\"s23_3821\",\"timestamp\":1772806035},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ranger Telenus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ranger Telenus says: At least he got his exercise, I suppose.\",\"id\":\"s23_3822\",\"timestamp\":1772806035},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hawkrancher Saman\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hawkrancher Saman says: Seems like Tiff just needed a little exercise. Ain't that right, girl?\",\"id\":\"s23_3823\",\"timestamp\":1772806080},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_RAID_BOSS_EMOTE\",\"type\":\"MONSTER_BOSS_EMOTE\"},\"color\":{\"b\":0,\"g\":0.8666667342185974,\"r\":1},\"text\":\"|TInterface\\\\ICONS\\\\Tracking_WildPet.blp:20|t  Track Pets via minimap to find wild pets.\",\"id\":\"s23_3824\",\"timestamp\":1772806080},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hawkrancher Saman\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hawkrancher Saman says: Keep your eyes peeled out there, pardner. Finding a pet takes some lookin'.\",\"id\":\"s23_3825\",\"timestamp\":1772806080},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Tiff\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Tiff chirps happily.\",\"id\":\"s23_3826\",\"timestamp\":1772806085},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Gidwin Goldbraids\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Gidwin Goldbraids says: Och, that's better.\",\"id\":\"s23_3827\",\"timestamp\":1772806110},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Gidwin Goldbraids\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Gidwin Goldbraids says: What? I learned my lesson! Always come prepared for web goo.\",\"id\":\"s23_3828\",\"timestamp\":1772806112},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Gidwin Goldbraids\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Gidwin Goldbraids says: I have one more item to look for. You get that spider!\",\"id\":\"s23_3829\",\"timestamp\":1772806122},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:237167::::::::90:1480:::::::::|h[Antique Necklace]|h|r\",\"id\":\"s23_3830\",\"timestamp\":1772806134},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:242639::::::::90:1480:::::::::|h[Practically Pork]|h|r\",\"id\":\"s23_3831\",\"timestamp\":1772806134},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260637::::::::90:1480:::::::::|h[Rotting Insect Eggs]|h|r\",\"id\":\"s23_3832\",\"timestamp\":1772806134},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:237164::::::::90:1480:::::::::|h[Art and Architecture of Silvermoon: Vol. 3]|h|r\",\"id\":\"s23_3833\",\"timestamp\":1772806142},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:237166::::::::90:1480:::::::::|h[Nondescript Bottle of Water]|h|r\",\"id\":\"s23_3834\",\"timestamp\":1772806155},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:237165::::::::90:1480:::::::::|h[Satchel of Herbs]|h|r\",\"id\":\"s23_3835\",\"timestamp\":1772806160},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Gidwin Goldbraids\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Gidwin Goldbraids says: Come on, Starphage. Don't want to keep Tarenar waiting!\",\"id\":\"s23_3836\",\"timestamp\":1772806167},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:263437::::::::90:1480::60:2:13573:13668:2:9:90:28:3321:::::|h[Gidwin's Tarnished Ring]|h|r\",\"id\":\"s23_3837\",\"timestamp\":1772806191},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Tarenar Sunstrike\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Tarenar Sunstrike says: Here. This should more than cover our old tab... and the years of interest.\",\"id\":\"s23_3838\",\"timestamp\":1772806193},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kiria Brightpalm\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Kiria Brightpalm says: Finally. Thank you. That takes care of your outstanding debt.\",\"id\":\"s23_3839\",\"timestamp\":1772806199},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kiria Brightpalm\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Kiria Brightpalm says: I am required to inform you that you are no longer welcome at The Plucked Phoenix. Good day.\",\"id\":\"s23_3840\",\"timestamp\":1772806204},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Valeera Sanguinar says: Well isn't this discreet. So what's the mission, Regent Lord?\",\"id\":\"s23_3841\",\"timestamp\":1772806222},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: The Twilight's Blade had sensitive information. Not just about Tranquillien, but all of Quel'Thalas.\",\"id\":\"s23_3842\",\"timestamp\":1772806229},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: Silvermoon is restless enough with the storm overhead. I won't give my people another reason to panic.\",\"id\":\"s23_3843\",\"timestamp\":1772806235},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"MagharOrc\",\"class\":\"WARRIOR\",\"name\":\"Berserkcat-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Berserkcat-Tichondrius|h[|cffc69b6dBerserkcat|r]|h獲得了|cffffff00|Hachievement:5228:Player-11-0EB0F0FE:1:3:6:26:4294967295:4294967295:4294967295:4294967295|h[Wild Hammering]|h|r的成就！\",\"id\":\"s23_3844\",\"timestamp\":1772806239},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"PALADIN\",\"name\":\"Xzaelpal-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Xzaelpal-Tichondrius|h[|cfff48cbaXzaelpal|r]|h has earned the achievement |cffffff00|Hachievement:61943:Player-11-0EB22723:1:3:6:26:4294967295:4294967295:4294967295:4294967295|h[Abundance: Prosperous Plentitude!]|h|r!\",\"id\":\"s23_3845\",\"timestamp\":1772806253},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"You sense a nearby Skyriding Glyph.\",\"id\":\"s23_3846\",\"timestamp\":1772806278},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"MagharOrc\",\"class\":\"WARRIOR\",\"name\":\"Berserkcat-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Berserkcat-Tichondrius|h[|cffc69b6dBerserkcat|r]|h獲得了|cffffff00|Hachievement:5215:Player-11-0EB0F0FE:1:3:6:26:4294967295:4294967295:4294967295:4294967295|h[Twin Peaks Perfection]|h|r的成就！\",\"id\":\"s23_3847\",\"timestamp\":1772806291},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"MagharOrc\",\"class\":\"WARRIOR\",\"name\":\"Berserkcat-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Berserkcat-Tichondrius|h[|cffc69b6dBerserkcat|r]|h獲得了|cffffff00|Hachievement:5216:Player-11-0EB0F0FE:1:3:6:26:4294967295:4294967295:4294967295:4294967295|h[Peak Speed]|h|r的成就！\",\"id\":\"s23_3848\",\"timestamp\":1772806291},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Valeera Sanguinar says: This must be the heart of their spy network.\",\"id\":\"s23_3849\",\"timestamp\":1772806292},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Valeera Sanguinar says: I'll stay in the shadows and keep eyes from above. Don't worry--if things turn, you won't be alone.\",\"id\":\"s23_3850\",\"timestamp\":1772806303},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 1 Gold, 26 Silver, 9 Copper\",\"id\":\"s23_3851\",\"timestamp\":1772806488},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260661::::::::90:1480:::::::::|h[Glowing Shrub]|h|rx2\",\"id\":\"s23_3852\",\"timestamp\":1772806508},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260642::::::::90:1480:::::::::|h[Fossilized Wildlife]|h|r\",\"id\":\"s23_3853\",\"timestamp\":1772806508},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"ROGUE\",\"name\":\"Nøçht-Area52\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Nøçht-Area52|h[|cfffff468Nøçht-Area52|r]|h has earned the achievement |cffffff00|Hachievement:61224:Player-3676-0E863B66:1:3:6:26:4294967295:4294967295:4294967295:4294967295|h[Tour of Duty: Voidstorm]|h|r!\",\"id\":\"s23_3854\",\"timestamp\":1772806709},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"PALADIN\",\"name\":\"Junkhog-Mannoroth\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Junkhog-Mannoroth|h[|cfff48cbaJunkhog-Mannoroth|r]|h has earned the achievement |cffffff00|Hachievement:13503:Player-77-0FA81358:1:3:6:26:4294967295:4294967295:4294967295:4294967295|h[Heritage of the Zandalari]|h|r!\",\"id\":\"s23_3855\",\"timestamp\":1772806714},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:244844::::::::90:1480:::::::::|h[Twilight's Blade Missive]|h|rx2\",\"id\":\"s23_3856\",\"timestamp\":1772806719},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260642::::::::90:1480:::::::::|h[Fossilized Wildlife]|h|r\",\"id\":\"s23_3857\",\"timestamp\":1772806719},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 1 Gold, 83 Silver, 8 Copper\",\"id\":\"s23_3858\",\"timestamp\":1772806720},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:244844::::::::90:1480:::::::::|h[Twilight's Blade Missive]|h|rx2\",\"id\":\"s23_3859\",\"timestamp\":1772806737},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 1 Gold, 31 Silver, 81 Copper\",\"id\":\"s23_3860\",\"timestamp\":1772806738},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Charge Bar\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"A nearby runestone begins to dim.\",\"id\":\"s23_3861\",\"timestamp\":1772806749},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:244844::::::::90:1480:::::::::|h[Twilight's Blade Missive]|h|rx2\",\"id\":\"s23_3862\",\"timestamp\":1772806754},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 3 Gold, 10 Silver, 41 Copper\",\"id\":\"s23_3863\",\"timestamp\":1772806755},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Salandria\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Salandria says: Find a cultist to capture. We'll meet you behind the Sanctum of the Moon.\",\"id\":\"s23_3864\",\"timestamp\":1772806818},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Captured Shadecaster\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Captured Shadecaster says: You'll get nothing from me!\",\"id\":\"s23_3865\",\"timestamp\":1772806846},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Salandria\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Salandria says: We'll see about that!\",\"id\":\"s23_3866\",\"timestamp\":1772806848},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Salandria\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Salandria says: Tell us where they are, cultist scum! Or else!\",\"id\":\"s23_3867\",\"timestamp\":1772806851},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Salandria\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Salandria says: We know you took my--you took my friends. Where are they?\",\"id\":\"s23_3868\",\"timestamp\":1772806863},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Taelia Fordragon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Taelia Fordragon says: This will go better if you let us know where they are.\",\"id\":\"s23_3869\",\"timestamp\":1772806867},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Salandria\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Salandria says: We might even let you live!\",\"id\":\"s23_3870\",\"timestamp\":1772806871},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Taelia Fordragon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Taelia Fordragon says: At the very least, you'll regret not telling us.\",\"id\":\"s23_3871\",\"timestamp\":1772806875},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Salandria\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Salandria says: Give it to them, Starphage.\",\"id\":\"s23_3872\",\"timestamp\":1772806879},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Taelia Fordragon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Taelia Fordragon says: Not... permanently. We need to know where the paladins are.\",\"id\":\"s23_3873\",\"timestamp\":1772806882},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Captured Shadecaster\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Captured Shadecaster says: Enough! Enough, I'll tell you! They're in the Ruins of Deatholme!\",\"id\":\"s23_3874\",\"timestamp\":1772806885},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Salandria\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Salandria says: Dawnheart may not have much time! Let's go!\",\"id\":\"s23_3875\",\"timestamp\":1772806891},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Taelia Fordragon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Taelia Fordragon says: Salandria, wait!\",\"id\":\"s23_3876\",\"timestamp\":1772806894},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Halduron Brightwing\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Halduron Brightwing says: Lightbloom Ath'ran is overgrown! H