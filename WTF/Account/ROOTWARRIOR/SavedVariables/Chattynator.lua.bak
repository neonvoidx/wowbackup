timestamp\":1773164185},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Harronir\",\"class\":\"DRUID\",\"name\":\"Wroot-Zuluhed\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Wroot-Zuluhed:789:GUILD:|h[|cffff7c0aWroot|r]|h: whats it called?\",\"id\":\"s26_3472\",\"timestamp\":1773164197},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Qtlolxdfurry-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Qtlolxdfurry-Tichondrius:790:GUILD:|h[|cffff7c0aQtlolxdfurry|r]|h: early morning training\",\"id\":\"s26_3473\",\"timestamp\":1773164204},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Harronir\",\"class\":\"DRUID\",\"name\":\"Wroot-Zuluhed\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Wroot-Zuluhed:791:GUILD:|h[|cffff7c0aWroot|r]|h: weird i cant find it\",\"id\":\"s26_3474\",\"timestamp\":1773164217},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"You sense a nearby Skyriding Glyph.\",\"id\":\"s26_3475\",\"timestamp\":1773164250},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: Your redeployment leaves a scant few behind to empower the Sunwell!\",\"id\":\"s26_3476\",\"timestamp\":1773164276},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: Would you check in with the Vanguard commanders for me, Stormclout? I must explain to the general why the Sunwell must not fall.\",\"id\":\"s26_3477\",\"timestamp\":1773164278},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Commander Venel Lightblood\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Commander Venel Lightblood says: My soldiers are too accustomed to sparring with the Light. They need to learn the tricks of other martial traditions.\",\"id\":\"s26_3478\",\"timestamp\":1773164286},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"General Amias Bellamy\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"General Amias Bellamy says: You think too provincially. We need the full might of the Vanguard to defeat Xal'atath.\",\"id\":\"s26_3479\",\"timestamp\":1773164287},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Commander Venel Lightblood\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Commander Venel Lightblood says: My soldiers are too accustomed to sparring with the Light. They need to learn the tricks of other martial traditions.\",\"id\":\"s26_3480\",\"timestamp\":1773164382},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"PALADIN\",\"name\":\"Bup-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_SAY\",\"type\":\"SAY\"},\"color\":{\"b\":1,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Bup-Tichondrius:805:SAY:|h[|cfff48cbaBup|r]|h says: [Orcish] thok re'ka dogg ka gesh'nuka\",\"id\":\"s26_3481\",\"timestamp\":1773164412},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"War Chaplain Senn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"War Chaplain Senn says: You are a beacon in the darkness. We will succeed, no matter the cost.\",\"id\":\"s26_3482\",\"timestamp\":1773164414},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Commander Koruth Mountainfist\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Commander Koruth Mountainfist says: Get those modifications fitted or we'll suffocate! The air on the other side is thicker than me gran's lamb stew.\",\"id\":\"s26_3483\",\"timestamp\":1773164424},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Commander Koruth Mountainfist\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Commander Koruth Mountainfist says: My gran taught me to fight the good fight, even if it seems hopeless, and to put me faith in the Light.\",\"id\":\"s26_3484\",\"timestamp\":1773164426},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Commander Koruth Mountainfist\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Commander Koruth Mountainfist says: Though, two tons of Light-blessed steel warframe bolsters my courage.\",\"id\":\"s26_3485\",\"timestamp\":1773164435},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"General Amias Bellamy\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"General Amias Bellamy says: We have left you a token force to hold back the Voidstorm. Light willing, it will suffice.\",\"id\":\"s26_3486\",\"timestamp\":1773164450},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: We can't spare the troops! Those ethereal cannons have us pinned down.\",\"id\":\"s26_3487\",\"timestamp\":1773164466},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"PALADIN\",\"name\":\"Claireadora-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Claireadora-Tichondrius|h[|cfff48cbaClaireadora|r]|h has earned the achievement |cffffff00|Hachievement:61310:Player-11-0EB24FAF:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[Casual Collector]|h|r!\",\"id\":\"s26_3488\",\"timestamp\":1773164476},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: We're being hit from all sides! We need a tactical assessment. Umbric! Stormclout can assist you.\",\"id\":\"s26_3489\",\"timestamp\":1773164490},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"ROGUE\",\"name\":\"Snekelz-Mal'Ganis\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Snekelz-Mal'Ganis|h[|cfffff468Snekelz-Mal'Ganis|r]|h has earned the achievement |cffffff00|Hachievement:61641:Player-3684-0EDB876F:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[The Blinding Vale]|h|r!\",\"id\":\"s26_3490\",\"timestamp\":1773164558},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"ROGUE\",\"name\":\"Snekelz-Mal'Ganis\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Snekelz-Mal'Ganis|h[|cfffff468Snekelz-Mal'Ganis|r]|h has earned the achievement |cffffff00|Hachievement:61649:Player-3684-0EDB876F:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[Mythic: The Blinding Vale]|h|r!\",\"id\":\"s26_3491\",\"timestamp\":1773164558},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"ROGUE\",\"name\":\"Snekelz-Mal'Ganis\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Snekelz-Mal'Ganis|h[|cfffff468Snekelz-Mal'Ganis|r]|h has earned the achievement |cffffff00|Hachievement:61648:Player-3684-0EDB876F:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[Heroic: The Blinding Vale]|h|r!\",\"id\":\"s26_3492\",\"timestamp\":1773164558},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"ROGUE\",\"name\":\"Snekelz-Mal'Ganis\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Snekelz-Mal'Ganis|h[|cfffff468Snekelz-Mal'Ganis|r]|h has earned the achievement |cffffff00|Hachievement:61568:Player-3684-0EDB876F:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[Glory of the Midnight Hero]|h|r!\",\"id\":\"s26_3493\",\"timestamp\":1773164558},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"ROGUE\",\"name\":\"Snekelz-Mal'Ganis\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Snekelz-Mal'Ganis|h[|cfffff468Snekelz-Mal'Ganis|r]|h has earned the achievement |cffffff00|Hachievement:61567:Player-3684-0EDB876F:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Dungeon Hero]|h|r!\",\"id\":\"s26_3494\",\"timestamp\":1773164558},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"ROGUE\",\"name\":\"Snekelz-Mal'Ganis\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Snekelz-Mal'Ganis|h[|cfffff468Snekelz-Mal'Ganis|r]|h has earned the achievement |cffffff00|Hachievement:62193:Player-3684-0EDB876F:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Dungeon Damage Dealer]|h|r!\",\"id\":\"s26_3495\",\"timestamp\":1773164558},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Umbric says: With this device, you'll be able to view the tactical situation in relative safety.\",\"id\":\"s26_3496\",\"timestamp\":1773164566},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"HighmountainTauren\",\"class\":\"DEATHKNIGHT\",\"name\":\"Durfd-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Durfd-Tichondrius|h[|cffc41e3aDurfd|r]|h has earned the achievement |cffffff00|Hachievement:168:Player-11-0EB322AE:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[Warsong Gulch Perfection]|h|r!\",\"id\":\"s26_3497\",\"timestamp\":1773164640},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"HighmountainTauren\",\"class\":\"DEATHKNIGHT\",\"name\":\"Durfd-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Durfd-Tichondrius|h[|cffc41e3aDurfd|r]|h has earned the achievement |cffffff00|Hachievement:166:Player-11-0EB322AE:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[Warsong Gulch Victory]|h|r!\",\"id\":\"s26_3498\",\"timestamp\":1773164640},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Umbric says: The captured ren'dorei are links in a chain. Break that chain, and our assault can truly begin.\",\"id\":\"s26_3499\",\"timestamp\":1773164670},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Troll\",\"class\":\"DRUID\",\"name\":\"Laserbearcat-Trollbane\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Laserbearcat-Trollbane|h[|cffff7c0aLaserbearcat-Trollbane|r]|h has earned the achievement |cffffff00|Hachievement:62289:Player-1175-0F941B09:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[Zul'Aman: The Highest Peaks]|h|r!\",\"id\":\"s26_3500\",\"timestamp\":1773164672},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"LightforgedDraenei\",\"class\":\"PALADIN\",\"name\":\"Sneakybution-Ysondre\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Sneakybution-Ysondre|h[|cfff48cbaSneakybution-Ysondre|r]|h has earned the achievement |cffffff00|Hachievement:62157:Player-78-0FAC896B:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[Prey: Sadistic Shamans (Hard)]|h|r!\",\"id\":\"s26_3501\",\"timestamp\":1773164679},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: You're right, Umbric. Freeing your people gives us the opening we need for an assault.\",\"id\":\"s26_3502\",\"timestamp\":1773164679},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Baa'lial\"},\"event\":\"CHAT_MSG_MONSTER_WHISPER\",\"type\":\"MONSTER_WHISPER\"},\"color\":{\"b\":0.9215686917304993,\"g\":0.7098039388656616,\"r\":1},\"text\":\"Baa'lial whispers: Blood will flow. Cities will burn. All will be ash and flame.\",\"id\":\"s26_3503\",\"timestamp\":1773164785},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Leona Darkstrider\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Leona Darkstrider says: The Void enslaves you, while I am empowered by it!\",\"id\":\"s26_3504\",\"timestamp\":1773164898},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lady Darkglen\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Darkglen says: The Voidspire will fall, ethereals!\",\"id\":\"s26_3505\",\"timestamp\":1773164913},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 3 Gold, 10 Silver, 39 Copper\",\"id\":\"s26_3506\",\"timestamp\":1773164915},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Troll\",\"class\":\"ROGUE\",\"name\":\"Stiizoned-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Stiizoned-Tichondrius|h[|cfffff468Stiizoned|r]|h has earned the achievement |cffffff00|Hachievement:41805:Player-11-0E6A0514:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[Arator's Journey]|h|r!\",\"id\":\"s26_3507\",\"timestamp\":1773164926},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260673::::::::90:269:::::::::|h[Partially Digested Bracers]|h|r\",\"id\":\"s26_3508\",\"timestamp\":1773164928},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260615::::::::90:269:::::::::|h[Void Dust Residue]|h|r\",\"id\":\"s26_3509\",\"timestamp\":1773164937},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Kelain\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Riftblade Kelain says: Here! Take this message back to Xal'atath!\",\"id\":\"s26_3510\",\"timestamp\":1773164962},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260650::::::::90:269:::::::::|h[Elemental Debris]|h|r\",\"id\":\"s26_3511\",\"timestamp\":1773164985},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 11 Gold, 33 Silver, 3 Copper\",\"id\":\"s26_3512\",\"timestamp\":1773164986},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 1 Gold, 14 Silver, 75 Copper\",\"id\":\"s26_3513\",\"timestamp\":1773165025},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260615::::::::90:269:::::::::|h[Void Dust Residue]|h|r\",\"id\":\"s26_3514\",\"timestamp\":1773165035},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: Well done, Stormclout! You've struck a decisive blow against the Devouring Host. With Umbric's help.\",\"id\":\"s26_3515\",\"timestamp\":1773165059},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:257179::::::::90:269::31:1:13634:1:28:3320:::::|h[Voidbreaker's Mantle]|h|r\",\"id\":\"s26_3516\",\"timestamp\":1773165063},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:257166::::::::90:269::31:1:13634:1:28:3320:::::|h[Voidbreaker's Shroud]|h|r\",\"id\":\"s26_3517\",\"timestamp\":1773165064},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: Stormclout, report to Commander Mountainfist. We'd be honored if you would join the Warframe assault.\",\"id\":\"s26_3518\",\"timestamp\":1773165073},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Commander Koruth Mountainfist\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Commander Koruth Mountainfist says: The Void cannons had us squattin' in a ditch since we got here. Seems only fair we return the favor. Care to give it a go?\",\"id\":\"s26_3519\",\"timestamp\":1773165075},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Scourge\",\"class\":\"PRIEST\",\"name\":\"Padrecarras-Ragnaros\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"¡|Hplayer:Padrecarras-Ragnaros|h[|cffffffffPadrecarras-Ragnaros|r]|h ha ganado el logro |cffffff00|Hachievement:61641:Player-1427-0D6603EE:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[The Blinding Vale]|h|r!\",\"id\":\"s26_3520\",\"timestamp\":1773165179},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Commander Koruth Mountainfist\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Commander Koruth Mountainfist says: I can see why the Light called you to this fight. You're an inspiration to all of us fighting the Void.\",\"id\":\"s26_3521\",\"timestamp\":1773165201},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:257188::::::::90:269::31:1:13634:1:28:3320:::::|h[Voidbreaker's Wristwraps]|h|r\",\"id\":\"s26_3522\",\"timestamp\":1773165211},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:262610::::::::90:269::11::1:28:3320:::::|h[Swirling Ritual Pedestal]|h|r\",\"id\":\"s26_3523\",\"timestamp\":1773165211},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: Check in with Arator if you haven't had a chance yet. He's over on the other side of camp, tending to the wounded.\",\"id\":\"s26_3524\",\"timestamp\":1773165212},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: Oh, Stormclout. You're here. Good. I need your help.\",\"id\":\"s26_3525\",\"timestamp\":1773165230},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"HighmountainTauren\",\"class\":\"DEATHKNIGHT\",\"name\":\"Durfd-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Durfd-Tichondrius|h[|cffc41e3aDurfd|r]|h has earned the achievement |cffffff00|Hachievement:8331:Player-11-0EB322AE:1:3:10:26:4294967295:4294967295:4294967295:4294967295|h[Deepwind Gorge Victory]|h|r!\",\"id\":\"s26_3526\",\"times