},
["text"] = "Pupperpriest-MoonGuard receives loot: |cnIQ1:|T1519431:12|t|Hitem:178128::::::::81:66::22::1:28:5383:::::|h[Pouch of Shinies]|h|r.",
["timestamp"] = 1784591576,
["id"] = "s51_2726",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "General Draven",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "General Draven says: The prisoner is down below. Z'rali, one of the naaru who invaded the Ember Ward. The others presumed it slain.",
["timestamp"] = 1784591578,
["id"] = "s51_2727",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "General Draven",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "General Draven says: Denathrius has been draining its Light to wield against his foes. We will wield it against him, instead.",
["timestamp"] = 1784591588,
["id"] = "s51_2728",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Grand Proctor Beryllia",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Grand Proctor Beryllia says: Your kind are so fascinating... with so many secrets to uncover...",
["timestamp"] = 1784591623,
["id"] = "s51_2729",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Z'rali",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Z'rali says: The Light... will... prevail...",
["timestamp"] = 1784591632,
["id"] = "s51_2730",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
