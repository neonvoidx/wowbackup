["g"] = 1,
["r"] = 1,
},
["text"] = "You loot 9 Gold, 52 Silver, 46 Copper",
["id"] = "s51_4382",
["timestamp"] = 1785261005,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
