lor\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ1:|Hitem:248593::::::::87:1480:::::::::|h[Nascent Blade]|h|r\",\"id\":\"s20_3249\",\"timestamp\":1772225342},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Decimus says: No, no, I must insist! You go have fun. I'll savor the aroma of your brutality from here.\",\"id\":\"s20_3250\",\"timestamp\":1772225342},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Scourge\",\"class\":\"WARLOCK\",\"name\":\"Claus-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Claus-Tichondrius|h[|cff8788eeClaus|r]|h has earned the achievement |cffffff00|Hachievement:61313:Player-11-0E5CD6EA:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Well-Travelled Collection]|h|r!\",\"id\":\"s20_3251\",\"timestamp\":1772225362},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ravenia\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ravenia says: Fidoficus is ready to prove himself. Meet him at the creature's den to the south and witness the ferocity we've cultivated.\",\"id\":\"s20_3252\",\"timestamp\":1772225371},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"ROGUE\",\"name\":\"Soulzcuh-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Soulzcuh-Tichondrius|h[|cfffff468Soulzcuh|r]|h has earned the achievement |cffffff00|Hachievement:41805:Player-11-0E6EF73F:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Arator's Journey]|h|r!\",\"id\":\"s20_3253\",\"timestamp\":1772225385},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Fidoficus\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Fido whimpers in terror.\",\"id\":\"s20_3254\",\"timestamp\":1772225412},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:242639::::::::87:1480:::::::::|h[Practically Pork]|h|rx2\",\"id\":\"s20_3255\",\"timestamp\":1772225439},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260672::::::::87:1480:::::::::|h[Fetid Eye]|h|r\",\"id\":\"s20_3256\",\"timestamp\":1772225439},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Fidoficus\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Fidoficus roars triumphantly over the corpse of Zitoc.\",\"id\":\"s20_3257\",\"timestamp\":1772225439},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ravenia\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ravenia says: So? How did the beast perform?\",\"id\":\"s20_3258\",\"timestamp\":1772225459},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Fidoficus\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Fidoficus looks at you with wide, pleading eyes.\",\"id\":\"s20_3259\",\"timestamp\":1772225461},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ravenia\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ravenia says: He WHAT?\",\"id\":\"s20_3260\",\"timestamp\":1772225470},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ravenia\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ravenia says: What a fool I was to waste my time investing in such a pathetic worm!\",\"id\":\"s20_3261\",\"timestamp\":1772225472},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ravenia\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ravenia says: I'd consume the beast myself if I thought it had any strength whatsoever for me to feast upon!\",\"id\":\"s20_3262\",\"timestamp\":1772225477},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Pandaren\",\"class\":\"DEATHKNIGHT\",\"name\":\"Frostyfries-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Frostyfries-Tichondrius:5247:GUILD:|h[|cffc41e3aFrostyfries|r]|h: sweet|cnIQ3:|Hitem:267482::::::::82:251::25:2:13578:13649:1:28:3087:::::|h[Aspiring Hara'ti Defender's Greatbelt]|h|r\",\"id\":\"s20_3263\",\"timestamp\":1772225480},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ravenia\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ravenia says: Now begone, the both of you! You're no longer worthy of my presence.\",\"id\":\"s20_3264\",\"timestamp\":1772225483},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:260922::::::::87:1480::11::1:28:373:::::|h[Fidoficus]|h|r\",\"id\":\"s20_3265\",\"timestamp\":1772225491},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ravenia\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ravenia says: Whether or not this nurturing approach is effective, it is clearly not for me.\",\"id\":\"s20_3266\",\"timestamp\":1772225492},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ravenia\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ravenia says: My beasts will continue to thrive under the threat of violence. It is the domanaar way.\",\"id\":\"s20_3267\",\"timestamp\":1772225497},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"MagharOrc\",\"class\":\"SHAMAN\",\"name\":\"Valkray-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Valkray-Tichondrius|h[|cff0070ddValkray|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-11-0E47C2F6:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s20_3268\",\"timestamp\":1772225511},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Astre\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Riftblade Astre says: Oh, Starphage. Do you have word from Hieron and the others?\",\"id\":\"s20_3269\",\"timestamp\":1772225519},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Astre\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Riftblade Astre says: I see. Hieron is gone.\",\"id\":\"s20_3270\",\"timestamp\":1772225520},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Astre\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Riftblade Astre says: Why couldn't the blood elves have just fought their own battle? Damn these whispers.\",\"id\":\"s20_3271\",\"timestamp\":1772225522},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"You sense a nearby Skyriding Glyph.\",\"id\":\"s20_3272\",\"timestamp\":1772225529},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Scout Nefina\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Scout Nefina says: I saw Faindel... one of the missing scouts! But he was wreathed in Void... shimmering like a mirage.\",\"id\":\"s20_3273\",\"timestamp\":1772225529},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Scout Nefina\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Scout Nefina says: There! Do you see it?\",\"id\":\"s20_3274\",\"timestamp\":1772225538},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ1:|Hitem:247713::::::::87:1480:::::::::|h[Reliquary of Darkness]|h|r\",\"id\":\"s20_3275\",\"timestamp\":1772225545},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lucia Nightbreaker\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lucia Nightbreaker says: Kalgorg began to disobey me when we entered this world. Help me sacrifice it. It's useless to us.\",\"id\":\"s20_3276\",\"timestamp\":1772225545},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Voidwhispèr-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Voidwhispèr-Area52|h[|cffa330c9Voidwhispèr-Area52|r]|h has earned the achievement |cffffff00|Hachievement:61387:Player-3676-0EC3359E:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Prey: Normal Mode I]|h|r!\",\"id\":\"s20_3277\",\"timestamp\":1772225548},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Brose-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Brose-Stormrage|h[|cffff7c0aBrose-Stormrage|r]|h has earned the achievement |cffffff00|Hachievement:61832:Player-60-0E85A860:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Delves: Tier 1]|h|r!\",\"id\":\"s20_3278\",\"timestamp\":1772225557},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"