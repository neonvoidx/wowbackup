e\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Touchmeelmo-Proudmoore|h[|cffc41e3aTouchmeelmo-Proudmoore|r]|h has earned the achievement |cffffff00|Hachievement:18645:Player-5-0A86A66B:1:2:3:26:4294967295:4294967295:4294967295:4294967295|h[Tools of the Trade]|h|r!\",\"timestamp\":1770128997,\"id\":\"s17_4965\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ1:|Hitem:208137::::::::80:1480:::::::::|h[The Clerk's Notes]|h|r\",\"timestamp\":1770128998,\"id\":\"s17_4966\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"HUNTER\",\"race\":\"BloodElf\",\"name\":\"Tanthelei\",\"sex\":3},\"event\":\"CHAT_MSG_TEXT_EMOTE\",\"type\":\"EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"|Hplayer:Tanthelei:104:TEXT_EMOTE:|h|cffaad372Tanthelei|r|h kneels before Odd Statue.\",\"timestamp\":1770128998,\"id\":\"s17_4967\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Generic Bunny\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"A chill hangs in the air. Perhaps the Torch of Pyrreth will protect you and help you find what is hidden.\",\"timestamp\":1770129096,\"id\":\"s17_4968\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Pillar Crystal\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"A tablet is unveiled at the base of the pillar.\",\"timestamp\":1770129115,\"id\":\"s17_4969\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You create: |cnIQ1:|Hitem:208143::::::::80:1480:::::::::|h[Unveiled Tablet Rubbing]|h|r.\",\"timestamp\":1770129117,\"id\":\"s17_4970\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Amerinth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Amerinth says: Well, I think my days of field research are over. Time to return to town and find a warm bath.\\r\\n\\r\\nThank you again for freeing me. Best of luck with your quest!\",\"timestamp\":1770129118,\"id\":\"s17_4971\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Brigita\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Brigita says: Welcome to the Roasted Ram! Seating is open.\",\"timestamp\":1770129468,\"id\":\"s17_4972\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ1:|Hitem:208144::::::::80:1480:::::::::|h[Preservationist's Dispatch Two]|h|r\",\"timestamp\":1770129481,\"id\":\"s17_4973\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Incense smoke rises and floats toward the entrance of the burial mound.\",\"timestamp\":1770129673,\"id\":\"s17_4974\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Huntmaster Yrgena\"},\"event\":\"CHAT_MSG_RAID_BOSS_EMOTE\",\"type\":\"MONSTER_BOSS_EMOTE\"},\"color\":{\"r\":1,\"g\":0.8666667342185974,\"b\":0},\"text\":\"Huntmaster Yrgena is being empowered by the Dreamsurge!\",\"timestamp\":1770129675,\"id\":\"s17_4975\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"The incense smoke grows thicker. You follow it leaving the entrance, heading northeast.\",\"timestamp\":1770129702,\"id\":\"s17_4976\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Overseer Zambul\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Overseer Zambul yells: Dig faster! Bring me more of the ancestors' weapons.\",\"timestamp\":1770129710,\"id\":\"s17_4977\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ukhel Gravestirrer\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Ukhel Gravestirrer says: Two-footed fool!\",\"timestamp\":1770129724,\"id\":\"s17_4978\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ukhel Gravestirrer\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Ukhel Gravestirrer says: My death is only... an interruption.\",\"timestamp\":1770129724,\"id\":\"s17_4979\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"The smoke grows thicker. It is clearly heading in the direction of Teerakai.\",\"timestamp\":1770129729,\"id\":\"s17_4980\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Steamgill\"},\"event\":\"CHAT_MSG_RAID_BOSS_EMOTE\",\"type\":\"MONSTER_BOSS_EMOTE\"},\"color\":{\"r\":1,\"g\":0.8666667342185974,\"b\":0},\"text\":\"Steamgill is being empowered by the Dreamsurge!\",\"timestamp\":1770129750,\"id\":\"s17_4981\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ3:|Hitem:208145::::::::80:1480:::::::::|h[Idol of Ohn'ahra]|h|r\",\"timestamp\":1770129795,\"id\":\"s17_4982\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Cataloger Coralie\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Cataloger Coralie says: There's so much to document in the Ohn'ahran Plains, hero. Another photographer is always welcome!\",\"timestamp\":1770129852,\"id\":\"s17_4983\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Journeyman Envial\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Journeyman Envial says: Add some shine to your hoard! Gems from across the seas, faceted on demand!\",\"timestamp\":1770129908,\"id\":\"s17_4984\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Brigita\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Brigita says: Welcome to the Roasted Ram! Seating is open.\",\"timestamp\":1770129912,\"id\":\"s17_4985\"},{\"recordedBy\