},
["text"] = "You receive loot: |cnIQ2:|T7425197:12|t|Hitem:253242::::::::90:269::6::1:28:2012:::::|h[Horde Warlord's Throne]|h|r",
["timestamp"] = 1785175219,
["id"] = "s51_3212",
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Crane Style Initiate",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Crane Style Initiate says: Greetings, Master Stormclout. How are you today?",
["timestamp"] = 1785175336,
["id"] = "s51_3213",
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Lorewalker Cho",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Lorewalker Cho says: This cannot be! The Black Empire itself has invaded the Vale! Act swiftly, before all is lost!",
["id"] = "s51_3214",
["timestamp"] = 1785175440,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "N'Zoth the Corruptor",
},
["event"] = "CHAT_MSG_MONSTER_WHISPER",
["type"] = "MONSTER_WHISPER",
},
["color"] = {
["b"] = 0.9215686917304993,
["g"] = 0.7098039388656616,
["r"] = 1,
},
["text"] = "N'Zoth the Corruptor whispers: Come, my chosen. Witness the fate of this world.",
["id"] = "s51_3215",
["timestamp"] = 1785175476,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "N'Zoth the Corruptor",
},
["event"] = "CHAT_MSG_MONSTER_WHISPER",
["type"] = "MONSTER_WHISPER",
},
["color"] = {
["b"] = 0.9215686917304993,
["g"] = 0.7098039388656616,
["r"] = 1,
},
["text"] = "N'Zoth the Corruptor whispers: Behold the one who shall herald its coming.",
["id"] = "s51_3216",
["timestamp"] = 1785175484,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Wrathion",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Wrathion says: My dear friends. A wondrous honor has been bestowed upon you. The chance to embrace your destiny, as I have.",
["id"] = "s51_3217",
["timestamp"] = 1785175491,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Wrathion",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Wrathion says: N'Zoth has shown me the inevitable truth. That to save Azeroth, we must accept his gift.",
["id"] = "s51_3218",
["timestamp"] = 1785175504,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Wrathion",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Wrathion says: Kneel and serve. It is the only way.",
["id"] = "s51_3219",
["timestamp"] = 1785175514,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
