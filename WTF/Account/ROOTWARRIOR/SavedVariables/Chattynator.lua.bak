},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Neltharion says: We have come to the end of your journey, champions.",
["id"] = "s51_4794",
["timestamp"] = 1785284093,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Sabellian",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Sabellian says: What do you mean? Where is Sarkareth?",
["id"] = "s51_4795",
["timestamp"] = 1785284098,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Wrathion",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Wrathion says: You were never leading us to Sarkareth.",
["id"] = "s51_4796",
["timestamp"] = 1785284100,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
