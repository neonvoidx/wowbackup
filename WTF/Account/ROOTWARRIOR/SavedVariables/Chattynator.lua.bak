},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Vidious says: The hatred burning in the hearts of these Alliance renegades is simply delectable. Do you also fight for vengeance?",
["id"] = "s27_4484",
["timestamp"] = 1773593881,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
