},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "N'Zoth the Corruptor",
},
["event"] = "CHAT_MSG_MONSTER_WHISPER",
["type"] = "MONSTER_WHISPER",
},
["color"] = {
["b"] = 0.9215686917304993,
["g"] = 0.7098039388656616,
["r"] = 1,
},
["text"] = "N'Zoth the Corruptor whispers: Every war waged... every trial overcome... led you here. To me.",
["id"] = "s51_3466",
["timestamp"] = 1785177405,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "N'Zoth the Corruptor",
},
["event"] = "CHAT_MSG_MONSTER_WHISPER",
["type"] = "MONSTER_WHISPER",
},
["color"] = {
["b"] = 0.9215686917304993,
["g"] = 0.7098039388656616,
["r"] = 1,
},
["text"] = "N'Zoth the Corruptor whispers: My vision shall be made real. Complete the circle. Open the way.",
["id"] = "s51_3467",
["timestamp"] = 1785177425,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Wrathion",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Wrathion says: For an Old God who claims to see everything, you are blind to the threat before you.",
["id"] = "s51_3468",
["timestamp"] = 1785177446,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "N'Zoth the Corruptor",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "N'Zoth the Corruptor yells: Within the Sleeping City, you will slumber forevermore.",
["id"] = "s51_3469",
["timestamp"] = 1785177581,
},
