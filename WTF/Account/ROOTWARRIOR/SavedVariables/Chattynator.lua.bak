uman\",\"name\":\"Fcrusader-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Fcrusader-Tichondrius|h[|cfff48cbaFcrusader|r]|h has earned the achievement |cffffff00|Hachievement:41805:Player-11-0E3247A2:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Arator's Journey]|h|r!\",\"timestamp\":1772204018,\"id\":\"s19_3760\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Eonka\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Eonka says: Kin's bloom changed. This one's did not.\",\"timestamp\":1772204046,\"id\":\"s19_3761\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:258623::::::::84:1480:::::::::|h[Glistening Seed Bag]|h|r\",\"timestamp\":1772204048,\"id\":\"s19_3762\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Eonka\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Eonka says: Take seed. Show others. May reveal answer.\",\"timestamp\":1772204050,\"id\":\"s19_3763\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Orweyna says: Alndust... The elders will not part with it easily. Still, we have to try.\",\"timestamp\":1772204064,\"id\":\"s19_3764\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Halduron Brightwing\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"typ