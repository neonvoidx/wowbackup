["name"] = "High Exarch Turalyon",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "High Exarch Turalyon yells: Alleria!",
["id"] = "s46_3058",
["timestamp"] = 1776307567,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Xal'atath",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Xal'atath yells: How touching. Your family has come to say goodbye.",
["id"] = "s46_3059",
["timestamp"] = 1776307569,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Xal'atath",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Xal'atath yells: Ah, and my favorite champions as well! I was afraid you might miss this.",
["id"] = "s46_3060",
["timestamp"] = 1776307575,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
