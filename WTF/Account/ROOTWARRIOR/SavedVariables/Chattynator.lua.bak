lass\":\"DEMONHUNTER\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"You sense a nearby Skyriding Glyph.\",\"id\":\"s23_3920\",\"timestamp\":1772807290},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kellor Sunshimmer\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Kellor Sunshimmer says: I could have died out there, old man.\",\"id\":\"s23_3921\",\"timestamp\":1772807293},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Woodcrafter Azai\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Woodcrafter Azai says: Don't be so dramatic. You lived, eh?\",\"id\":\"s23_3922\",\"timestamp\":1772807296},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Woodcrafter Azai\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Woodcrafter Azai says: Boy, assist Starphage. Chop de lumber.\",\"id\":\"s23_3923\",\"timestamp\":1772807297},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kellor Sunshimmer\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Kellor Sunshimmer says: What? I'm still tied up! How am I supposed to help?\",\"id\":\"s23_3924\",\"timestamp\":1772807300},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Woodcrafter Azai\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Woodcrafter Azai says: We have limited resources here. Keep de oil on de wood!\",\"id\":\"s23_3925\",\"timestamp\":1772807305},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:239138::::::::90:1480:::::::::|h[Lightwood Chunk]|h|r\",\"id\":\"s23_3926\",\"timestamp\":1772807308},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Woodcrafter Azai\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Woodcrafter Azai says: Sand it down now, child. No more complaints--stop distractin' Starphage.\",\"id\":\"s23_3927\",\"timestamp\":1772807309},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Woodcrafter Azai\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Woodcrafter Azai says: Attach de blade, Starphage. Hold it steady for dem, boy.\",\"id\":\"s23_3928\",\"timestamp\":1772807314},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kellor Sunshimmer\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Kellor Sunshimmer says: This would be easier if you would untie me.\",\"id\":\"s23_3929\",\"timestamp\":1772807318},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Woodcrafter Azai\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Woodcrafter Azai says: Maybe. But it wouldn't be as funny. Stop whinin'.\",\"id\":\"s23_3930\",\"timestamp\":1772807321},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Woodcrafter Azai\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Woodcrafter Azai says: Preserve de Light in de grain with de dragonhawk ash oil.\",\"id\":\"s23_3931\",\"timestamp\":1772807321},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kellor Sunshimmer\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Kellor Sunshimmer says: Huh. Using a loa's magic to preserve the Light... Clever.\",\"id\":\"s23_3932\",\"timestamp\":1772807325},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kellor Sunshimmer\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Kellor Sunshimmer says: I was a fool. You are just people--like us. It was the Twilight's Blade that attacked that night!\",\"id\":\"s23_3933\",\"timestamp\":1772807332},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:241612::::::::90:1480:::::::::|h[Lightwood Javelin]|h|r\",\"id\":\"s23_3934\",\"timestamp\":1772807334},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Woodcrafter Azai\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Woodcrafter Azai says: Go. Eliminate de scout commander before he kills de boy.\",\"id\":\"s23_3935\",\"timestamp\":1772807334},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Woodcrafter Azai\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Woodcrafter Azai says: Wait! Come back, you reckless boy!\",\"timestamp\":1772807345,\"id\":\"s23_3936\"},{\"record