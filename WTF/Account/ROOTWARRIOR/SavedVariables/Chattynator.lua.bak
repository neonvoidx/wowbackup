{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Mueh'zala",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Mueh'zala yells: Don't ya be forgettin' who made ya a loa, Bwonsamdi! Now gimme dem souls and kneel before ya mastah!",
["id"] = "s51_2630",
["timestamp"] = 1784560655,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Bwonsamdi",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Bwonsamdi yells: Dat was long ago, but me remember. Remember how da trolls be turnin' away from ya. All dem sacrifices... all dat blood... dey were gonna NNNGGGHHHH!",
["id"] = "s51_2631",
["timestamp"] = 1784560665,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Mueh'zala",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Mueh'zala yells: Me don't need worshippers! Da Jailer gonna give me all da power I need... and Bwonsamdi da one who gonna be forgotten!",
["id"] = "s51_2632",
["timestamp"] = 1784560678,
},
