mp\":1772808898,\"id\":\"s23_4101\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bark Breaker\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bark Breaker yells: Tusk!\",\"timestamp\":1772808900,\"id\":\"s23_4102\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bark Breaker\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bark Breaker yells: Tusk!\",\"timestamp\":1772808900,\"id\":\"s23_4103\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bark Breaker\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Bark Breaker yells: Tusk!\",\"timestamp\":1772808903,\"id\":\"s23_4104\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Tusk Taker\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Tusk Taker yells: More come to steal Tusk Taker's prize!\",\"timestamp\":1772808905,\"id\":\"s23_4105\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Tusk Taker\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Tusk Taker says: I am the strongest. I kill all challengers!\",\"timestamp\":1772808910,\"id\":\"s23_4106\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Tusk Taker\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Tusk Taker yells: You are weak. You will die!\",\"timestamp\":1772808916,\"id\":\"s23_4107\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Tusk Taker\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Tusk Taker says: You... strongest... now...\",\"timestamp\":1772808926,\"id\":\"s23_4108\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 2 Gold, 51 Silver, 78 Copper\",\"timestamp\":1772808928,\"id\":\"s23_4109\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kel'vujo\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kel'vujo says: We are de strongest! You done good, Starphage.\",\"timestamp\":1772808929,\"id\":\"s23_4110\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_SKILL\",\"type\":\"SKILL\"},\"color\":{\"r\":0.3333333432674408,\"g\":0.3333333432674408,\"b\":1},\"text\":\"Your skill in Midnight Mining has increased to 56.\",\"timestamp\":1772808936,\"id\":\"s23_4111\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ2:|Hitem:237362::::::::90:1480::::1:38:13:::::|h[Umbral Tin Ore |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|rx4\",\"timestamp\":1772808936,\"id\":\"s23_4112\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kel'vujo\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kel'vujo says: I'll take de trophies now. Meet me back down de hill.\",\"timestamp\":1772808937,\"id\":\"s23_4113\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kel'vujo\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kel'vujo says: Don't keep me waitin' long. De other Amani will want to see all de trophies we got!\",\"timestamp\":1772808953,\"id\":\"s23_4114\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:237359::::::::90:1480::::1:38:13:::::|h[Refulgent Copper Ore |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|rx3\",\"timestamp\":1772808974,\"id\":\"s23_4115\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kel'vujo\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kel'vujo says: H-hold on! We can split de trophies... I was just yankin' your tusks!\",\"timestamp\":1772808981,\"id\":\"s23_4116\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Huntmaster Jinki\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Huntmaster Jinki says: Dat is enough, Kel'vujo! You know de punishment of cheatin' on a trial.\",\"timestamp\":1772808987,\"id\":\"s23_4117\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Huntmaster Jinki\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Huntmaster Jinki says: Valdyr, meet us in Amani'zar. You deserve a reward for unmaskin' dis shame of an Amani!\",\"timestamp\":1772808991,\"id\":\"s23_4118\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kel'vujo\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kel'vujo says: Hnng! Dis is not fair! You punish me for outsmartin' de trial?\",\"timestamp\":1772809027,\"id\":\"s23_4119\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ3:|Hitem:269980::::::::90:1480::60:3:13573:13613:13615:2:9:90:28:3321:::::|h[Tuskcarver's Warglaive]|h|r\",\"timestamp\":1772809028,\"id\":\"s23_4120\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Huntmaster Jinki\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Huntmaster Jinki says: Kel'vujo, you are bein' punished for cheatin' and bein' too dumb to hide it good.\",\"timestamp\":1772809028,\"id\":\"s23_4121\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kagara\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kagara says: Zak'kash is de best of our young fighters. If he is interested in Namaji, there's no way my plan can work!\",\"timestamp\":1772809034,\"id\":\"s23_4122\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Huntmaster Jinki\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Huntmaster Jinki says: You should've softened Starphage before you attacked and not squealed like a pango when it didn't go your way.\",\"timestamp\":1772809037,\"id\":\"s23_4123\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zak'kash\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zak'kash says: I hope Kagara don't like her, or I won't stand a chance. He's the smartest kid in de village!\",\"timestamp\":1772809037,\"id\":\"s23_4124\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Huntmaster Jinki\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Huntmaster Jinki says: Maybe a few years with a spear in your gut will teach you a lesson.\",\"timestamp\":1772809045,\"id\":\"s23_4125\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zul'jarra says: Ya might see familiar faces in Atal'Aman... but I doubt they're as friendly as they once were.\",\"timestamp\":1772809050,\"id\":\"s23_4126\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx500\",\"timestamp\":1772809055,\"id\":\"s23_4127\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:263318::::::::90:1480::14::1:28:3086:::::|h[Simple Amani Basket]|h|r\",\"timestamp\":1772809061,\"id\":\"s23_4128\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Old Teo'zan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Old Teo'zan says: It was huge. De biggest murloc I've ever seen. Could it be... a loa? I'm not gonna go down there and find out!\",\"timestamp\":1772809085,\"id\":\"s23_4129\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"An'jali\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"An'jali says: But Papa, I want to go play with de others!\",\"timestamp\":1772809099,\"id\":\"s23_4130\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Iklani\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Iklani says: Dat boy needs a demonstration. Show him how a great demon hunter dances!\",\"timestamp\":1772809101,\"id\":\"s23_4131\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Gunditá\",\"sex\":3},\"event\":\"CHAT_MSG_TEXT_EMOTE\",\"type\":\"EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"|Hplayer:Gunditá:1134:TEXT_EMOTE:|h|cfffff468Gunditá|r|h bursts into dance.\",\"timestamp\":1772809104,\"id\":\"s23_4132\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_TEXT_EMOTE\",\"type\":\"EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"You dance with Kovu.\",\"timestamp\":1772809118,\"id\":\"s23_4133\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kovu\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kovu says: Even you can do it? ...Dis is impossible. I'll never get it down.\",\"timestamp\":1772809118,\"id\":\"s23_4134\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kovu\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kovu says: If it gets me credit for bein' here, fine. But I don't see how dat relates to dancin'.\",\"timestamp\":1772809122,\"id\":\"s23_4135\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_TEXT_EMOTE\",\"type\":\"EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"You burst into dance.\",\"timestamp\":1772809129,\"id\":\"s23_4136\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kovu\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kovu says: Wait, I think I feel de rhythm.\",\"timestamp\":1772809129,\"id\":\"s23_4137\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kovu\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kovu says: I've got it! I'm dancin'!\",\"timestamp\":1772809132,\"id\":\"s23_4138\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Iklani\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Iklani says: See, Kovu? I knew you could do it.\",\"timestamp\":1772809134,\"id\":\"s23_4139\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"An'jali\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"An'jali says: But Papa, I want to go play with de others!\",\"timestamp\":1772809139,\"id\":\"s23_4140\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Tal'rin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Tal'rin says: Not until you've finished your assignment. Show me what you've learned.\",\"timestamp\":1772809142,\"id\":\"s23_4141\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"An'jali\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"An'jali says: You can find de herbs around de village! Okay, thanks, bye!\",\"timestamp\":1772809144,\"id\":\"s23_4142\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Tal'rin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Tal'rin says: An'jali, wait, you're supposed to do it yourself! ...Not again.\",\"timestamp\":1772809148,\"id\":\"s23_4143\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:258892::::::::90:1480:::::::::|h[Dragonhawk Fern Frond]|h|r\",\"timestamp\":1772809154,\"id\":\"s23_4144\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:258892::::::::90:1480:::::::::|h[Dragonhawk Fern Frond]|h|r\",\"timestamp\":1772809179,\"id\":\"s23_4145\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"Human\",\"name\":\"Xzaelpal-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Xzaelpal-Tichondrius|h[|cfff48cbaXzaelpal|r]|h has earned the achievement |cffffff00|Hachievement:6