},
["text"] = "You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx25",
["id"] = "s27_2997",
["timestamp"] = 1773446355,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Kamari",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Kamari says: I hope you are not too disappointed, little one. Mysteries and legends are fickle things.",
["id"] = "s27_2998",
["timestamp"] = 1773446357,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Kuri",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Kuri says: Disappointed?! No way!",
["id"] = "s27_2999",
["timestamp"] = 1773446361,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Kuri",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Kuri says: So our first attempt didn't work. That doesn't mean Aln'sharan isn't real! It just means I'm missing something.",
["id"] = "s27_3000",
["timestamp"] = 1773446363,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Kuri",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Kuri says: Our home is filled to the brim with wonders. Everything is so strange and old! I bet Aln'sharan is out there. I just have to figure out how to call him down!",
["id"] = "s27_3001",
["timestamp"] = 1773446368,
},
