etree\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Telorian-Firetree|h[|cffa330c9Telorian-Firetree|r]|h has earned the achievement |cffffff00|Hachievement:63325:Player-127-0AFDF46F:1:7:14:26:4294967295:4294967295:4294967295:4294967295|h[Omnium Folio Studies]|h|r!\",\"id\":\"s50_4561\",\"timestamp\":1784047414},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Scourge\",\"class\":\"WARLOCK\",\"name\":\"Dreadloccs-Mug'thol\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Dreadloccs-Mug'thol|h[|cff8788eeDreadloccs-Mug'thol|r]|h has earned the achievement |cffffff00|Hachievement:63325:Player-84-0A65797F:1:7:14:26:4294967295:4294967295:4294967295:4294967295|h[Omnium Folio Studies]|h|r!\",\"id\":\"s50_4562\",\"timestamp\":1784047414},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Lilykilikili-Garrosh\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Lilykilikili-Garrosh|h[|cffa330c9Lilykilikili-Garrosh|r]|h has earned the achievement |cffffff00|Hachievement:63325:Player-1136-088D4FED:1:7:14:26:4294967295:4294967295:4294967295:4294967295|h[Omnium Folio Studies]|h|r!\",\"id\":\"s50_4563\",\"timestamp\":1784047426},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Den Welcomer\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Den Welcomer says: Good, you are here. The elders and others await you below.\",\"id\":\"s50_4564\",\"timestamp\":1784047494},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Mechagnome\",\"class\":\"WARLOCK\",\"name\":\"Çów\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Çów-Tichondrius|h[|cff8788eeÇów|r]|h has earned the achievement |cffffff00|Hachievement:63384:Player-11-0A64A33E:1:7:14:26:4294967295:4294967295:4294967295:4294967295|h[Prepared for a Showdown]|h|r!\",\"id\":\"s50_4565\",\"timestamp\":1784047498},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Orweyna says: All manner of elves and trolls are here. We await only the blood elves and the Amani.\",\"id\":\"s50_4566\",\"timestamp\":1784047501},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Orweyna says: So many old wounds. It makes them tense, being near those who were enemies for so long.\",\"id\":\"s50_4567\",\"timestamp\":1784047506},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Umbric says: For a group that has avoided trolls and elves for so long, the haranir seem rather rushed to tell us something.\",\"id\":\"s50_4568\",\"timestamp\":1784047511},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"First Arcanist Thalyssra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"First Arcanist Thalyssra says: Many kaldorei still view us with scorn. To them, we are either cowards who hid from the Legion or traitors who joined the Horde.\",\"id\":\"s50_4569\",\"timestamp\":1784047516},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Orweyna says: Elder Hagar has called on the elven leaders to join this gathering in Harandar. It is of great importance.\",\"timestamp\":1784047563,\"id\":\"s50_4570\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lor'themar Theron says: It would be an honor. We will join you as soon as we can.\",\"timestamp\":1784047570,\"id\":\"s50_4571\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Manyfaced\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"You sense a nearby Skyriding Glyph.\",\"timestamp\":1784047616,\"id\":\"s50_4572\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"HighmountainTauren\",\"name\":\"Nikaldo\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Nikaldo-Tichondrius|h[|cff0070ddNikaldo|r]|h has earned the achievement |cffffff00|Hachievement:63325:Player-11-0EAD53CF:1:7:14:26:4294967295:4294967295:4294967295:4294967295|h[Omnium Folio Studies]|h|r!\",\"timestamp\":1784047680,\"id\":\"s50_4573\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PRIEST\",\"race\":\"Scourge\",\"name\":\"Rasspail-Anub'arak\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Rasspail-Anub'arak|h[|cffffffffRasspail-Anub'arak|r]|h has earned the achievement |cffffff00|Hachievement:63325:Player-1138-098BB80F:1:7:14:26:4294967295:4294967295:4294967295:4294967295|h[Omnium Folio Studies]|h|r!\",\"timestamp\":1784047684,\"id\":\"s50_4574\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Halduron Brightwing\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Halduron Brightwing says: Lightbloom Ath'ran is overgrown! Help my Farstriders tame the area.\",\"timestamp\":1784047818,\"id\":\"s50_4575\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Manyfaced\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"You sense a nearby Skyriding Glyph.\",\"timestamp\":1784047820,\"id\":\"s50_4576\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Selen'vjar\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Selen'vjar yells: To arms my captains! They must not hinder us.\",\"timestamp\":1784047873,\"id\":\"s50_4577\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Manyfaced\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ3:|T4226155:12|t|Hitem:274576::::::::90:260:::::::::|h[Ritualized Arcana]|h|r\",\"timestamp\":1784047886,\"id\":\"s50_4578\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Manyfaced\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ2:|T4914669:12|t|Hitem:267051::::::::90:260:::::::::|h[Dark Particle]|h|rx2\",\"timestamp\":1784047886,\"id