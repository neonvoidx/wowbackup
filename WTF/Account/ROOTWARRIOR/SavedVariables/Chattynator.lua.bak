\":\"Averus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Averus says: Your allies are fascinating, Decimus. Perhaps we can come to an arrangement.\",\"id\":\"s20_3284\",\"timestamp\":1772225645},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"PRIEST\",\"name\":\"Swagchecked-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Swagchecked-Tichondrius|h[|cffffffffSwagchecked|r]|h has earned the achievement |cffffff00|Hachievement:41287:Player-11-0EB2269B:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Windrunner Spire]|h|r!\",\"id\":\"s20_3285\",\"timestamp\":1772225645},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Decimus says: Ha! That would require you having anything of value to offer us.\",\"id\":\"s20_3286\",\"timestamp\":1772225649},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"ROGUE\",\"name\":\"Shiñobi-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Shiñobi-Tichondrius|h[|cfffff468Shiñobi|r]|h has earned the achievement |cffffff00|Hachievement:61832:Player-11-0E9B3ED5:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Delves: Tier 1]|h|r!\",\"id\":\"s20_3287\",\"timestamp\":1772225661},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"