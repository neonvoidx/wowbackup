},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zealous Adherent says: Azeroth will be ours!",
["id"] = "s51_3436",
["timestamp"] = 1785176756,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Wrathion",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Wrathion says: Understood, Magni. N'Zoth will answer for what he has done to Azeroth... and to my father.",
["id"] = "s51_3437",
["timestamp"] = 1785176759,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
