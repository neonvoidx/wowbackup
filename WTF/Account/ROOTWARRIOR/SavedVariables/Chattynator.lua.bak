},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Neltharion says: The dracthyr eagerly accepted. They were designed to serve.",
["id"] = "s51_4802",
["timestamp"] = 1785284124,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
