or?\",\"id\":\"s19_3084\",\"timestamp\":1772166282},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"You sense a nearby Skyriding Glyph.\",\"id\":\"s19_3085\",\"timestamp\":1772166284},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Climatechang-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Climatechang-Tichondrius:3647:GUILD:|h[|cffff7c0aClimatechang|r]|h: anyone figure it out yet how to make your nightfall campaign quests track automatically?\",\"id\":\"s19_3086\",\"timestamp\":1772166297},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Manasia-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Manasia-Tichondrius|h[|cffff7c0aManasia|r]|h has earned the achievement |cffffff00|Hachievement:61856:Player-11-0EA21DE7:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Explore Zul'Aman]|h|r!\",\"id\":\"s19_3087\",\"timestamp\":1772166310},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_SKILL\",\"type\":\"SKILL\"},\"color\":{\"b\":1,\"g\":0.3333333432674408,\"r\":0.3333333432674408},\"text\":\"Your skill in Midnight Mining has increased to 11.\",\"id\":\"s19_3088\",\"timestamp\":1772166349},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type