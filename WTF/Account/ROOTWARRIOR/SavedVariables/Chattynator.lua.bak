6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ4:|T7658128:12|t|Hcurrency:3418:0|h[Nebulous Voidcore]|h|rx2\",\"timestamp\":1776816551,\"id\":\"s46_3776\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: This is a delicate art. Your labor will imbue the blade with the energy of your very soul.\",\"timestamp\":1776816560,\"id\":\"s46_3777\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: It will be an exquisite weapon for you. Now, follow my directions precisely.\",\"timestamp\":1776816565,\"id\":\"s46_3778\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: Scatter behemoth bone dust over the Void-burning blade. It will harden the metal.\",\"timestamp\":1776816567,\"id\":\"s46_3779\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: Yes, good. The energy you imbue in these components is crucial.\",\"timestamp\":1776816573,\"id\":\"s46_3780\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: Use the crystalized Void to enhance the blade's edge!\",\"timestamp\":1776816579,\"id\":\"s46_3781\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name