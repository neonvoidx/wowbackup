ibash-Mal'Ganis:50:GUILD:|h[|cfff48cbaDelibash|r]|h: |cnIQ4:|Hitem:249296::::::::80:70::6:1:3524:1:28:3610:::::|h[Alah'endal, the Dawnsong]|h|r\",\"timestamp\":1768961376,\"id\":\"s17_3475\"},{\"recordedBy\":\"Ofpuss-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"BloodElf\",\"name\":\"Depressedbtw-Mal'Ganis\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Depressedbtw-Mal'Ganis|h[|cffc41e3aDepressedbtw-Mal'Ganis|r]|h has earned the achievement |cffffff00|Hachievement:2093:Player-3684-0EB7FF61:1:1:20:26:4294967295:4294967295:4294967295:4294967295|h[Rival]|h|r!\",\"timestamp\":1768961539,\"id\":\"s17_3476\"},{\"recordedBy\":\"Ofpuss-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"BloodElf\",\"name\":\"Depressedbtw-Mal'Ganis\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Depressedbtw-Mal'Ganis|h[|cffc41e3aDepressedbtw-Mal'Ganis|r]|h has earned the achievement |cffffff00|Hachievement:2090:Player-3684-0EB7FF61:1:1:20:26:4294967295:4294967295:4294967295:4294967295|h[Challenger]|h|r!\",\"timestamp\":1768961539,\"id\":\"s17_3477\"},{\"recordedBy\":\"Ofpuss-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"BloodElf\",\"name\":\"Depressedbtw-Mal'Ganis\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Depressedbtw-Mal'Ganis|h[|cffc41e3aDepressedbtw-Mal'Ganis|r]|h has earned the achievement |cffffff00|Hachievement:42287:Player-3684-0EB7FF61:1:1:20:26:4294967295:4294967295:4294967295:4294967295|h[Hidden Potential of the Deathlord]|h|r!\",\"timestamp\":1768961539,\"id\":\"s17_3478\"},{\"recordedBy\":\"Ofpuss-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Overlord Geya'rah\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Overlord Geya'rah says: Your people have broken their word, Trollbane.\",\"timestamp\":1768961617,\"id\":\"s17_3479\"},{\"recordedBy\":\"Ofpuss-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Danath Trollbane\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Danath Trollbane says: I understand your frustration, Geya'rah. But do not rush to conclusions.\",\"timestamp\":1768961619,\"id\":\"s17_3480\"},{\"recordedBy\":\"Ofpuss-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Constable Zo'ardaz\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Constable Zo'ardaz says: The Shadowguard continue their assault on Tazavesh. We need your help to repel the invaders and re-establish our defenses.\",\"timestamp\":1768961826,\"id\":\"s17_3481\"},{\"recordedBy\":\"Ofpuss-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Om'taha\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Om'taha says: Did I lose them? Are they still chasing me?\",\"timestamp\":1768961872,\"id\":\"s17_3482\"},{\"recordedBy\":\"Ofpuss-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_PING\",\"type\":\"PING\"},\"color\":{\"r\":0.6666666865348816,\"g\":0.6666666865348816,\"b\":1},\"text\":\"|Hplayer:Ofpuss|h[Ofpuss]: |h|A:ping_chat_warning:0:0:0:0|aWarning: Ofpuss\",\"timestamp\":1768961938,\"id\":\"s17_3483\"},{\"recordedBy\":\"Ofpuss-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Om'taha\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Om'taha says: Did I lose them? Are they still chasing me?\",\"id\":\"s17_3484\",\"timestamp\":1768961995},{\"recordedBy\":\"Ofpuss-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Om'rajula\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Om'rajula says: This antique transmogrifier was damaged in transit. See if you can repair it.\",\"id\":\"s17_3485\",\"timestamp\":1768962027},{\"recordedBy\":\"Ofpuss-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"MAGE\",\"name\":\"Zeloschosen-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Zeloschosen-Tichondrius|h[|cff3fc7ebZeloschosen|r]|h has earned the achievement |cffffff00|Hachievement:61916:Player-11-0AA0A4FD:1:1:20:26:4294967295:4294967295:4294967295:4294967295|h[Rage of the Ren'dorei]|h|r!\",\"id\":\"s17_3486\",\"timestamp\":1768962029},{\"recordedBy\":\"Ofpuss-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Leona Darkstrider\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Leona Darkstrider says: Allari told me to meet her out there. Follow me.\",\"id\":\"s17_3487\",\"timestamp\":1768962033},{\"recordedBy\":\"Ofpuss-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Maella\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Riftblade Maella says: The Shadowguard harry us from all sides, even across planes. We must not be caught off guard.\",\"id\":\"s17_3488\",\"timestamp\":1768962037},{\"recordedBy\":\"Ofpuss-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"HUNTER\",\"name\":\"Thrinax-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Thrinax-Tichondrius|h[|cffaad372Thrinax|r]|h has earned the achievement |cffffff00|Hachievement:61916:Player-11-0E59B49B:1:1:20:26:4294967295:4294967295:4294967295:4294967295|h[Rage of the Ren'dorei]|h|r!\",\"id\":\"s17_3489\",\"timestamp\":1768962051},{\"recordedBy\":\"Ofpuss-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Leona Darkstrider\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Leona Darkstrider says: You're not Adarus. I suppose I shouldn't be surprised.\",\"id\":\"s17_3490\",\"timestamp\":1768962076},{\"recordedBy\":\"Ofpuss-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Allari the Souleater\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Allari the Souleater says: Be warned, Darkstrider. The path of a demon hunter is one of pain and sacrifice.\",\"id\":\"s17_3491\",\"timestamp\":1768962095},{\"recordedBy\":\"Ofpuss-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Leona Darkstrider\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Leona Darkstrider says: I am prepared to meet the challenges that lie before me.\",\"id\":\"s17_3492\",\"timestamp\":1768962100},{\"recordedBy\":\"Ofpuss-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Allari the Souleater\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Allari the Souleater says: Show me the precision of your attacks. If you can't focus your hatred, then the demon within you has already won.\",\"id\":\"s17_3493\",\"timestamp\":1768962103},{\"recordedBy\":\"Ofpuss-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Leona Darkstrider\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Leona Darkstrider says: I'll carve out those pieces like I was holding a scalpel.\",\"id\":\"s17_3494\",\"timestamp\":176896211