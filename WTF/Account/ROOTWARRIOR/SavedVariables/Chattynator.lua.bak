["g"] = 1,
["r"] = 1,
},
["text"] = "Loa Speaker Kinduru says: Zul'jan, something's happening!",
["id"] = "s51_4580",
["timestamp"] = 1785268875,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
