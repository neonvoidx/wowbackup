|cfff48cbaPtitslut-Thunderlord|r]|h a accompli le haut fait |cffffff00|Hachievement:62157:Player-77-0FD0C0FB:1:3:11:26:4294967295:4294967295:4294967295:4294967295|h[Prey: Sadistic Shamans (Hard)]|h|r !\",\"id\":\"s26_4807\",\"timestamp\":1773274899},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Stormclout-Tichondrius:426:PARTY:|h[|cff00ff98Stormclout|r]|h: im inside\",\"id\":\"s26_4808\",\"timestamp\":1773274922},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Stormclout places a cozy Feast of the Midnight Masquerade for everyone to enjoy!\",\"id\":\"s26_4809\",\"timestamp\":1773274932},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEATHKNIGHT\",\"name\":\"Deadsponge-Mal'Ganis\",\"sex\":3},\"event\":\"CHAT_MSG_PARTY_LEADER\",\"type\":\"PARTY_LEADER\"},\"color\":{\"b\":1,\"g\":0.7843137979507446,\"r\":0.4627451300621033},\"text\":\"|Hchannel:PARTY|h[Party Leader]|h |Hplayer:Deadsponge-Mal'Ganis:428:PARTY:|h[|cffc41e3aDeadsponge-Mal'Ganis|r]|h: yea monk tank\",\"id\":\"s26_4810\",\"timestamp\":1773274958},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Firsona-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Firsona-Tichondrius|h[|cffff7c0aFirsona|r]|h has earned the achievement |cffffff00|Hachievement:61802:Player-11-0E988735:1:3:11:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Delves: Tier 6 (Season 1)]|h|r!\",\"id\":\"s26_4811\",\"timestamp\":1773274959},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Stormclout-Tichondrius:430:PARTY:|h[|cff00ff98Stormclout|r]|h: pogger\",\"id\":\"s26_4812\",\"timestamp\":1773274965},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEATHKNIGHT\",\"name\":\"Deadsponge-Mal'Ganis\",\"sex\":3},\"event\":\"CHAT_MSG_PARTY_LEADER\",\"type\":\"PARTY_LEADER\"},\"color\":{\"b\":1,\"g\":0.7843137979507446,\"r\":0.4627451300621033},\"text\":\"|Hchannel:PARTY|h[Party Leader]|h |Hplayer:Deadsponge-Mal'Ganis:431:PARTY:|h[|cffc41e3aDeadsponge-Mal'Ganis|r]|h: fast tank XD\",\"id\":\"s26_4813\",\"timestamp\":1773274969},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Dis must be de fire Lilaju spoke of.\",\"id\":\"s26_4814\",\"timestamp\":1773274969},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Sit and we will start de ritual--but be ready. Dis is de Loa of War. What ever he dreams of, we must complete de trial.\",\"id\":\"s26_4815\",\"timestamp\":1773274972},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEATHKNIGHT\",\"name\":\"Deadsponge-Mal'Ganis\",\"sex\":3},\"event\":\"CHAT_MSG_PARTY_LEADER\",\"type\":\"PARTY_LEADER\"},\"color\":{\"b\":1,\"g\":0.7843137979507446,\"r\":0.4627451300621033},\"text\":\"|Hchannel:PARTY|h[Party Leader]|h |Hplayer:Deadsponge-Mal'Ganis:434:PARTY:|h[|cffc41e3aDeadsponge-Mal'Ganis|r]|h: the dk dream\",\"id\":\"s26_4816\",\"timestamp\":1773274984},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Nanea\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Nanea says: Do not worry about your friend, de would-be hash'ey. Nalorakk, de dreamer, de Loa of War, will test her strength.\",\"id\":\"s26_4817\",\"timestamp\":1773274989},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Nanea\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Nanea says: A hash'ey is only as strong as their warriors. So, you too will be tested in Nalorakk's dream.\",\"id\":\"s26_4818\",\"timestamp\":1773275000},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"PALADIN\",\"name\":\"Moistybubble-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Moistybubble-Tichondrius|h[|cfff48cbaMoistybubble|r]|h has earned the achievement |cffffff00|Hachievement:1795:Player-11-0E9D4D8B:1:3:11:26:4294967295:4294967295:4294967295:4294967295|h[Lunch Lady]|h|r!\",\"id\":\"s26_4819\",\"timestamp\":1773275009},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Nanea\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Nanea says: The loa dreams of de Amani's past. When de winter was their only foe. Preparin' for it will be your first trial.\",\"id\":\"s26_4820\",\"timestamp\":1773275010},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"ROGUE\",\"name\":\"Âlpha-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Âlpha-Tichondrius:440:GUILD:|h[|cfffff468Âlpha|r]|h: anyone running m0s?\",\"id\":\"s26_4821\",\"timestamp\":1773275050},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Nightborne\",\"class\":\"PRIEST\",\"name\":\"Grolbure-Zul'jin\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Grolbure-Zul'jin receives loot: |cnIQ0:|Hitem:260614::::::::90:268:::::::::|h[Unrecognizable Organ]|h|r.\",\"id\":\"s26_4822\",\"timestamp\":1773275090},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"ROGUE\",\"name\":\"Jégg-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Jégg-Tichondrius:443:GUILD:|h[|cfffff468Jégg|r]|h: me and firsona are soon\",\"id\":\"s26_4823\",\"timestamp\":1773275107},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_PING\",\"type\":\"PING\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"[Tank] |Hplayer:Stormclout|h[Stormclout]: |h|A:ping_chat_nonthreat:0:0:0:0|aLook here\",\"id\":\"s26_4824\",\"timestamp\":1773275134},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Nanea\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Nanea says: Preparin' will help you in de trial ahead.\",\"id\":\"s26