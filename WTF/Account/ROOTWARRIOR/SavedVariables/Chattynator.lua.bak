["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Loa Speaker Nanea says: De winter do not care who you are. Hash'ey, elder, child, beggar. It tests all.",
["id"] = "s28_2780",
["timestamp"] = 1773629163,
},
{
["recordedBy"] = "Starphage-Tichondrius",
