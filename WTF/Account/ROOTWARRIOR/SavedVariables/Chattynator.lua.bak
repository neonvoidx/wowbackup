},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Kuri says: Meet me back at Har'kuai. We're going to summon ourselves a flying serpent!",
["id"] = "s27_2993",
["timestamp"] = 1773446335,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Kuri",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Kuri says: There you are! Come on. Throw the shards into the pools!",
["id"] = "s27_2994",
["timestamp"] = 1773446343,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Kuri",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Kuri says: Look! It's happening!",
["id"] = "s27_2995",
["timestamp"] = 1773446353,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
