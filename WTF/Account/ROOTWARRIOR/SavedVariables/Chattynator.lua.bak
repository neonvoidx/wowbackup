rned the achievement |cffffff00|Hachievement:61681:Player-11-0E3848F3:1:4:7:26:4294967295:4294967295:4294967295:4294967295|h[Abundance: You Should See Him in a Crown]|h|r!\",\"timestamp\":1775565348,\"id\":\"s42_3641\"},{\"recordedBy\":\"Korahron-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Freed Expedition Member\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Freed Expedition Member says: Thanks. They have Crenna Earth-Daughter deeper inside, you have to rescue her!\",\"id\":\"s42_3642\",\"timestamp\":1775565579},{\"recordedBy\":\"Korahron-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Freed Expedition Member\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Freed Expedition Member says: I thought I was done for! You've got to rescue Crenna Earth-Daughter, she's deeper below.\",\"id\":\"s42_3643\",\"timestamp\":1775565600},{\"recordedBy\":\"Korahron-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Freed Expedition Member\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Freed Expedition Member says: I knew the Horde wouldn't let me die. Crenna Earth-Daughter is trapped deeper in the pit.\",\"id\":\"s42_3644\",\"timestamp\":1775565611},{\"recordedBy\":\"Korahron-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Freed Expedition Member\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Freed Expedition Member says: You have to find Crenna Earth-Daughter! She tried fighting the monster in this pit.\",\"id\":\"s42_3645\",\"timestamp\":1775565626},{\"recordedBy\":\"Korahron-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Crenna Earth-Daughter\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Crenna Earth-Daughter says: A rescue party! Earth Mother, guide their path!\",\"id\":\"s42_3646\",\"timestamp\":1775565665},{\"recordedBy\":\"Korahron-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hrun the Exiled\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hrun the Exiled says: I will harvest your life force... and then those who sealed me in here shall burn!\",\"id\":\"s42_3647\",\"timestamp\":1775565673},{\"recordedBy\":\"Korahron-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hrun the Exiled\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hrun the Exiled says: You will be kindling for the flame!\",\"id\":\"s42_3648\",\"timestamp\":1775565688},{\"recordedBy\":\"Korahron-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hrun the Exiled\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hrun the Exiled says: If... I die... so... do you!\",\"id\":\"s42_3649\",\"timestamp\":1775565723},{\"recordedBy\":\"Korahron-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Crenna Earth-Daughter\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Crenna Earth-Daughter says: Thank you, friend. I will bear us to safety. Hop on!\",\"id\":\"s42_3650\",\"timestamp\":1775565730},{\"recordedBy\":\"Korahron-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Crenna Earth-Daughter\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Crenna Earth-Daughter says: An'she, watch over and protect us!\",\"id\":\"s42_3651\",\"timestamp\":1775565737},{\"recordedBy\":\"Korahron-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Crenna Earth-Daughter\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Crenna Earth-Daughter says: Dark magic has brought ruin to this place.\",\"id\":\"s42_3652\",\"timestamp\":1775565762},{\"recordedBy\":\"Korahron-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lana Jordan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lana Jordan says: Oh good, you made it out.\",\"id\":\"s42_3653\",\"timestamp\":1775565778},{\"recordedBy\":\"Korahron-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Won'sa\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Won'sa says: Ya did good savin' da survivors an' killin' da spiders.\",\"id\":\"s42_3654\",\"timestamp\":1775565785},{\"recordedBy\":\"Korahron-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Crenna Earth-Daughter\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Crenna Earth-Daughter says: Those spiders had their rightful home destroyed. They deserved better.\",\"id\":\"s42_3655\",\"timestamp\":1775565789},{\"recordedBy\":\"Korahron-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Won'sa\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Won'sa says: Well if ya be puttin' it dat way...\",\"id\":\"s42_3656\",\"timestamp\":1775565794},{\"recordedBy\":\"Korahron-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"MONK\",\"name\":\"Korahron-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|T1911971:12|t|Hitem:175237::::::::7:1450::11:1:6500:2:9:7:28:955:::::|h[Expeditionary Leather Bracers (Wrist 8)]|h|r\",\"id\":\"s42_3657\",\"timestamp\":1775565797},{\"recordedBy\":\"Korahron-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lana Jordan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lana Jordan says: You have a problem with spiders, Won'sa?\",\"id\":\"s42_3658\",\"timestamp\":1775565800},{\"recordedBy\":\"Korahron-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Won'sa\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Won'sa says: Ya seen da spiders we trolls be dealin' wit', ya not be a fan of dem either.\",\"id\":\"s42_3659\",\"timestamp\":1775565805},{\"recordedBy\":\"Korahron-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Shuja Grimaxe\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Shuja Grimaxe says: I will join Bo farther north, where the harpies roost. Meet me there.\",\"id\":\"s42_3660\",\"timestamp\":1775565817},{\"recordedBy\":\"Korahron-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Bo\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Bo says: They seem to have captured a Forsaken prisoner for their ritual.\",\"id\":\"s42_3661\",\"timestamp\":1775565835},{\"recordedBy\":\"Auteist-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"DEATHKNIGHT\",\"name\":\"Ravenmockr-Thrall\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Ravenmockr-Thrall:295:GUILD:|h[|cffc41e3aRavenmockr|r]|h: any resto evoker/shammy wanna run a +8 academy?\",\"id\":\"s42_3662\",\"timestamp\":1775566068},{\"recordedBy\":\"Auteist-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Aurosalia\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294