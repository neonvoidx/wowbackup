d\":\"s20_2887\",\"timestamp\":1772222880},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:262606::::::::87:1480::11::1:28:3084:::::|h[Smoldering Energy Forge]|h|r\",\"id\":\"s20_2888\",\"timestamp\":1772222880},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Alleria Windrunner says: Give Lor'themar my report. Tell him... we did what we had to.\",\"id\":\"s20_2889\",\"timestamp\":1772222881},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: I'm sure Lothraxion felt the same.\",\"id\":\"s20_2890\",\"timestamp\":1772222888},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"WARLOCK\",\"name\":\"Ppoonlock-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Ppoonlock-Tichondrius|h[|cff8788eePpoonlock|r]|h has earned the achievement |cffffff00|Hachievement:18768:Player-11-0E2D423B:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Disenchantment III]|h|r!\",\"id\":\"s20_2891\",\"timestamp\":1772222901},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Magisstorm-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Magisstorm-Tichondrius|h[|cff0070ddMagisstorm|r]|h has earned the achievement |cffffff00|Hachievement:61856:Player-11-0EAC3E8E:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Explore Zul'Aman]|h|r!\",\"id\":\"s20_2892\",\"timestamp\":1772222933},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: Starphage? Thank the Light. With the storm breaking, we just might win this.\",\"id\":\"s20_2893\",\"timestamp\":1772222938},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Amaragos-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Amaragos-Tichondrius|h[|cff00ff98Amaragos|r]|h has earned the achievement |cffffff00|Hachievement:61640:Player-11-0EB05FFC:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Nexus-Point Xenas]|h|r!\",\"id\":\"s20_2894\",\"timestamp\":1772222939},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: You made the right choice--the only choice. Now we can truly begin to fight back.\",\"id\":\"s20_2895\",\"timestamp\":1772222940},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Starphage-Tichondrius|h[|cffa330c9Starphage|r]|h has earned the achievement |cffffff00|Hachievement:41806:Player-11-0EA2971B:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Breaching the Voidstorm]|h|r!\",\"id\":\"s20_2896\",\"timestamp\":1772222940},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Starphage-Tichondrius|h[|cffa330c9Starphage|r]|h has earned the achievement |cffffff00|Hachievement:42045:Player-11-0EA2971B:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Midnight]|h|r!\",\"id\":\"s20_2897\",\"timestamp\":1772222940},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Starphage-Tichondrius|h[|cffa330c9Starphage|r]|h has earned the achievement |cffffff00|Hachievement:41806:Player-11-0EA2971B:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Breaching the Voidstorm]|h|r!\",\"id\":\"s20_2898\",\"timestamp\":1772222940},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Starphage-Tichondrius|h[|cffa330c9Starphage|r]|h has earned the achievement |cffffff00|Hachievement:42045:Player-11-0EA2971B:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Midnight]|h|r!\",\"id\":\"s20_2899\",\"timestamp\":1772222940},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Magisstorm-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Magisstorm-Tichondrius|h[|cff0070ddMagisstorm|r]|h has earned the achievement |cffffff00|Hachievement:41803:Player-11-0EAC3E8E:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[For Zul'Aman!]|h|r!\",\"id\":\"s20_2900\",\"timestamp\":1772222978},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"HUNTER\",\"name\":\"Dexand-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Dexand-Tichondrius|h[|cffaad372Dexand|r]|h has earned the achievement |cffffff00|Hachievement:41806:Player-11-0E2B8100:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Breaching the Voidstorm]|h|r!\",\"id\":\"s20_2901\",\"timestamp\":1772222989},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"HUNTER\",\"name\":\"Dexand-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Dexand-Tichondrius|h[|cffaad372Dexand|r]|h has earned the achievement |cffffff00|Hachievement:42045:Player-11-0E2B8100:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Midnight]|h|r!\",\"id\":\"s20_2902\",\"timestamp\":1772222989},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"PALADIN\",\"name\":\"Junkhog-Mannoroth\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Junkhog-Mannoroth|h[|cfff48cbaJunkhog-Mannoroth|r]|h has earned the achievement |cffffff00|Hachievement:61638:Player-77-0FA81358:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Den of Nalorakk]|h|r!\",\"id\":\"s20_2903\",\"timestamp\":1772223025},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: My colleagues are searching for methods to protect our city. I have my own solution.\",\"id\":\"s20_2904\",\"timestamp\":1772223057},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: Meet me near the harbor and I will reveal to you another path...\",\"id\":\"s20_2905\",\"timestamp\":1772223066},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"MAGE\",\"name\":\"Mageyuya-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Mageyuya-Tichondrius|h[|cff3fc7ebMageyuya|r]|h has earned the achievement |cffffff00|Hachievement:41803:Player-11-0E97F286:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[For Zul'Aman!]|h|r!\",\"id\":\"s20_2906\",\"timestamp\":1772223071},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Grand Magister Rommath says: Our training grounds are riddled with pests! Your... years of experience should allow you to swiftly handle this matter.\",\"id\":\"s20_2907\",\"timestamp\":1772223088},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Sanctum Attendant\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Sanctum Attendant says: Magister Bloodsworn and his guest are waiting for you below.\",\"id\":\"s20_2908\",\"timestamp\":1772223092},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: I have been tracking these threats to our realm for some time. They are quite tenacious.\",\"id\":\"s20_2909\",\"timestamp\":1772223099},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: This crystal vessel... it's made from an unusually resilient cosmic material. Fascinating.\",\"id\":\"s20_2910\",\"timestamp\":1772223104},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Captured Gnarldin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Captured Gnarldin says: Release me and we will see who is \\\"prey.\\\"\",\"id\":\"s20_2911\",\"timestamp\":1772223107},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: As if it were made to withstand something as volatile as anguish... This bodes well.\",\"id\":\"s20_2912\",\"timestamp\":1772223114},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: The crystal reacts favorably to your touch. Duly noted.\",\"id\":\"s20_2913\",\"timestamp\":1772223118},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Captured Gnarldin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Captured Gnarldin says: Lucky void elf.\",\"id\":\"s20_2914\",\"timestamp\":1772223130},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: A skilled hunter is capable of disarming any trap placed before them.\",\"id\":\"s20_2915\",\"timestamp\":1772223130},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: A hasty hunter is oft bitten...\",\"id\":\"s20_2916\",\"timestamp\":1772223133},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Captured Gnarldin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Captured Gnarldin says: Ha! Got you good. Wait... what is that?\",\"id\":\"s20_2917\",\"timestamp\":1772223133},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Amaragos-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Amaragos-Tichondrius|h[|cff00ff98Amaragos|r]|h has earned the achievement |cffffff00|Hachievement:41806:Player-11-0EB05FFC:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Breaching the Voidstorm]|h|r!\",\"id\":\"s20_2918\",\"timestamp\":1772223135},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Amaragos-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Amaragos-Tichondrius|h[|cff00ff98Amaragos|r]|h has earned the achievement |cffffff00|Hachievement:42045:Player-11-0EB05FFC:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Midnight]|h|r!\",\"id\":\"s20_2919\",\"timestamp\":1772223135},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Captured Gnarldin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Captured Gnarldin says: Raaaagh!\",\"id\":\"s20_2920\",\"timestamp\":1772223138},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: I am well positioned to turn pain into power...\",\"id\":\"s20_2921\",\"timestamp\":1772223138},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: Be careful, champion. Our magic is almost as deadly as our prey.\",\"id\":\"s20_2922\",\"timestamp\":1772223148},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: If you give them an inch, they will seek to claim the upper hand.\",\"id\":\"s20_2923\",\"timestamp\":1772223154},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Captured Gnarldin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Captured Gnarldin says: Aaaggh! I kill you!\",\"id\":\"s20_2924\",\"timestamp\":1772223161},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Captured Gnarldin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Captured Gnarldin says: Surprise, void elf!\",\"id\":\"s20_2925\",\"timestamp\":1772223164},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Kaliostus-BleedingHollow\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Kaliostus-BleedingHollow|h[|cffa330c9Kaliostus-BleedingHollow|r]|h has earned the achievement |cffffff00|Hachievement:153:Player-73-0FDB5F09:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[The Old Gnome and the Sea]|h|r!\",\"id\":\"s20_2926\",\"timestamp\":1772223168},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: Do you feel it? Do you feel the power? The anguish?\",\"id\":\"s20_2927\",\"timestamp\":1772223178},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Draenei\",\"class\":\"MAGE\",\"name\":\"Domiitius-Bonechewer\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Domiitius-Bonechewer|h[|cff3fc7ebDomiitius-Bonechewer|r]|h has earned the achievement |cffffff00|Hachievement:62191:Player-1136-09359A83:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Call of the Light]|h|r!\",\"id\":\"s20_2928\",\"timestamp\":1772223189},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Tauren\",\"class\":\"PALADIN\",\"name\":\"Geöspäwn-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Geöspäwn-Tichondrius|h[|cfff48cbaGeöspäwn|r]|h has earned the achievement |cffffff00|Hachievement:41802:Player-11-0AEAEF4B:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Eversong In Reprise]|h|r!\",\"id\":\"s20_2929\",\"timestamp\":1772223212},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"PRIEST\",\"name\":\"Swagchecked-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Swagchecked-Tichondrius|h[|cffffffffSwagchecked|r]|h has earned the achievement |cffffff00|Hachievement:61856:Player-11-0EB2269B:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Explore Zul'Aman]|h|r!\",\"id\":\"s20_2930\",\"timestamp\":1772223240},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Sarvi\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Sarvi says: Make sure you tell him Sarvi sent you. I want my cut.\",\"id\":\"s20_2931\",\"timestamp\":1772223387},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Solwin Brightstitch says: Alas, if I had but one worthy customer...\",\"id\":\"s20_2932\",\"timestamp\":1772223400},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Solwin Brightstitch says: At least fitting all these dilettantes will go faster with help...\",\"id\":\"s20_2933\",\"timestamp\":1772223404},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Solwin Brightstitch says: There is entirely too much material here--throw me my shears!\",\"id\":\"s20_2934\",\"timestamp\":1772223414},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Solwin Brightstitch yells: NEXT!\",\"id\":\"s20_2935\",\"timestamp\":1772223429},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Solwin Brightstitch says: It doesn't look expensive enough--plush velour, please!\",\"id\":\"s20_2936\",\"timestamp\":1772223431},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Solwin Brightstitch yells: NEXT!\",\"id\":\"s20_2937\",\"timestamp\":1772223431},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Solwin Brightstitch says: I need something classy! Something tasteful--I need glittering chiffon!\",\"id\":\"s20_2938\",\"timestamp\":1772223434},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Solwin Brightstitch yells: NEXT!\",\"id\":\"s20_2939\",\"timestamp\":1772223437},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Solwin Brightstitch says: Mmm... no, actually, I preferred the plush velour!\",\"id\":\"s20_2940\",\"timestamp\":1772223439},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Solwin Brightstitch yells: NEXT!\",\"id\":\"s20_2941\",\"timestamp\":1772223442},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Solwin Brightstitch says: There's nothing I can do to save this--just cover it with sequins and call it a day!\",\"id\":\"s20_2942\",\"timestamp\":1772223444},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Solwin Brightstitch says: It's useless! I can't work like this. These people have no appreciation for my craft!\",\"id\":\"s20_2943\",\"timestamp\":1772223447},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Voidwhispèr-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Voidwhispèr-Area52|h[|cffa330c9Voidwhispèr-Area52|r]|h has earned the achievement |cffffff00|Hachievement:61640:Player-3676-0EC3359E:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Nexus-Point Xenas]|h|r!\",\"id\":\"s20_2944\",\"timestamp\":1772223454},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Gaari\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Gaari says: My ask is humble. I have had this cloak since the days of the Shattered Sun, and it needs a repair.\",\"id\":\"s20_2945\",\"timestamp\":1772223454},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Solwin Brightstitch says: This cloak is pure Thalassian arcanoweave! And some of the finest I've ever seen...\",\"id\":\"s20_2946\",\"timestamp\":1772223460},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Amaragos-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Amaragos-Tichondrius|h[|cff00ff98Amaragos|r]|h has earned the achievement |cffffff00|Hachievement:17335:Player-11-0EB05FFC:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Airborne Tumbler]|h|r!\",\"id\":\"s20_2947\",\"timestamp\":1772223461},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Solwin Brightstitch says: I am going quite far out of my way for this, you know.\",\"id\":\"s20_2948\",\"timestamp\":1772223461},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Solwin Brightstitch says: Starphage, turn them away!\",\"id\":\"s20_2949\",\"timestamp\":1772223461},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Gaari\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Gaari says: I insist upon accompanying you. Your trouble is my trouble.\",\"id\":\"s20_2950\",\"timestamp\":1772223463},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Gaari\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Gaari says: It is an honor to see the source of such fine craftsmanship.\",\"id\":\"s20_2951\",\"timestamp\":1772223482},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ1:|Hitem:250919::::::::87:1480::11::1:28:3321:::::|h[Empty Manasilk Bobbin]|h|r\",\"id\":\"s20_2952\",\"timestamp\":1772223484},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Gaari\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Gaari says: The wyrms must be beaten first? No gain without sacrifice.\",\"id\":\"s20_2953\",\"timestamp\":1772223485},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"PALADIN\",\"name\":\"Håvi-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Håvi-Tichondrius|h[|cfff48cbaHåvi|r]|h has earned the achievement |cffffff00|Hachievement:41805:Player-11-0E92A9E5:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Arator's Journey]|h|r!\",\"id\":\"s20_2954\",\"timestamp\":1772223486},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Solwin Brightstitch says: Hmmph. What would you know about craftsmanship?\",\"id\":\"s20_2955\",\"timestamp\":1772223487},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Solwin Brightstitch says: I-I have been assured it is quite ethical! They are otherwise treated very well!\",\"id\":\"s20_2956\",\"timestamp\":1772223489},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Gaari\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Gaari says: I understand, my friend. Beauty and pain go hand in hand.\",\"id\":\"s20_2957\",\"timestamp\":1772223493},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:251521::::::::87:1480:::::::::|h[Full Bobbin of Manasilk]|h|r\",\"id\":\"s20_2958\",\"timestamp\":1772223504},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:251521::::::::87:1480:::::::::|h[Full Bobbin of Manasilk]|h|r\",\"id\":\"s20_2959\",\"timestamp\":1772223508},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:251521::::::::87:1480:::::::::|h[Full Bobbin of Manasilk]|h|r\",\"id\":\"s20_2960\",\"timestamp\":1772223516},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:251521::::::::87:1480:::::::::|h[Full Bobbin of Manasilk]|h|r\",\"id\":\"s20_2961\",\"timestamp\":1772223533},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"PALADIN\",\"name\":\"Dinktard-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Dinktard-Tichondrius|h[|cfff48cbaDinktard|r]|h has earned the achievement |cffffff00|Hachievement:61835:Player-11-0E66EE97:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Delves: Tier 2]|h|r!\",\"id\":\"s20_2962\",\"timestamp\":1772223534},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 5 Gold, 90 Silver, 27 Copper\",\"id\":\"s20_2963\",\"timestamp\":1772223545},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:251521::::::::87:1480:::::::::|h[Full Bobbin of Manasilk]|h|r\",\"id\":\"s20_2964\",\"timestamp\":1772223556},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:251521::::::::87:1480:::::::::|h[Full Bobbin of Manasilk]|h|r\",\"id\":\"s20_2965\",\"timestamp\":1772223559},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:251521::::::::87:1480:::::::::|h[Full Bobbin of Manasilk]|h|r\",\"id\":\"s20_2966\",\"timestamp\":1772223563},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:251521::::::::87:1480:::::::::|h[Full Bobbin of Manasilk]|h|r\",\"id\":\"s20_2967\",\"timestamp\":1772223575},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Gaari\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Gaari says: ...and so I tell him, \\\"Your ears might be long, but my tail is longer!\\\"\",\"id\":\"s20_2968\",\"timestamp\":1772223580},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Solwin Brightstitch says: With this much power, it's likely we will manifest some... manifestations.\",\"id\":\"s20_2969\",\"timestamp\":1772223583},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Solwin Brightstitch says: Oh, that's devious! I can't imagine you...\",\"id\":\"s20_2970\",\"timestamp\":1772223586},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Gaari\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Gaari says: Whatever adversity comes, I will defend you.\",\"id\":\"s20_2971\",\"timestamp\":1772223586},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Solwin Brightstitch says: Ahem. Here comes our helper.\",\"id\":\"s20_2972\",\"timestamp\":1772223588},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Solwin Brightstitch hurries off before his blush can be noticed.\",\"id\":\"s20_2973\",\"timestamp\":1772223591},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Solwin Brightstitch says: Look alive, everyone! I've begun!\",\"id\":\"s20_2974\",\"timestamp\":1772223591},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Gaari\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Gaari says: The manifestations... they are memories of the cloak!\",\"id\":\"s20_2975\",\"timestamp\":1772223593},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Draenei\",\"class\":\"MAGE\",\"name\":\"Domiitius-Bonechewer\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Domiitius-Bonechewer|h[|cff3fc7ebDomiitius-Bonechewer|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-1136-09359A83:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s20_2976\",\"timestamp\":1772223600},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"ROGUE\",\"name\":\"Pedrayy-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Pedrayy-Illidan|h[|cfffff468Pedrayy-Illidan|r]|h has earned the achievement |cffffff00|Hachievement:62191:Player-57-0D6693B5:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Call of the Light]|h|r!\",\"id\":\"s20_2977\",\"timestamp\":1772223601},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"PRIEST\",\"name\":\"Twìtch-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Twìtch-Tichondrius:4522:GUILD:|h[|cffffffffTwìtch|r]|h: almost got an upgrade finally!! |cnIQ4:|Hitem:251721::::::::84:258::11:4:13573:13614:13616:6652:2:28:3088:9:84:::::|h[Light's Hope Shoulders]|h|r but it's still lower ilevel than my gear from TWW\",\"id\":\"s20_2978\",\"timestamp\":1772223602},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"PRIEST\",\"name\":\"Twìtch-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Twìtch-Tichondrius:4525:GUILD:|h[|cffffffffTwìtch|r]|h: i feel like they started the ilevel super low\",\"id\":\"s20_2979\",\"timestamp\":1772223612},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Manifested Memory\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Manifested Memory says: A shame for it to come to this, old friend.\",\"id\":\"s20_2980\",\"timestamp\":1772223628},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Gaari\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Gaari says: I had hoped never to face this memory again...\",\"id\":\"s20_2981\",\"timestamp\":1772223631},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Voidwhispèr-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Voidwhispèr-Area52|h[|cffa330c9Voidwhispèr-Area52|r]|h has earned the achievement |cffffff00|Hachievement:41806:Player-3676-0EC3359E:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Breaching the Voidstorm]|h|r!\",\"id\":\"s20_2982\",\"timestamp\":1772223638},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Voidwhispèr-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Voidwhispèr-Area52|h[|cffa330c9Voidwhispèr-Area52|r]|h has earned the achievement |cffffff00|Hachievement:42045:Player-3676-0EC3359E:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Midnight]|h|r!\",\"id\":\"s20_2983\",\"timestamp\":1772223638},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Manifested Memory\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Manifested Memory says: I'm glad... you were here... to take up my mantle...\",\"id\":\"s20_2984\",\"timestamp\":1772223648},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 12 Gold, 8 Silver, 58 Copper\",\"id\":\"s20_2985\",\"timestamp\":1772223651},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Solwin Brightstitch says: I've done it! The cloak is whole once more, and dare I say it looks...\",\"id\":\"s20_2986\",\"timestamp\":1772223651},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Solwin Brightstitch says: Gaari? Are you all right?\",\"id\":\"s20_2987\",\"timestamp\":1772223654},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Gaari\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Gaari says: Forgive me. I am sure it is beautiful... but I must clear my head.\",\"id\":\"s20_2988\",\"timestamp\":1772223657},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ3:|Hitem:258127::::::::87:1480::11::1:28:3321:::::|h[Pattern: Silvermoon Curtains]|h|r\",\"id\":\"s20_2989\",\"timestamp\":1772223664},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Gaari\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Gaari says: Thank you, again, for lending your talent to my cause.\",\"id\":\"s20_2990\",\"timestamp\":1772223665},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Solwin Brightstitch says: Thank you for trusting me with such an important task--both for you and for me.\",\"id\":\"s20_2991\",\"timestamp\":1772223670},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Gaari\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Gaari says: He was a lover of fine things. I hope seeing it finally repaired brings him peace.\",\"id\":\"s20_2992\",\"timestamp\":1772223672},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Voidwhispèr-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Voidwhispèr-Area52:4554:GUILD:|h[|cffa330c9Voidwhispèr|r]|h: 88 and a half after finishing main story\",\"id\":\"s20_2993\",\"timestamp\":1772223690},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Aradis\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Aradis says: Pure arcane... This should be simple enough.\",\"id\":\"s20_2994\",\"timestamp\":1772223697},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:239511::::::::87:1480:::::::::|h[Depleted Wardbreaker]|h|r\",\"id\":\"s20_2995\",\"timestamp\":1772223702},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Aradis\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Aradis says: Take the wardbreaker and charge it using the reservoirs around my study. I trust this task is simple enough for you to manage.\",\"id\":\"s20_2996\",\"timestamp\":1772223702},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Aradis\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Aradis says: As I was saying, the wardsmiths are led by Magister Dawnblaze. She inherited the vacant seat following the war but has proven inadequate since then.\",\"id\":\"s20_2997\",\"timestamp\":1772223702},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Aradis\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Aradis says: She does not adapt to the new challenges the sin'dorei face. That is why I proffered myself to take her seat.\",\"id\":\"s20_2998\",\"timestamp\":1772223708},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Aradis\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Aradis says: She has fabricated blackmail against me in an attempt to prevent this. You can see how this is a great injustice.\",\"id\":\"s20_2999\",\"timestamp\":1772223711},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Aradis\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Aradis says: Ugh, your form is terrible. Do not move while it is siphoning. You will warp the aetheric flow.\",\"id\":\"s20_3000\",\"timestamp\":1772223715},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Aradis\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Aradis says: Still terrible, but the wardbreaker is sufficiently charged, I suppose. Come here.\",\"id\":\"s20_3001\",\"timestamp\":1772223717},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Aradis\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Aradis says: The wardbreaker is attuned to the arcane magic guarding this conduit. Use it and the shield will break.\",\"id\":\"s20_3002\",\"timestamp\":1772223722},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Pandaren\",\"class\":\"DEATHKNIGHT\",\"name\":\"Frostyfries-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Frostyfries-Tichondrius:4581:GUILD:|h[|cffc41e3aFrostyfries|r]|h: sounds about right \",\"id\":\"s20_3003\",\"timestamp\":1772223723},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"WARLOCK\",\"name\":\"Dolphinz-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Dolphinz-Tichondrius:4582:GUILD:|h[|cff8788eeDolphinz|r]|h: i did all the side quets for silvermoon and like half of zulaman to get to 90 from that point\",\"id\":\"s20_3004\",\"timestamp\":1772223725},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Aradis\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Aradis says: Splendid. This conduit will take you to the next link in the chain. Do attempt not to fail.\",\"id\":\"s20_3005\",\"timestamp\":1772223728},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Voidwhispèr-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Voidwhispèr-Area52:4585:GUILD:|h[|cffa330c9Voidwhispèr|r]|h: good lookin out, ill have to start them up\",\"id\":\"s20_3006\",\"timestamp\":1772223740},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"MAGE\",\"name\":\"Mageyuya-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Mageyuya-Tichondrius:4586:GUILD:|h[|cff3fc7ebMageyuya|r]|h: oh shit umbric is the clone troopers from Clone Wars\",\"id\":\"s20_3007\",\"timestamp\":1772223741},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"MAGE\",\"name\":\"Mageyuya-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Mageyuya-Tichondrius:4590:GUILD:|h[|cff3fc7ebMageyuya|r]|h: i knew he sounded familiar\",\"id\":\"s20_3008\",\"timestamp\":1772223748},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Scourge\",\"class\":\"PRIEST\",\"name\":\"Idealtoheal-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Idealtoheal-Tichondrius|h[|cffffffffIdealtoheal|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-11-0E754C36:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s20_3009\",\"timestamp\":1772223758},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"WARLOCK\",\"name\":\"Dolphinz-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Dolphinz-Tichondrius:4603:GUILD:|h[|cff8788eeDolphinz|r]|h: dont do any world quests yet that give gear cause youll want that to get closer to heroic ilvl\",\"id\":\"s20_3010\",\"timestamp\":1772223761},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"PALADIN\",\"name\":\"Håvi-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Håvi-Tichondrius:4621:GUILD:|h[|cfff48cbaHåvi|r]|h: So I bought some gear off the AH that ive been wearing for a few levels now and half of it just scaled up to higher level req and I cant wear it now?? \",\"id\":\"s20_3011\",\"timestamp\":1772223831},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"ROGUE\",\"name\":\"Pedrayy-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Pedrayy-Illidan|h[|cfffff468Pedrayy-Illidan|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-57-0D6693B5:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s20_3012\",\"timestamp\":1772223863},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Aradis\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Aradis says: Ah, her protection dwindles. My magic was thwarted from reaching here, but no longer.\",\"id\":\"s20_3013\",\"timestamp\":1772223870},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Aradis\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Aradis says: All that matters is retrieving those documents. Do not fail me.\",\"id\":\"s20_3014\",\"timestamp\":1772223874},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEATHKNIGHT\",\"name\":\"Pleaseclap-WyrmrestAccord\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Pleaseclap-WyrmrestAccord:4636:GUILD:|h[|cffc41e3aPleaseclap|r]|h: get scammed\",\"id\":\"s20_3015\",\"timestamp\":1772223880},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"PALADIN\",\"name\":\"Håvi-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Håvi-Tichondrius:4637:GUILD:|h[|cfff48cbaHåvi|r]|h: apparently hahaha\",\"id\":\"s20_3016\",\"timestamp\":1772223888},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:239608::::::::87:1480:::::::::|h[Incriminating Documents]|h|r\",\"id\":\"s20_3017\",\"timestamp\":1772223888},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Dawnblaze\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Dawnblaze says: Ah, there you are. The dreadfully conspicuous thief dispelling my wards.\",\"id\":\"s20_3018\",\"timestamp\":1772223890},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Dawnblaze\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Dawnblaze says: Given the papers you hold, I presume Aradis put you up to this. Come here and I will not call the guards.\",\"id\":\"s20_3019\",\"timestamp\":1772223896},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ1:|Hitem:259992::::::::87:1480:::::::::|h[Duplicate Documents]|h|r\",\"id\":\"s20_3020\",\"timestamp\":1772223905},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Dawnblaze\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Dawnblaze says: Jaeth has done some... prior work for me. And I happen to know he might have a special interest in Aradis.\",\"id\":\"s20_3021\",\"timestamp\":1772223906},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Dawnblaze\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Dawnblaze says: Take these duplicates of the documents. Do let him know I would be willing to part with a sum of gold to see the situation remedied.\",\"id\":\"s20_3022\",\"timestamp\":1772223912},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Row Rat\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Row Rat says: I'm not a snitch!\",\"id\":\"s20_3023\",\"timestamp\":1772223945},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Row Rat\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Row Rat says: You're on the wrong side of town!\",\"id\":\"s20_3024\",\"timestamp\":1772223949},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Row Rat\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Row Rat says: I don't answer to you.\",\"id\":\"s20_3025\",\"timestamp\":1772223953},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Row Rat\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Row Rat says: Get lost.\",\"id\":\"s20_3026\",\"timestamp\":1772223956},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Row Rat\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Row Rat says: Who's asking?\",\"id\":\"s20_3027\",\"timestamp\":1772223960},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Row Rat\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Row Rat says: Who's asking?\",\"id\":\"s20_3028\",\"timestamp\":1772223966},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Row Rat\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Row Rat says: Get lost.\",\"id\":\"s20_3029\",\"timestamp\":1772223977},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Row Rat\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Row Rat says: Get lost.\",\"id\":\"s20_3030\",\"timestamp\":1772223978},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Row Rat\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Row Rat looks behind you and smirks.\",\"id\":\"s20_3031\",\"timestamp\":1772223981},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: That's enough of that. You're looking for me? Well, you've got me.\",\"id\":\"s20_3032\",\"timestamp\":1772223981},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: If you're wanting to talk, we'll talk in the bar. And don't cause any more trouble on your way in.\",\"id\":\"s20_3033\",\"timestamp\":1772223987},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: If she thinks I'd have a special interest, show me.\",\"id\":\"s20_3034\",\"timestamp\":1772223997},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Jaeth glares at the papers, then spits on the ground.\",\"id\":\"s20_3035\",\"timestamp\":1772223998},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: Didn't know his name, but I do know this warlock bastard. He's been abducting people for months. They never come back.\",\"id\":\"s20_3036\",\"timestamp\":1772224001},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: He knows he can't touch most of the city, but no one cares if elves in the Row go missing.\",\"id\":\"s20_3037\",\"timestamp\":1772224008},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: The shops we'll hit sell to the upper ranks of Silvermoon. Meaning they'll have the good stuff, and I don't give a damn if they lose gold over it.\",\"id\":\"s20_3038\",\"timestamp\":1772224018},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: We'll start here. Distract the worker over there while I sneak inside.\",\"id\":\"s20_3039\",\"timestamp\":1772224032},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Dprh-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Dprh-Tichondrius|h[|cffa330c9Dprh|r]|h has earned the achievement |cffffff00|Hachievement:61641:Player-11-0EA1AF2F:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[The Blinding Vale]|h|r!\",\"id\":\"s20_3040\",\"timestamp\":1772224044},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:241205::::::::87:1480:::::::::|h[Thrumming Amulet]|h|r\",\"id\":\"s20_3041\",\"timestamp\":1772224046},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_WHISPER\",\"type\":\"MONSTER_WHISPER\"},\"color\":{\"b\":0.9215686917304993,\"g\":0.7098039388656616,\"r\":1},\"text\":\"Jaeth whispers: Found a magical necklace that should work. Let's get out of here.\",\"id\":\"s20_3042\",\"timestamp\":1772224046},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lendranil\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lendranil says: ...and you mentioned spell penetration? I'll have to bring in a specialist for that one. Come back in a few days.\",\"id\":\"s20_3043\",\"timestamp\":1772224050},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: Over here. Same deal as before: you talk their ears off while I get inside.\",\"id\":\"s20_3044\",\"timestamp\":1772224060},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"PALADIN\",\"name\":\"Lasadin-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Lasadin-Tichondrius|h[|cfff48cbaLasadin|r]|h has earned the achievement |cffffff00|Hachievement:61836:Player-11-0E872977:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Delves: Tier 3]|h|r!\",\"id\":\"s20_3045\",\"timestamp\":1772224063},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: Damn it...\",\"id\":\"s20_3046\",\"timestamp\":1772224074},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:241208::::::::87:1480:::::::::|h[Basket of Spell Reagents]|h|r\",\"id\":\"s20_3047\",\"timestamp\":1772224092},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_WHISPER\",\"type\":\"MONSTER_WHISPER\"},\"color\":{\"b\":0.9215686917304993,\"g\":0.7098039388656616,\"r\":1},\"text\":\"Jaeth whispers: Lots of magic in these reagents. Let's go. One more mark to hit.\",\"id\":\"s20_3048\",\"timestamp\":1772224093},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothene\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lothene says: ...so with the spider legs, viscous fluid, and random pebbles included, this would be your itemized list. Pleasure doing business with you.\",\"id\":\"s20_3049\",\"timestamp\":1772224096},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: Our last target. Lot more eyes on this one, but I can get around them. Distract the worker for me again.\",\"id\":\"s20_3050\",\"timestamp\":1772224108},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"MAGE\",\"name\":\"Fireysquirts-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Fireysquirts-Tichondrius|h[|cff3fc7ebFireysquirts|r]|h has earned the achievement |cffffff00|Hachievement:6883:Player-11-0E013D50:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Silvershard Mines Veteran]|h|r!\",\"id\":\"s20_3051\",\"timestamp\":1772224117},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:241207::::::::87:1480:::::::::|h[Arcane Sword]|h|r\",\"id\":\"s20_3052\",\"timestamp\":1772224124},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_WHISPER\",\"type\":\"MONSTER_WHISPER\"},\"color\":{\"b\":0.9215686917304993,\"g\":0.7098039388656616,\"r\":1},\"text\":\"Jaeth whispers: This sword looks like it has some juice in it. Let's get back to the Row.\",\"id\":\"s20_3053\",\"timestamp\":1772224124},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Belil\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Belil says: ...and now a lot of people think slate and shale are the same, but slate is actually--wait, where are you going?\",\"id\":\"s20_3054\",\"timestamp\":1772224128},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zanien\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zanien says: A functional wardbreaker, you say? Those are worth quite the coin.\",\"id\":\"s20_3055\",\"timestamp\":1772224136},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: Killing this warlock is worth more. We just need the thing attuned to break his wards.\",\"id\":\"s20_3056\",\"timestamp\":1772224141},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zanien\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zanien says: Place the wardbreaker on the altar. I will draw the magic out of these items to reattune it.\",\"id\":\"s20_3057\",\"timestamp\":1772224145},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zanien\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zanien says: Fel is a tool that offers great and dangerous power. The sin'dorei understand this well.\",\"id\":\"s20_3058\",\"timestamp\":1772224147},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zanien\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zanien says: But tools must be wielded carefully. We can neither grasp it weakly nor allow it to wield us in turn.\",\"id\":\"s20_3059\",\"timestamp\":1772224150},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zanien\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zanien says: All warlocks must walk that line between cowardice and temptation.\",\"id\":\"s20_3060\",\"timestamp\":1772224153},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Evohsx-Stormrage\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Evohsx-Stormrage|h[|cffff7c0aEvohsx-Stormrage|r]|h has earned the achievement |cffffff00|Hachievement:61734:Player-60-0F286FF8:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Delves: Endgame]|h|r!\",\"id\":\"s20_3061\",\"timestamp\":1772224156},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Evohsx-Stormrage\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Evohsx-Stormrage|h[|cffff7c0aEvohsx-Stormrage|r]|h has earned the achievement |cffffff00|Hachievement:42328:Player-60-0F286FF8:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[One Warband Mentor: Midnight]|h|r!\",\"id\":\"s20_3062\",\"timestamp\":1772224156},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zanien\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zanien says: If Aradis has bent to one side like a weakling, he deserves his pathetic end.\",\"id\":\"s20_3063\",\"timestamp\":1772224156},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:242253::::::::87:1480:::::::::|h[Recharged Wardbreaker]|h|r\",\"id\":\"s20_3064\",\"timestamp\":1772224158},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zanien\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zanien says: I will take great joy in hearing an \\\"interesting\\\" story about Aradis tomorrow.\",\"id\":\"s20_3065\",\"timestamp\":1772224161},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: I'll tell you all about it. Come on, Starphage. We have a throat to cut.\",\"id\":\"s20_3066\",\"timestamp\":1772224166},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: No sign of Aradis yet, but I hear something past this ward. Be on your guard.\",\"id\":\"s20_3067\",\"timestamp\":1772224178},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: Let's make him regret giving you that staff.\",\"id\":\"s20_3068\",\"timestamp\":1772224180},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: Come on! No time to waste.\",\"id\":\"s20_3069\",\"timestamp\":1772224188},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"MAGE\",\"name\":\"Mageyuya-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Mageyuya-Tichondrius:4848:GUILD:|h[|cff3fc7ebMageyuya|r]|h: |cnIQ3:|Hitem:251782::::::::86:64::11:2:6652:13613:2:28:4283:9:86:::::|h[Withered Saptor's Paw]|h|r can i stop getting the most useless mage items off of these elites\",\"id\":\"s20_3070\",\"timestamp\":1772224196},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: What is this...\",\"id\":\"s20_3071\",\"timestamp\":1772224196},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: Damn it! Get everyone free from those crystals. I'll just--Sarvi, wake up!\",\"id\":\"s20_3072\",\"timestamp\":1772224200},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Row Prisoner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Row Prisoner says: I thought I was going to die...\",\"id\":\"s20_3073\",\"timestamp\":1772224204},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Row Prisoner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Row Prisoner says: He said... he'd get me out of the Row...\",\"id\":\"s20_3074\",\"timestamp\":1772224209},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Row Prisoner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Row Prisoner says: I... I think I can walk.\",\"id\":\"s20_3075\",\"timestamp\":1772224215},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Row Prisoner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Row Prisoner says: He offered me an apprenticeship...\",\"id\":\"s20_3076\",\"timestamp\":1772224221},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Row Prisoner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Row Prisoner says: So... hungry...\",\"id\":\"s20_3077\",\"timestamp\":1772224229},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Aradis\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Aradis says: We meet again, Starphage. And with a new rat to replace the ones you released. How thoughtful.\",\"id\":\"s20_3078\",\"timestamp\":1772224233},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Aradis\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Aradis says: Rats belong in cages!\",\"id\":\"s20_3079\",\"timestamp\":1772224235},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: I'll gut you a second time, bastard!\",\"id\":\"s20_3080\",\"timestamp\":1772224239},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Aradis\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Aradis says: I... deserved... better...\",\"id\":\"s20_3081\",\"timestamp\":1772224284},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: Nngh--I wish I got the kill... But at least he's dead.\",\"id\":\"s20_3082\",\"timestamp\":1772224285},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 2 Gold, 65 Silver, 71 Copper\",\"id\":\"s20_3083\",\"timestamp\":1772224286},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: I need to check on the others. Meet me upstairs after you take whatever you want from his corpse.\",\"id\":\"s20_3084\",\"timestamp\":1772224290},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:263362::::::::87:1480::11:2:13573:6652:2:9:87:28:3321:::::|h[Row Rat's Trousers]|h|r\",\"id\":\"s20_3085\",\"timestamp\":1772224296},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Row Prisoner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Row Prisoner says: Is the Magister dead?\",\"id\":\"s20_3086\",\"timestamp\":1772224299},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: Yeah. He's dead. He won't be taking anyone else.\",\"id\":\"s20_3087\",\"timestamp\":1772224303},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Dawnblaze\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Dawnblaze says: What a pleasure to see you, Jaeth. Care for a glass?\",\"id\":\"s20_3088\",\"timestamp\":1772224319},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Dawnblaze\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Dawnblaze says: Truly an unfortunate turn of events for Aradis.\",\"id\":\"s20_3089\",\"timestamp\":1772224322},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Dawnblaze\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Dawnblaze says: I am pleased this little situation could be resolved happily.\",\"id\":\"s20_3090\",\"timestamp\":1772224325},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: Sorry, I only drink five century vintages.\",\"id\":\"s20_3091\",\"timestamp\":1772224329},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: You think this is happy? One of my friends died over this.\",\"id\":\"s20_3092\",\"timestamp\":1772224333},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Climatechang-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Climatechang-Tichondrius|h[|cffff7c0aClimatechang|r]|h has earned the achievement |cffffff00|Hachievement:61734:Player-11-0E90740E:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Delves: Endgame]|h|r!\",\"id\":\"s20_3093\",\"timestamp\":1772224337},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Climatechang-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Climatechang-Tichondrius|h[|cffff7c0aClimatechang|r]|h has earned the achievement |cffffff00|Hachievement:42328:Player-11-0E90740E:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[One Warband Mentor: Midnight]|h|r!\",\"id\":\"s20_3094\",\"timestamp\":1772224337},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Grand Magister Rommath says: Silvermoon thrives through fresh talent. Recruit any who seem capable.\",\"id\":\"s20_3095\",\"timestamp\":1772224357},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ1:|Hitem:250440::::::::87:1480:::::::::|h[Recruitment Fliers]|h|r\",\"id\":\"s20_3096\",\"timestamp\":1772224365},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Grand Magister Rommath says: Our training grounds are riddled with pests! Your... years of experience should allow you to swiftly handle this matter.\",\"id\":\"s20_3097\",\"timestamp\":1772224366},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Tytalor Goldenblade\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Tytalor Goldenblade says: You there! Yes you!\",\"id\":\"s20_3098\",\"timestamp\":1772224368},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Prospective Student\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Prospective Student says: Wow! I think I want to join the Magisters!\",\"id\":\"s20_3099\",\"timestamp\":1772224388},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Prospective Student\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Prospective Student says: With today's tuition prices? No thank you!\",\"id\":\"s20_3100\",\"timestamp\":1772224395},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Prospective Student\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Prospective Student says: I'm off to join the Farstriders!\",\"id\":\"s20_3101\",\"timestamp\":1772224401},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Prospective Student\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Prospective Student says: With today's tuition prices? No thank you!\",\"id\":\"s20_3102\",\"timestamp\":1772224412},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ4:|Hitem:251786::::::::87:1480::133:1:13573:2:9:87:28:3321:::::|h[Ever-Collapsing Void Fissure]|h|r\",\"id\":\"s20_3103\",\"timestamp\":1772224413},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Grand Magister Rommath says: Every recruit sown today will blossom into Silvermoon's strength tomorrow.\",\"id\":\"s20_3104\",\"timestamp\":1772224413},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx30\",\"id\":\"s20_3105\",\"timestamp\":1772224414},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kyltus Bloodburn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Kyltus Bloodburn says: Hmm, what to choose...\",\"id\":\"s20_3106\",\"timestamp\":1772224443},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"MagharOrc\",\"class\":\"SHAMAN\",\"name\":\"Valkray-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Valkray-Tichondrius|h[|cff0070ddValkray|r]|h has earned the achievement |cffffff00|Hachievement:62191:Player-11-0E47C2F6:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Call of the Light]|h|r!\",\"id\":\"s20_3107\",\"timestamp\":1772224461},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Knight Anais\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Knight Anais says: We need a search party! I won't lose him.\",\"id\":\"s20_3108\",\"timestamp\":1772224504},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Knight Anais\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Knight Anais says: The trench outside the Voidspire--that's where we start.\",\"id\":\"s20_3109\",\"timestamp\":1772224510},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Void Researcher Anomander\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Void Researcher Anomander says: This technology is unlike anything we have ever seen! The domanaar are so far beyond us in terms of their understanding of the Void...\",\"id\":\"s20_3110\",\"timestamp\":1772224514},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx500\",\"id\":\"s20_3111\",\"timestamp\":1772224518},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ4:|Hcurrency:3400:0|h[Uncontaminated Void Sample]|h|rx1\",\"id\":\"s20_3112\",\"timestamp\":1772224519},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Void Researcher Anomander\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Void Researcher Anomander says: Be careful, Starphage!\",\"id\":\"s20_3113\",\"timestamp\":1772224522},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Void Researcher Anomander\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Void Researcher Anomander says: Did you feel that? Like a subtle pulse of... hunger.\",\"id\":\"s20_3114\",\"timestamp\":1772224534},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Void Researcher Anomander\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Void Researcher Anomander says: Keep an eye out for more uncontaminated samples as you explore these lands. There is much we can learn here.\",\"id\":\"s20_3115\",\"timestamp\":1772224538},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Baa'lial\"},\"event\":\"CHAT_MSG_MONSTER_WHISPER\",\"type\":\"MONSTER_WHISPER\"},\"color\":{\"b\":0.9215686917304993,\"g\":0.7098039388656616,\"r\":1},\"text\":\"Baa'lial whispers: Give in to your hatred.\",\"id\":\"s20_3116\",\"timestamp\":1772224626},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ3:|Hitem:267607::::::::87:1480::25:2:13578:13649:1:28:3084:::::|h[Hazy Penumbral Handwraps]|h|r\",\"id\":\"s20_3117\",\"timestamp\":1772224635},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You are refunded: |cnIQ1:|Hcurrency:3316:25|h[Voidlight Marl]|h|rx25.\",\"id\":\"s20_3118\",\"timestamp\":1772224639},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo