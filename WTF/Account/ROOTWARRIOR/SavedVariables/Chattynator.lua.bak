R\",\"name\":\"Sotens-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Sotens-Illidan|h[|cffc69b6dSotens-Illidan|r]|h has earned the achievement |cffffff00|Hachievement:5802:Player-57-0DBAE571:1:3:31:26:4294967295:4294967295:4294967295:4294967295|h[Firelands]|h|r!\",\"id\":\"s38_4920\",\"timestamp\":1774978279},{\"recordedBy\":\"Neonvoid-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Tenwu of the Red Smoke\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Tenwu of the Red Smoke says: You seek to challenge the infamous Tenwu of the Red Smoke? Come friend, let us see what you have got!\",\"id\":\"s38_4921\",\"timestamp\":1774978281},{\"recordedBy\":\"Neonvoid-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hawkmaster Nurong\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hawkmaster Nurong says: Don't hold back.\",\"id\":\"s38_4922\",\"timestamp\":1774978289},{\"recordedBy\":\"Neonvoid-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hawkmaster Nurong\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Hawkmaster Nurong yells: You give a good fight!  Don't stop now.\",\"id\":\"s38_4923\",\"timestamp\":1774978293},{\"recordedBy\":\"Neonvoid-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hawkmaster Nurong\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hawkmaster Nurong says: You... have... bested me...\",\"id\":\"s38_4924\",\"timestamp\":1774978293},{\"recordedBy\":\"Neonvoid-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hawkmaster Nurong\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hawkmaster Nurong says: My compliments, friend.  I can't remember the last time someone bested me so handily.\",\"id\":\"s38_4925\",\"timestamp\":1774978299},{\"recordedBy\":\"Neonvoid-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hawkmaster Nurong\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hawkmaster Nurong says: You are impressive indeed.  It would be my honor to fight beside you.\",\"id\":\"s38_4926\",\"timestamp\":1774978306},{\"recordedBy\":\"Neonvoid-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"WARLOCK\",\"name\":\"Ppoonlock-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Ppoonlock-Tichondrius|h[|cff8788eePpoonlock|r]|h has earned the achievement |cffffff00|Hachievement:61222:Player-11-0E2D423B:1:3:31:26:4294967295:4294967295:4294967295:4294967295|h[Tour of Duty: Zul'Aman]|h|r!\",\"id\":\"s38_4927\",\"timestamp\":1774978318},{\"recordedBy\":\"Neonvoid-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Tenwu of the Red Smoke\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Tenwu of the Red Smoke says: Do not worry, I will go easy on you.\",\"id\":\"s38_4928\",\"timestamp\":1774978323},{\"recordedBy\":\"Neonvoid-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Tenwu of the Red Smoke\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Tenwu of the Red Smoke yells: Not bad, not bad... but we are not done yet!\",\"id\":\"s38_4929\",\"timestamp\":1774978328},{\"recordedBy\":\"Neonvoid-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Tenwu of the Red Smoke\"},\"event\":\"CHAT_M