["text"] = "|Hplayer:Havorn-MoonGuard|h[|cfff48cbaHavorn-MoonGuard|r]|h has earned the achievement |cffffff00|Hachievement:7057:Player-3675-0AB4FF14:1:3:14:26:4294967295:4294967295:4294967295:4294967295|h[End of the Line]|h|r!",
