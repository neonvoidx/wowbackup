},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Ethereal Warpweaver says: Your attire seems adequate. How may I assist you?",
["timestamp"] = 1785330869,
["id"] = "s52_2562",
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "High Exarch Turalyon",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "High Exarch Turalyon says: We can't spare the troops! Those ethereal cannons have us pinned down.",
["id"] = "s52_2563",
["timestamp"] = 1785331110,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["event"] = "CHAT_MSG_CURRENCY",
["type"] = "CURRENCY",
},
["color"] = {
["b"] = -0,
["g"] = 0.6666666865348816,
["r"] = -0,
},
["text"] = "You receive currency: |cnIQ1:|T7137586:12|t|Hcurrency:3316:0|h[Voidlight Marl]|h|rx5",
["id"] = "s52_2564",
["timestamp"] = 1785331114,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "High Exarch Turalyon",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "High Exarch Turalyon says: We're being hit from all sides! We need a tactical assessment. Umbric! Neonvoid can assist you.",
["id"] = "s52_2565",
["timestamp"] = 1785331118,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Magister Umbric",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Magister Umbric says: With this device, you'll be able to view the tactical situation in relative safety.",
["id"] = "s52_2566",
["timestamp"] = 1785331121,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["event"] = "CHAT_MSG_CURRENCY",
["type"] = "CURRENCY",
},
["color"] = {
["b"] = -0,
["g"] = 0.6666666865348816,
["r"] = -0,
},
["text"] = "You receive currency: |cnIQ1:|T7137586:12|t|Hcurrency:3316:0|h[Voidlight Marl]|h|rx10",
["id"] = "s52_2567",
["timestamp"] = 1785331176,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Magister Umbric",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Magister Umbric says: The captured ren'dorei are links in a chain. Break that chain, and our assault can truly begin.",
["id"] = "s52_2568",
["timestamp"] = 1785331177,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "High Exarch Turalyon",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "High Exarch Turalyon says: You're right, Umbric. Freeing your people gives us the opening we need for an assault.",
["id"] = "s52_2569",
["timestamp"] = 1785331186,
},
