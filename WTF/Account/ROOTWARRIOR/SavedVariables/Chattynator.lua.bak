},
["text"] = "Noir-Spirestone receives loot: |cnIQ1:|T134002:12|t|Hitem:172054::::::::81:66:::::::::|h[Raw Seraphic Wing]|h|rx2.",
["timestamp"] = 1784592596,
["id"] = "s51_2830",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Devos",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Devos says: For eons, we have been told to \"purify\" ourselves. To let go of our memories, our identities, our loved ones. All in the name of service.",
["timestamp"] = 1784592602,
["id"] = "s51_2831",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Devos",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Devos says: But what do we serve? An impotent Arbiter, an oppressive law! Our sacrifices were made for nothing!",
["timestamp"] = 1784592616,
["id"] = "s51_2832",
},
{
