},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Mueh'zala yells: Dese little friends o' yours think dey gonna help ya, Bwonsamdi? What chance ya be havin' against me?",
