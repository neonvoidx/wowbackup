\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: Let's try the last location.\",\"timestamp\":1772154996,\"id\":\"s18_4378\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Orc\",\"name\":\"Bombadilo-Gilneas\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Bombadilo-Gilneas|h[|cff00ff98Bombadilo-Gilneas|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-67-0A795585:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"timestamp\":1772155001,\"id\":\"s18_4379\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: Kasiea... what were you doing?\",\"timestamp\":1772155031,\"id\":\"s18_4380\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260689::::::::81:1480:::::::::|h[Fine Bioluminescent Powder]|h|r\",\"timestamp\":1772155049,\"id\":\"s18_4381\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260642::::::::81:1480:::::::::|h[Fossilized Wildlife]|h|r\",\"timestamp\":1772155049,\"id\":\"s18_4382\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: That's our last sample. What was the purpose of all of this?\",\"timestamp\":1772155049,\"id\":\"s18_4383\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: Let's take these back to my study.\",\"timestamp\":1772155056,\"id\":\"s18_4384\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: Too many people are dodging questions... There may be something darker going on here.\",\"timestamp\":1772155060,\"id\":\"s18_4385\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:251883::::::::81:1480::11:2:13573:6652:2:9:81:28:3085:::::|h[Umbric's Channeling Focus]|h|r\",\"timestamp\":1772155061,\"id\":\"s18_4386\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: Lord Antenorian values nothing more than the safety of his people. He'll want to know about this.\",\"timestamp\":1772155064,\"id\":\"s18_4387\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Secretary Faloria\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Secretary Faloria says: What are you--what brings you here?\",\"timestamp\":1772155072,\"id\":\"s18_4388\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Secretary Faloria\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Secretary Faloria says: Lord Antenorian is away. I can help you.\",\"timestamp\":1772155081,\"id\":\"s18_4389\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lord Antenorian\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lord Antenorian says: Magister Umbric! How goes your research?\",\"timestamp\":1772155084,\"id\":\"s18_4390\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_WHISPER\",\"type\":\"MONSTER_WHISPER\"},\"color\":{\"r\":1,\"g\":0.7098039388656616,\"b\":0.9215686917304993},\"text\":\"Arator whispers: This isn't right. See what's in that lockbox she was toying with.\",\"timestamp\":1772155084,\"id\":\"s18_4391\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: Go on, Starphage. Tell him.\",\"timestamp\":1772155088,\"id\":\"s18_4392\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lord Antenorian\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lord Antenorian says: A cult? That is a most serious accusation.\",\"timestamp\":1772155100,\"id\":\"s18_4393\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:244783::::::::81:1480::11::1:28:3085:::::|h[Majestic Lightwood Table]|h|r\",\"timestamp\":1772155102,\"id\":\"s18_4394\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lord Antenorian\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lord Antenorian says: I cannot thank you three enough for taking the town's safety seriously.\",\"timestamp\":1772155104,\"id\":\"s18_4395\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lord Antenorian\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lord Antenorian says: I shall have it looked into. But I'm glad you're here--I need your assistance with something.\",\"timestamp\":1772155108,\"id\":\"s18_4396\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Moonslasher-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Moonslasher-Tichondrius|h[|cffff7c0aMoonslasher|r]|h has earned the achievement |cffffff00|Hachievement:41802:Player-11-0DCBF9A7:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Eversong In Reprise]|h|r!\",\"timestamp\":1772155108,\"id\":\"s18_4397\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lord Antenorian\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lord Antenorian says: I shall look into your investigation. We'll compare notes later.\",\"timestamp\":1772155109,\"id\":\"s18_4398\"},{\"rec