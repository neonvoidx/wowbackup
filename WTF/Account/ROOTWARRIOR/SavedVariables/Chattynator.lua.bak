["g"] = 0.4705882668495178,
["b"] = 0.03921568766236305,
},
["text"] = "The battle begins in 30 seconds!",
["timestamp"] = 1773537122,
["id"] = "s27_3562",
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Master Mathias Shaw",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Master Mathias Shaw says: Champions, Azerite deposits have been located on an island off the coast of Feralas. We must secure them before the Horde does.",
["timestamp"] = 1773537123,
["id"] = "s27_3563",
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
