},
["color"] = {
["b"] = 1,
["g"] = 0.6666666865348816,
["r"] = 0.6666666865348816,
},
["text"] = "|Hplayer:Smileclap|h[Smileclap]: |h|A:ping_chat_threat:0:0:0:0|aThreatening alert: Volatile Totem",
["id"] = "s28_2802",
["timestamp"] = 1773629533,
},
{
["recordedBy"] = "Starphage-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Loa Speaker Nanea",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Loa Speaker Nanea says: Well done, Amani cub. You have... passed de trial. Take de Burden of Nalorakk.",
["id"] = "s28_2803",
["timestamp"] = 1773629566,
},
{
["recordedBy"] = "Starphage-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Nalorakk",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Nalorakk says: She has died honorably. But the death of those loyal to me... that is my burden. It will be yours as hash'ey.",
["id"] = "s28_2804",
["timestamp"] = 1773629581,
},
