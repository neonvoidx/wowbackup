["text"] = "|Hchannel:GUILD|h[Guild]|h |Hplayer:Imlendil-Tichondrius:527:GUILD:|h[|cfff48cbaImlendil|r]|h: anyone 2.3+ plus to farm glad wins I am a hpally",
