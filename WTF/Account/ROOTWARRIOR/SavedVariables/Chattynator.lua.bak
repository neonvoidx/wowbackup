["g"] = 0.6666666865348816,
["r"] = -0,
},
["text"] = "You receive loot: |cnIQ1:|T1500877:12|t|Hitem:262752::::::::90:258:::::::::|h[Vilebranch Scroll]|h|r",
["id"] = "s51_4361",
["timestamp"] = 1785260867,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zul'jan",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zul'jan says: I have lived my entire life without dem. Why should I?",
["id"] = "s51_4362",
["timestamp"] = 1785260869,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Enchanted Amani Mask",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Enchanted Amani Mask says: True. Dey were here for generations, yet our empire has crumbled.",
["id"] = "s51_4363",
["timestamp"] = 1785260875,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Hex Master Soye'mal",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Hex Master Soye'mal says: De loa have failed us for generations!",
["id"] = "s51_4364",
["timestamp"] = 1785260877,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Hex Master Soye'mal",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Hex Master Soye'mal says: We will never... serve de loa...",
["id"] = "s51_4365",
["timestamp"] = 1785260892,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
