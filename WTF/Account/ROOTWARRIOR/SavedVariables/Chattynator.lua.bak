["g"] = 0.6666666865348816,
["r"] = -0,
},
["text"] = "You receive item: |cnIQ4:|T348526:12|t|Hitem:263467::::::::90:269::11::2:9:90:28:3321:::::|h[Avid Learner's Supply Pack]|h|r",
["id"] = "s47_3001",
["timestamp"] = 1776880417,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zur'ashar Kassameh",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zur'ashar Kassameh says: May Russula's Outreach remind us to temper our claws. Harandar endures longest when mercy guides the hunt.",
["id"] = "s47_3002",
["timestamp"] = 1776880417,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
