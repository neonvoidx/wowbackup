},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Imperator Averzian yells: The Void consumes all!",
["id"] = "s46_3054",
["timestamp"] = 1776307543,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Magister Umbric",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Magister Umbric says: We must make haste. Xal'atath is using Alleria's rage and pain to erode her mastery over the Void.",
["id"] = "s46_3055",
["timestamp"] = 1776307545,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Magister Umbric",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Magister Umbric says: After what happened with Turalyon and Arator... I can see how Alleria would struggle to maintain control. I doubt I'd be able to, if it were me.",
["id"] = "s46_3056",
["timestamp"] = 1776307555,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Arator",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Arator yells: Mother!",
["id"] = "s46_3057",
["timestamp"] = 1776307566,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
