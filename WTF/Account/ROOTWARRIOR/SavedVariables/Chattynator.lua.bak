},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["class"] = "DEATHKNIGHT",
["race"] = "BloodElf",
["name"] = "Salastar",
["sex"] = 2,
},
["event"] = "CHAT_MSG_GUILD_ACHIEVEMENT",
["type"] = "GUILD_ACHIEVEMENT",
},
["color"] = {
["r"] = 0.250980406999588,
["g"] = 1,
["b"] = 0.250980406999588,
},
["text"] = "|Hplayer:Salastar-Tichondrius|h[|cffc41e3aSalastar|r]|h has earned the achievement |cffffff00|Hachievement:62262:Player-11-0E0798C4:1:7:28:26:4294967295:4294967295:4294967295:4294967295|h[Silvermoon Court Champion]|h|r!",
["timestamp"] = 1785290823,
["id"] = "s52_2544",
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Lor'themar Theron",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Lor'themar Theron says: I have received word from Magister Umbric. The way to the Voidstorm is clear!",
["timestamp"] = 1785290828,
["id"] = "s52_2545",
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Lor'themar Theron",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Lor'themar Theron says: I sent Lady Liadrin to inform the Vanguard's commanders that they may deploy at once, and leave our city in peace.",
["timestamp"] = 1785290834,
["id"] = "s52_2546",
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Lady Liadrin",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Lady Liadrin says: Your redeployment leaves a scant few behind to empower the Sunwell!",
["id"] = "s52_2547",
["timestamp"] = 1785329139,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Lady Liadrin",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Lady Liadrin says: Would you check in with the Vanguard commanders for me, Neonvoid? I must explain to the general why the Sunwell must not fall.",
["id"] = "s52_2548",
["timestamp"] = 1785329142,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Commander Venel Lightblood",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Commander Venel Lightblood says: Prepare yourself, priest.",
["id"] = "s52_2549",
["timestamp"] = 1785329147,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "General Amias Bellamy",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "General Amias Bellamy says: You think too provincially. We need the full might of the Vanguard to defeat Xal'atath.",
["id"] = "s52_2550",
["timestamp"] = 1785329151,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Commander Venel Lightblood",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Commander Venel Lightblood says: My soldiers are too accustomed to sparring with the Light. They need to learn the tricks of other martial traditions.",
["id"] = "s52_2551",
["timestamp"] = 1785329171,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "War Chaplain Senn",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "War Chaplain Senn says: You are a beacon in the darkness. We will succeed, no matter the cost.",
["id"] = "s52_2552",
["timestamp"] = 1785329176,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Commander Koruth Mountainfist",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Commander Koruth Mountainfist says: Get those modifications fitted or we'll suffocate! The air on the other side is thicker than me gran's lamb stew.",
["id"] = "s52_2553",
["timestamp"] = 1785329186,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Commander Koruth Mountainfist",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Commander Koruth Mountainfist says: My gran taught me to fight the good fight, even if it seems hopeless, and to put me faith in the Light.",
["timestamp"] = 1785329209,
["id"] = "s52_2554",
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Commander Koruth Mountainfist",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Commander Koruth Mountainfist says: Though, two tons of Light-blessed steel warframe bolsters my courage.",
["timestamp"] = 1785329217,
["id"] = "s52_2555",
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["event"] = "CHAT_MSG_CURRENCY",
["type"] = "CURRENCY",
},
["color"] = {
["r"] = -0,
["g"] = 0.6666666865348816,
["b"] = -0,
},
["text"] = "You receive currency: |cnIQ1:|T7137586:12|t|Hcurrency:3316:0|h[Voidlight Marl]|h|rx5",
["timestamp"] = 1785329222,
["id"] = "s52_2556",
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "General Amias Bellamy",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "General Amias Bellamy says: We have left you a token force to hold back the Voidstorm. Light willing, it will suffice.",
["timestamp"] = 1785329224,
["id"] = "s52_2557",
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Lady Liadrin",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Lady Liadrin says: We both claim the Light as our guide, but yours is a sterile, cold faith I scarcely recognize.",
["timestamp"] = 1785329232,
["id"] = "s52_2558",
},
