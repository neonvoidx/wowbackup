\":\"Scout Watu\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Scout Watu says: I'm not little--I'll heal just fine, Olekk! Let me walk it off.\",\"id\":\"s18_3101\",\"timestamp\":1770235521},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Sentinel Olekk\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Sentinel Olekk says: Walk? You can barely stand. Be still.\",\"id\":\"s18_3102\",\"timestamp\":1770235524},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Scout Tomul\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Scout Tomul says: There are tracks nearby. Follow them. See if they lead to our quarry.\",\"id\":\"s18_3103\",\"timestamp\":1770235532},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Scout Tomul\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Scout Tomul says: Quickly, kill these creatures so that we may harvest their bounty.\",\"id\":\"s18_3104\",\"timestamp\":1770235541},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Wrathion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Wrathion says: As a good friend, and the loyal supporter I know you are.  I call upon your help at this time.\",\"id\":\"s18_3105\",\"timestamp\":1770235635},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Sabellian\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Sabellian says: I believe our goals to be aligned, friend. I would be honored to have your continued support in our efforts to secure the citadel.\",\"id\":\"s18_3106\",\"timestamp\":1770235646},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kajiki\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Kajiki says: My, what fancy spectacles you're wearing. Someone with your sense of style must surely have similar tastes in spirits. Come, share a drink or three with me.\",\"id\":\"s18_3107\",\"timestamp\":1770235964},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ2:|Hitem:202061::::::::80:1480::::1:28:2424:::::|h[Empty Fish Barrel]|h|r\",\"id\":\"s18_3108\",\"timestamp\":1770236293},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Wrathion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Wrathion says: As a good friend, and the loyal supporter I know you are.  I call upon your help at this time.\",\"id\":\"s18_3109\",\"timestamp\":1770236360},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Sabellian\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Sabellian says: I believe our goals to be aligned, friend. I would be honored to have your continued support in our efforts to secure the citadel.\",\"id\":\"s18_3110\",\"timestamp\":1770236371},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Adventurer Mithalder\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Adventurer Mithalder says: Yeah? What do y