["id"] = "s27_3076",
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Void Researcher Anomander",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Void Researcher Anomander says: This technology is unlike anything we have ever seen! The domanaar are so far beyond us in terms of their understanding of the Void...",
["timestamp"] = 1773508963,
["id"] = "s27_3077",
},
