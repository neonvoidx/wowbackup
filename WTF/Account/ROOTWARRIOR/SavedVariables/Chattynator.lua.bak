\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Trainee Solanin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Trainee Solanin says: It sounded as if someone felled a tree. The Farstriders left to investigate.\",\"timestamp\":1772156617,\"id\":\"s18_4628\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:242640::::::::81:1480:::::::::|h[Plant Protein]|h|rx2\",\"timestamp\":1772156643,\"id\":\"s18_4629\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260664::::::::81:1480:::::::::|h[Bioluminescent Flower Petals]|h|r\",\"timestamp\":1772156643,\"id\":\"s18_4630\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 1 Gold, 57 Silver, 20 Copper\",\"timestamp\":1772156657,\"id\":\"s18_4631\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lor'themar Theron says: So the crash caused the Lightbloom to surge... Thank you. Rest easy, and leave this to us.\",\"timestamp\":1772156665,\"id\":\"s18_4632\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:248057::::::::81:1480::11:2:13573:6652:2:9:81:28:3085:::::|h[Bloomtrimmer's Wrap]|h|r\",\"timestamp\":1772156674,\"id\":\"s18_4633\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lady Liadrin says: The Farstriders left to investigate that noise. Suncrown had no defenders.\",\"timestamp\":1772156674,\"id\":\"s18_4634\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lady Liadrin says: I'll finish up here with the survivors.\",\"timestamp\":1772156683,\"id\":\"s18_4635\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lor'themar Theron says: Thank you, Liadrin. I hope Halduron can tell us what's going on.\",\"timestamp\":1772156685,\"id\":\"s18_4636\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"MAGE\",\"race\":\"Dwarf\",\"name\":\"Mookiemagi-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Mookiemagi-Tichondrius|h[|cff3fc7ebMookiemagi|r]|h has earned the achievement |cffffff00|Hachievement:40599:Player-11-0E5B9C4D:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[The Dawnbreaker]|h|r!\",\"timestamp\":1772156693,\"id\":\"s18_4637\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ranger Captain Lilatha\"},\"event\":\"CHAT_MS