\",\"typeInfo\":{\"event\":\"CHAT_MSG_BG_SYSTEM_NEUTRAL\",\"type\":\"BG_NEUTRAL\"},\"color\":{\"b\":0.03921568766236305,\"g\":0.4705882668495178,\"r\":1},\"text\":\"The battle begins in 30 seconds!\",\"id\":\"s45_3588\",\"timestamp\":1776193384},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Master Mathias Shaw\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Master Mathias Shaw says: Champions, Azerite deposits have been located on an island off the coast of Feralas. We must secure them before the Horde does.\",\"id\":\"s45_3589\",\"timestamp\":1776193385},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Master Mathias Shaw\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Master Mathias Shaw says: We've brought our ship around to the center of the island. Collect as much Azerite as you can. It is the key to victory!\",\"id\":\"s45_3590\",\"timestamp\":1776193394},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"PRIEST\",\"name\":\"Covalskisiño-Ragnaros\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"¡|Hplayer:Covalskisiño-Ragnaros|h[|cffffffffCovalskisiño-Ragnaros|r]|h ha ganado el logro |cffffff00|Hachievement:61519:Player-1427-0E6ACF81:1:4:14:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Season 1: Catalyst Unbound]|h|r!\",\"id\":\"s45_3591\",\"timestamp\":1776193400},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Master Mathias Shaw\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Master Mathias Shaw says: There's a rich Azerite deposit below us, heroes. G