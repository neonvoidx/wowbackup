},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.501960813999176,
["r"] = 1,
},
["text"] = "Alleria Windrunner grimaces in pain.",
["id"] = "s46_3061",
["timestamp"] = 1776307584,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Arator",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Arator yells: What are you doing to her?!",
["id"] = "s46_3062",
["timestamp"] = 1776307585,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Xal'atath",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Xal'atath yells: Keeping my promise, of course. Taking everything she loves. Leaving her with nothing but the Void.",
["id"] = "s46_3063",
["timestamp"] = 1776307586,
},
