59\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ban-Lu\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Ban-Lu says: Where are we going today, Grandmaster?\",\"timestamp\":1776223768,\"id\":\"s45_4160\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Abíde-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Abíde-Illidan|h[|cffff7c0aAbíde-Illidan|r]|h has earned the achievement |cffffff00|Hachievement:61574:Player-57-0DB85ABA:1:4:14:26:4294967295:4294967295:4294967295:4294967295|h[Legends Never Die]|h|r!\",\"timestamp\":1776223782,\"id\":\"s45_4161\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"Orc\",\"name\":\"Relyk-Mal'Ganis\",\"sex\":2},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"r\":0.6666666865348816,\"g\":0.6666666865348816,\"b\":1},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Relyk-Mal'Ganis:2549:PARTY:|h[|cff0070ddRelyk-Mal'Ganis|r]|h: maisara\",\"timestamp\":1776223797,\"id\":\"s45_4162\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ban-Lu\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Ban-Lu says: Farewell!\",\"timestamp\":1776223808,\"id\":\"s45_4163\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kul'amara the Fierce says: Stormclout. Oraka'zul! I am blessed ya be here to prowl with me.\",\"timestamp\":1776223846,\"id\":\"s45_4164\"},{\"recordedBy\":\"Stormclout-Ticho