":\"PALADIN\",\"race\":\"Tauren\",\"name\":\"Megoodatgame-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Megoodatgame-Tichondrius|h[|cfff48cbaMegoodatgame|r]|h has earned the achievement |cffffff00|Hachievement:40604:Player-11-0E821754:1:2:1:26:4294967295:4294967295:4294967295:4294967295|h[Mythic: The Dawnbreaker]|h|r!\",\"timestamp\":1769995239,\"id\":\"s17_4475\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"Tauren\",\"name\":\"Megoodatgame-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Megoodatgame-Tichondrius|h[|cfff48cbaMegoodatgame|r]|h has earned the achievement |cffffff00|Hachievement:11184:Player-11-0E821754:1:2:1:26:4294967295:4294967295:4294967295:4294967295|h[Keystone Challenger]|h|r!\",\"timestamp\":1769995239,\"id\":\"s17_4476\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Baa'lial\"},\"event\":\"CHAT_MSG_MONSTER_WHISPER\",\"type\":\"MONSTER_WHISPER\"},\"color\":{\"r\":1,\"g\":0.7098039388656616,\"b\":0.9215686917304993},\"text\":\"Baa'lial whispers: Blood will flow. Cities will burn. All will be ash and flame.\",\"timestamp\":1769995333,\"id\":\"s17_4477\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Baa'lial\"},\"event\":\"CHAT_MSG_MONSTER_WHISPER\",\"type\":\"MONSTER_WHISPER\"},\"color\":{\"r\":1,\"g\":0.7098039388656616,\"b\":0.9215686917304993},\"text\":\"Baa'lial whispers: All flesh must burn.\",\"timestamp\":1769995453,\"id\":\"s17_4478\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Stormspeaker Qian\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Stormspeaker Qian says: These upstart clans seek to seize the Vale for themselves. Show them that they are nothing before the Rajani.\",\"id\":\"s17_4479\",\"timestamp\":1770040782},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Baroness Draka\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Baroness Draka says: Strength means everything to the Maldraxxi. Prove that none can match you in the arena!\",\"id\":\"s17_4480\",\"timestamp\":1770040932},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Plaguebound\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Plaguebound yells: It's coming for us!\",\"id\":\"s17_4481\",\"timestamp\":1770040961},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Domina Venomblade\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Domina Venomblade says: So, the House of Eyes has finally sent someone to kill me. You're welcome to try.\",\"id\":\"s17_4482\",\"timestamp\":1770040961},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Plaguebound\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Plaguebound yells: We're better off jumping...\",\"id\":\"s17_4483\",\"timestamp\":1770040963},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Plaguebound\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Plaguebound yells: Ahhhhhhh!!!!!!!\",\"id\":\"s17_4484\",\"timestamp\":1770040963},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Domina Venomblade\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Domina Venomblade says: The horrors within these halls will make quick work of you. Stradama's plague will soon be mine.\",\"id\":\"s17_4485\",\"timestamp\":1770040970},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Domina Venomblade\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Domina Venomblade says: That was a mere taste of what the plague can do. Once I control it, all of Maldraxxus will pay for what they've done.\",\"id\":\"s17_4486\",\"timestamp\":1770041001},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ4:|Hitem:178753::::::::80:1480::23:2:9026:6652:1:28:749:::::|h[Surgical Pustule Extractor]|h|r\",\"id\":\"s17_4487\",\"timestamp\":1770041002},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ4:|Hitem:178753::::::::80:1480::23:2:9026:6652:1:28:749:::::|h[Surgical Pustule Extractor]|h|r\",\"id\":\"s17_4488\",\"timestamp\":1770041002},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:176866::::::::80:1480:::::::::|h[Putrid Sludge]|h|rx4\",\"id\":\"s17_4489\",\"timestamp\":1770041002},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 13 Gold, 79 Silver, 61 Copper\",\"id\":\"s17_4490\",\"timestamp\":1770041003},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Virulax Blightweaver\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Virulax Blightweaver yells: Wonderful, more test subjects! Unleash the plagueborers!\",\"id\":\"s17_4491\",\"timestamp\":1770041039},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Virulax Blightweaver\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Virulax Blightweaver yells: I will dissect you myself!\",\"id\":\"s17_4492\",\"timestamp\":1770041050},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ4:|Hitem:178771::::::::80:1480::23:2:9026:6652:1:28:749:::::|h[Phial of Putrefaction]|h|r\",\"id\":\"s17_4493\",\"timestamp\":1770041066},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ4:|Hitem:178775::::::::80:1480::23:4:9026:8136:8117:6652:1:28:749:::::|h[Fleshfused Crushers]|h|r\",\"id\":\"s17_4494\",\"timestamp\":1770041066},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 14 Gold, 62 Silver, 87 Copper\",\"id\":\"s17_4495\",\"timestamp\":1770041067},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Domina Venomblade\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Domina Venomblade says: So you emerge victorious. But at what cost? What vile mixtures now course through your veins?\",\"id\":\"s17_4496\",\"timestamp\":1770041073},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Venomous Sniper\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Venomous Sniper yells: Something is forming in the slime...\",\"id\":\"s17_4497\",\"timestamp\":1770041079},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Defender of Many Eyes\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Defender of Many Eyes yells: Press the line! Domina will have our skulls if she cannot claim Stradama's plague!\",\"id\":\"s17_4498\",\"timestamp\":1770041079},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Domina Venomblade\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Domina Venomblade says: That is the plague's true power. It lingers, festers, destroys everything it touches... even the victor.\",\"id\":\"s17_4499\",\"timestamp\":1770041084},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Venomous Sniper Captain\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Venomous Sniper Captain yells: Draw the bowstring until your bones snap, we will claim the plague! Hold your ground here and now, or answer to Domina later, choose your fate!\",\"id\":\"s17_4500\",\"timestamp\":1770041091},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Deathroc Rider\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Deathroc Rider yells: Unleash the Bone Spears!\",\"id\":\"s17_4501\",\"timestamp\":1770041100},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Domina Venomblade\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Domina Venomblade says: Had Akarek not been so foolish, had he reached out and seized the plague, the House of Eyes would still stand!\",\"id\":\"s17_4502\",\"timestamp\":1770041101},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ4:|Hitem:178931::::::::80:1480::23:5:9026:8136:8137:6652:8811:1:28:749:::::|h[Scarred Bloodbound Girdle]|h|r\",\"id\":\"s17_4503\",\"timestamp\":1770041116},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ4:|Hitem:178929::::::::80:1480::23:2:9026:6652:1:28:749:::::|h[Halberd of the Aranakk]|h|r\",\"id\":\"s17_4504\",\"timestamp\":1770041116},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 11 Gold, 83 Silver, 20 Copper\",\"id\":\"s17_4505\",\"timestamp\":1770041117},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Margrave Stradama\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Margrave Stradama says: Who trespasses upon the House of Plagues? Who seeks that which cannot be controlled?\",\"id\":\"s17_4506\",\"timestamp\":1770041121},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Margrave Stradama\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Margrave Stradama says: If you so desire this power, then come and claim it... or let it claim you.\",\"id\":\"s17_4507\",\"timestamp\":1770041131},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ickor Bileflesh\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Ickor Bileflesh yells: Welcome. We've been expecting you!\",\"id\":\"s17_4508\",\"timestamp\":1770041138},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ickor Bileflesh\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Ickor Bileflesh yells: The mother of plagues... comes... for you...\",\"id\":\"s17_4509\",\"timestamp\":1770041139},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:173202::::::::80:1480:::::::::|h[Shrouded Cloth]|h|rx3\",\"id\":\"s17_4510\",\"timestamp\":1770041171},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ2:|Hitem:173204::::::::80:1480:::::::::|h[Lightless Silk]|h|r\",\"id\":\"s17_4511\",\"timestamp\":1770041171},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 30 Gold, 3 Silver, 55 Copper\",\"id\":\"s17_4512\",\"timestamp\":1770041172},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ4:|Hitem:178774::::::::80:1480::23:4:9026:8136:8137:6652:1:28:749:::::|h[Muckwallow Stompers]|h|r\",\"id\":\"s17_4513\",\"timestamp\":1770041174},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ4:|Hitem:178755::::::::80:1480::23:4:9026:8136:8138:6652:1:28:749:::::|h[Blighted Margrave's Cloak]|h|r\",\"id\":\"s17_4514\",\"timestamp\":1770041174},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:176874::::::::80:1480:::::::::|h[Desiccated Humerus]|h|rx3\",\"id\":\"s17_4515\",\"timestamp\":1770041174},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color