\":\"s25_2657\",\"timestamp\":1773017421},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Tarenar Sunstrike\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Tarenar Sunstrike says: I know, I know. My friend Gidwin should be back any minute now with your payment!\",\"id\":\"s25_2658\",\"timestamp\":1773017422},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Gnome\",\"class\":\"MONK\",\"name\":\"Coreysgtime-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Coreysgtime-Tichondrius:828:GUILD:|h[|cff00ff98Coreysgtime|r]|h: 10\",\"id\":\"s25_2659\",\"timestamp\":1773017423},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Pandaren\",\"class\":\"WARRIOR\",\"name\":\"Hhyyzzll-Mal'Ganis\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Hhyyzzll-Mal'Ganis:830:GUILD:|h[|cffc69b6dHhyyzzll|r]|h: but everything close af\",\"id\":\"s25_2660\",\"timestamp\":1773017425},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Pandaren\",\"class\":\"WARRIOR\",\"name\":\"Hhyyzzll-Mal'Ganis\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Hhyyzzll-Mal'Ganis:833:GUILD:|h[|cffc69b6dHhyyzzll|r]|h: oh wowze\",\"id\":\"s25_2661\",\"timestamp\":1773017429},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: My colleagues are searching for methods to protect our city. I have my own solution.\",\"id\":\"s25_2662\",\"timestamp\":1773017439},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: K'aresh produced some of the deadliest predators in the cosmos. This is one of them.\",\"id\":\"s25_2663\",\"timestamp\":1773017446},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: Meet me near the harbor and I will reveal to you another path...\",\"id\":\"s25_2664\",\"timestamp\":1773017448},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Gnome\",\"class\":\"MONK\",\"name\":\"Coreysgtime-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Coreysgtime-Tichondrius:852:GUILD:|h[|cff00ff98Coreysgtime|r]|h: the store is like .8 of a mile to my house except i just got my son to bed\",\"id\":\"s25_2665\",\"timestamp\":1773017451},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"PALADIN\",\"name\":\"Xzaelpal-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Xzaelpal-Tichondrius|h[|cfff48cbaXzaelpal|r]|h has earned the achievement |cffffff00|Hachievement:61681:Player-11-0EB22723:1:3:8:26:4294967295:4294967295:4294967295:4294967295|h[Abundance: You Should See Him in a Crown]|h|r!\",\"id\":\"s25_2666\",\"timestamp\":1773017479},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Pandaren\",\"class\":\"WARRIOR\",\"name\":\"Hhyyzzll-Mal'Ganis\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Hhyyzzll-Mal'Ganis:866:GUILD:|h[|cffc69b6dHhyyzzll|r]|h: lmao\",\"id\":\"s25_2667\",\"timestamp\":1773017482},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Fortitude-Korialstrasz\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Fortitude-Korialstrasz|h[|cff00ff98Fortitude-Korialstrasz|r]|h has earned the achievement |cffffff00|Hachievement:61644:Player-84-0AAFA190:1:3:8:26:4294967295:4294967295:4294967295:4294967295|h[Heroic: Maisara Caverns]|h|r!\",\"id\":\"s25_2668\",\"timestamp\":1773017494},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Fortitude-Korialstrasz\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Fortitude-Korialstrasz|h[|cff00ff98Fortitude-Korialstrasz|r]|h has earned the achievement |cffffff00|Hachievement:61645:Player-84-0AAFA190:1:3:8:26:4294967295:4294967295:4294967295:4294967295|h[Mythic: Maisara Caverns]|h|r!\",\"id\":\"s25_2669\",\"timestamp\":1773017494},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ranger Telenus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ranger Telenus says: Look at this mess!\",\"id\":\"s25_2670\",\"timestamp\":1773017509},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Orweyna says: The Den has been ravaged with vermin. If we deal with that problem the elders will be more favorable with us. Take a grymlinx--they are always up for a meal.\",\"id\":\"s25_2671\",\"timestamp\":1773017520},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Gnome\",\"class\":\"MONK\",\"name\":\"Coreysgtime-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Coreysgtime-Tichondrius:875:GUILD:|h[|cff00ff98Coreysgtime|r]|h: did you know |cff71d5ff|Hspell:449582:0|h[Lighter Than Air]|h|r gives you water walking\",\"id\":\"s25_2672\",\"timestamp\":1773017564},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: To stand in the stillness where her presence once stirred... that is no small honor. Go now, and listen with more than ears.\",\"id\":\"s25_2673\",\"timestamp\":1773017579},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: The seekers did not cry out for the goddess's return. They listened, and waited, in the quiet places where memory clings.\",\"id\":\"s25_2674\",\"timestamp\":1773017601},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: The creatures remembered where she had been.\",\"id\":\"s25_2675\",\"timestamp\":1773017614},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: Some creatures became consumed with gluttony, in order to fill the void created from her departure.\",\"id\":\"s25_2676\",\"timestamp\":1773017621},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"PALADIN\",\"name\":\"Tmcáke-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Tmcáke-Tichondrius:881:GUILD:|h[|cfff48cbaTmcáke|r]|h: boomy is looking very strong\",\"id\":\"s25_2677\",\"timestamp\":1773017621},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Rutaani Sapling\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"The Rutaani does not react to your presence, it continues to sit silently.\",\"id\":\"s25_2678\",\"timestamp\":1773017626},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: The stones echoed her song, but this one was different. Within it the song stirred, yearning to share its tune.\",\"id\":\"s25_2679\",\"timestamp\":1773017631},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Echo of Memory\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"A faint echo shimmers into view, its gentle motion urging you to follow.\",\"id\":\"s25_2680\",\"timestamp\":1773017655},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: They followed not a path, but an echo of feeling.\",\"id\":\"s25_2681\",\"timestamp\":1773017655},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Echo of Memory\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"The echo begins to move again, urging you to follow.\",\"id\":\"s25_2682\",\"timestamp\":1773017658},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: She was not in the light--she was the warmth it left behind.\",\"id\":\"s25_2683\",\"timestamp\":1773017662},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Echo of Memory\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"The echo begins to move again, urging you to follow.\",\"id\":\"s25_2684\",\"timestamp\":1773017664},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: The seekers sat in silence. Even there, we heard her song.\",\"id\":\"s25_2685\",\"timestamp\":1773017671},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Tahnkajahari-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Tahnkajahari-Tichondrius|h[|cffa330c9Tahnkajahari|r]|h has earned the achievement |cffffff00|Hachievement:40763:Player-11-0EB210B1:1:3:8:26:4294967295:4294967295:4294967295:4294967295|h[I'm not a Thief, I'm a Treasure Hunter]|h|r!\",\"id\":\"s25_2686\",\"timestamp\":1773017675},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: We called out with song. She did not answer. But something she left behind did. And it was enough.\",\"id\":\"s25_2687\",\"timestamp\":1773017678},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ6:|Hitem:248139::::::::90:269:::::::::|h[Aln'hara's Bloom]|h|r\",\"id\":\"s25_2688\",\"timestamp\":1773017686},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: She did not return. But something of her remained, blooming in the silence for those who remembered.\",\"id\":\"s25_2689\",\"timestamp\":1773017692},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Stormclout-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ4:|Hitem:268487::::::::90:269::11::2:9:90:28:3321:::::|h[Avid Learner's Supply Pack]|h|r\",\"id\":\"s25_2690\",\"timestamp\":1773017703},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: Aln'hara leaves no trace by accident. The Bloom was not a gift... it was a promise. Living, sacred, and real. Thank you for revealing the truth of its story.\",\"id\":\"s25_2691\",\"timestamp\":1773017704},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx200\",\"id\":\"s25_2692\",\"timestamp\":1773017704},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3391:0|h[Adventurer Dawncrest]|h|rx20\",\"id\":\"s25_2693\",\"timestamp\":1773017705},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Harronir\",\"class\":\"MONK\",\"name\":\"Terrybrews-Zul'jin\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Terrybrews-Zul'jin|h[|cff00ff98Terrybrews-Zul'jin|r]|h has earned the achievement |cffffff00|Hachievement:61438:Player-61-0C415F22:1:3:8:26:4294967295:4294967295:4294967295:4294967295|h[Thalassian Profession Master]|h|r!\",\"id\":\"s25_2694\",\"timestamp\":1773017774},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Harronir\",\"class\":\"MONK\",\"name\":\"Terrybrews-Zul'jin\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Terrybrews-Zul'jin|h[|cff00ff98Terrybrews-Zul'jin|r]|h has earned the achievement |cffffff00|Hachievement:42793:Player-61-0C415F22:1:3:8:26:4294967295:4294967295:4294967295:4294967295|h[Herbalism at Midnight]|h|r!\",\"id\":\"s25_2695\",\"timestamp\":1773017774},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Namoon-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Namoon-Stormrage|h[|cffff7c0aNamoon-Stormrage|r]|h has earned the achievement |cffffff00|Hachievement:61223:Player-60-0EFC3DD6:1:3:8:26:4294967295:4294967295:4294967295:4294967295|h[Tour of Duty: Harandar]|h|r!\",\"id\":\"s25_2696\",\"timestamp\":1773017796},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Silvermoon Guard\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"The nearby guard glares at you and the void energy that you surround yourself with.\",\"timestamp\":1773017840,\"id\":\"s25_2697\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"VoidElf\",\"name\":\"Zãrå-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Zãrå-Tichondrius|h[|cfffff468Zãrå|r]|h has earned the achievement |cffffff00|Hachievement:61227:Player-11-0EA92130:1:3:8:26:4294967295:4294967295:4294967295:4294967295|h[Entering the Void]|h|r!\",\"timestamp\":1773017858,\"id\":\"s25_2698\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"Human\",\"name\":\"Xzaelpal-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\