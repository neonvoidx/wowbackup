TER\",\"race\":\"BloodElf\",\"name\":\"Voidwhispèr-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Voidwhispèr-Area52:559:GUILD:|h[|cffa330c9Voidwhispèr|r]|h: thats a bonus \",\"timestamp\":1772204639,\"id\":\"s19_3818\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Doecha\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Doecha says: I wish to help Orweyna, but she will not want to go where she must go.\",\"timestamp\":1772204679,\"id\":\"s19_3819\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"Tauren\",\"name\":\"Àshtray-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Àshtray-Tichondrius|h[|cfff48cbaÀshtray|r]|h has earned the achievement |cffffff00|Hachievement:153:Player-11-0EB1F2BC:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[The Old Gnome and the Sea]|h|r!\",\"timestamp\":1772204680,\"id\":\"s19_3820\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"Pandaren\",\"name\":\"Frostyfries-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Frostyfries-Tichondrius:562:GUILD:|h[|cffc41e3aFrostyfries|r]|h: yeah  so if Anyone u guys get stuck or ask where things are i can point u right direction\",\"timestamp\":1772204684,\"id\":\"s19_3821\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ku'paal\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Ku'paal says: Orweyna, I beg you. You know where Alndust falls.\",\"timestamp\":1772204688,\"id\":\"s19_3822\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ku'paal\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Ku'paal says: When the goddess was torn from her Cradle, the violence left wounds that will not heal.\",\"timestamp\":1772204690,\"id\":\"s19_3823\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ku'paal\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Ku'paal says: Those who walk the rift without guidance risk being forever lost.\",\"timestamp\":1772204693,\"id\":\"s19_3824\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ku'paal\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Ku'paal says: If you must go, you will need the Shul'ka. How you feel about him cannot change that.\",\"timestamp\":1772204694,\"id\":\"s19_3825\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"BloodElf\",\"name\":\"Voidwhispèr-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Voidwhispèr-Area52:574:GUILD:|h[|cffa330c9Voidwhispèr|r]|h: thanks a bunch, 'preciate it!\",\"timestamp\":1772204698,\"id\":\"s19_3826\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"Pandaren\",\"name\":\"Frostyfries-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Frostyfries-Tichondrius:575:GUILD:|h[|cffc41e3aFrostyfries|r]|h: you're welcome\",\"timestamp\":1772204713,\"id\":\"s19_3827\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ2:|Hcurrency:3385:0|h[Luminous Dust]|h|rx1\",\"timestamp\":1772204727,\"id\":\"s19_3828\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Amarakk\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Amarakk says: After all this time, you return and seek entry into the rift? You have not changed at all, Orweyna.\",\"timestamp\":1772204734,\"id\":\"s19_3829\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ1:|Hitem:243595::::::::84:1480::11::1:28:3087:::::|h[Salve of Aln]|h|r\",\"timestamp\":1772204738,\"id\":\"s19_3830\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Amarakk\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Amarakk says: If you insist on doing this, then you need to protect your mind and spirit with the Alndust.\",\"timestamp\":1772204738,\"id\":\"s19_3831\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Amarakk\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Amarakk says: Find me once you are prepared. And Orweyna... Be careful.\",\"timestamp\":1772204746,\"id\":\"s19_3832\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\