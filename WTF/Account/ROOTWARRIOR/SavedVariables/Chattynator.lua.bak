["g"] = 0.6666666865348816,
["r"] = -0,
},
["text"] = "You receive loot: |cnIQ4:|T5007851:12|t|Hitem:204411::::::::90:258::6:7:7981:9380:6652:9224:9218:1498:8767:1:28:2647:::::|h[Crucible Curator's Wingspan (Shoulder 83)]|h|r",
["id"] = "s51_4733",
["timestamp"] = 1785283192,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zskarn",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zskarn says: It was my honor to evaluate the development of Neltharion's dracthyr.",
["id"] = "s51_4734",
["timestamp"] = 1785283192,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zskarn",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zskarn says: Unfortunately they were too volatile to control. But where others see failure, I see opportunity.",
["id"] = "s51_4735",
["timestamp"] = 1785283197,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["race"] = "VoidElf",
["class"] = "PRIEST",
["name"] = "Neonvoid",
["sex"] = 3,
},
["event"] = "CHAT_MSG_LOOT",
["type"] = "LOOT",
},
["color"] = {
["b"] = -0,
["g"] = 0.6666666865348816,
["r"] = -0,
},
["text"] = "You receive item: |cnIQ4:|T5007846:12|t|Hitem:202541::::::::90:258::6:6:6652:9228:7981:9381:1501:8767:1:28:1040:::::|h[Breeches of the Furnace Seraph (Legs 83)]|h|r",
["id"] = "s51_4736",
["timestamp"] = 1785283201,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zskarn",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zskarn says: This early attempt at creating dracthyr yielded a subject too violent to control.",
["id"] = "s51_4737",
["timestamp"] = 1785283205,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zskarn",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zskarn says: Yet there is value in documenting the carnage it generates.",
["id"] = "s51_4738",
["timestamp"] = 1785283210,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zskarn",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zskarn says: You will serve nicely as new test subjects.",
["id"] = "s51_4739",
["timestamp"] = 1785283216,
},
{
