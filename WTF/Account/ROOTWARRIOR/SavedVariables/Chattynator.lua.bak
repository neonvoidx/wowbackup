},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Kul'amara the Fierce says: What she doin'? She's rendin' de souls. Twisting dem! Feeding dem to that monster!",
["id"] = "s51_4543",
["timestamp"] = 1785268353,
},
{
