ecordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Manyfaced\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ4:|T1708500:12|t|Hitem:264317::::::::90:260::14::1:28:3321:::::|h[Cache of Void-Touched Chestpieces]|h|r\",\"timestamp\":1784052865,\"id\":\"s50_4845\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Manyfaced\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ4:|T1708500:12|t|Hitem:264316::::::::90:260::14::1:28:3321:::::|h[Cache of Void-Touched Cloaks]|h|r\",\"timestamp\":1784052866,\"id\":\"s50_4846\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Manyfaced\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ4:|T1708500:12|t|Hitem:264318::::::::90:260::14::1:28:3321:::::|h[Cache of Void-Touched Bracers]|h|r\",\"timestamp\":1784052867,\"id\":\"s50_4847\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Manyfaced\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ4:|T1708500:12|t|Hitem:264320::::::::90:260::14::1:28:3321:::::|h[Cache of Void-Touched Belts]|h|r\",\"timestamp\":1784052868,\"id\":\"s50_4848\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Manyfaced\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ4:|T6050433:12|t|Hitem:263705::::::::90:260::14::1:28:3321:::::|h[Waistband of Voidwrath (Waist 1)]|h|r\",\"timestamp\":1784052874,\"id\":\"s50_4849\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Manyfaced\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ4:|T6154018:12|t|Hitem:263668::::::::90:260::14::1:28:3321:::::|h[Bindings of Voidcendence (Wrist 1)]|h|r\",\"timestamp\":1784052874,\"id\":\"s50_4850\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Manyfaced\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ4:|T6052830:12|t|Hitem:263689::::::::90:260::14::1:28:3321:::::|h[Void Nemesis' Robes (Chest 1)]|h|r\",\"timestamp\":1784052875,\"id\":\"s50_4851\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Manyfaced\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ4:|T6104671:12|t|Hitem:263592::::::::90:260::14::1:28:3321:::::|h[Void Rider's Cloak (Back 1)]|h|r\",\"timestamp\":1784052875,\"id\":\"s50_4852\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"BloodElf\",\"name\":\"Skedoinker-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Skedoinker-Area52|h[|cfff48cbaSkedoinker-Area52|r]|h has earned the achievement |cffffff00|Hachievement:14414:Player-3676-0EDF6FA1:1:7:14:26:4294967295:4294967295:4294967295:4294967295|h[Heroic: Plaguefall]|h|r!\",\"timestamp\":1784053050,\"id\":\"s50_4853\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"BloodElf\",\"name\":\"Skedoinker-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Skedoinker-Area52|h[|cfff48cbaSkedoinker-Area52|r]|h has earned the achievement |cffffff00|Hachievement:14369:Player-3676-0EDF6FA1:1:7:14:26:4294967295:4294967295:4294967295:4294967295|h[Plaguefall]|h|r!\",\"timestamp\":1784053050,\"id\":\"s50_4854\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Maella\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Maella says: Use discretion when recruiting our... allies. Umbric cannot afford upset tensions here in Silvermoon.\",\"timestamp\":1784053188,\"id\":\"s50_4855\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Commander Tala'saan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Commander Tala'saan says: Affirmative, Manyfaced. We will mobilize to meet you and Maella in the Voidstorm.\",\"timestamp\":1784053203,\"id\":\"s50_4856\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Archmage Y'mera\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Archmage Y'mera waves you over to speak with her.\",\"timestamp\":1784053210,\"id\":\"s50_4857\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Archmage Y'mera\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Archmage Y'mera says: While cloaked with invisibility, take hold of the tether from the beacon and see how far you can extend it.\",\"timestamp\":1784053213,\"id\":\"s50_4858\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Manyfaced\",\"sex\":3},\"event\":\"CHAT_MSG_RAID_BOSS_WHISPER\",\"type\":\"MONSTER_BOSS_WHISPER\"},\"color\":{\"r\":1,\"g\":0.8666667342185974,\"b\":0},\"text\":\"While stealthed or invisible, pull the tether as far as you can to test the device.\",\"timestamp\":1784053216,\"id\":\"s50_4859\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Commander Tala'saan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Commander Tala'saan says: Will the cloaking tether be operational, Y'mera? Maella is counting on it to keep our arrival point hidden.\",\"timestamp\":1784053222,\"id\":\"s50_4860\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Archmage Y'mera\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Archmage Y'mera says: Did I not promise the Riftblade she would have her defenses, Commander? A few more adjustments is all I require.\",\"timestamp\":1784053229,\"id\":\"s50_4861\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ4:|T2459456:12|t|Hcurrency:3405:0|h[Field Accolade]|h|rx10\",\"timestamp\":1784053235,\"id\":\"s50_4862\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Solwin Brightstitch\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Solwin Brightstitch says: Alas, if I had but one worthy customer...\",\"timestamp\":1784053240,\"id\":\"s50_4863\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Leona Darkstrider\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Leona Darkstrider says: Champion, a moment if you would!\",\"timestamp\":1784053253,\"id\":\"s50_4864\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Belath Dawnblade\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Belath Dawnblade says: Very well, Manyfaced. We will meet you in the Voidstorm.\",\"timestamp\":1784053253,\"id\":\"s50_4865\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Leona Darkstrider\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Leona Darkstrider says: With Spectral Sight active, simply locate and stomp out any Shadows you find. My attuned Sight Ward will do the rest.\",\"timestamp\":1784053258,\"id\":\"s50_4866\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Leona Darkstrider\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Leona Darkstrider says: Thank you, Manyfaced. Attuning the Umbral Sight Ward should bolster our camp's defenses when we arrive.\",\"timestamp\":1784053313,\"id\":\"s50_4867\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Projected Image of Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Projected Image of Decimus says: Light... fel... Void. The perfect recipe for upsetting tensions. How delicious.\",\"timestamp\":1784053324,\"id\":\"s50_4868\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ4:|T2459456:12|t|Hcurrency:3405:0|h[Field Accolade]|h|rx10\",\"timestamp\":1784053324,\"id\":\"s50_4869\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Maella\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Riftblade Maella glares at the projection of Decimus.\",\"timestamp\":1784053335,\"id\":\"s50_4870\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: I hope your little strike team is ready. I can already taste the conflict beyond this rift.\",\"timestamp\":1784053436,\"id\":\"s50_4871\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Maella\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Maella says: If you are done instigating, Decimus, our riftwardens stand at the ready.\",\"timestamp\":1784053438,\"id\":\"s50_4872\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Maella\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Maella says: Stars guide our path. Forward!\",\"timestamp\":1784053454,\"id\":\"s50_4873\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Maella\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Maella says: Allari, you and Leona establish a perimeter. Belath, scout ahead with Baraat and the others.\",\"timestamp\":1784053472,\"id\":\"s50_4874\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Maella\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Maella says: Y'mera, keep us hidden while we gather our bearings. Champion, to me.\",\"timestamp\":1784053479,\"id\":\"s50_4875\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Maella\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Maella says: Our allies have scouted ahead to see what we're dealing with. Regroup with them and see what they found.\",\"timestamp\":1784053482,\"id\":\"s50_4876\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Maella\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Maella says: And should you encounter the Nexus-Captain leading their assaults in Eversong... take his head.\",\"timestamp\":1784053490,\"id\":\"s50_4877\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PRIEST\",\"race\":\"Tauren\",\"name\":\"Bullzdeepa-Mal'Ganis\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Bullzdeepa-Mal'Ganis|h[|cffffffffBullzdeepa-Mal'Ganis|r]|h has earned the achievement |cffffff00|Hachievement:62513:Player-3684-0EE711A2:1:7:14:26:4294967295:4294967295:4294967295:4294967295|h[Outstanding in the Field]|h|r!\",\"timestamp\":1784053515,\"id\":\"s50_4878\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: The runoff from the manaforge processing sites is affecting the local fauna. Gather some samples for our research.\",\"timestamp\":1784053603,\"id\":\"s50_4879\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|T7137586:12|t|Hcurrency:3316:0|h[Voidlight Marl]|h|rx30\",\"timestamp\":1784053637,\"id\":\"s50_4880\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ4:|T2459456:12|t|Hcurrency:3405:0|h[Field Accolade]|h|rx10\",\"timestamp\":1784053637,\"id\":\"s50_4881\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Baraat the Longshot\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Baraat the Longshot points to the structure up ahead.\",\"timestamp\":1784053660,\"id\":\"s50_4882\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Baraat the Longshot\"},\"event\":\"CHAT_MSG_MONSTER_WHISPER\",\"type\":\"MONSTER_WHISPER\"},\"color\":{\"r\":1,\"g\":0.7098039388656616,\"b\":0.9215686917304993},\"text\":\"Baraat the Longshot whispers: See that Nexus Port? The ethereals are using it to ship materials on and off this world.\",\"timestamp\":1784053664,\"id\":\"s50_4883\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ4:|T2459456:12|t|Hcurrency:3405:0|h[Field Accolade]|h|rx10\",\"timestamp\":1784053730,\"id\":\"s50_4884\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|T7137586:12|t|Hcurrency:3316:0|h[Voidlight Marl]|h|rx30\",\"timestamp\":1784053730,\"id\":\"s50_4885\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Belath Dawnblade\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Belath gestures to the crashed demon vessel in the distance.\",\"timestamp\":1784053774,\"id\":\"s50_4886\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Belath Dawnblade\"},\"event\":\"CHAT_MSG_MONSTER_WHISPER\",\"type\":\"MONSTER_WHISPER\"},\"color\":{\"r\":1,\"g\":0.7098039388656616,\"b\":0.9215686917304993},\"text\":\"Belath Dawnblade whispers: The Hal'hadar are using their skiffs overhead to carry their salvage from the northern shores to their forges.\",\"timestamp\":1784053778,\"id\":\"s50_4887\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: I know so very little about these \\\"Hal'hadar,\\\" but they appear to be more formidable than the Shadowguard. I suggest you cull their numbers so you don't find yourself overwhelmed later.\",\"timestamp\":1784053846,\"id\":\"s50_4888\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Commander Tala'saan\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Commander Tala'saan gestures for silence before pointing to the Mana-forge up ahead.\",\"timestamp\":1784053852,\"id\":\"s50_4889\"},{\"recordedBy\":\"Manyfaced-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ4:|T2459456:12|t|Hcurrency:3405:0|h[Field Accolade]|h|rx40\",