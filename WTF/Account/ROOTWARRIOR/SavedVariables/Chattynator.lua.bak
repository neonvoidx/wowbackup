},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Hex Master Uy'okan",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Hex Master Uy'okan says: You will always be... in your sister's shadow...",
["id"] = "s51_4352",
["timestamp"] = 1785260768,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
