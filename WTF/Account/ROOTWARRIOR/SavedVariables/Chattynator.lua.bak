6157,\"id\":\"s50_4546\"},{\"recordedBy\":\"Neonvoid-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Uuna\"},\"event\":\"CHAT_MSG_SAY\",\"type\":\"SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":1},\"text\":\"|Hplayer:Uuna:81:SAY:|h[Uuna]|h says: Tulip's sister, pure and humble! Seeks to... something...\",\"timestamp\":1783966157,\"id\":\"s50_4547\"},{\"recordedBy\":\"Neonvoid-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Uuna\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Uuna mumbles.\",\"timestamp\":1783966157,\"id\":\"s50_4548\"},{\"recordedBy\":\"Neonvoid-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ethereal Warpweaver\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Ethereal Warpweaver says: I have arrived.\",\"timestamp\":1783966781,\"id\":\"s50_4549\"},{\"recordedBy\":\"Neonvoid-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PRIEST\",\"race\":\"VoidElf\",\"name\":\"Neonvoid\",\"sex\":3},\"event\":\"CHAT_MSG_RAID_BOSS_WHISPER\",\"type\":\"MONSTER_BOSS_WHISPER\"},\"color\":{\"r\":1,\"g\":0.8666667342185974,\"b\":0},\"text\":\"The guards' eyes are on you. Return to neutral territory.\",\"timestamp\":1783967915,\"id\":\"s50_4550\"},{\"recordedBy\":\"Neonvoid-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Silvermoon Guard\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"The nearby guard glares at you and the void energy that you surround yourself with.\",\"timestamp\":1783968418,\"id\":\"s50_4551\"},{\"recordedBy\":\"Neonvoid-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ethereal Warpweaver\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Ethereal Warpweaver says: My skills in warpweaving can only do so much to help you. But I shall do my best.\",\"timestamp\":1783968552,\"id\":\"s50_4552\"},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Orweyna says: Elder Hagar has called on the elven leaders to join this gathering in Harandar. It is of great importance.\",\"id\":\"s50_4553\",\"timestamp\":1784047226},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: It would be an honor. We will join you as soon as we can.\",\"id\":\"s50_4554\",\"timestamp\":1784047233},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"MONK\",\"name\":\"Stormclout\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"You sense a nearby Skyriding Glyph.\",\"id\":\"s50_4555\",\"timestamp\":1784047311},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Dracthyr\",\"class\":\"EVOKER\",\"name\":\"Dracussy-Firetree\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Dracussy-Firetree|h[|cff33937fDracussy-Firetree|r]|h has earned the achievement |cffffff00|Hachievement:63325:Player-127-0A60410C:1:7:14:26:4294967295:4294967295:4294967295:4294967295|h[Omnium Folio Studies]|h|r!\",\"id\":\"s50_4556\",\"timestamp\":1784047379},{\"recordedBy\":\"Stormclout-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"DarkIronDwarf\",\"class\":\"WARRIOR\",\"name\":\"Balewar\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|