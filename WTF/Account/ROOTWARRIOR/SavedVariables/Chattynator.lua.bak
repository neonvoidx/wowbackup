estamp\":1772805657},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Tarenar Sunstrike\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Tarenar Sunstrike says: I know, I know. My friend Gidwin should be back any minute now with your payment!\",\"id\":\"s23_3790\",\"timestamp\":1772805674},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Tarenar Sunstrike\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Tarenar Sunstrike says: My friend here is going to help Gidwin find the payment. Shouldn't be long now.\",\"id\":\"s23_3791\",\"timestamp\":1772805678},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kiria Brightpalm\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Kiria Brightpalm says: You're lucky we haven't repossessed your apartment after all this time, Sunstrike.\",\"id\":\"s23_3792\",\"timestamp\":1772805683},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Valeera Sanguinar says: I'm guessing Lor'themar needs something done in secret. Never forget that the sun casts the deepest shadows.\",\"id\":\"s23_3793\",\"timestamp\":1772805702},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Scourge\",\"class\":\"PRIEST\",\"name\":\"Sanfu-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Sanfu-Tichondrius:548:GUILD:|h[|cffffffffSanfu|r]|h: How are other executes? Shadow Word: Death barely does 7k damage for me right now.\",\"id\":\"s23_3794\",\"timestamp\":1772805703},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"MAGE\",\"name\":\"Cosmictrauma-Eitrigg\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Cosmictrauma-Eitrigg|h[|cff3fc7ebCosmictrauma-Eitrigg|r]|h has earned the achievement |cffffff00|Hachievement:61219:Player-47-09510778:1:3:6:26:4294967295:4294967295:4294967295:4294967295|h[No Time to Paws]|h|r!\",\"id\":\"s23_3795\",\"timestamp\":1772805728},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hawkrancher Saman\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hawkrancher Saman says: Bet you'll find her in the gardens just north of here. Tiff is a wily one, I'll warn ya.\",\"id\":\"s23_3796\",\"timestamp\":1772805743},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ranger Telenus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ranger Telenus says: Look at this mess!\",\"id\":\"s23_3797\",\"timestamp\":1772805759},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Silvermoon Guard\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"The nearby guard glares at you and the void energy that you surround yourself with.\",\"id\":\"s23_3798\",\"timestamp\":1772805763},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ranger Telenus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ranger Telenus says: There he goes! He's headed for Thalassian University!\",\"id\":\"s23_3799\",\"timestamp\":1772805771},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You create: |cnIQ1:|Hitem:264165::::::::90:1480:::::::::|h[Tiff]|h|r.\",\"id\":\"s23_3800\",\"timestamp\":1772805797},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Grand Magister Rommath says: Silvermoon's students have unique ways of studying the arcane. Perhaps you could learn a thing or two.\",\"id\":\"s23_3801\",\"timestamp\":1772805807},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magistrix Zaedana\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magistrix Zaedana says: I can't teach in these conditions!\",\"id\":\"s23_3802\",\"timestamp\":1772805809},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:255842::::::::90:1480:::::::::|h[Training Rod of Polymorph]|h|r\",\"id\":\"s23_3803\",\"timestamp\":1772805820},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:258965::::::::90:1480:::::::::|h[Tome of Polymorph]|h|r\",\"id\":\"s23_3804\",\"timestamp\":1772805830},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Polymorphed Student\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Polymorphed Student says: Please tell me you finished the diagram that time...\",\"id\":\"s23_3805\",\"timestamp\":1772805837},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Polymorphed Student\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Polymorphed Student says: Ugh-- Can we shift the rune-work a little to the left next time?\",\"id\":\"s23_3806\",\"timestamp\":1772805841},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Polymorphed Student\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Polymorphed Student says: My back hurts. I'm not doing the next one!\",\"id\":\"s23_3807\",\"timestamp\":1772805866},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Polymorphed Student\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Polymorphed Student says: Ugh-- Can we shift the rune-work a little to the left next time?\",\"id\":\"s23_3808\",\"timestamp\":1772805873},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Polymorphed Student\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Polymorphed Student says: I don't think we were supposed to use that much mana.\",\"id\":\"s23_3809\",\"timestamp\":1772805878},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Gnome\",\"class\":\"MONK\",\"name\":\"Wankge-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_A