\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260662::::::::90:1480:::::::::|h[Polished Purple Pebble]|h|r\",\"id\":\"s24_2809\",\"timestamp\":1772820358},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260683::::::::90:1480:::::::::|h[Fine Magenta Sand]|h|r\",\"id\":\"s24_2810\",\"timestamp\":1772820358},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"PALADIN\",\"name\":\"Northernmist-BlackwaterRaiders\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Northernmist-BlackwaterRaiders:2956:GUILD:|h[|cfff48cbaNorthernmist|r]|h: take as long as u want ☻\",\"id\":\"s24_2811\",\"timestamp\":1772820365},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kuri\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Kuri says: Whoa! There's so much of it! Hang on--I'll gather up as much as I can.\",\"id\":\"s24_2812\",\"timestamp\":1772820371},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:242639::::::::90:1480:::::::::|h[Practically Pork]|h|rx2\",\"id\":\"s24_2813\",\"timestamp\":1