r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260605::::::::88:1480:::::::::|h[Shattered Spear Tip]|h|r\",\"timestamp\":1772250950,\"id\":\"s20_3636\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Astre\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Astre says: This energy is overwhelming. I'm not like Umbric--I won't be able to keep this up.\",\"timestamp\":1772250964,\"id\":\"s20_3637\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Maella\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Maella says: You two didn't think we'd let you do this alone, did you?\",\"timestamp\":1772250978,\"id\":\"s20_3638\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Maella\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Maella says: Whatever it is, it's this way.\",\"timestamp\":1772250982,\"id\":\"s20_3639\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftwalker Sideras\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftwalker Sideras says: These rifts... They're like wounds. And they feel oddly familiar.\",\"timestamp\":1772250987,\"id\":\"s20_3640\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftwalker Sideras\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftwalker Sideras says: This way!\",\"timestamp\":1772250992,\"id\":\"s20_3641\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: This is the work of a domanaar. Hieron wounded it, but it must have taken something from him.\",\"timestamp\":1772251003,\"id\":\"s20_3642\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: Wait... I sense... Silvermoon. Look! Down below!\",\"timestamp\":1772251009,\"id\":\"s20_3643\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Notatus the Riftscarred\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Notatus the Riftscarred yells: Who's that scrabbling about on the ridge? You won't delay my revenge.\",\"timestamp\":1772251012,\"id\":\"s20_3644\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: Silvermoon depends on us. Together!\",\"timestamp\":1772251024,\"id\":\"s20_3645\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_SKILL\",\"type\":\"SKILL\"},\"color\":{\"r\":0.3333333432674408,\"g\":0.3333333432674408,\"b\":1},\"text\":\"Your skill in Midnight Mining has increased to 35.\",\"timestamp\":1772251047,\"id\":\"s20_3646\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ2:|Hitem:237364::::::::88:1480::::1:38:13:::::|h[Brilliant Silver Ore |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|r\",\"timestamp\":1772251047,\"id\":\"s20_3647\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Notatus the Riftscarred\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Notatus the Riftscarred says: You could not save him. His city falls next!\",\"timestamp\":1772251053,\"id\":\"s20_3648\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Notatus the Riftscarred\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Notatus the Riftscarred says: A pack... of filthy... animals...!\",\"timestamp\":1772251078,\"id\":\"s20_3649\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 2 Gold, 57 Silver, 3 Copper\",\"timestamp\":1772251080,\"id\":\"s20_3650\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: The rift is sealed. Obscurion Citadel threatens Silvermoon no more.\",\"timestamp\":1772251081,\"id\":\"s20_3651\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Astre\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Astre says: We could only have done this together. Let's get back to the Howling Ridge.\",\"timestamp\":1772251085,\"id\":\"s20_3652\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_SKILL\",\"type\":\"SKILL\"},\"color\":{\"r\":0.3333333432674408,\"g\":0.3333333432674408,\"b\":1},\"text\":\"Your skill in Midnight Mining has increased to 36.\",\"timestamp\":1772251147,\"id\":\"s20_3653\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ2:|Hitem:237362::::::::88:1480::::1:38:13:::::|h[Umbral Tin Ore |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|r\",\"timestamp\":1772251147,\"id\":\"s20_3654\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ3:|Hitem:236952::::::::88:1480:::::::::|h[Mote of Pure Void]|h|rx2\",\"timestamp\":1772251147,\"id\":\"s20_3655\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3158:0|h[Midnight Mining Knowledge]|h|rx1\",\"timestamp\":1772251148,\"id\":\"s20_3656\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3264:0|h[Artisan Miner's Moxie]|h|rx5\",\"timestamp\":1772251148,\"id\":\"s20_3657\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Astre\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Astre says: I won't be long. I'm not welcome there anyway.\",\"timestamp\":1772251170,\"id\":\"s20_3658\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: Yes. Watch after Astre in Silvermoon. Make sure they don't start a fight. For their sake, and mine. Rommath gives me enough grief as is.\",\"timestamp\":1772251171,\"id\":\"s20_3659\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Magister Umbric glances from Astre to you.\",\"timestamp\":1772251173,\"id\":\"s20_3660\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Silvermoon Guard\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"The nearby guard glares at you and the void energy that you surround yourself with.\",\"timestamp\":1772251203,\"id\":\"s20_3661\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Sedona Duskspire\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Sedona Duskspire says: What, come to commiserate? Did he abandon you too?\",\"timestamp\":1772251203,\"id\":\"s20_3662\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Astre\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Astre says: Sedona, this is Starphage. Do you mind if she joins us?\",\"timestamp\":1772251205,\"id\":\"s20_3663\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Sedona Duskspire\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Sedona Duskspire says: You were both in the storm? Please, come in.\",\"timestamp\":1772251209,\"id\":\"s20_3664\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Astre\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Astre says: She also has something from Hieron. You still have plenty of tea leaves, right Starphage?\",\"timestamp\":1772251212,\"id\":\"s20_3665\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Sedona Duskspire\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Sedona Duskspire says: Smells like bitter medicine. A little citrus from Eversong might balance it out.\",\"timestamp\":1772251216,\"id\":\"s20_3666\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Astre\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Astre says: Back in the Voidstorm, the tea manifested shades of our negative emotions. But it helps.\",\"timestamp\":1772251225,\"id\":\"s20_3667\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Sedona Duskspire\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Sedona Duskspire says: The Void's allure. Power at a cost. Costs be damned, right? The Sunwell--renewed. Our mana addiction--cured. Was what our people fought for really not enough?\",\"timestamp\":1772251226,\"id\":\"s20_3668\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:249724::::::::88:1480:::::::::|h[Sunfruit Wedge]|h|r\",\"timestamp\":1772251226,\"id\":\"s20_3669\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Astre\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Astre says: Try the tea. It can help. Care to try it too, Starphage? You brewed it, after all.\",\"timestamp\":1772251231,\"id\":\"s20_3670\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Astre\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Astre says: The Light exacts its own toll. The rigid order. It's stifling. Constraining. We're just not the same.\",\"timestamp\":1772251235,\"id\":\"s20_3671\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Sedona Duskspire\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Sedona Duskspire says: It's good. Refined. This takes me back.\",\"timestamp\":1772251236,\"id\":\"s20_3672\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Astre\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Astre says: The sunfruit mellows it out. Good idea, Sedona. We share excellent taste, after all.\",\"timestamp\":1772251239,\"id\":\"s20_3673\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Sedona Duskspire\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Sedona and Astre both laugh.\",\"timestamp\":1772251244,\"id\":\"s20_3674\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:264412::::::::88:1480::11:3:13573:6652:13668:2:9:88:28:3321:::::|h[Sin'dorei Magister's Keepsake]|h|r\",\"timestamp\":1772251244,\"id\":\"s20_3675\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Astre\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Astre says: We'll give you some space to read Hieron's letter, Sedona.\",\"timestamp\":1772251244,\"id\":\"s20_3676\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Sedona Duskspire\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Sedona Duskspire says: It can wait. Stay, Astre. I'd like to enjoy the tea a little longer, if you don't mind.\",\"timestamp\":1772251249,\"id\":\"s20_3677\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Sedona Duskspire\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Sedona Duskspire says: Did he also wake you to thistle tea?\",\"timestamp\":1772251254,\"id\":\"s20_3678\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Astre\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Astre says: Hah. The leaves were so hard to come by in Telogrus.\",\"timestamp\":1772251257,\"id\":\"s20_3679\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PRIEST\",\"race\":\"Scourge\",\"name\":\"Idealtoheal-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Idealtoheal-Tichondrius|h[|cffffffffIdealtoheal|r]|h has earned the achievement |cffffff00|Hachievement:41803:Player-11-0E754C36:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[For Zul'Aman!]|h|r!\",\"timestamp\":1772251258,\"id\":\"s20_3680\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Astre\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Astre says: Thanks for everything, Starphage. I'll see you back at the Howling Ridge tomorrow.\",\"timestamp\":1772251260,\"id\":\"s20_3681\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Sedona Duskspire\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Astre and Sedona carry on their conversation, lost in their shared reveries.\",\"timestamp\":1772251265,\"id\":\"s20_3682\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"BloodElf\",\"name\":\"Kalevala-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Kalevala-Tichondrius|h[|cffa330c9Kalevala|r]|h has earned the achievement |cffffff00|Hachievement:41803:Player-11-0E6775FC:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[For Zul'Aman!]|h|r!\",\"timestamp\":1772251278,\"id\":\"s20_3683\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"WARLOCK\",\"race\":\"BloodElf\",\"name\":\"Shookone-Area52\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Shookone-Area52|h[|cff8788eeShookone-Area52|r]|h has earned the achievement |cffffff00|Hachievement:41803:Player-3676-0EC012CA:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[For Zul'Aman!]|h|r!\",\"timestamp\":1772251297,\"id\":\"s20_3684\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kifaan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kifaan says: At last... I've found them...\",\"timestamp\":1772251311,\"id\":\"s20_3685\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kifaan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kifaan says: The Shadowguard readings are coming from that direction.\",\"timestamp\":1772251313,\"id\":\"s20_3686\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kifaan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kifaan says: My sister Veraan may be lost to the Void, but perhaps we can recover her memory.\",\"timestamp\":1772251317,\"id\":\"s20_3687\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Juras the Nethersent\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Juras bows gratefully and then points to the northwestern horizon.\",\"timestamp\":1772251336,\"id\":\"s20_3688\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"WARRIOR\",\"race\":\"Gnome\",\"name\":\"Durfnn-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Durfnn-Tichondrius:669:GUILD:|h[|cffc69b6dDurfnn|r]|h: we figure out how to fix 2nd prey quest? other people have finished it\",\"timestam