["typeInfo"] = {
["player"] = {
["name"] = "Winglord Dezran",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Winglord Dezran says: What is this foul place?",
["id"] = "s51_4832",
["timestamp"] = 1785285192,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Wrathion",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Wrathion says: It feels as though it is somewhere beyond. Teeming with raw, dark energy.",
["id"] = "s51_4833",
["timestamp"] = 1785285197,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Winglord Dezran",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Winglord Dezran says: Sarkareth lost himself to his pursuit of power. Now what will happen to my people?",
["id"] = "s51_4834",
["timestamp"] = 1785285208,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Sabellian",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Sabellian says: Is this the fate of all who pursue this legacy?",
["id"] = "s51_4835",
["timestamp"] = 1785285217,
},
