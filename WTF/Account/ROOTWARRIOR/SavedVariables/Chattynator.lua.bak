rdedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ketan\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Ketan's moment of excitement is replaced with a sudden stern expression on his face.\",\"id\":\"s24_2721\",\"timestamp\":1772819671},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:260478::::::::90:1480::60:1:13573:2:9:90:28:3321:::::|h[Ka'shuk Trainee's Warglaive]|h|r\",\"id\":\"s24_2722\",\"timestamp\":1772819684},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Akazi\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Akazi says: Starphage, you are now one of the Ka'dani. May the goddess guide you through your future hunts.\",\"id\":\"s24_2723\",\"timestamp\":1772819684},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Akazi\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Akazi says: Ketan, your sense of purpose, passion, and perseverance have brought you here.\",\"id\":\"s24_2724\",\"timestamp\":1772819689},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Akazi\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Akazi says: Step up to the hunt, Ka'dani Ketan. May the goddess guide you through your future hunts.\",\"id\":\"s24_2725\",\"timestamp\":1772819694},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ka'dani Ketan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ka'dani Ketan says: Thank you, Starphage, for everything that you have done for me. May the hunt forever be in your favor.\",\"id\":\"s24_2726\",\"timestamp\":1772819699},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"You sense a nearby Skyriding Glyph.\",\"id\":\"s24_2727\",\"timestamp\":1772819699},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx2\",\"id\":\"s24_2728\",\"timestamp\":1772819705},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx1\",\"id\":\"s24_2729\",\"timestamp\":1772819711},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Greenspeaker Cyenna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Greenspeaker Cyenna says: You're going to get bored of lazing about, Riverscale!\",\"id\":\"s24_2730\",\"timestamp\":1772819727},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Greenspeaker Cyenna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Greenspeaker Cyenna says: We settled here before the World Trees took root in Harandar.\",\"id\":\"s24_2731\",\"timestamp\":1772819735},{\"recordedBy\":\"Starphage-Tichondrius\",