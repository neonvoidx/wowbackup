["id"] = "s51_2593",
["timestamp"] = 1784560287,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Hakkar the Soulflayer",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Hakkar the Soulflayer yells: The power... was mine...",
["id"] = "s51_2594",
["timestamp"] = 1784560330,
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
