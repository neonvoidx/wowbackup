["text"] = "Noir-Spirestone receives loot: |cnIQ3:|T3395744:12|t|Hitem:180099::::::::82:66::22:3:6652:13609:7756:2:9:81:28:5383:::::|h[Breastplate of Brutal Dissonance (Chest 139)]|h|r.",
