},
["text"] = "|Hchannel:PARTY|h[Party]|h |Hplayer:Polarvoker-Mal'Ganis:1652:PARTY:|h[|cff33937fPolarvoker-Mal'Ganis|r]|h: |cff71d5ff|Hspell:1264378:0|h[Unravel]|h|r",
