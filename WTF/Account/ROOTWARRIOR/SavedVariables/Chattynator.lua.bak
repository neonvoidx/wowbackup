},
["color"] = {
["b"] = -0,
["g"] = 0.6666666865348816,
["r"] = -0,
},
["text"] = "You receive loot: |cnIQ1:|T1500877:12|t|Hitem:262752::::::::90:258:::::::::|h[Vilebranch Scroll]|h|r",
["id"] = "s51_4377",
["timestamp"] = 1785260979,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Enchanted Amani Mask",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Enchanted Amani Mask says: Malacrass infused avatars with de loa's power--avatars like your grandfather.",
["id"] = "s51_4378",
["timestamp"] = 1785260980,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zul'jan",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zul'jan says: So he researched Ula'tek. If Grandfather could wield de power of our greatest weapon, then...",
["id"] = "s51_4379",
["timestamp"] = 1785260989,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Enchanted Amani Mask",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Enchanted Amani Mask says: He could reclaim stolen lands. Rebuild de empire. Realize his dream.",
["id"] = "s51_4380",
["timestamp"] = 1785260999,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["race"] = "VoidElf",
["class"] = "PRIEST",
["name"] = "Neonvoid",
["sex"] = 3,
},
["event"] = "CHAT_MSG_LOOT",
["type"] = "LOOT",
},
["color"] = {
["b"] = -0,
["g"] = 0.6666666865348816,
["r"] = -0,
},
["text"] = "You receive loot: |cnIQ0:|T134339:12|t|Hitem:260614::::::::90:258:::::::::|h[Unrecognizable Organ]|h|rx2",
["id"] = "s51_4381",
["timestamp"] = 1785261004,
},
