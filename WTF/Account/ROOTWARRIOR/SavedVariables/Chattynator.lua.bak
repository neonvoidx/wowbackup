xt\":\"Decimus says: Excellent.\",\"id\":\"s20_3230\",\"timestamp\":1772225181},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Decimus says: Almost done! Your friends of the Vanguard of Light left some Light shards behind. Get one, will you?\",\"id\":\"s20_3231\",\"timestamp\":1772225186},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"MagharOrc\",\"class\":\"SHAMAN\",\"name\":\"Valkray-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Valkray-Tichondrius|h[|cff0070ddValkray|r]|h has earned the achievement |cffffff00|Hachievement:7328:Player-11-0E47C2F6:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Ironpaw Chef]|h|r!\",\"id\":\"s20_3232\",\"timestamp\":1772225186},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:248281::::::::87:1480:::::::::|h[Light Shard]|h|r\",\"id\":\"s20_3233\",\"timestamp\":1772225200},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Decimus says: Delicious. Now this will truly be a blade to remember.\",\"id\":\"s20_3234\",\"timestamp\":1772225208},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Climatechang-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Climatechang-Tichondrius|h[|cffff7c0aClimatechang|r]|h has earned the achievement |cffffff00|Hachievement:61855:Player-11-0E90740E:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Explore Eversong Woods]|h|r!\",\"id\":\"s20_3235\",\"timestamp\":1772225209},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Decimus says: I'm eager to see you in action once more.\",\"id\":\"s20_3236\",\"timestamp\":1772225223},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Decimus says: Let's continue our delightful romp at Nexus-Point Xenas. I will find you there.\",\"id\":\"s20_3237\",\"timestamp\":1772225225},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ravenia\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ravenia says: I will bring these ingredients to the cauldron, but you will do the cooking.\",\"id\":\"s20_3238\",\"timestamp\":1772225260},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ravenia\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ravenia says: I've placed the ingredients on these tables. You will perform the cooking. And the feeding. And the caring for the creature afterward.\",\"id\":\"s20_3239\",\"timestamp\":1772225265},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEATHKNIGHT\",\"name\":\"Pleaseclap-WyrmrestAccord\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Pleaseclap-WyrmrestAccord|h[|cffc41e3aPleaseclap-WyrmrestAccord|r]|h has earned the achievement |cffffff00|Hachievement:41805:Player-1171-080405AF:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Arator's Journey]|h|r!\",\"id\":\"s20_3240\",\"timestamp\":1772225274},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"PALADIN\",\"name\":\"Junkhog-Mannoroth\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Junkhog-Mannoroth|h[|cfff48cbaJunkhog-Mannoroth|r]|h has earned the achievement |cffffff00|Hachievement:61856:Player-77-0FA81358:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Explore Zul'Aman]|h|r!\",\"id\":\"s20_3241\",\"timestamp\":1772225286},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Fidoficus\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Fidoficus roars confidently at the tiny blistercreeps.\",\"id\":\"s20_3242\",\"timestamp\":1772225295},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Fidoficus\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Fidoficus postures ferociously at the void elves.\",\"id\":\"s20_3243\",\"timestamp\":1772225304},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ren'dorei Scout\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ren'dorei Scout says: He's really doing his best!\",\"id\":\"s20_3244\",\"timestamp\":1772225308},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeIn