},
["color"] = {
["b"] = -0,
["g"] = 0.6666666865348816,
["r"] = -0,
},
["text"] = "You receive loot: |cnIQ1:|T1500877:12|t|Hitem:262752::::::::90:258:::::::::|h[Vilebranch Scroll]|h|r",
["id"] = "s51_4384",
["timestamp"] = 1785261017,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Loa Speaker Kinduru",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Loa Speaker Kinduru says: Jan-boy, dis has gone far enough. We must stop following Malacrass's footsteps! Lest we anger de loa.",
["id"] = "s51_4385",
["timestamp"] = 1785261034,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zul'jan",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zul'jan says: De loa? If we can harness Ula'tek's power, we will not need de loa.",
["id"] = "s51_4386",
["timestamp"] = 1785261042,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Loa Speaker Kinduru",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Loa Speaker Kinduru says: How can you say dat? De loa made your sister hash'ey! Dey helped us defeat de Twilight's Blade!",
["id"] = "s51_4387",
["timestamp"] = 1785261048,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zul'jan",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zul'jan says: What about when de elves invaded our lands? When de Trollbanes hunted our people? When my grandfather was tortured?",
["id"] = "s51_4388",
["timestamp"] = 1785261056,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zul'jan",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zul'jan says: And still, we had to beg them to aid us against the Twilight's Blade.",
["id"] = "s51_4389",
["timestamp"] = 1785261065,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zul'jan",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zul'jan says: No, Uncle. We must take the power we need to protect the Amani, like my grandfather did.",
["id"] = "s51_4390",
["timestamp"] = 1785261073,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Loa Speaker Kinduru",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Loa Speaker Kinduru says: Your grandfather led de Amani to catastrophe, Zul'jan!",
["id"] = "s51_4391",
["timestamp"] = 1785261083,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zul'jan",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zul'jan says: My grandfather did what was needed. The Amani stand alone. And the Amani never die.",
["id"] = "s51_4392",
["timestamp"] = 1785261088,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Meredy Huntswell",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Meredy Huntswell says: Prepare yourselves. Necromancy is a serious matter. We need to stop the Vilebranch.",
["id"] = "s51_4393",
["timestamp"] = 1785261124,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Crenna Earth-Daughter",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Crenna Earth-Daughter says: Everyone get your buffs on.",
["id"] = "s51_4394",
["timestamp"] = 1785261127,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Meredy Huntswell",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Meredy Huntswell says: A mage table for all your summoned food needs.",
["id"] = "s51_4395",
["timestamp"] = 1785261129,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Captain Garrick",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Captain Garrick says: Check your adventure guide if you need more information about what we'll find here.",
["id"] = "s51_4396",
["timestamp"] = 1785261131,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Kul'amara the Fierce",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Kul'amara the Fierce says: Neonvoid. Oraka'zul! I am blessed ya be here to prowl with me.",
["id"] = "s51_4397",
["timestamp"] = 1785261159,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Frenzied Berserker",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
