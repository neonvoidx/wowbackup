["text"] = "Delibash-Mal'Ganis receives loot: |cnIQ4:|Hitem:263193::::::::90:1480::23:6:12779:13439:6652:12667:12699:13577:1:28:3025:::::|h[Trollhunter's Bands]|h|r.",
