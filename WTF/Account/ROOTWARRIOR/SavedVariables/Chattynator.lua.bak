},
["color"] = {
["r"] = -0,
["g"] = 0.6666666865348816,
["b"] = -0,
},
["text"] = "Noir-Spirestone receives loot: |cnIQ2:|T2032179:12|t|Hitem:178061::::::::81:66:::::::::|h[Malleable Flesh]|h|r.",
["timestamp"] = 1784592384,
["id"] = "s51_2803",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Kyrestia the Firstborne",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kyrestia the Firstborne says: You were the Paragon of Loyalty, Devos. And yet all this time, it was you who led the Forsworn.",
["timestamp"] = 1784592387,
["id"] = "s51_2804",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Devos",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Devos says: Your blind adherence to the path would have doomed us all. You left me no choice but to oppose you!",
["timestamp"] = 1784592398,
["id"] = "s51_2805",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Devos",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Devos says: Forsworn, see that the mortals do not interfere!",
["timestamp"] = 1784592407,
["id"] = "s51_2806",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Kin-Tara",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["r"] = 1,
["g"] = 0.250980406999588,
["b"] = 0.250980406999588,
},
["text"] = "Kin-Tara yells: You cannot hide!",
["timestamp"] = 1784592416,
["id"] = "s51_2807",
},
