OOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"|HlootHistory:3214|h[Loot]|h: You have selected Need for: |cnIQ2:|Hitem:264717::::::::90:1480::2:::::::|h[Amani Warding Hex]|h|r |HlootHistory:3214|h|cnLOOT_LINK_COLOR:[View Loot Rolls]|r|h\",\"timestamp\":1772812951,\"id\":\"s23_4471\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"|HlootHistory:3214|h[Loot]|h: You have rolled Need - 36 for: |cnIQ2:|Hitem:264717::::::::90:1480::2:::::::|h[Amani Warding Hex]|h|r\",\"timestamp\":1772812951,\"id\":\"s23_4472\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"|HlootHistory:3214|h[Loot]|h: Moistchicken (Need - 65, Main-Spec) Won: |cnIQ2:|Hitem:264717::::::::90:1480::2:::::::|h[Amani Warding Hex]|h|r\",\"timestamp\":1772812951,\"id\":\"s23_4473\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Moistchicken-Frostmourne\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Moistchicken-Frostmourne receives loot: |cnIQ2:|Hitem:264717::::::::90:1480::2:::::::|h[Amani Warding Hex]|h|r.\",\"timestamp\":1772812952,\"id\":\"s23_4474\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kul'amara the Fierce says: We will always be lookin' over our shoulders at de Vilebranch. Come back with me. De chief be havin' a reward for ya.\",\"timestamp\":1772812955,\"id\":\"s23_4475\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Prigmon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Prigmon says: Budd's been refinin' his forest troll disguise! Dey just need one last touch!\",\"timestamp\":1772812965,\"id\":\"s23_4476\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"Harronir\",\"name\":\"Hungryboy-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Hungryboy-Tichondrius|h[|cffff7c0aHungryboy|r]|h has earned the achievement |cffffff00|Hachievement:40436:Player-11-0EAE6597:1:3:6:26:4294967295:4294967295:4294967295:4294967295|h[You're Getting a Delve!]|h|r!\",\"timestamp\":1772812993,\"id\":\"s23_4477\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Prigmon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Prigmon says: My skinnin' talents are wasted here. Somethin' about yankin' troll tusks makes me queasy...\",\"timestamp\":1772812993,\"id\":\"s23_4478\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Mannuth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mannuth says: Stop! Do not rob me of my belongings, you heathens!\",\"timestamp\":1772812995,\"id\":\"s23_4479\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Mawago\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mawago says: Pah! What a selfish act!\",\"timestamp\":1772813002,\"id\":\"s23_4480\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Raiding Caster\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Raiding Caster says: Healers! Don't let me die!\",\"timestamp\":1772813010,\"id\":\"s23_4481\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Raiding Warrior\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Raiding Warrior says: I just wanted the frog...\",\"timestamp\":1772813019,\"id\":\"s23_4482\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Raiding Caster\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Raiding Caster says: Should have left this party months ago...\",\"timestamp\":1772813020,\"id\":\"s23_4483\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Raiding Warrior\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Raiding Warrior says: My mana burned out ages ago!\",\"timestamp\":1772813023,\"id\":\"s23_4484\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Raiding Caster\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Raiding Caster says: My mana burned out ages ago!\",\"timestamp\":1772813023,\"id\":\"s23_4485\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Melissa\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Melissa says: No! I've only just looted this charm!\",\"timestamp\":1772813027,\"id\":\"s23_4486\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Nøçht-Area52\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Nøçht-Area52|h[|cfffff468Nøçht-Area52|r]|h has earned the achievement |cffffff00|Hachievement:62291:Player-3676-0E863B66:1:3:6:26:4294967295:4294967295:4294967295:4294967295|h[Voidstorm: The Highest Peaks]|h|r!\",\"timestamp\":1772813079,\"id\":\"s23_4487\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"You sense a nearby Skyriding Glyph.\",\"timestamp\":1772813082,\"id\":\"s23_4488\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Mixer Jamanga\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mixer Jamanga says: You have de shell? Let us begin!\",\"timestamp\":1772813093,\"id\":\"s23_4489\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Mixer Jamanga\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mixer Jamanga says: Stand in de middle there and focus on de three ritual objects.\",\"timestamp\":1772813096,\"id\":\"s23_4490\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Mixer Jamanga\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Mixer Jamanga yells: Shadra, we bring your fang, eye, and shell together once more.\",\"timestamp\":1772813100,\"id\":\"s23_4491\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Mixer Jamanga\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Mixer Jamanga yells: Return to your loyal Witherbark and Revantusk!\",\"timestamp\":1772813104,\"id\":\"s23_4492\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Mixer Jamanga\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mixer Jamanga says: An egg has formed!\",\"timestamp\":1772813107,\"id\":\"s23_4493\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Mixer Jamanga\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mixer Jamanga says: You'll have to assist it in hatchin'--carefully now!\",\"timestamp\":1772813110,\"id\":\"s23_4494\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Shadra\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Shadra yells: I am reborn!\",\"timestamp\":1772813116,\"id\":\"s23_4495\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Nija Torntusk\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Nija Torntusk says: I am... relieved I was wrong. And dat we fought our real enemies together. And found a new, old ally.\",\"timestamp\":1772813118,\"id\":\"s23_4496\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Mixer Jamanga\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mixer Jamanga says: Shadra, de Witherbark are honored to have you back among us.\",\"timestamp\":1772813119,\"id\":\"s23_4497\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Nija Torntusk\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Nija Torntusk says: I will go with you, Starphage.\",\"timestamp\":1772813121,\"id\":\"s23_4498\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Mixer Jamanga\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mixer Jamanga says: Yes, having Shadra back is a wonderful boon. Perhaps she needs a speaker. Or two? Ah! We need to tell de chief!\",\"timestamp\":1772813125,\"id\":\"s23_4499\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Nija Torntusk\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Nija Torntusk says: And Nalorakk's Revantusk are ready to work with you, de Witherbark, and Halazzi against our common enemies.\",\"timestamp\":1772813125,\"id\":\"s23_4500\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Shadra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Shadra says: Hm. It seems there is much to do. I think I was reborn at just the right time.\",\"timestamp\":1772813130,\"id\":\"s23_4501\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Vun'zarah\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Vun'zarah says: Nija. I had wondered why you had come to our village. Was it for Shadra?\",\"timestamp\":1772813146,\"id\":\"s23_4502\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Shadra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Shadra says: They will never see us coming, Halazzi. We will have such fun--like the old days.\",\"timestamp\":1772813147,\"id\":\"s23_4503\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Nija Torntusk\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Nija Torntusk says: No, I came from de Hinterlands where de Witherbark hunted Revantusk. I wanted to know if de Witherbark here kept the old ways or if refugees like me are truly safe.\",\"timestamp\":1772813151,\"id\":\"s23_4504\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Vun'zarah\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Vun'zarah says: It is different here. The Witherbark were and always will be your allies. We do what we can to keep us all safe. The Vilebranch are our true enemy.\",\"timestamp\":1772813160,\"id\":\"s23_4505\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"You sense a nearby Skyriding Glyph.\",\"timestamp\":1772813165,\"id\":\"s23_4506\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Nija Torntusk\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Nija Torntusk says: We all gotta resist de Vilebranch together.\",\"timestamp\":1772813169,\"id\":\"s23_4507\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Vun'zarah\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Vun'zarah says: Dat is truth. And with our loa, we gonna do more than resist!\",\"timestamp\":1772813172,\"id\":\"s23_4508\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Loa Speaker Kinduru says: Many are still recoverin' from de Twilight's Blade attack. Help us gather herbs 'round de Shrine of Kulzi for medicine.\",\"timestamp\":1772813196,\"id\":\"s23_4509\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ1:|Hitem:267005::::::::90:1480:::::::::|h[Rakan's Totem]|h|r\",\"timestamp\":1772813259,\"id\":\"s23_4510\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Rakan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Rakan says: De loa will do de heavy liftin' through dat totem. You are just transferrin' their power.\",\"timestamp\":1772813259,\"id\":\"s23_4511\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Rakan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Rakan says: Akil'zon. Loa of Victory. Lord of de sky, de wind, de rain, and de thunder!\",\"timestamp\":1772813283,\"id\":\"s23_4512\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Rakan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Rakan says: She's been guiding de Amani since we came to dis land and has remained de embodiment and icon of our tribe all dis time.\",\"timestamp\":1772813289,\"id\":\"s23_4513\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kaziil\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kaziil says: Halazzi. Loa of de Hunt. Agile, cunning, patient. An ideal hunter in all lands, and in pursuit of any prey.\",\"timestamp\":1772813300,\"id\":\"s23_4514\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kaziil\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kaziil says: Witherbark from all over Zul'Aman make pilgrimage to Halazzi's temple to leave a piece of their hunts in worship.\",\"timestamp\":1772813308,\"id\":\"s23_4515\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Rul'ari\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Rul'ari says: Jan'alai. Loa of Fire. Master of magics and de flame inside each livin' being.\",\"timestamp\":1772813313,\"id\":\"s23_4516\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"MAGE\",\"race\":\"BloodElf\",\"name\":\"Jakiiro-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Jakiiro-Tichondrius|h[|cff3fc7ebJakiiro|r]|h has earned the achievement |cffffff00|Hachievement:61576:Player-11-0E521C49:1:3:6:26:4294967295:4294967295:4294967295:4294967295|h[Eversong Woods Glyph Hunter]|h|r!\",\"timestamp\":1772813315,\"id\":\"s23_4517\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kaziil\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kaziil says: Including de Witherbark children fishin' up breakfast along de shore!\",\"timestamp\":1772813315,\"id\":\"s23_4518\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Rul'ari\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Rul'ari says: Shadowpine became de primary worshippers of Jan'alai long ago when an ancient loa speaker led de tribe to safety because a vision seen in de temple fires.\",\"timestamp\":1772813320,\"id\":\"s23_4519\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Du'gal\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Du'gal says: You may use this altar to worship as often as you wish.\",\"timestamp\":1772813329,\"id\":\"s23_4520\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"NightElf\",\"name\":\"Helapvp-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Helapvp-Tichondrius|h[|cffa330c9Helapvp|r]|h has earned the achievement |cffffff00|Hachievement:61641:Player-11-0E3414CA:1:3:6:26:4294967295:4294967295:4294967295:4294967295|h[The Blinding Vale]|h|r!\",\"timestamp\":1772813342,\"id\":\"s23_4521\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Du'gal\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Du'gal says: There are many loa of lesser domains here in Zul'Aman. Seek them out and return here to receive their blessings.\",\"timestamp\":1772813345,\"id\":\"s23_4522\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Starphage-Tichondrius|h[|cffa330c9Starphage|r]|h has earned the achievement |cffffff00|Hachievement:62270:Player-11-0EA2971B:1:3:6:26:4294967295:4294967295:4294967295:4294967295|h[Altar of Blessings: One for Altar]|h|r!\",\"timestamp\":1772813345,\"id\":\"s23_4523\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Starphage-Tichondrius|h[|cffa330c9Starphage|r]|h has earned the achievement |cffffff00|Hachievement:62270:Player-11-0EA2971B:1:3:6:26:4294967295:4294967295:4294967295:4294967295|h[Altar of Blessings: One for Altar]|h|r!\",\"timestamp\":1772813345,\"id\":\"s23_4524\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Amala\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Amala says: Nalorakk. Loa of War. Stubborn and unforgiving, but fiercely loyal to his worshippers.\",\"timestamp\":1772813354,\"id\":\"s23_4525\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Amala\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Amala says: De Revantusk favor him most out of de four great ones due to dis straight-forward attitude, as well as his battlefield mastery.\",\"timestamp\":1772813360,\"id\":\"s23_4526\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"WARLOCK\",\"race\":\"Dwarf\",\"name\":\"Alyrimistsex-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Alyrimistsex-Tichondrius|h[|cff8788eeAlyrimistsex|r]|h has earned the achievement |cffffff00|Hachievement:62270:Player-11-0E98A0E9:1:3:6:26:4294967295:4294967295:4294967295:4294967295|h[Altar of Blessings: One for Altar]|h|r!\",\"timesta