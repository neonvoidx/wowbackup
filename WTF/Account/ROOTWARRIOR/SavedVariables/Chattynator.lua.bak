["b"] = 0.250980406999588,
},
["text"] = "|Hplayer:Idealtoheal-Tichondrius|h[|cffffffffIdealtoheal|r]|h has earned the achievement |cffffff00|Hachievement:61225:Player-11-0E754C36:1:3:14:26:4294967295:4294967295:4294967295:4294967295|h[Investigating the Rise]|h|r!",
