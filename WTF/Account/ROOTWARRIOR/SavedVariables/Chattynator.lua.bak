},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Sabellian says: I cannot... move...",
["id"] = "s51_4798",
["timestamp"] = 1785284106,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Wrathion",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Wrathion says: What... are you?",
["id"] = "s51_4799",
["timestamp"] = 1785284110,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Neltharion",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Neltharion says: I am the whisper in the dark.",
["id"] = "s51_4800",
["timestamp"] = 1785284114,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Neltharion",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Neltharion says: I had hoped you would see the value of the gifts I offered. Yet you rejected them.",
["id"] = "s51_4801",
["timestamp"] = 1785284117,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
