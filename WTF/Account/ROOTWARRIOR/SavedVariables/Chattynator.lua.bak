{
["startTimestamp"] = 1774803751,
["data"] = "[{\"recordedBy\":\"Strathmoan-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Valeera Sanguinar says: My eye's on you.\",\"id\":\"s35_5000\",\"timestamp\":1774803751},{\"recordedBy\":\"Strathmoan-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 9 Gold, 20 Silver, 59 Copper\",\"id\":\"s36_2502\",\"timestamp\":1774803753},{\"recordedBy\":\"Strathmoan-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Talvis Tenthoven\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Talvis Tenthoven says: This teaching approach confuses me. It seems rather questionable to invite the Twilight Blade here.\",\"id\":\"s36_2503\",\"timestamp\":1774803754},{\"recordedBy\":\"Strathmoan-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Thalassian Professor\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Thalassian Professor says: Do not worry, students, Strathmoan is merely here as part of this demonstration.\",\"id\":\"s36_2504\",\"timestamp\":1774803758},{\"recordedBy\":\"Strathmoan-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Valeera Sanguinar says: Won't see me coming.\",\"id\":\"s36_2505\",\"timestamp\":1774803761},{\"recordedBy\":\"Strathmoan-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Valeera Sanguinar says: Your pain, my pleasure.\",\"id\":\"s36_2506\",\"timestamp\":1774803765},{\"recordedBy\":\"Strathmoan-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Eryndar Spellbinder\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Eryndar Spellbinder yells: Enough of this charade. It is time to put an end to Strathmoan.\",\"id\":\"s36_2507\",\"timestamp\":1774803770},{\"recordedBy\":\"Strathmoan-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 2 Gold, 89 Silver, 58 Copper\",\"id\":\"s36_2508\",\"timestamp\":1774803772},{\"recordedBy\":\"Strathmoan-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"ROGUE\",\"name\":\"Tmspongwoqt-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Tmspongwoqt-Tichondrius|h[|cfffff468Tmspongwoqt|r]|h has earned the achievement |cffffff00|Hachievement:397:Player-11-0EB46C08:1:3:29:26:4294967295:4294967295:4294967295:4294967295|h[Step Into The Arena]|h|r!\",\"id\":\"s36_2509\",\"timestamp\":1774803787},{\"recordedBy\":\"Strathmoan-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Valeera Sanguinar says: Now strike!\",\"id\":\"s36_2510\",\"timestamp\":1774803803},{\"recordedBy\":\"Strathmoan-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"DEATHKNIGHT\",\"name\":\"Strathmoan-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Strathmoan-Tichondrius|h[|cffc41e3aStrathmoan|r]|h has earned the achievement |cffffff00|Hachievement:61726:Player-11-0EB43A45:1:3:29:26:4294967295:4294967295:4294967295:429496729