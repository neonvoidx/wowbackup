edBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 1 Gold, 42 Silver, 14 Copper\",\"timestamp\":1772218510,\"id\":\"s20_2527\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Forlorn Inventor\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Forlorn Inventor says: A mortal! Your soul shall renew my creation!\",\"timestamp\":1772218521,\"id\":\"s20_2528\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Forlorn Inventor\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Forlorn Inventor says: Relief... At last...\",\"timestamp\":1772218533,\"id\":\"s20_2529\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 2 Gold, 31 Silver, 56 Copper\",\"timestamp\":1772218538,\"id\":\"s20_2530\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"WARRIOR\",\"race\":\"Tauren\",\"name\":\"Minotaur-Bonechewer\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Minotaur-Bonechewer|h[|cffc69b6dMinotaur-Bonechewer|r]|h has earned the achievement |cffffff00|Hachievement:1799:Player-1136-07EC844D:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Chef de Cuisine]|h|r!\",\"timestamp\":1772218576,\"id\":\"s20_2531\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Darkened Unbound\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Darkened Unbound says: The Void... unmakes us...\",\"timestamp\":1772218584,\"id\":\"s20_2532\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Entropy Orbiter\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Entropy Orbiter says: Return. To nothing.\",\"timestamp\":1772218593,\"id\":\"s20_2533\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Entropy Orbiter\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Entropy Orbiter says: I fade away.\",\"timestamp\":1772218607,\"id\":\"s20_2534\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Darkened Unbound\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Darkened Unbound says: Was there... no other way...?\",\"timestamp\":1772218610,\"id\":\"s20_2535\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260659::::::::86:1480:::::::::|h[Stellar Vortex Residue]|h|r\",\"timestamp\":1772218611,\"id\":\"s20_2536\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 2 Gold, 17 Silver\",\"timestamp\":1772218612,\"id\":\"s20_2537\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Xal'atath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Xal'atath says: A pity Alleria has to die. Her dark naaru would make a far more effective weapon than this one.\",\"timestamp\":1772218633,\"id\":\"s20_2538\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Xal'atath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Xal'atath says: If only your Shadowguard had captured it before she claimed its power all those years ago.\",\"timestamp\":1772218644,\"id\":\"s20_2539\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Xal'atath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Xal'atath says: Your foes work quickly, Salhadaar. You had best redouble your efforts to turn the naaru before it's too late. Again.\",\"timestamp\":1772218653,\"id\":\"s20_2540\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"WARLOCK\",\"race\":\"BloodElf\",\"name\":\"Dolphinz-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Dolphinz-Tichondrius|h[|cff8788eeDolphinz|r]|h has earned the achievement |cffffff00|Hachievement:61508:Player-11-09C892D3:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Voidscar Arena]|h|r!\",\"timestamp\":1772218654,\"id\":\"s20_2541\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Nexus-King Salhadaar\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Nexus-King Salhadaar yells: Enough of your veiled threats, Xal'atath! You will have your naaru and I will have what I am owed!\",\"timestamp\":1772218665,\"id\":\"s20_2542\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: This is taking too long. Stand aside, I'll smash the damned thing.\",\"timestamp\":1772218686,\"id\":\"s20_2543\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:264340::::::::86:1480::11::1:28:3084:::::|h[Cosmic Barrel]|h|r\",\"timestamp\":1772218689,\"id\":\"s20_2544\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"WARLOCK\",\"race\":\"Human\",\"name\":\"Ppoonlock-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Ppoonlock-Tichondrius|h[|cff8788eePpoonlock|r]|h has earned the achievement |cffffff00|Hachievement:61835:Player-11-0E2D423B:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Delves: Tier 2]|h|r!\",\"timestamp\":1772218692,\"id\":\"s20_2545\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: No, Lothraxion! Starphage, we need your eyes.\",\"timestamp\":1772218692,\"id\":\"s20_2546\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Entropy Orbiter\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Entropy Orbiter says: Consume. Kill.\",\"timestamp\":1772218716,\"id\":\"s20_2547\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Insatiable Watcher\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Insatiable Watcher says: HUNGER. WITHOUT. END.\",\"timestamp\":1772218737,\"id\":\"s20_2548\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Insatiable Watcher\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Insatiable Watcher says: EAT... OR BE...\",\"timestamp\":1772218750,\"id\":\"s20_2549\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260659::::::::86:1480:::::::::|h[Stellar Vortex Residue]|h|r\",\"timestamp\":1772218752,\"id\":\"s20_2550\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260611::::::::86:1480:::::::::|h[Large Bestial Scale]|h|r\",\"timestamp\":1772218752,\"id\":\"s20_2551\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 2 Gold, 87 Silver, 26 Copper\",\"timestamp\":1772218753,\"id\":\"s20_2552\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:263282::::::::86:1480::11:2:13573:6652:2:9:86:28:3084:::::|h[Repurposed Volatile Manacell]|h|r\",\"timestamp\":1772218766,\"id\":\"s20_2553\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"T'era\"},\"event\":\"CHAT_MSG_MONSTER_WHISPER\",\"type\":\"MONSTER_WHISPER\"},\"color\":{\"r\":1,\"g\":0.7098039388656616,\"b\":0.9215686917304993},\"text\":\"T'era whispers: Dusk... Beckons...\",\"timestamp\":1772218766,\"id\":\"s20_2554\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: We need that shield down, now!\",\"timestamp\":1772218771,\"id\":\"s20_2555\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Xal'atath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Xal'atath says: Complete your task and return to the Voidspire, Salhadaar. You shall have the power you were promised.\",\"timestamp\":1772218775,\"id\":\"s20_2556\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Xal'atath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Xal'atath says: So long as you remain gracious in accepting it, of course.\",\"timestamp\":1772218785,\"id\":\"s20_2557\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Nexus-King Salhadaar\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Nexus-King Salhadaar yells: The naaru has fallen! All this power... pledged to Xal'atath... while I have nothing in return!\",\"timestamp\":1772218787,\"id\":\"s20_2558\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Nexus-King Salhadaar\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Nexus-King Salhadaar yells: Even now, in my moment of victory, I must bow and scrape before her!\",\"timestamp\":1772218797,\"id\":\"s20_2559\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Nexus-King Salhadaar\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Nexus-King Salhadaar yells: How I wish I could watch you all die! T'era, destroy them!\",\"timestamp\":1772218805,\"id\":\"s20_2560\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"T'era\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"T'era says: The brightest Light casts the longest shadow.\",\"timestamp\":1772218814,\"id\":\"s20_2561\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: I will not allow this!\",\"timestamp\":1772218819,\"id\":\"s20_2562\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Unknown\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Unknown says: No! You... must...!\",\"timestamp\":1772218848,\"id\":\"s20_2563\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: It's her or us! We have to fight!\",\"timestamp\":1772218853,\"id\":\"s20_2564\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"T'era\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"T'era says: Be unmade.\",\"timestamp\":1772218857,\"id\":\"s20_2565\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: The Void! It's too much!\",\"timestamp\":1772218872,\"id\":\"s20_2566\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: Arator! No!\",\"timestamp\":1772218876,\"id\":\"s20_2567\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:260833::::::::86:1480::11:2:13573:6652:2:9:86:28:3084:::::|h[Cowl of Infinite Gravity]|h|r\",\"timestamp\":1772218975,\"id\":\"s20_2568\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: A naaru, lost to us!\",\"timestamp\":1772218975,\"id\":\"s20_2569\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: Mother, the toll you've taken... We should fall back and recover.\",\"timestamp\":1772218980,\"id\":\"s20_2570\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: I had no idea Lady Windrunner held a dark naaru of her own. This is more than mere entertainment...\",\"timestamp\":1772218988,\"id\":\"s20_2571\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"Tauren\",\"name\":\"Geöspäwn-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Geöspäwn-Tichondrius|h[|cfff48cbaGeöspäwn|r]|h has earned the achievement |cffffff00|Hachievement:62288:Player-11-0AEAEF4B:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Eversong Woods: The Highest Peaks]|h|r!\",\"timestamp\":1772218994,\"id\":\"s20_2572\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"You sense a nearby Skyriding Glyph.\",\"timestamp\":1772218998,\"id\":\"s20_2573\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: Ignore it, Arator. See to Alleria. Salvaging this mission now falls to me.\",\"timestamp\":1772218998,\"id\":\"s20_2574\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: Arator, you must ensure that no harm comes to Decimus. They have the answers we need. Trust me.\",\"timestamp\":1772219007,\"id\":\"s20_2575\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftwalker Hieron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftwalker Hieron says: Stay with us, Astre. Feel my hand in yours.\",\"timestamp\":1772219013,\"id\":\"s20_2576\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: The dark naaru within you, mother... I never understood just how exhausting it must be to maintain control over it.\",\"timestamp\":1772219016,\"id\":\"s20_2577\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: I do. I will.\",\"timestamp\":1772219017,\"id\":\"s20_2578\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftwalker Hieron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftwalker Hieron says: I'm sorry, but I need a little longer with them. Check with Maella. Her report is more thorough than mine anyway.\",\"timestamp\":1772219019,\"id\":\"s20_2579\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Overwhelmed Scout\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Overwhelmed Scout says: These whispers suffocate my senses.\",\"timestamp\":1772219021,\"id\":\"s20_2580\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: Or how lonely it's been for you, protecting us from it.\",\"timestamp\":1772219024,\"id\":\"s20_2581\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: For you, my son, I could endure anything. I know at times, I have been somewhat... cold.\",\"timestamp\":1772219028,\"id\":\"s20_2582\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ1:|Hitem:238500::::::::86:1480:::::::::|h[Maella's Report]|h|r\",\"timestamp\":1772219028,\"id\":\"s20_2583\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Maella\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Maella says: Here. Hieron is too modest. You can tell him I said that.\",\"timestamp\":1772219029,\"id\":\"s20_2584\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Maella\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Maella says: The whispers grow evermore enticing, but we stand strong. Our mission demands it.\",\"timestamp\":1772219035,\"id\":\"s20_2585\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: How could this have gone so wrong? We're no closer to bringing the forces of the Light to bear on this world.\",\"timestamp\":1772219035,\"id\":\"s20_2586\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: Stop. Don't apologize for--\",\"timestamp\":1772219037,\"id\":\"s20_2587\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: You and Lady Windrunner are simply wonderful. I've not encountered such capable mortals in my many travels.\",\"timestamp\":1772219039,\"id\":\"s20_2588\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: I need you to hear me, Arator. Understand, it's not the naaru within me that creates the distance between us.\",\"timestamp\":1772219040,\"id\":\"s20_2589\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"Tauren\",\"name\":\"Geöspäwn-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Geöspäwn-Tichondrius|h[|cfff48cbaGeöspäwn|r]|h has earned the achievement |cffffff00|Hachievement:61855:Player-11-0AEAEF4B:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Explore Eversong Woods]|h|r!\",\"timestamp\":1772219041,\"id\":\"s20_2590\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: You must feel it too, Starphage. A waiting betrayal. I know what must be done.\",\"timestamp\":1772219044,\"id\":\"s20_2591\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: It's the fight. I know.\",\"timestamp\":1772219049,\"id\":\"s20_2592\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: I'm eager to see what violence you may next wreak.\",\"timestamp\":1772219051,\"id\":\"s20_2593\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: But you need to understand. You can't protect me from what's out there. And you can't scare me away, either. My fight is by your side.\",\"timestamp\":1772219051,\"id\":\"s20_2594\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Overwhelmed Scout\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Overwhelmed Scout says: You're right. I should sit with the others.\",\"timestamp\":1772219057,\"id\":\"s20_2595\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: What comes, mother, we will face together.\",\"timestamp\":1772219060,\"id\":\"s20_2596\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Overwhelmed Scout\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Overwhelmed Scout says: W-Who's there? Stay away!\",\"timestamp\":1772219062,\"id\":\"s20_2597\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Alleria gazes at Arator with a mournful expression and then looks away.\",\"timestamp\":1772219063,\"id\":\"s20_2598\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lady Darkglen\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lady Darkglen says: Dust yourself off, ren'dorei. You have not succumbed yet.\",\"timestamp\":1772219080,\"id\":\"s20_2599\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: About your father. When he--wait. Did you hear that?\",\"timestamp\":1772219085,\"id\":\"s20_2600\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Lothraxion yells: You've been subverting us all along! Be eradicated, Decimus!\",\"timestamp\":1772219087,\"id\":\"s20_2601\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: Arator! Stop them!\",\"timestamp\":1772219105,\"id\":\"s20_2602\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: We have to move!\",\"timestamp\":1772219109,\"id\":\"s20_2603\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"You sense a nearby Skyriding Glyph.\",\"timestamp\":1772219111,\"id\":\"s20_2604\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"MAGE\",\"race\":\"Orc\",\"name\":\"Fireysquirts-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Fireysquirts-Tichondrius|h[|cff3fc7ebFireysquirts|r]|h has earned the achievement |cffffff00|Hachievement:153:Player-11-0E013D50:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[The Old Gnome and the Sea]|h|r!\",\"timestamp\":1772219113,\"id\":\"s20_2605\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: You are a paladin, Arator! You must see this Decimus for the monster it is!\",\"timestamp\":1772219113,\"id\":\"s20_2606\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: Starphage, empower me with the Light and I'll try to restrain them!\",\"timestamp\":1772219120,\"id\":\"s20_2607\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_RAID_BOSS_EMOTE\",\"type\":\"MONSTER_BOSS_EMOTE\"},\"color\":{\"r\":1,\"g\":0.8666667342185974,\"b\":0},\"text\":\"Lothraxion's wrathful Light sears your flesh! Infuse Arator with its power!\",\"timestamp\":1772219142,\"id\":\"s20_2608\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: Jumping at shadows, in fear of deceit? Quite a unique variety of nathrezim you are, Lothraxion.\",\"timestamp\":1772219146,\"id\":\"s20_2609\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_RAID_BOSS_EMOTE\",\"type\":\"MONSTER_BOSS_EMOTE\"},\"color\":{\"r\":1,\"g\":0.8666667342185974,\"b\":0},\"text\":\"Too much wrathful Light sears your flesh! Infuse Arator with its power!\",\"timestamp\":1772219154,\"id\":\"s20_2610\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: The Light... it burns with Lothraxion's wrath... just like my father's...\",\"timestamp\":1772219156,\"id\":\"s20_2611\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: I was reforged in the Light! You are blind to the truth!\",\"timestamp\":1772219158,\"id\":\"s20_2612\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_RAID_BOSS_EMOTE\",\"type\":\"MONSTER_BOSS_EMOTE\"},\"color\":{\"r\":1,\"g\":0.8666667342185974,\"b\":0},\"text\":\"Too much wrathful Light sears your flesh! Infuse Arator with its power!\",\"timestamp\":1772219163,\"id\":\"s20_2613\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"WARLOCK\",\"race\":\"Human\",\"name\":\"Ppoonlock-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Ppoonlock-Tichondrius|h[|cff8788eePpoonlock|r]|h has earned the achievement |cffffff00|Hachievement:62388:Player-11-0E2D423B:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Illicit Rain: Five Stars]|h|r!\",\"timestamp\":1772219181,\"id\":\"s20_2614\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Arator yells: Cease!\",\"timestamp\":1772219214,\"id\":\"s20_2615\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: By the Light's mercy, I command you both to yield! We have no shortage of enemies!\",\"timestamp\":1772219218,\"id\":\"s20_2616\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: ... Gave myself away, did I?\",\"timestamp\":1772219224,\"id\":\"s20_2617\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: And we need not create them where we might find allies. Decimus is more than they seem.\",\"timestamp\":1772219225,\"id\":\"s20_2618\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: You seek power, Decimus. Xal'atath will not give you what you want, but her defeat might. Join us.\",\"timestamp\":1772219228,\"id\":\"s20_2619\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: Truly fascinating. You continue to defy expectations.\",\"timestamp\":1772219238,\"id\":\"s20_2620\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Magisstorm-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Magisstorm-Tichondrius|h[|cff0070ddMagisstorm|r]|h has earned the achievement |cffffff00|Hachievement:153:Player-11-0EAC3E8E:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[The Old Gnome and the Sea]|h|r!\",\"timestamp\":1772219240,\"id\":\"s20_2621\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: This beast is off its leash!\",\"timestamp\":1772219246,\"id\":\"s20_2622\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:260855::::::::86:1480::11:2:13573:6652:2:9:86:28:3084:::::|h[Pauldrons of Infinite Gravity]|h|r\",\"timestamp\":1772219248,\"id\":\"s20_2623\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: You'd follow this creature to its foul den?\",\"timestamp\":1772219251,\"id\":\"s20_2624\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: If you prefer to keep throwing naaru at Nexus-Points, don't let me stop you.\",\"timestamp\":1772219257,\"id\":\"s20_2625\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"You sense a nearby Skyriding Glyph.\",\"timestamp\":1772219262,\"id\":\"s20_2626\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: Ah, the rest of our party arrives. Were there time, I'd have you for dinner.\",\"timestamp\":1772219278,\"id\":\"s20_2627\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: Make yourself at home. Then we can discuss weakening the storm.\",\"timestamp\":1772219282,\"id\":\"s20_2628\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ4:|Hcurrency:3400:0|h[Uncontaminated Void Sample]|h|rx1\",\"timestamp\":1772219288,\"id\":\"s20_2629\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Void Researcher Anomander\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Void Researcher Anomander says: Being here is an opportunity. Our understanding of the Void will grow by leaps and bounds if we learn from the domanaar. Assist me when you are able.\",\"timestamp\":1772219288,\"id\":\"s20_2630\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: This is the most stable place for a portal, but Decimus's beast is in the way.\",\"timestamp\":1772219313,\"id\":\"s20_2631\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftwalker Malloril\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftwalker Malloril says: Careful, Starphage. This beast looks hungry.\",\"timestamp\":1772219341,\"id\":\"s20_2632\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftwalker Malloril\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftwalker Malloril says: It seems even the skies here are full of teeth.\",\"timestamp\":1772219348,\"id\":\"s20_2633\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ0:|Hitem:260662::::::::86:1480:::::::::|h[Polished Purple Pebble]|h|r\",\"timestamp\":1772219361,\"id\":\"s20_2634\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: I thought you and Lothraxion were friends.\",\"timestamp\":1772219369,\"id\":\"s20_2635\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: We were--We are. He's not wrong to distrust the Void. I only wish he would trust me.\",\"timestamp\":1772219373,\"id\":\"s20_2636\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:246268::::::::86:1480:::::::::|h[A Steamy Romance Novel: Voidlust]|h|r\",\"timestamp\":1772219377,\"id\":\"s20_2637\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: Come, Starphage. I have so much to show you.\",\"timestamp\":1772219391,\"id\":\"s20_2638\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: Borrow my pet's sight. I'll tell you how to weaken the storm.\",\"timestamp\":1772219394,\"id\":\"s20_2639\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: The key to weakening the storm is an artifact known as the Mantle of Predation.\",\"timestamp\":1772219420,\"id\":\"s20_2640\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: With it, you may enter a Nexus-Point and simply shut it down. Doing so will nullify the others in a cascade.\",\"timestamp\":1772219428,\"id\":\"s20_2641\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: Why merely shut down the Nexus-Points? We should raze them from within.\",\"timestamp\":1772219443,\"id\":\"s20_2642\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: And cause an energy surge that would obliterate precious Silvermoon? Shut them down safely--spare your poor city.\",\"timestamp\":1772219450,\"id\":\"s20_2643\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Terminas\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Terminas says: Hello little morsel. How did you drift so close?\",\"timestamp\":1772219457,\"id\":\"s20_2644\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_SKILL\",\"type\":\"SKILL\"},\"color\":{\"r\":0.3333333432674408,\"g\":0.3333333432674408,\"b\":1},\"text\":\"Your skill in Warglaives has increased to 435.\",\"timestamp\":1772219481,\"id\":\"s20_2645\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:260859::::::::87:1480::11:3:13573:6652:13668:2:9:86:28:3084:::::|h[Thorny Necklace]|h|r\",\"timestamp\":1772219481,\"id\":\"s20_2646\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: Steal the Mantle of Predation, enter a Nexus-Point, and weaken the storm. Oh, Terminas will be humiliated.\",\"timestamp\":1772219482,\"id\":\"s20_2647\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: Make haste. We should have the Mantle before Terminas returns to his citadel.\",\"timestamp\":1772219510,\"id\":\"s20_2648\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Maella\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Maella says: In his absence, Terminas's lieutenants control access to his vault.\",\"timestamp\":1772219525,\"id\":\"s20_2649\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Maella\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Maella says: Torentia controls the trench, Severum guards the upper citadel.\",\"timestamp\":1772219528,\"id\":\"s20_2650\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: I'll hunt down Severum. You and this voidspawn can handle the trench.\",\"timestamp\":1772219533,\"id\":\"s20_2651\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: This is no time to go off on your own!\",\"timestamp\":1772219539,\"id\":\"s20_2652\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Riftblade Maella\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Riftblade Maella says: We'll follow him, my lady. Ren'dorei, with me.\",\"timestamp\":1772219542,\"id\":\"s20_2653\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: Break her toys and fight to the top of the food chain. Dear little Torentia will take it as a challenge.\",\"timestamp\":1772219546,\"id\":\"s20_2654\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Torentia\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Torentia yells: No, you won't take this from me!\",\"id\":\"s20_2655\",\"timestamp\":1772219694},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Draenei\",\"class\":\"MAGE\",\"name\":\"Domiitius-Bonechewer\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Domiitius-Bonechewer|h[|cff3fc7ebDomiitius-Bonechewer|r]|h has earned the achievement |cffffff00|Hachievement:61401:Player-1136-09359A83:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Heroic Edition: Lightwing Dragonhawk]|h|r!\",\"id\":\"s20_2656\",\"timestamp\":1772219702},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Draenei\",\"class\":\"MAGE\",\"name\":\"Domiitius-Bonechewer\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Domiitius-Bonechewer|h[|cff3fc7ebDomiitius-Bonechewer|r]|h has earned the achievement |cffffff00|Hachievement:61402:Player-1136-09359A83:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Epic Edition: Voidlight Surger]|h|r!\",\"id\":\"s20_2657\",\"timestamp\":1772219702},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"Draenei\",\"class\":\"MAGE\",\"name\":\"Domiitius-Bonechewer\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Domiitius-Bonechewer|h[|cff3fc7ebDomiitius-Bonechewer|r]|h has earned the achievement |cffffff00|Hachievement:2142:Player-1136-09359A83:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Filling Up The Barn]|h|r!\",\"id\":\"s20_2658\",\"timestamp\":1772219702},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"PRIEST\",\"name\":\"Twìtch-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Twìtch-Tichondrius:3732:GUILD:|h[|cffffffffTwìtch|r]|h: i feel very laggy\",\"id\":\"s20_2659\",\"timestamp\":1772219757},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"PALADIN\",\"name\":\"Junkhog-Mannoroth\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Junkhog-Mannoroth:3733:GUILD:|h[|cfff48cbaJunkhog|r]|h: ya definitely \",\"id\":\"s20_2660\",\"timestamp\":1772219810},{\"reco