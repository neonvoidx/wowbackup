["r"] = 1,
},
["text"] = "The nearby guard glares at you and the void energy that you surround yourself with.",
["id"] = "s51_3188",
["timestamp"] = 1785174062,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Alliance Battlemage",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Alliance Battlemage says: Neonvoid? What are you doing here? We need you up on the Skyfire! Quick, take the portal!",
["id"] = "s51_3189",
["timestamp"] = 1785174190,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Ethereal Warpweaver",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Ethereal Warpweaver says: My skills in warpweaving can only do so much to help you. But I shall do my best.",
["id"] = "s51_3190",
["timestamp"] = 1785174605,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Crane Style Initiate",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Crane Style Initiate says: Our efforts are going to pay off, I know it.",
["timestamp"] = 1785174852,
["id"] = "s51_3191",
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Ban-Lu",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Ban-Lu says: Where are we going today, Grandmaster?",
["timestamp"] = 1785174866,
["id"] = "s51_3192",
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Ban-Lu",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Ban-Lu says: Farewell!",
["timestamp"] = 1785174919,
["id"] = "s51_3193",
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Lorewalker Cho",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["r"] = 1,
["g"] = 0.250980406999588,
["b"] = 0.250980406999588,
},
["text"] = "Lorewalker Cho yells: Ah, we adventure together again, except this time I am afraid that the circumstances are much more dire.",
["timestamp"] = 1785174942,
["id"] = "s51_3194",
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Thrall",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["r"] = 1,
["g"] = 0.250980406999588,
["b"] = 0.250980406999588,
},
["text"] = "Thrall yells: It is not too late, Garrosh. Lay down the mantle of Warchief. We can end this here, now, with no more bloodshed.",
["timestamp"] = 1785174953,
["id"] = "s51_3195",
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Lorewalker Cho",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["r"] = 1,
["g"] = 0.250980406999588,
["b"] = 0.250980406999588,
},
["text"] = "Lorewalker Cho yells: The land is scarred, the ever-blooming trees and plants wither and die as the water from the pools drains away.",
["timestamp"] = 1785174953,
["id"] = "s51_3196",
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Garrosh Hellscream",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["r"] = 1,
["g"] = 0.250980406999588,
["b"] = 0.250980406999588,
},
["text"] = "Garrosh Hellscream yells: Ha! Do you remember nothing of Honor? Of glory on the battlefield?  You who would parlay with the humans, who allowed warlocks to practice their dark magics right under our feet.  You are weak.",
["timestamp"] = 1785174965,
["id"] = "s51_3197",
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Garrosh Hellscream",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["r"] = 1,
["g"] = 0.250980406999588,
["b"] = 0.250980406999588,
},
["text"] = "Garrosh Hellscream yells: We are the Orcish Horde, the True Horde.  We die, bloody and thrashing on the field of battle, like true orcs SHOULD.",
["timestamp"] = 1785174987,
["id"] = "s51_3198",
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Garrosh Hellscream",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["r"] = 1,
["g"] = 0.250980406999588,
["b"] = 0.250980406999588,
},
["text"] = "Garrosh Hellscream yells: You are an Orc no longer, and speak for none but yourself. You betrayed our people to forge your fragile alliances, and I will take great pleasure in tearing them apart.",
["timestamp"] = 1785175000,
["id"] = "s51_3199",
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Thrall",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["r"] = 1,
["g"] = 0.250980406999588,
["b"] = 0.250980406999588,
},
["text"] = "Thrall yells: Then you have forced my hand.  I will correct the mistake I made long ago.  Spirits of the wind, the earth, the water, hear my call!  Come to my aid!",
["timestamp"] = 1785175018,
["id"] = "s51_3200",
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Garrosh Hellscream",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["r"] = 1,
["g"] = 0.250980406999588,
["b"] = 0.250980406999588,
},
["text"] = "Garrosh Hellscream yells: Fool. My Dark Shaman have twisted and tortured the elements for miles around. They cannot hear you now. Once again you prove too weak and powerless to do anything.",
["timestamp"] = 1785175033,
["id"] = "s51_3201",
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Thrall",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["r"] = 1,
["g"] = 0.250980406999588,
["b"] = 0.250980406999588,
},
["text"] = "Thrall yells: Never powerless Garrosh. And never alone.",
["timestamp"] = 1785175055,
["id"] = "s51_3202",
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Garrosh Hellscream",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["r"] = 1,
["g"] = 0.250980406999588,
["b"] = 0.250980406999588,
},
["text"] = "Garrosh Hellscream yells: So, you wish to face off against a real Orc Warchief.  So be it.",
["timestamp"] = 1785175061,
["id"] = "s51_3203",
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["event"] = "CHAT_MSG_MONEY",
["type"] = "MONEY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = -0,
},
["text"] = "You loot 15 Gold, 24 Silver, 41 Copper",
["timestamp"] = 1785175215,
["id"] = "s51_3204",
},
