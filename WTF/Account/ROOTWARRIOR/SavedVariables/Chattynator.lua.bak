61995},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3391:0|h[Adventurer Dawncrest]|h|rx20\",\"id\":\"s21_4327\",\"timestamp\":1772561995},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ranger Telenus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Ranger Telenus says: Look at this mess!\",\"timestamp\":1772563693,\"id\":\"s21_4328\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Orweyna says: The defenders of the Vale are growing weary. Use this rejuvenation pollen to revive them.\",\"timestamp\":1772563714,\"id\":\"s21_4329\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"NightElf\",\"name\":\"Eanwe\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Got a real troublemaker on our hands. Take them on, if you think you're up to it.\",\"timestamp\":1772563722,\"id\":\"s21_4330\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Vidious\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Vidious says: Keep an eye out for opportunities for loot when they arise, like now!\",\"timestamp\":1772563734,\"id\":\"s21_4331\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"Human\",\"name\":\"Anniewinters-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Anniewinters-Tichondrius|h[|cffc41e3aAnniewinters|r]|h has earned the achievement |cffffff00|Hachievement:41288:Player-11-0EA2851E:1:3:3:26:4294967295:4294967295:4294967295:4294967295|h[Heroic: Windrunner Spire]|h|r!\",\"timestamp\":1772563736,\"id\":\"s21_4332\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"Human\",\"name\":\"Anniewinters-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Anniewinters-Tichondrius|h[|cffc41e3aAnniewinters|r]|h has earned the achievement |cffffff00|Hachievement:41291:Player-11-0EA2851E:1:3:3:26:4294967295:4294967295:4294967295:4294967295|h[Mythic: Windrunner Spire]|h|r!\",\"timestamp\":1772563736,\"id\":\"s21_4333\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"Human\",\"name\":\"Anniewinters-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Anniewinters-Tichondrius|h[|cffc41e3aAnniewinters|r]|h has earned the achievement |cffffff00|Hachievement:41287:Player-11-0EA2851E:1:3:3:26:4294967295:4294967295:4294967295:4294967295|h[Windrunner Spire]|h|r!\",\"timestamp\":1772563736,\"id\":\"s21_4334\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: To stand in the stillness where her presence once stirred... that is no small honor. Go now, and listen with more than ears.\",\"timestamp\":1772563755,\"id\":\"s21_4335\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"Tauren\",\"name\":\"Udderbutter-Daggerspine\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Udderbutter-Daggerspine|h[|cfff48cbaUdderbutter-Daggerspine|r]|h has earned the achievement |cffffff00|Hachievement:41287:Player-1136-097E3BC3:1:3:3:26:4294967295:4294967295:4294967295:4294967295|h[Windrunner Spire]|h|r!\",\"timestamp\":1772563768,\"id\":\"s21_4336\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: The seekers did not cry out for the goddess's return. They listened, and waited, in the quiet places where memory clings.\",\"timestamp\":1772563835,\"id\":\"s21_4337\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: Some creatures became consumed with gluttony, in order to fill the void created from her departure.\",\"timestamp\":1772563852,\"id\":\"s21_4338\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: Some creatures still sang in harmony with her.\",\"timestamp\":1772563862,\"id\":\"s21_4339\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: The creatures remembered where she had been.\",\"timestamp\":1772563866,\"id\":\"s21_4340\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Rutaani Sapling\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"The Rutaani does not react to your presence, it continues to sit silently.\",\"timestamp\":1772563873,\"id\":\"s21_4341\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: Some creatures forgot her song and listened only to the silence that followed.\",\"timestamp\":1772563873,\"id\":\"s21_4342\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: The stones echoed her song, but this one was different. Within it the song stirred, yearning to share its tune.\",\"timestamp\":1772563881,\"id\":\"s21_4343\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Echo of Memory\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"A faint echo shimmers into view, its gentle motion urging you to follow.\",\"timestamp\":1772563894,\"id\":\"s21_4344\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: They followed not a path, but an echo of feeling.\",\"timestamp\":1772563894,\"id\":\"s21_4345\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"MAGE\",\"race\":\"Pandaren\",\"name\":\"Sukhmi-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Sukhmi-Tichondrius:35:GUILD:|h[|cff3fc7ebSukhmi|r]|h: anyone know if the \\\"abundances\\\" are bugged?\",\"timestamp\":1772563897,\"id\":\"s21_4346\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Echo of Memory\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"The echo begins to move again, urging you to follow.\",\"timestamp\":1772563899,\"id\":\"s21_4347\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: She was not in the light--she was the warmth it left behind.\",\"timestamp\":1772563899,\"id\":\"s21_4348\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Echo of Memory\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"The echo begins to move again, urging you to follow.\",\"timestamp\":1772563905,\"id\":\"s21_4349\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: The seekers sat in silence. Even there, we heard her song.\",\"timestamp\":1772563908,\"id\":\"s21_4350\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"EVOKER\",\"race\":\"Dracthyr\",\"name\":\"Rejuvidrake-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Rejuvidrake-Tichondrius|h[|cff33937fRejuvidrake|r]|h has earned the achievement |cffffff00|Hachievement:41805:Player-11-0E4719BD:1:3:3:26:4294967295:4294967295:4294967295:4294967295|h[Arator's Journey]|h|r!\",\"timestamp\":1772563913,\"id\":\"s21_4351\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: We called out with song. She did not answer. But something she left behind did. And it was enough.\",\"timestamp\":1772563918,\"id\":\"s21_4352\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"MAGE\",\"race\":\"Pandaren\",\"name\":\"Sukhmi-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Sukhmi-Tichondrius:42:GUILD:|h[|cff3fc7ebSukhmi|r]|h: I did the one in Zul'aman on my druid.. now im trying to do one on my mage and I cant repeat that one. But none of the others seem to be working\",\"timestamp\":1772563932,\"id\":\"s21_4353\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ6:|Hitem:248139::::::::90:1480:::::::::|h[Aln'hara's Bloom]|h|r\",\"timestamp\":1772563936,\"id\":\"s21_4354\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: She did not return. But something of her remained, blooming in the silence for those who remembered.\",\"timestamp\":1772563936,\"id\":\"s21_4355\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Starphage-Tichondrius|h[|cffa330c9Starphage|r]|h has earned the achievement |cffffff00|Hachievement:62371:Player-11-0EA2971B:1:3:3:26:4294967295:4294967295:4294967295:4294967295|h[Couponing for Beginners]|h|r!\",\"timestamp\":1772563936,\"id\":\"s21_4356\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Starphage-Tichondrius|h[|cffa330c9Starphage|r]|h has earned the achievement |cffffff00|Hachievement:62371:Player-11-0EA2971B:1:3:3:26:4294967295:4294967295:4294967295:4294967295|h[Couponing for Beginners]|h|r!\",\"timestamp\":1772563936,\"id\":\"s21_4357\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ2:|Hcurrency:3363:0|h[Community Coupons]|h|rx10\",\"timestamp\":1772563937,\"id\":\"s21_4358\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3383:0|h[Adventurer Dawncrest]|h|rx10\",\"timestamp\":1772563937,\"id\":\"s21_4359\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:263196::::::::90:1480::11::1:28:3321:::::|h[Harandar Glowvine Lantern]|h|r\",\"timestamp\":1772563955,\"id\":\"s21_4360\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ4:|Hitem:268487::::::::90:1480::11::2:9:90:28:3321:::::|h[Avid Learner's Supply Pack]|h|r\",\"timestamp\":1772563955,\"id\":\"s21_4361\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: Aln'hara leaves no trace by accident. The Bloom was not a gift... it was a promise. Living, sacred, and real. Thank you for revealing the truth of its story.\",\"timestamp\":1772563955,\"id\":\"s21_4362\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ3:|Hitem:257012::::::::90:1480::26:2:12770:43:1:28:3321:::::|h[Rootwarden's Spellblade]|h|r\",\"timestamp\":1772563960,\"id\":\"s21_4363\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx100\",\"timestamp\":1772563961,\"id\":\"s21_4364\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3391:0|h[Adventurer Dawncrest]|h|rx20\",\"timestamp\":1772563961,\"id\":\"s21_4365\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"HUNTER\",\"race\":\"Gnome\",\"name\":\"Twin\",\"sex\":2},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Got a real troublemaker on our hands. Take them on, if you think you're up to it.\",\"timestamp\":1772563965,\"id\":\"s21_4366\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Aksem\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Aksem says: Welcome to the Cradle.\",\"timestamp\":1772563996,\"id\":\"s21_4367\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Aksem\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Aksem says: I am Aksem, and I listen to the voice of the Cradle. I carry knowledge that is hidden to even most haranir.\",\"timestamp\":1772563999,\"id\":\"s21_4368\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Aksem\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Aksem says: The goddess's memories have been shared with me, and I share them only with those who understand their importance.\",\"timestamp\":1772564008,\"id\":\"s21_4369\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ4:|Hitem:232875::::::::90:1480:::::::::|h[Spark of Radiance]|h|r\",\"timestamp\":1772564051,\"id\":\"s21_4370\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Pedrayy-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Pedrayy-Illidan|h[|cfffff468Pedrayy-Illidan|r]|h has earned the achievement |cffffff00|Hachievement:40458:Player-57-0D6693B5:1:3:3:26:4294967295:4294967295:4294967295:4294967295|h[Stranger Delves]|h|r!\",\"timestamp\":1772564083,\"id\":\"s21_4371\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ3:|Hitem:245876::::::::90:1480:::::::::|h[Darkmoon Sigil: Hunt |A:Professions-ChatIcon-Quality-12-Tier2:17:15::1|a]|h|r\",\"timestamp\":1772564144,\"id\":\"s21_4372\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:238202::::::::90:1480:::::::::|h[Gloaming Alloy |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|rx8\",\"timestamp\":1772564145,\"id\":\"s21_4373\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:244637::::::::90:1480:::::::::|h[Silvermoon Weapon Wrap |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|r\",\"timestamp\":1772564145,\"id\":\"s21_4374