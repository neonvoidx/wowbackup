},
["text"] = "|Hchannel:GUILD|h[Guild]|h |Hplayer:Murky-Frostmane:404:GUILD:|h[|cfffff468Murky-Frostmane|r]|h: any healers 2300+ want to que blitz",
["id"] = "s51_4383",
["timestamp"] = 1785261014,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["race"] = "VoidElf",
["class"] = "PRIEST",
["name"] = "Neonvoid",
["sex"] = 3,
},
["event"] = "CHAT_MSG_LOOT",
