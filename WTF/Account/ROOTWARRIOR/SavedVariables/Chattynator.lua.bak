,\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Sunwalker Dezco says: Starphage, if you would gather what you can, Arator and I will prepare the forge.\",\"timestamp\":1772159824,\"id\":\"s18_4971\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: Is this what it means to be a Sunwalker?\",\"timestamp\":1772159824,\"id\":\"s18_4972\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Sunwalker Dezco\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Sunwalker Dezco says: For some. Others are content to smite the wicked with a giant hammer.\",\"timestamp\":1772159828,\"id\":\"s18_4973\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:238515::::::::82:1480:::::::::|h[Forgotten Skullcleaver]|h|r\",\"timestamp\":1772159834,\"id\":\"s18_4974\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:238516::::::::82:1480:::::::::|h[Fallen Longsword]|h|r\",\"timestamp\":1772159838,\"id\":\"s18_4975\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:238516::::::::82:1480:::::::::|h[Fallen Longsword]|h|r\",\"timestamp\":1772159842,\"id\":\"s18_4976\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:238516::::::::82:1480:::::::::|h[Fallen Longsword]|h|r\",\"timestamp\":1772159852,\"id\":\"s18_4977\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"WARLOCK\",\"race\":\"Scourge\",\"name\":\"Badonkadonk-Trollbane\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Badonkadonk-Trollbane|h[|cff8788eeBadonkadonk-Trollbane|r]|h has earned the achievement |cffffff00|Hachievement:61832:Player-1175-0BF5D1E6:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Delves: Tier 1]|h|r!\",\"timestamp\":1772159857,\"id\":\"s18_4978\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:238516::::::::82:1480:::::::::|h[Fallen Longsword]|h|r\",\"timestamp\":1772159859,\"id\":\"s18_4979\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:238515::::::::82:1480:::::::::|h[Forgotten Skullcleaver]|h|r\",\"timestamp\":1772159865,\"id\":\"s18_4980\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:238515::::::::82:1480:::::::::|h[Forgotten Skullcleaver]|h|r\",\"timestamp\":1772159873,\"id\":\"s18_4981\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:238515::::::::82:1480:::::::::|h[Forgotten Skullcleaver]|h|r\",\"timestamp\":1772159882,\"id\":\"s18_4982\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Sunwalker Dezco\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Sunwalker Dezco says: The fields are cleared of scrap metal! We'll make something useful out of this refuse.\",\"timestamp\":1772159890,\"id\":\"s18_4983\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Sunwalker Dezco\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Sunwalker Dezco says: We're shaped by the events in our lives. But we can choose how we will live going forward.\",\"timestamp\":1772159897,\"id\":\"s18_4984\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Sunwalker Dezco\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Sunwalker Dezco says: What type of paladin do you want to be, Arator? What type of person?\",\"timestamp\":1772159899,\"id\":\"s18_4985\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: I... want to come back here and help you, once this war has ended. I think this is as much my calling as facing down the horrors of the Void.\",\"timestamp\":1772159906,\"id\":\"s18_4986\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kurdran Wildhammer\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kurdran Wildhammer says: There you are! Faol, why'd you bring us back to this desolate place?\",\"timestamp\":1772159914,\"id\":\"s18_4987\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: I... want to come back here and help you, once this war has ended. I think this is as much my calling as facing down the horrors of the Void.\",\"timestamp\":1772159917,\"id\":\"s18_4988\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Alonsus Faol\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alonsus Faol says: We are on a hunt for artifacts to support the defenders at Silvermoon.\",\"timestamp\":1772159931,\"id\":\"s18_4989\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ1:|Hitem:239130::::::::82:1480::11::1:28:3088:::::|h[Torch]|h|r\",\"timestamp\":1772159937,\"id\":\"s18_4990\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Danath Trollbane\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Danath Trollbane says: Come, Kurdran. We should scout out the other Dark Horde encampments.\",\"timestamp\":1772159938,\"id\":\"s18_4991\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Danath Trollbane\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Danath Trollbane says: The only holy artifact here is--\",\"timestamp\":1772159941,\"id\":\"s18_4992\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kurdran Wildhammer\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kurdran Wildhammer says: Oh you must be joking!\",\"timestamp\":1772159942,\"id\":\"s18_4993\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kurdran Wildhammer\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kurdran Wildhammer says: Pfft! The Dark Horde. They're stuck trying to win the Second War, while we've made peace on the Fourth. Get with the times!\",\"timestamp\":1772159943,\"id\":\"s18_4994\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Lìqur-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Lìqur-Tichondrius|h[|cfffff468Lìqur|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-11-0E4CFEF3:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"timestamp\":1772159945,\"id\":\"s18_4995\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Eitrigg\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Eitrigg says: The Dark Horde will have taken the fragments, divided it up amongst themselves as a trophy.\",\"timestamp\":1772159945,\"id\":\"s18_4996\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kurdran Wildhammer\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kurdran Wildhammer says: Well ain't that lovely. Come on lads. Time for a difficult walk down memory lane.\",\"timestamp\":1772159952,\"id\":\"s18_4997\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:4338::::::::82:1480:::::::::|h[Mageweave Cloth]|h|rx3\",\"timestamp\":1772159957,\"id\":\"s18_4998\"}]",
["endTimestamp"] = 1772159957,
},
{
["startTimestamp"] = 1772159957,
["data"] = "[{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:8952::::::::82:1480:::::::::|h[Roasted Quail]|h|r\",\"timestamp\":1772159957,\"id\":\"s18_4999\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:13446::::::::82:1480:::::::::|h[Major Healing Potion]|h|r\",\"timestamp\":1772159957,\"id\":\"s18_5000\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 5 Gold, 4 Silver, 77 Copper\",\"timestamp\":1772159958,\"id\":\"s19_2502\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: My father, Turalyon, fought in this battle, though he has rarely talked to me about it.\",\"timestamp\":1772159967,\"id\":\"s19_2503\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"WARRIOR\",\"race\":\"Gnome\",\"name\":\"ßigßrain-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:ßigßrain-Tichondrius|h[|cffc69b6dßigßrain|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-11-0E43E93E:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"timestamp\":1772159982,\"id\":\"s19_2504\"},{\"recor