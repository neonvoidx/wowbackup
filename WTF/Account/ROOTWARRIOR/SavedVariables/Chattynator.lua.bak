},
["text"] = "Sonoflothar-Illidan receives loot: |cnIQ0:|T237423:12|t|Hitem:173360::::::::81:66:::::::::|h[Glossy Fur]|h|r.",
["timestamp"] = 1784592531,
["id"] = "s51_2822",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Kyrestia the Firstborne",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kyrestia the Firstborne says: Listen to reason, Devos. The kyrian must stand united.",
["timestamp"] = 1784592535,
["id"] = "s51_2823",
},
{
["recordedBy"] = "Praisesun-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Devos",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Devos says: Not so long as you command them. The Forsworn will forge a new path for Bastion!",
["timestamp"] = 1784592543,
["id"] = "s51_2824",
},
{
