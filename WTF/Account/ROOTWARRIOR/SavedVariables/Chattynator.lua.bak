["g"] = 1,
["r"] = 0.250980406999588,
},
["text"] = "|Hplayer:Neonvoid-Tichondrius|h[|cffffffffNeonvoid|r]|h has earned the achievement |cffffff00|Hachievement:18156:Player-11-0EA29727:1:7:28:26:4294967295:4294967295:4294967295:4294967295|h[Mythic: The Vigilant Steward, Zskarn]|h|r!",
["id"] = "s51_4760",
["timestamp"] = 1785283696,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zskarn",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Zskarn yells: This was only... a precursor to... your suffering...",
