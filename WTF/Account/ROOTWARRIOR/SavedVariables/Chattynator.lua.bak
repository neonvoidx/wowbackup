ichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ3:|Hitem:258924::::::::84:1480::134:3:13613:42:13578:2:9:86:28:3086:::::|h[Tarnished Dawnlit Corsair's Breeches]|h|r\",\"timestamp\":1772201603,\"id\":\"s19_3583\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Halduron Brightwing\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Halduron Brightwing says: My skin is tingling. What IS this?\",\"timestamp\":1772201710,\"id\":\"s19_3584\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Orweyna says: Alndust--remnants of the goddess's will, given form. It empowers our magics and allows us to walk between worlds.\",\"timestamp\":1772201715,\"id\":\"s19_3585\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Halduron Brightwing\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Halduron Brightwing says: Orweyna has gone ahead to speak to her elders. Let me know when you're ready, Starphage.\",\"timestamp\":1772201732,\"id\":\"s19_3586\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"Pandaren\",\"name\":\"Frostyfries-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Frostyfries-Tichondrius|h[|cffc41e3aFrostyfries|r]|h has earned the achievement |cffffff00|Hachievement:61855:Player-11-0E83AB7E:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Explore Eversong Woods]|h|r!\",\"timestamp\":1772201796,\"id\":\"s19_3587\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"Pandaren\",\"name\":\"Frostyfries-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Frostyfries-Tichondrius|h[|cffc41e3aFrostyfries|r]|h has earned the achievement |cffffff00|Hachievement:61576:Player-11-0E83AB7E:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Eversong Woods Glyph Hunter]|h|r!\",\"timestamp\":1772201836,\"id\":\"s19_3588\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"WARRIOR\",\"race\":\"Gnome\",\"name\":\"Durfnn-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Durfnn-Tichondrius|h[|cffc69b6dDurfnn|r]|h has earned the achievement |cffffff00|Hachievement:61219:Player-11-0E799EEA:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[No Time to Paws]|h|r!\",\"timestamp\":1772201844,\"id\":\"s19_3589\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:256209::::::::84:1480::11:2:13573:6652:2:9:84:28:3087:::::|h[Battered Belt of the Council]|h|r\",\"timestamp\":1772201845,\"id\":\"s19_3590\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Ruia\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Ruia says: You have forgotten the value of tradition, Orweyna. Go to the Den of Echoes, and remind yourself of what it means to be haranir.\",\"timestamp\":1772201845,\"id\":\"s19_3591\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Hagar says: The elders have spoken. They hope that reliving the past will show you the folly of your actions.\",\"timestamp\":1772201845,\"id\":\"s19_3592\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"You sense a nearby Skyriding Glyph.\",\"timestamp\":1772201885,\"id\":\"s19_3593\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Hagar says: I understand the threat of the Lightbloom, but we need to appease the elders or you will have two enemies in Harandar.\",\"timestamp\":1772201901,\"id\":\"s19_3594\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Hagar says: Aln'hara guide you. Good luck.\",\"timestamp\":1772201904,\"id\":\"s19_3595\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Orweyna says: It is not like you to avoid conflict.\",\"timestamp\":1772201905,\"id\":\"s19_3596\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Orweyna says: Have your fangs dulled since I was gone?\",\"timestamp\":1772201907,\"id\":\"s19_3597\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Hagar says: Don't test me, little sprout. I know when to roar and when to wait.\",\"timestamp\":1772201910,\"id\":\"s19_3598\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Hagar says: I could have pitted my pride against Ruia, but alone what good would it do?\",\"timestamp\":1772201916,\"id\":\"s19_3599\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ3:|Hitem:251881::::::::84:1480:::::::::|h[Small Pile of Luminous Dust]|h|r\",\"timestamp\":1772201920,\"id\":\"s19_3600\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ2:|Hcurrency:3385:0|h[Luminous Dust]|h|rx1\",\"timestamp\":1772201921,\"id\":\"s19_3601\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Orweyna says: You are as strong as any.\",\"timestamp\":1772201923,\"id\":\"s19_3602\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Hagar says: First you left, then the roots of Teldrassil burned. Now the elders barely consider me one of them.\",\"timestamp\":1772201926,\"id\":\"s19_3603\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: I was told you would be arriving, Starphage. Let us begin.\",\"timestamp\":1772201932,\"id\":\"s19_3604\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: Touch the painting. The Alndust within empowers it to reveal our truths.\",\"timestamp\":1772201934,\"id\":\"s19_3605\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Orweyna says: Should I not have heeded the goddess's call?\",\"timestamp\":1772201935,\"id\":\"s19_3606\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: Countless generations ago our people walked beneath the trees of the great mountain.\",\"timestamp\":1772201936,\"id\":\"s19_3607\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Hagar says: You did what needed to be done. I have always told you to trust your instincts.\",\"timestamp\":1772201938,\"id\":\"s19_3608\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: None knew of our presence. Not the giant whose steps shook the earth... nor her massive beasts.\",\"timestamp\":1772201942,\"id\":\"s19_3609\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:239014::::::::84:1480:::::::::|h[Iceberries]|h|r\",\"timestamp\":1772201943,\"id\":\"s19_3610\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Hagar says: All I ask is that you trust mine. We must regain their faith in you.\",\"timestamp\":1772201945,\"id\":\"s19_3611\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:239014::::::::84:1480:::::::::|h[Iceberries]|h|r\",\"timestamp\":1772201947,\"id\":\"s19_3612\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Hagar says: And know that I will always defend you, even if you do not see.\",\"timestamp\":1772201951,\"id\":\"s19_3613\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:239014::::::::84:1480:::::::::|h[Iceberries]|h|r\",\"timestamp\":1772201953,\"id\":\"s19_3614\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:239014::::::::84:1480:::::::::|h[Iceberries]|h|r\",\"timestamp\":1772201973,\"id\":\"s19_3615\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:239014::::::::84:1480:::::::::|h[Iceberries]|h|r\",\"timestamp\":1772201983,\"id\":\"s19_3616\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:239014::::::::84:1480:::::::::|h[Iceberries]|h|r\",\"timestamp\":1772201999,\"id\":\"s19_3617\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: Hiding was not our only talent.\",\"timestamp\":1772202013,\"id\":\"s19_3618\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:246415::::::::84:1480::11::1:28:3087:::::|h[Ruddy Haranir Pigment Bowl]|h|r\",\"timestamp\":1772202015,\"id\":\"s19_3619\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: We learned the shape of the beasts.\",\"timestamp\":1772202017,\"id\":\"s19_3620\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: We grew to become the forest's greatest hunters.\",\"timestamp\":1772202022,\"id\":\"s19_3621\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: Rivaling, and then taming the fiercest predators.\",\"timestamp\":1772202027,\"id\":\"s19_3622\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"MAGE\",\"race\":\"Scourge\",\"name\":\"Parryhadder-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Parryhadder-Tichondrius|h[|cff3fc7ebParryhadder|r]|h has earned the achievement |cffffff00|Hachievement:153:Player-11-0EA2B21A:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[The Old Gnome and the Sea]|h|r!\",\"timestamp\":1772202146,\"id\":\"s19_3623\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: In times of quiet, we felt empty. We longed for purpose.\",\"timestamp\":1772202148,\"id\":\"s19_3624\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Wankies-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Wankies-Tichondrius|h[|cfffff468Wankies|r]|h has earned the achievement |cffffff00|Hachievement:62387:Player-11-0E48C902:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[It's Nearly Midnight]|h|r!\",\"timestamp\":1772202149,\"id\":\"s19_3625\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Wankies-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Wankies-Tichondrius|h[|cfffff468Wankies|r]|h has earned the achievement |cffffff00|Hachievement:61308:Player-11-0E48C902:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Score a Decor]|h|r!\",\"timestamp\":1772202149,\"id\":\"s19_3626\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Wankies-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Wankies-Tichondrius|h[|cfffff468Wankies|r]|h has earned the achievement |cffffff00|Hachievement:61309:Player-11-0E48C902:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Amateur Antiquarian]|h|r!\",\"timestamp\":1772202149,\"id\":\"s19_3627\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Wankies-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Wankies-Tichondrius|h[|cfffff468Wankies|r]|h has earned the achievement |cffffff00|Hachievement:61310:Player-11-0E48C902:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Casual Collector]|h|r!\",\"timestamp\":1772202149,\"id\":\"s19_3628\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"NightElf\",\"name\":\"Wankies-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Wankies-Tichondrius|h[|cfffff468Wankies|r]|h has earned the achievement |cffffff00|Hachievement:61311:Player-11-0E48C902:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Ready to Remodel]|h|r!\",\"timestamp\":1772202149,\"id\":\"s19_3629\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: Our longing was answered by a song from the depths of the world.\",\"timestamp\":1772202216,\"id\":\"s19_3630\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"Troll\",\"name\":\"Renewmedaddy-Stormrage\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Renewmedaddy-Stormrage|h[|cffff7c0aRenewmedaddy-Stormrage|r]|h has earned the achievement |cffffff00|Hachievement:41802:Player-60-0FE30D1E:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Eversong In Reprise]|h|r!\",\"timestamp\":1772202219,\"id\":\"s19_3631\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: Not all heeded the goddess's call, but the Hara'ti followed the Song.\",\"timestamp\":1772202219,\"id\":\"s19_3632\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: The journey was long and very difficult. We faced many hardships on the way.\",\"timestamp\":1772202226,\"id\":\"s19_3633\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Observer Talos\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Observer Talos says: System... failure.\",\"timestamp\":1772202233,\"id\":\"s19_3634\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 3 Gold, 3 Silver, 19 Copper\",\"timestamp\":1772202237,\"id\":\"s19_3635\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: We battled our way through the roots, and found ourselves in Harandar. But that is a deeper, more dangerous tale.\",\"timestamp\":1772202238,\"id\":\"s19_3636\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:256181::::::::84:1480::11:2:13573:6652:2:9:84:28:3087:::::|h[Glaive of Painted Memories]|h|r\",\"timestamp\":1772202247,\"id\":\"s19_3637\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zur'ashar Kassameh says: One trial yet remains. Hagar is waiting for you ahead. May Aln'hara be with you, Starphage.\",\"timestamp\":1772202248,\"id\":\"s19_3638\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ2:|Hcurrency:3385:0|h[Luminous Dust]|h|rx1\",\"timestamp\":1772202261,\"id\":\"s19_3639\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_SKILL\",\"type\":\"SKILL\"},\"color\":{\"r\":0.3333333432674408,\"g\":0.3333333432674408,\"b\":1},\"text\":\"Your skill in Midnight Mining has increased to 14.\",\"timestamp\":1772202280,\"id\":\"s19_3640\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:237359::::::::84:1480::::1:38:13:::::|h[Refulgent Copper Ore |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|rx2\",\"timestamp\":1772202280,\"id\":\"s19_3641\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3376:0|h[Shard of Dundun]|h|rx1\",\"timestamp\":1772202281,\"id\":\"s19_3642\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Hagar says: The final mural holds our most sacred memory -- and our most ancient shame. To witness it, you will need a fragment we store away from the rest.\",\"timestamp\":1772202315,\"id\":\"s19_3643\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Valeera Sanguinar begins making a campfire.\",\"timestamp\":1772202316,\"id\":\"s19_3644\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kobold Mystic\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Kobold Mystic attempts to run away in fear!\",\"timestamp\":1772202352,\"id\":\"s19_3645\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Kobold Mystic\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Kobold Mystic attempts to run away in fear!\",\"timestamp\":1772202355,\"id\":\"s19_3646\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Spitfire Fusetender\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Spitfire Fusetender attempts to run away in fear!\",\"timestamp\":1772202356,\"id\":\"s19_3647\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Valeera Sanguinar says: My eye's on you.\",\"timestamp\":1772202360,\"id\":\"s19_3648\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Hagar says: Our ancestors traveled for weeks, finding strange peoples deep below Mount Hyjal. They thought the haranir were strange too.\",\"timestamp\":1772202475,\"id\":\"s19_3649\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"event\":\"CHAT_MSG_SKILL\",\"type\":\"SKILL\"},\"color\":{\"r\":0.3333333432674408,\"g\":0.3333333432674408,\"b\":1},\"text\":\"Your skill in Midnight Mining has increased to 15.\",\"timestamp\":1772202479,\"id\":\"s19_3650\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:237359::::::::84:1480::::1:38:13:::::|h[Refulgent Copper Ore |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|rx3\",\"timestamp\":1772202479,\"id\":\"s19_3651\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Spitfire Fusetender\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Spitfire Fusetender attempts to run away in fear!\",\"timestamp\":1772202509,\"id\":\"s19_3652\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Valeera Sanguinar says: Now strike!\",\"timestamp\":1772202509,\"id\":\"s19_3653\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"ZandalariTroll\",\"name\":\"Junkhog-Mannoroth\",\"sex\":2},\"event\":\"CHAT_MSG_