["g"] = 0.6666666865348816,
["r"] = -0,
},
["text"] = "You receive loot: |cnIQ1:|T1500877:12|t|Hitem:262752::::::::90:258:::::::::|h[Vilebranch Scroll]|h|r",
["id"] = "s51_4375",
["timestamp"] = 1785260965,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
