},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Enchanted Amani Mask says: You do not share your uncle's faith in de loa?",
["id"] = "s51_4360",
["timestamp"] = 1785260861,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
