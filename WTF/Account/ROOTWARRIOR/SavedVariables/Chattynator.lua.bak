},
["text"] = "|Hplayer:Nalia-Tichondrius|h[|cffc69b6dNalia|r]|h has earned the achievement |cffffff00|Hachievement:61508:Player-11-0E436124:1:3:15:26:4294967295:4294967295:4294967295:4294967295|h[Voidscar Arena]|h|r!",
