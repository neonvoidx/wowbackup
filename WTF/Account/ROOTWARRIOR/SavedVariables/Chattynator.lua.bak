},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Hex Master Jintagga says: Ula'tek was Malacrass's obsession: a way to return to de Amani Empire!",
["id"] = "s51_4358",
["timestamp"] = 1785260813,
},
