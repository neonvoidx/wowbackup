},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Kuri says: I'll stay out here and, uh, keep watch. You call out when you find a bunch of skyglass, and I'll come running!",
["id"] = "s27_2972",
["timestamp"] = 1773446184,
},
{
["recordedBy"] = "Stormclout-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Kuri",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
