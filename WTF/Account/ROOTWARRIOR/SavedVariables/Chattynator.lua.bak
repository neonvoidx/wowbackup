["name"] = "Void Researcher Anomander",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Void Researcher Anomander says: Did you feel that? Like a subtle pulse of... hunger.",
