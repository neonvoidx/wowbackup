},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Kul'amara the Fierce says: There are souls still that we can save. You confront her. I gonna release all de souls I can find.",
["id"] = "s51_4472",
["timestamp"] = 1785262267,
},
