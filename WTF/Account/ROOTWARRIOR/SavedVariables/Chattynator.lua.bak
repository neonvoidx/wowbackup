},
{
["recordedBy"] = "Starphage-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Zul'jarra",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zul'jarra says: What took you so long, eh? De loa will not fight me without you.",
["id"] = "s28_2797",
["timestamp"] = 1773629502,
},
{
["recordedBy"] = "Starphage-Tichondrius",
["typeInfo"] = {
["player"] = {
["race"] = "BloodElf",
["class"] = "PALADIN",
["name"] = "Delibash-Mal'Ganis",
["sex"] = 2,
},
["event"] = "CHAT_MSG_LOOT",
["type"] = "LOOT",
},
["color"] = {
["b"] = -0,
["g"] = 0.6666666865348816,
["r"] = -0,
},
["text"] = "Delibash-Mal'Ganis receives loot: |cnIQ1:|Hitem:242639::::::::90:1480:::::::::|h[Practically Pork]|h|r.",
["id"] = "s28_2798",
["timestamp"] = 1773629503,
},
{
["recordedBy"] = "Starphage-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Loa Speaker Nanea",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Loa Speaker Nanea says: Hold. Before ya face de loa, ya must face an' kill... me.",
["id"] = "s28_2799",
["timestamp"] = 1773629506,
},
{
["recordedBy"] = "Starphage-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Nalorakk",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Nalorakk says: Leadership requires sacrifice. Even of the things we cherish.",
["id"] = "s28_2800",
["timestamp"] = 1773629512,
},
{
["recordedBy"] = "Starphage-Tichondrius",
["typeInfo"] = {
["player"] = {
["race"] = "NightElf",
["class"] = "DRUID",
["name"] = "Smileclap-Mal'Ganis",
