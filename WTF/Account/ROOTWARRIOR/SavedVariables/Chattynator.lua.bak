},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Neltharion says: Combined, they become something even greater. Learn to harness them together, and no force can oppose you.",
["id"] = "s51_4708",
["timestamp"] = 1785282991,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
