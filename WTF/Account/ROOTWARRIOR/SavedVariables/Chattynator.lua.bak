},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Vidious says: I request your aid, regardless. Head to the Grief Spire, elf. I will meet you there.",
["id"] = "s27_4485",
["timestamp"] = 1773593888,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
