},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Hex Master Soye'mal says: Vordaza was de Hex Lord's favored apprentice. If any have Malacrass's scrolls, it is her.",
