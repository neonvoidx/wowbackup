["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zul'jarra says: Twilight's Blade be hidin' out at Speaker's Rest. Show them how a hash'ura protects Zul'Aman!",
