\":1772170232,\"id\":\"s19_3424\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Qtlolxdfurry-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Qtlolxdfurry-Tichondrius:4357:GUILD:|h[|cffff7c0aQtlolxdfurry|r]|h: gaming\",\"timestamp\":1772170234,\"id\":\"s19_3425\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Nalorakk\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Nalorakk says: Fought like a true Amani, hash'ura!\",\"timestamp\":1772170248,\"id\":\"s19_3426\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Manasia-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Manasia-Tichondrius:4359:GUILD:|h[|cffff7c0aManasia|r]|h: haxers\",\"timestamp\":1772170251,\"id\":\"s19_3427\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Treesuh-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Treesuh-Tichondrius:4361:GUILD:|h[|cffff7c0aTreesuh|r]|h: dung spam or something?\",\"timestamp\":1772170259,\"id\":\"s19_3428\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"Orc\",\"name\":\"Recoveryee-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Recoveryee-Tichondrius|h[|cff0070ddRecoveryee|r]|h has earned the achievement |cffffff00|Hachievement:61638:Player-11-0A87223A:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Den of Nalorakk]|h|r!\",\"timestamp\":1772170279,\"id\":\"s19_3429\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"HUNTER\",\"race\":\"Orc\",\"name\":\"Dexand-Tichondrius\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Dexand-Tichondrius|h[|cffaad372Dexand|r]|h has earned the achievement |cffffff00|Hachievement:41960:Player-11-0E2B8100:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Murder Row]|h|r!\",\"timestamp\":1772170288,\"id\":\"s19_3430\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Mor'duun\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mor'duun says: Bah! My minions are nothing more than fodder! Slay as many as you wish!\",\"timestamp\":1772170294,\"id\":\"s19_3431\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zul'jan says: We couldn't wait any longer for your loa. If my hand forced yours, so be it!\",\"timestamp\":1772170302,\"id\":\"s19_3432\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:248580::::::::84:1480::11:2:13573:6652:2:9:84:28:3086:::::|h[Atalguard's Oath Shoulderpads]|h|r\",\"timestamp\":1772170303,\"id\":\"s19_3433\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"LightforgedDraenei\",\"name\":\"Amyrabelle-MoonGuard\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Amyrabelle-MoonGuard|h[|cfff48cbaAmyrabelle-MoonGuard|r]|h has earned the achievement |cffffff00|Hachievement:61832:Player-3675-0A7793FD:1:2:26:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Delves: Tier 1]|h|r!\",\"timestamp\":1772170308,\"id\":\"s19_3434\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zul'jarra says: We need to take de fight to Mor'duun. Let's go.\",\"timestamp\":1772170313,\"id\":\"s19_3435\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Mor'duun\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mor'duun says: You seek to challenge me? Hah! Your strength isn't even enough to break my barrier!\",\"timestamp\":1772170319,\"id\":\"s19_3436\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Akil'zon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Akil'zon says: Mor'duun thinks he is safe behind his barrier. He is wrong.\",\"timestamp\":1772170325,\"id\":\"s19_3437\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zul'jarra says: Great Loa. You helped us get this far. But it must be us dat end this fight for good.\",\"timestamp\":1772170330,\"id\":\"s19_3438\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Akil'zon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Akil'zon says: Go forth, Zul'jarra. Take our blessing and crush your prey!\",\"timestamp\":1772170337,\"id\":\"s19_3439\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Mor'duun\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mor'duun says: I will not die by your hand, mortals. Only a god could slay me!\",\"timestamp\":1772170364,\"id\":\"s19_3440\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zul'jarra says: How about a mortal blessed by four of dem?\",\"timestamp\":1772170375,\"id\":\"s19_3441\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Mor'duun\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mor'duun says: I will bring your corpses to Xal'atath personally!\",\"timestamp\":1772170393,\"id\":\"s19_3442\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zul'jan says: Not if my blade sends her yours first!\",\"timestamp\":1772170400,\"id\":\"s19_3443\"},{\"recordedBy\":\"Starphage-Tichondrius\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Starphage-Tichondrius\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ3:|Hitem:248583::::::::84:1480::11:3:13183:13613:6652:2:9:84:28:3086:::::|h[Drum of Renewed Bonds]|h|r\",\"time