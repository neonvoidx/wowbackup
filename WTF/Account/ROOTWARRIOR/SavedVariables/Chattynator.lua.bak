},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Wrathion says: There is no denying its strength, but it seems too dangerous to truly control.",
["id"] = "s51_4723",
["timestamp"] = 1785283099,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
["player"] = {
["name"] = "Neltharion",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Neltharion says: You possess the will to master it, my son. Just imagine what you could accomplish.",
["id"] = "s51_4724",
["timestamp"] = 1785283105,
},
{
["recordedBy"] = "Neonvoid-Tichondrius",
["typeInfo"] = {
