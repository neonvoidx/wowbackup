},
{
["outbound"] = false,
["sender"] = "Magister Umbric",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1394,
["message"] = "Wait... Does this mean what I think it means?",
