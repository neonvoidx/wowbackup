["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 738,
["message"] = "There's a rich Azerite deposit below us, heroes. Get down there and collect all you can. And if those Horde marauders gets in your way... put them down!",
