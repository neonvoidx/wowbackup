},
{
["outbound"] = false,
["sender"] = "Abbot Benthar",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4248,
["message"] = "The Light will choose... a new leader... for our crusade...",
