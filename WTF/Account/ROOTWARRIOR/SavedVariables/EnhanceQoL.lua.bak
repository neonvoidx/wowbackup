["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_YELL",
["lineID"] = 3341,
["message"] = "Yes, I smell them too, Riplimb. Outsiders encroach on the Firelord's private grounds. Find their trail. Find them for me, that I may dispense punishment!",
