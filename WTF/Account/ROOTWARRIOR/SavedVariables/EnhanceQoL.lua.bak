["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 518,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Amarakk",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 3717,
["message"] = "Even the Shul'ka cannot reach so deep in the rift without risking our end in the madness.",
["time"] = 1774415274,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 573,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Amarakk",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 3718,
["message"] = "But you can. Slay this malformed creature, before it threatens lands beyond the Rift of Aln.",
["time"] = 1774415281,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 574,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Amarakk",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 3737,
["message"] = "This one was allowed to grow for too long. The rift has formed it into something terrible.",
["time"] = 1774415382,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 592,
