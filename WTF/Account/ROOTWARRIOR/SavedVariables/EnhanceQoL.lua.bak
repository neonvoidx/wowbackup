["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Kurdran Wildhammer",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 94,
["message"] = "Khadgar introduced us. It's in some wizardy, hocus-pocus, dimensional whatzzuhthing. Hot food, cold drinks, magical access.",
