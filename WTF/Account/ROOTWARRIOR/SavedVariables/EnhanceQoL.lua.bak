["sender"] = "Magistrix Landra Dawnstrider",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 150,
["message"] = "Hmm, perhaps when the Sunwell blew sky high into that swirling vortex? ...sorry. I'm a bit overwhelmed.",
