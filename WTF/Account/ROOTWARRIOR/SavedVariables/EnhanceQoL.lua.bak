["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 87,
["ownerCharKey"] = "Strathmoan-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Lor'themar Theron",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 706,
["message"] = "The Amani Pass takes priority. I will not let them invade Quel'Thalas again.",
["time"] = 1774718234,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 88,
["ownerCharKey"] = "Strathmoan-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Halduron Brightwing",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 707,
["message"] = "The Amani were only the source of a bigger problem.",
["time"] = 1774718235,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 89,
["ownerCharKey"] = "Strathmoan-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Halduron Brightwing",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 708,
["message"] = "The Lightbloom has never acted like this before. The forests had only small pockets of growth.",
["time"] = 1774718237,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 90,
["ownerCharKey"] = "Strathmoan-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Halduron Brightwing",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 710,
["message"] = "But the moment the Sunwell surged--it changed everything. Every pocket of Lightbloom has grown into dense thickets, teeming with strange wildlife.",
["time"] = 1774718243,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 92,
["ownerCharKey"] = "Strathmoan-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 713,
["message"] = "This is the place--covered in runes and well warded, it seems.",
["time"] = 1774718267,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 95,
["ownerCharKey"] = "Strathmoan-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 716,
["message"] = "I suspect the Amani didn't want any uninvited guests. Lucky these wards are old.",
["time"] = 1774718276,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 98,
["ownerCharKey"] = "Strathmoan-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 719,
["message"] = "If they were this well guarded, we'll want to take care ahead. Follow me, and keep quiet.",
["time"] = 1774718298,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 101,
["ownerCharKey"] = "Strathmoan-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 720,
["message"] = "That weapon... the lightwood... they aren't trying to conquer Eversong. They're trying to defend themselves from the Twilight's Blade.",
["time"] = 1774718311,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 102,
["ownerCharKey"] = "Strathmoan-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 721,
["message"] = "...and they've locked the way forward. Come on, Strathmoan. We need to follow them.",
["time"] = 1774718319,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 103,
["ownerCharKey"] = "Strathmoan-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 729,
["message"] = "This riddle must be the key to getting us out of here.",
["time"] = 1774718332,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 109,
["ownerCharKey"] = "Strathmoan-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 730,
["message"] = "I'd heard this land belonged to the Amani, long ago. I hadn't really thought about it beyond recorded history.",
["time"] = 1774718358,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 110,
["ownerCharKey"] = "Strathmoan-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 731,
["message"] = "But these ancient bones--there must be generations of Amani buried here. Resting where no one can reach them.",
["time"] = 1774718365,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 111,
["ownerCharKey"] = "Strathmoan-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 732,
["message"] = "We elves do not revere our ancestors as the orcs do, but we still honor our dead.",
["time"] = 1774718373,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 112,
["ownerCharKey"] = "Strathmoan-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 733,
["message"] = "The Amani cannot even do that much. We've taken it away from them. Little wonder they hold such hatred for elvenkind.",
["time"] = 1774718379,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 113,
["ownerCharKey"] = "Strathmoan-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
