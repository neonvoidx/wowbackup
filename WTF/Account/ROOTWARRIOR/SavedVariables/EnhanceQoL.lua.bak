{
["outbound"] = false,
["sender"] = "Majordomo Selistra",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 2357,
["message"] = "Alexstrasza charged us with protecting the Life Pools from the Primalists. I pray they have not infiltrated too deeply. Ensure the eggs are safe and eliminate any threat on these sacred grounds.",
