["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 2367,
["message"] = "Still, should Xal'atath succeed, and Alleria loses her grip on the dark naaru within her... I fear all may be lost.",
