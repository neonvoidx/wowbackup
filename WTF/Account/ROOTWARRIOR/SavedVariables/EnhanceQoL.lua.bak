},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 705,
["message"] = "Lor'themar, we found evidence of a nearby hideout--",
