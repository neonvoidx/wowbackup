["ownerCharKey"] = "Strathmoan-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 32,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Danath Trollbane",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 84,
["message"] = "Honestly, Arator, we've wanted to show you the place for some time. Glad to finally get the chance.",
["time"] = 1774704175,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Strathmoan-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 35,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 85,
["message"] = "So did I... but a wise man once told me \"I can't change anything but how I feel.\"",
["time"] = 1774704177,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Strathmoan-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 36,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 86,
["message"] = "I suppose I'll need to figure out what to do with this shield.",
