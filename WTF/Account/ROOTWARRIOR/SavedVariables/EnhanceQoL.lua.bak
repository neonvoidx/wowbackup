["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4253,
["message"] = "Arator, the Light may empower its followers, but the morals and ethics of this force come from within each of us.",
