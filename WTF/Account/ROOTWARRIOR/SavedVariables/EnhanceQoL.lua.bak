{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4277,
["message"] = "Is this the fate of all paladins? Die a legend or live to be consumed by zealotry and wrath?",
["time"] = 1774670990,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 99,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4278,
["message"] = "No, Arator. My hope is that you can find a different path to follow.",
["time"] = 1774670999,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 100,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4281,
["message"] = "I can't face those gathered at the Sunwell right now.",
["time"] = 1774671010,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 101,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4288,
["message"] = "Arator, I did not mean to add to your burdens. The trip to the cathedral was necessary to save the Sunwell.",
["time"] = 1774671014,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 107,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4291,
["message"] = "Tampacks, if you could deliver the relics. I need to have a word in private with Arator.",
["time"] = 1774671024,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 110,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Commander Venel Lightblood",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4295,
["message"] = "I appreciate your concerns, Koruth. For my people, the Light and the Sunwell are the same. They may complain, but they will accept the Vanguard.",
["time"] = 1774671109,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 114,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Commander Koruth Mountainfist",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4296,
["message"] = "If you say so, Venel. It just seems we're ruffling too many gryphon feathers.",
["time"] = 1774671118,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 115,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Mehlar Dawnblade",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4297,
["message"] = "For years, Tampacks, I was bitter with Uther for having trained Arthas, but he forgave me. Even that upset me.",
["time"] = 1774671129,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 116,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Salandria",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4298,
["message"] = "Thank you, Tampacks. I can feel its energy already. I'll use it well.",
["time"] = 1774671133,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 117,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Taelia Fordragon",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4299,
["message"] = "Wha... that's unbelievable. She was my grandmother. She watched over refugees fleeing from Stormwind to Lordaeron.",
["time"] = 1774671138,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 118,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Valunei",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4300,
["message"] = "Maraad was a hero to our people, Tampacks. I can feel his Light--it still remains in the crystal.",
["time"] = 1774671141,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 119,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Prophet Velen",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4301,
["message"] = "Thank you, Tampacks. We are resolute in our defense, but mortal in our constitutions. These relics will bolster us for a time.",
["time"] = 1774671161,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 120,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4307,
["message"] = "With the relics delivered, the Sunwell is safe, for now.",
["time"] = 1774671205,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 123,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4314,
["message"] = "I spoke to you of finding a different path, Arator. I think it's time we started on it.",
["time"] = 1774671208,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 129,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4316,
["message"] = "All right... But if this lesson is anything like the others--",
["time"] = 1774671216,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 131,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4317,
["message"] = "Oh, don't worry. This one won't be imparted by me.",
["time"] = 1774671221,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 132,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4322,
["message"] = "Hammerfall? Is this about the Red Dawn?",
["time"] = 1774671274,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 134,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4323,
["message"] = "Quite the opposite. We're going to see someone who is doing something wonderful. Something I failed to accomplish.",
["time"] = 1774671278,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 135,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Sunwalker Dezco",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4331,
["message"] = "One moment--this post is being stubborn.",
["time"] = 1774671288,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 142,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Sunwalker Dezco",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4335,
["message"] = "Faol! What brings you and your friends to Hammerfall? Please tell me the world isn't ending again.",
["time"] = 1774671292,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 143,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Injured Peon",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4344,
["message"] = "Much better!",
["time"] = 1774671361,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 144,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Injured Peon",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4349,
["message"] = "Much better!",
["time"] = 1774671459,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 149,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Eitrigg",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4356,
["message"] = "I understand, Faol. I'll gather the others and wait for your arrival.",
["time"] = 1774671516,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 151,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Sunwalker Dezco",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4369,
["message"] = "The discarded weapons of past wars litter the fields and complicate farming.",
["time"] = 1774671531,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 162,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Sunwalker Dezco",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4370,
["message"] = "Tampacks, if you would gather what you can, Arator and I will prepare the forge.",
["time"] = 1774671537,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 163,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Sunwalker Dezco",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4381,
["message"] = "The fields are cleared of scrap metal! We'll make something useful out of this refuse.",
["time"] = 1774671999,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 1,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4382,
["message"] = "Is this what it means to be a Sunwalker?",
["time"] = 1774672002,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 2,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Sunwalker Dezco",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4388,
["message"] = "For some. Others are content to smite the wicked with a giant hammer.",
["time"] = 1774672006,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 7,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Sunwalker Dezco",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4390,
["message"] = "But allowing the innocent to suffer... that is the worst evil.",
["time"] = 1774672012,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 9,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4391,
["message"] = "I must now steal Arator and Tampacks away. Arrangements have been made to find one last relic.",
["time"] = 1774672014,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 10,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Kurdran Wildhammer",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4394,
["message"] = "There you are! Faol, why'd you bring us back to this desolate place?",
["time"] = 1774672025,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 11,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4395,
["message"] = "Thank you, Dezco. I really admire what you're doing here. I'll be sure to return.",
["time"] = 1774672028,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 12,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4396,
["message"] = "My father was one of those students. He's never mentioned any of this to me.",
["time"] = 1774672054,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 13,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4397,
["message"] = "I... want to come back here and help you, once this war has ended. I think this is as much my calling as facing down the horrors of the Void.",
["time"] = 1774672089,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 14,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Ethereal Warpweaver",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4398,
["message"] = "Your attire seems adequate. How may I assist you?",
["time"] = 1774672197,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 1,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4399,
["message"] = "We are on a hunt for artifacts to support the defenders at Silvermoon.",
["time"] = 1774672293,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 2,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Danath Trollbane",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4409,
["message"] = "Come, Kurdran. We should scout out the other Dark Horde encampments.",
["time"] = 1774672300,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 11,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Kurdran Wildhammer",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4410,
["message"] = "Oh you must be joking!",
["time"] = 1774672305,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 12,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Kurdran Wildhammer",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4411,
["message"] = "Pfft! The Dark Horde. They're stuck trying to win the Second War, while we've made peace on the Fourth. Get with the times!",
["time"] = 1774672305,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 13,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Eitrigg",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4412,
["message"] = "The Dark Horde will have taken the fragments, divided it up amongst themselves as a trophy.",
["time"] = 1774672308,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 14,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Kurdran Wildhammer",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4414,
["message"] = "Well ain't that lovely. Come on lads. Time for a difficult walk down memory lane.",
["time"] = 1774672314,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 15,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4419,
["message"] = "My father, Turalyon, fought in this battle, though he has rarely talked to me about it.",
["time"] = 1774672335,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 19,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Mar'kag",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4421,
["message"] = "How... Mar'kag so strong!",
["time"] = 1774672359,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 20,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4423,
["message"] = "This is one of the fragments that we're looking for. Might have been from a piece of armor or a shield.",
["time"] = 1774672360,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 22,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4442,
["message"] = "After Anduin Lothar fell in battle, my father rallied the Alliance to victory.",
["time"] = 1774672434,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 34,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4445,
["message"] = "The Dark Horde seems traumatized by this battle. They remain here and fight a war long lost.",
["time"] = 1774672481,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 35,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Eitrigg",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4452,
["message"] = "The Horde left behind this dark past long ago. If only everyone here had come with us.",
["time"] = 1774672513,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 39,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4469,
["message"] = "Kurdran flew to the entrance of Blackrock Spire, Tampacks. He's tracked down the next fragment.",
["time"] = 1774672517,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 53,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
