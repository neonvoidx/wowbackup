["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 2701,
["message"] = "...and perhaps offer an apology for the near catastrophe.",
["time"] = 1774412092,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
