["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 137,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Zul'jarra",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 592,
["message"] = "Dis must be de fire Lilaju spoke of.",
["time"] = 1774658414,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 161,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Zul'jarra",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 593,
["message"] = "Sit and we will start de ritual--but be ready. Dis is de Loa of War. What ever he dreams of, we must complete de trial.",
["time"] = 1774658417,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 162,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Loa Speaker Nanea",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 596,
["message"] = "Do not worry about your friend, de would-be hash'ey. Nalorakk, de dreamer, de Loa of War, will test her strength.",
["time"] = 1774658435,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 164,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Loa Speaker Nanea",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 598,
["message"] = "A hash'ey is only as strong as their warriors. So, you too will be tested in Nalorakk's dream.",
["time"] = 1774658446,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 165,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Loa Speaker Nanea",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 599,
["message"] = "The loa dreams of de Amani's past. When de winter was their only foe. Preparin' for it will be your first trial.",
["time"] = 1774658456,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 166,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Loa Speaker Nanea",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 633,
["message"] = "Well done. You just might survive.",
["time"] = 1774658639,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 180,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Loa Speaker Nanea",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 651,
["message"] = "In de winter there were those like de Hoardmonger whose greed burdened others.",
["time"] = 1774658779,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 190,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Loa Speaker Nanea",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 652,
["message"] = "De Amani hash'ey used their most trusted warriors to eliminate them. For de good of de tribe.",
["time"] = 1774658786,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 191,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Loa Speaker Nanea",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 665,
["message"] = "Good. Resources will keep you alive.",
["time"] = 1774658870,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 195,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Loa Speaker Nanea",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 668,
["message"] = "Well done. Like a living vine, some branches must be cut so de others may live. De tribe survives--for now.",
["time"] = 1774658983,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 196,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Loa Speaker Nanea",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 714,
["message"] = "Seasons in de loa's mind are changin'. All you can do is take shelter from de rising winds.",
["time"] = 1774659193,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 217,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Loa Speaker Nanea",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 752,
["message"] = "De winter do not care who you are. Hash'ey, elder, child, beggar. It tests all.",
["time"] = 1774659551,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 225,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Loa Speaker Nanea",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 757,
["message"] = "Impressive. You have proved your strength and endurance. But what about your loyalty?",
["time"] = 1774659708,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 226,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Loa Speaker Nanea",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 760,
["message"] = "Come back to de fire. Your last trial awaits you.",
["time"] = 1774659716,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 229,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Zul'jarra",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 795,
["message"] = "What took you so long, eh? De loa will not fight me without you.",
["time"] = 1774659989,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 243,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Loa Speaker Nanea",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 796,
["message"] = "Hold. Before ya face de loa, ya must face an' kill... me.",
["time"] = 1774659993,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 244,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Nalorakk",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 797,
["message"] = "Leadership requires sacrifice. Even of the things we cherish.",
