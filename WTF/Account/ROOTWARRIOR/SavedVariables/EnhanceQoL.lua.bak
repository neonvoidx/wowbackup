["lineID"] = 1189,
["message"] = "But you can. Slay this malformed creature, before it threatens lands beyond the Rift of Aln.",
["time"] = 1775091324,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 210,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Amarakk",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1219,
["message"] = "This one was allowed to grow for too long. The rift has formed it into something terrible.",
["time"] = 1775091439,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 240,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Amarakk",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1221,
["message"] = "Without the goddess to shape it, it is only torment and rage. It must be stopped.",
["time"] = 1775091446,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 242,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Amarakk",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1304,
["message"] = "One day, the goddess may be able to shape what forms here into what they should be.",
["time"] = 1775091942,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 21,
["ownerCharKey"] = "Stormclout-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Amarakk",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1306,
["message"] = "Until then, the Shul'ka must protect the world from their rage and sorrow. Thank you, friend.",
["time"] = 1775091949,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 23,
["ownerCharKey"] = "Stormclout-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Vereesa Windrunner",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1438,
["message"] = "In the end, he knew... he sacrificed himself for us.",
["time"] = 1775092734,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 109,
["ownerCharKey"] = "Stormclout-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1440,
["message"] = "No need to mourn--he'll return anew.",
["time"] = 1775092739,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 111,
["ownerCharKey"] = "Stormclout-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Vereesa Windrunner",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1629,
["message"] = "We've won, but the Darkwell remains.",
["time"] = 1775093519,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 188,
["ownerCharKey"] = "Stormclout-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Lady Liadrin",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1635,
["message"] = "What was wrought here cannot simply be undone. The Light is all but consumed. I barely feel the well's power.",
["time"] = 1775093523,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 194,
["ownerCharKey"] = "Stormclout-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1639,
["message"] = "We can't leave it like this--the wounds the Void left behind must be healed.",
["time"] = 1775093535,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 197,
["ownerCharKey"] = "Stormclout-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1650,
["message"] = "There's more to be done, but I think we've earned a moment of respite. Let's head back to Silvermoon for now.",
["time"] = 1775093568,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 206,
["ownerCharKey"] = "Stormclout-Tichondrius",
},
