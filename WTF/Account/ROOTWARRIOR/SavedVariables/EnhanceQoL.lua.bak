["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 219,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Grand Magister Rommath",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1396,
["message"] = "That desk was a menace. It kept eating magic items we left on it.",
