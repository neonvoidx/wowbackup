["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 245,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Loa Speaker Nanea",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 798,
["message"] = "Well done, Amani cub. You have... passed de trial. Take de Burden of Nalorakk.",
