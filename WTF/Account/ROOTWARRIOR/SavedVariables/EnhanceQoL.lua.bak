{
["outbound"] = false,
["sender"] = "Majordomo Staghelm",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_YELL",
["lineID"] = 3253,
["message"] = "What have we here - visitors to our kingdom in the Firelands?",
["time"] = 1774985630,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Strathmoan-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 718,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Majordomo Staghelm",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_YELL",
["lineID"] = 3256,
["message"] = "You mortals may remember Alysra, who spirited me to freedom in Mount Hyjal. She, too has been reborn. Born of flame!",
["time"] = 1774985640,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Strathmoan-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 721,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Majordomo Staghelm",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_YELL",
["lineID"] = 3258,
["message"] = "I wish I could watch her reduce your pitiful band to cinders, but I am needed elsewhere. Farewell!",
["time"] = 1774985656,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Strathmoan-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 723,
["ownerFaction"] = "Alliance",
},
