},
{
["outbound"] = false,
["sender"] = "Purged of Dalaran",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 216,
["message"] = "Bear the unending weight of guilt!",
["time"] = 1774373752,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 150,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Purged of Dalaran",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 217,
["message"] = "I... am... free!",
["time"] = 1774373752,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 151,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Purged of Dalaran",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 220,
["message"] = "Now it is you who will be purged!",
["time"] = 1774373756,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 154,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Purged of Dalaran",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 222,
["message"] = "Bear the unending weight of guilt!",
["time"] = 1774373766,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 156,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Vereesa Windrunner",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 233,
["message"] = "The Silver Covenant returns to Silvermoon, one last time.",
["time"] = 1774373791,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 165,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 234,
["message"] = "Champion, if you would meet us at the gates it would be a powerful symbol.",
["time"] = 1774373797,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 166,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Vereesa Windrunner",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 243,
["message"] = "Aethas, I am not here to fight you. We are here to defend the city of our birth from the Void.",
["time"] = 1774373868,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 175,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Archmage Aethas Sunreaver",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 244,
["message"] = "The artifacts of Anasterian? We thought these lost, taken by the Lich King.",
["time"] = 1774373871,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 176,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Vereesa Windrunner",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 245,
["message"] = "I wish to return them to their home--our home.",
["time"] = 1774373877,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 177,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Lor'themar Theron",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 251,
["message"] = "Vereesa Windrunner. I had not believed you would ever return to this city, but I welcome your help.",
["time"] = 1774373884,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 180,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 266,
["message"] = "That's everyone except for the shal'dorei. Any word, First Arcanist?",
["time"] = 1774373892,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 189,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 270,
["message"] = "The Nightborne have yet to answer the missive? Could it have been lost in transit?",
["time"] = 1774373896,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 191,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "First Arcanist Thalyssra",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 277,
["message"] = "That should not be possible. I sent it magically to Ulen, my seneschal in charge during my absence. Something may be amiss in Suramar.",
["time"] = 1774373902,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 195,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "First Arcanist Thalyssra",
