["message"] = "And we invite the high elves and the Silver Covenant to join our efforts.",
["time"] = 1774373374,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 30,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Magister Umbric",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 60,
["message"] = "This much Void energy will soon spill from the Sunwell, corrupting all of Azeroth. It must be stopped.",
["time"] = 1774373380,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 32,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "First Arcanist Thalyssra",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 61,
["message"] = "Even now, my people gather their own army to lend to the sin'dorei. We remember those who aided us in the past.",
["time"] = 1774373381,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 33,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 69,
["message"] = "You are wrong about them! Of all the peoples of Azeroth, the elves understand the threat of the Darkwell.",
["time"] = 1774373385,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 39,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Shandris Feathermoon",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 71,
["message"] = "Stormclout, please aid Maiev with awakening the ancients and preparing them for war.",
["time"] = 1774373386,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 41,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Maiev Shadowsong",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 76,
["message"] = "The sin'dorei continue the ancient elven tradition of not learning from their disastrous mistakes.",
["time"] = 1774373395,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 44,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Ban-Lu",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 83,
["message"] = "Where are we going today, Grandmaster?",
["time"] = 1774373415,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 49,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Maiev Shadowsong",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 100,
["message"] = "It was the incessant need for a fount of power that destroyed our civilization and brought our home to ruin.",
["time"] = 1774373459,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 56,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Maiev Shadowsong",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 132,
["message"] = "Once again, the Sunwell invites corruption and calamity. How many times must its mere existence imperil our world?",
["time"] = 1774373541,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 80,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Maiev Shadowsong",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 136,
["message"] = "Each time the Sunwell comes under attack, the blood elves suffer in the aftermath. And yet they cling to it.",
["time"] = 1774373597,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 82,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Lor'themar Theron",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 139,
["message"] = "The kaldorei forces make this fight possible, but we will need more allies to be assured of victory.",
["time"] = 1774373610,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 83,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Lor'themar Theron",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 160,
["message"] = "The conflict between the blood elves and the high elves of the Silver Covenant is still fresh. I foresee problems on both sides.",
["time"] = 1774373622,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 100,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Shandris Feathermoon",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 161,
["message"] = "Lor'themar, I've attached no conditions to my aid. A corrupted Sunwell is an existential threat that cannot be ignored.",
["time"] = 1774373625,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 101,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 170,
["message"] = "... Just a bunch of stubborn old elves!",
["time"] = 1774373656,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 108,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Vereesa Windrunner",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 175,
["message"] = "Fret not. You did well to bring them together.",
["time"] = 1774373660,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 111,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 178,
["message"] = "Do you think returning Anasterian's relics will convince those like Aethas to allow you to return?",
["time"] = 1774373661,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 114,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 179,
["message"] = "I was young when Quel'Thalas fell. I don't remember much about King Anasterian.",
["time"] = 1774373663,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 115,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Vereesa Windrunner",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 180,
["message"] = "I don't intend it as a bribe. But if relics of the last king must return home, then perhaps the quel'dorei deserve the same?",
["time"] = 1774373668,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 116,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Vereesa Windrunner",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 181,
["message"] = "He ruled for thousands of years, from the Troll Wars against the Amani to his heroic sacrifice against the Scourge.",
["time"] = 1774373670,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 117,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Vereesa Windrunner",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 183,
["message"] = "High King Anasterian's book of law. He applied its dictates equally to all his subjects.",
["time"] = 1774373676,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 119,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Vereesa Windrunner",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 184,
["message"] = "To this day, Anasterian is revered by both blood elves and high elves. He is a symbol of when our people stood as one.",
["time"] = 1774373679,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 120,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Ban-Lu",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 185,
["message"] = "Good luck, Grandmaster!",
["time"] = 1774373686,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 121,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Vereesa Windrunner",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 187,
["message"] = "Passed down from Anasterian's great grandfather, this crown adorned the brow of every quel'dorei king.",
["time"] = 1774373688,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 123,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Vereesa Windrunner",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 188,
["message"] = "After Anasterian's sacrifice, our people were split apart. The blood elves stayed in the ruins to rebuild, and did terrible things to regain that feeling of power.",
["time"] = 1774373690,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 124,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Vereesa Windrunner",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 190,
["message"] = "We high elves could not abide what Prince Kael'thas was asking of us. We left during our people's greatest need.",
["time"] = 1774373703,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 126,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 191,
["message"] = "I hope that these relics of Anasterian are enough to remind Silvermoon that we are still one people.",
["time"] = 1774373705,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 127,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Vereesa Windrunner",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 198,
["message"] = "We have also done terrible things since then.",
["time"] = 1774373712,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 132,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 199,
["message"] = "Would anything have been different if Anasterian had survived?",
["time"] = 1774373716,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 133,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Purged of Dalaran",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 200,
["message"] = "We will never forgive the Silver Covenant.",
["time"] = 1774373720,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 134,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Purged of Dalaran",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 201,
["message"] = "We will never forgive the Silver Covenant.",
["time"] = 1774373725,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 135,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Purged of Dalaran",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 204,
["message"] = "Bear the unending weight of guilt!",
["time"] = 1774373731,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 138,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Purged of Dalaran",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 205,
["message"] = "We are returned to peace.",
