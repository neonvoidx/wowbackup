},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4628,
["message"] = "This is my father's shield, isn't it? How did it break?",
["time"] = 1774673191,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 149,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Danath Trollbane",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4629,
["message"] = "I still have nightmares about that time. After all I've seen, I still dream about this place.",
["time"] = 1774673196,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 150,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Eitrigg",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4630,
["message"] = "If the boy has all the fragments of the shield, we can begin.",
