},
{
["outbound"] = false,
["sender"] = "Zo'sorg",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1420,
["message"] = "Many in the cartel are wagering on who are the greater combatants. Care to influence the outcome?",
["time"] = 1776189655,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 231,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Archmage Aethas Sunreaver",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1443,
["message"] = "Vereesa and I have decided that our people can no longer afford to fight each other.",
["time"] = 1776189755,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 242,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Vereesa Windrunner",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1444,
["message"] = "The Silver Covenant was formed to oppose the Horde. Our enmity toward them could not be quelled.",
["time"] = 1776189766,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 243,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Vereesa Windrunner",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1445,
["message"] = "Not when greater threats lurk outside our walls.",
["time"] = 1776189767,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 244,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Archmage Aethas Sunreaver",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1448,
["message"] = "The Sunreavers sought to reclaim our place in the Kirin Tor. We never meant to become a political tool.",
["time"] = 1776189774,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 246,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Vereesa Windrunner",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1457,
["message"] = "I agree to this compact, though I will never forgive the Horde for what it has done.",
["time"] = 1776189781,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 253,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Archmage Aethas Sunreaver",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1460,
["message"] = "Let this flame remind us of our true calling: to share knowledge and power against a common foe.",
["time"] = 1776189784,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 256,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Archmage Aethas Sunreaver",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1461,
["message"] = "As I will never forgive the Alliance for purging us from Dalaran. Yet I, too, agree to this compact.",
["time"] = 1776189787,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 257,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Lor'themar Theron",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1462,
["message"] = "I trust--and hope--that things went well, Stormclout.",
["time"] = 1776189795,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 258,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Lor'themar Theron",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1468,
["message"] = "We believe we can heal the Darkwell, and we would like you there when we do.",
["time"] = 1776189798,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 262,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1513,
["message"] = "The others have gathered gifts from their home to help with the Darkwell. Please let them know we are ready for them.",
["time"] = 1776190092,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 284,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "First Arcanist Thalyssra",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1514,
["message"] = "The fruit of the Arcan'dor can cleanse all manner of magic. I'm certain it will do so here.",
["time"] = 1776190097,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 285,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Lor'themar Theron",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1515,
["message"] = "I know this is no small thing you offer us. Silvermoon owes you a debt of gratitude.",
["time"] = 1776190099,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 286,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Vereesa Windrunner",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1516,
["message"] = "Aethas and I have agreed to bring Anasterian's crown. A symbolic gesture befitting the last king of Silvermoon.",
["time"] = 1776190104,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 287,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Vereesa Windrunner",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1517,
["message"] = "Are you sure about this, Aethas? The crown has only just been returned to its home.",
["time"] = 1776190106,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 288,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Magister Umbric",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1518,
["message"] = "Trust me, Rommath. This shard will regulate the Void energies within the well.",
["time"] = 1776190110,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 289,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Grand Magister Rommath",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1519,
["message"] = "To allow the Void to remain at all... your calculations have to be perfect, Umbric.",
["time"] = 1776190112,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 290,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Shandris Feathermoon",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1521,
["message"] = "We have brought the purifying waters of our moonwells. I hope it will help.",
["time"] = 1776190124,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 292,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Halduron Brightwing",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1522,
["message"] = "Thank you for coming. I know this was not an easy decision.",
["time"] = 1776190125,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 293,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Shandris Feathermoon",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1523,
["message"] = "The right decision is seldom easy. A lesson that we must all take to heart.",
["time"] = 1776190130,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 294,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Lady Liadrin",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1524,
["message"] = "We stand here today because of you, champion. Let us put an end to this Darkwell.",
["time"] = 1776190143,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 295,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Lady Liadrin",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1540,
["message"] = "Though today we celebrate, there remains much to which we must attend. Still, thank you for all you have done.",
["time"] = 1776190184,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 307,
["ownerFaction"] = "Alliance",
},
