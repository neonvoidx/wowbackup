},
{
["outbound"] = false,
["sender"] = "Kurdran Wildhammer",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 105,
["message"] = "I could use a hot meal and a drink while you ponder. Come with us, lad. You too, Strathmoan.",
["time"] = 1774704211,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Strathmoan-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 53,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 106,
["message"] = "I was going to hang up the shield. Instead, I will wield it. I want to protect the people of Azeroth.",
["time"] = 1774704212,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Strathmoan-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 54,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 114,
["message"] = "Thank you for helping me, Strathmoan. I think that our presence has been missed in Silvermoon. We should return.",
["time"] = 1774704230,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Strathmoan-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 60,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Eitrigg",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 115,
["message"] = "The Sons of Lothar will stay here for a bit. The Arcantina needs our protection. Or at least I need another round.",
["time"] = 1774704238,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Strathmoan-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 61,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Lor'themar Theron",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 123,
["message"] = "I've received reports from the Sunwell that Faol's plan has worked. The defenders hold back the Voidstorm another day.",
