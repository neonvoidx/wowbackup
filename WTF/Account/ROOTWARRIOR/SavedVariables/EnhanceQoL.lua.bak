["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 675,
["ownerCharKey"] = "Stormclout-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Magister Umbric",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 2522,
["message"] = "After what happened with Turalyon and Arator... I can see how Alleria would struggle to maintain control. I doubt I'd be able to, if it were me.",
