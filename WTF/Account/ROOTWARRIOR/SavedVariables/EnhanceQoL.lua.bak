["bnetIDAccount"] = 0,
["ownerCharKey"] = "Strathmoan-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 84,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 158,
["message"] = "The Lightbloom first appeared when the Sunwell was restored, many years ago. But it never grew near civilization like this.",
["time"] = 1774704508,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Strathmoan-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 89,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 159,
["message"] = "That creature must have come from the Lightbloom! We should let the Magistrix know.",
