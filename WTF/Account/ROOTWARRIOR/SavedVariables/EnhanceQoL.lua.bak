},
{
["outbound"] = false,
["sender"] = "Majordomo Selistra",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 2421,
["message"] = "Good work, champion. Now that you have secured the pools below, I require your aid above.",
["time"] = 1774663955,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Auteist-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 194,
["ownerFaction"] = "Horde",
},
{
["outbound"] = false,
["sender"] = "Majordomo Selistra",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 2426,
["message"] = "The exposed Life Pools are in grave danger. A powerful Primalist is attempting to burn all the nesting areas! You must clear them to get to her. I will keep watch from above while I confront the dragon who is leading this assault.",
["time"] = 1774663977,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Auteist-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 199,
["ownerFaction"] = "Horde",
},
{
["outbound"] = false,
