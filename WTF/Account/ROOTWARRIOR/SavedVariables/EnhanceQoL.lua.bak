["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 3786,
["message"] = "One day, the goddess may be able to shape what forms here into what they should be.",
["time"] = 1774415679,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 615,
["ownerFaction"] = "Alliance",
},
{
