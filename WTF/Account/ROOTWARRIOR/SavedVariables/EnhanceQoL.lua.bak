["bnetIDAccount"] = 0,
["ownerCharKey"] = "Strathmoan-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 42,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Kurdran Wildhammer",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 95,
["message"] = "...and so I said, \"If that's my gryphon, who's sitting on the egg?\"",
["time"] = 1774704190,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Strathmoan-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 43,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 96,
["message"] = "So I'm going to focus on that. My father may not be ready to change, but I am.",
["time"] = 1774704190,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Strathmoan-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
