},
{
["outbound"] = false,
["sender"] = "Magister Umbric",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 2359,
["message"] = "We must make haste. Xal'atath is using Alleria's rage and pain to erode her mastery over the Void.",
