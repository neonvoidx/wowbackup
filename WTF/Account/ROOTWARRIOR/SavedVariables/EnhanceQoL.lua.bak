["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 151,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4635,
["message"] = "As you have guessed, that is your father's shield. Broken into fragments and left on the field of battle.",
["time"] = 1774673247,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 155,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4649,
["message"] = "I had no idea. I didn't realize what my father went through.",
["time"] = 1774673357,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 162,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4656,
["message"] = "If I repair the shield, maybe it can remind my father of the kind of paladin he wanted to be.",
