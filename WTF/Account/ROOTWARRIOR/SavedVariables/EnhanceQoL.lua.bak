["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 2493,
["message"] = "The Terrace holds what we require to gain entry to the Voidstorm... the Cynosure of Twilight.",
["time"] = 1774410361,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 242,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Magister Umbric",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 2697,
["message"] = "It is done! We have our way into the Voidstorm. Let us inform Lor'themar.",
["time"] = 1774412085,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
