["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 246,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Nalorakk",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 799,
["message"] = "She has died honorably. But the death of those loyal to me... that is my burden. It will be yours as hash'ey.",
