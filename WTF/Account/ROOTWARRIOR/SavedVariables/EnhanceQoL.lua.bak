["bnetIDAccount"] = 0,
["ownerCharKey"] = "Stormclout-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 221,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Grand Magister Rommath",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1406,
["message"] = "To show our gratitude for your aid, we... I... am awarding you this property as an embassy for the ren'dorei.",
