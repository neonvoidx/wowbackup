["sender"] = "Eitrigg",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 104,
["message"] = "Take a look around. Horde, Alliance... this place is a refuge for those who've had enough of war.",
