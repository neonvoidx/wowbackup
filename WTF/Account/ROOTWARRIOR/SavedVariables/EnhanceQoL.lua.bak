["outbound"] = false,
["sender"] = "Ban-Lu",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 1661,
["message"] = "Have I told you the tale of the hozen and the buttercream pie? Hmm... Perhaps best saved for another time.",
