["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_YELL",
["lineID"] = 3499,
["message"] = "Well, well. I admire your tenacity. Baleroc stood guard over this keep for a thousand mortal lifetimes.",
