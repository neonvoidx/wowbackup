},
{
["outbound"] = false,
["sender"] = "Silvermoon Guard",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 3747,
["message"] = "We still bear the scars from the previous Lich King, death knight.",
["time"] = 1774668317,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 454,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Lor'themar Theron",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 3998,
["message"] = "The Sunwell holds for now, only through the constant effort of its defenders. Should their strength waver...",
["time"] = 1774669622,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 543,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Lor'themar Theron",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 3999,
["message"] = "Bishop Alonsus Faol has a plan to support those at the Sunwell. And to help Arator.",
["time"] = 1774669629,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 544,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4000,
["message"] = "Tampacks! We're going to save the Sunwell. More importantly, we're going to fix that broken young man.",
["time"] = 1774669632,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 545,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4007,
["message"] = "Such a troubled boy. That'll happen when your father leaves a gaping wound in your chest. Not to worry--I have a plan.",
["time"] = 1774669638,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 551,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4008,
["message"] = "Asking for me to inspire anyone? Faol always was an original thinker.",
["time"] = 1774669653,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 552,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4030,
["message"] = "Ah good! You're both here. There is a crisis of faith that we need to fix!",
["time"] = 1774669786,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 562,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4037,
["message"] = "That's your solution? To zap them with your staff?",
["time"] = 1774669789,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 568,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4039,
["message"] = "Hmmph. Those defenders have exhausted themselves, giving of their own faith and power. We bolster their reserves.",
["time"] = 1774669794,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 570,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "General Amias Bellamy",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4042,
["message"] = "I'm worried that Void Elf might sneak back in here and disrupt our efforts at the Sunwell.",
["time"] = 1774669837,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 573,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "War Chaplain Senn",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4043,
["message"] = "I have marshalled what priests were available to ward against the Void. It won't repel the Devouring Host, but will prevent contamination from any undesirable mortals.",
["time"] = 1774669843,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 574,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4046,
["message"] = "What if I promised that my task would take you far away from here?",
["time"] = 1774669881,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 577,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4054,
["message"] = "You're creating a bigger cloud with your moping than Xal'atath's Voidstorm.",
["time"] = 1774669892,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 584,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4055,
["message"] = "To Light's Hope to gather relics and inspire the Vanguard.",
["time"] = 1774669897,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 585,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4056,
["message"] = "No better place to take my mind off the problems with paladins.",
["time"] = 1774669901,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 586,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4057,
["message"] = "Speak your mind! Let it out before these feelings create a well of poison in your gut.",
["time"] = 1774669902,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 587,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4058,
["message"] = "I'm not just upset that my father cut me down.",
["time"] = 1774669907,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 588,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4083,
["message"] = "Lord Tyrosus, I had no idea things were so desperate. What can we do to help?",
["time"] = 1774670058,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 595,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Lord Maxwell Tyrosus",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4090,
["message"] = "With so many defenders called away to the Sunwell, the Scourge almost broke through to the chapel.",
["time"] = 1774670063,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 601,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Lord Maxwell Tyrosus",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4091,
["message"] = "I've called for assistance from the Ebon Blade, but we could use your help pushing back this latest attack.",
["time"] = 1774670071,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 602,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4098,
["message"] = "I fear if I were stationed here to fight the Scourge, I'd become just like my fath--I'd fall to rage and wrath.",
["time"] = 1774670104,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 604,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4110,
["message"] = "I shouldn't let my doubts get in the way of the defense of this place.",
["time"] = 1774670223,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 608,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4122,
["message"] = "But is this what it means to wield the Light? An endless battle against evil?",
["time"] = 1774670266,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 609,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4133,
["message"] = "Light's Hope is in danger. The world is in danger. I need to get my head in the battle.",
["time"] = 1774670317,
["bnetIDAccount"] = 0,
["ownerFaction"] = "Alliance",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 614,
["ownerCharKey"] = "Tampacks-Tichondrius",
},
{
["outbound"] = false,
["sender"] = "Lord Maxwell Tyrosus",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4139,
["message"] = "Thank you. The Scourge has diminished. Take whatever relics you need to support the Sunwell.",
["time"] = 1774670350,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 1,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4147,
["message"] = "For my first lesson, learn from the revered heroes of the past and what inspired their Light.",
["time"] = 1774670353,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 8,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4148,
["message"] = "That's what I've been trying to do since I joined the Silver Hand.",
["time"] = 1774670362,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 9,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4149,
["message"] = "I've known the stories of these paladins since I was a child.",
["time"] = 1774670370,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 10,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4150,
["message"] = "Each of them is a legend immortalized in stone. Their great deeds set an example for all paladins.",
["time"] = 1774670374,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 11,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4156,
["message"] = "But no matter how hard I try... I fear that I'll never live up to them.",
["time"] = 1774670382,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 14,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4159,
["message"] = "Maraad was known for his skill in combat, yet his relic is a meditation crystal.",
["time"] = 1774670402,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 17,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4161,
["message"] = "Krohm defended the people of Lordaeron. But the relic is a smithing hammer, not a weapon.",
["time"] = 1774670410,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 19,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4163,
["message"] = "Mara's heroics inspired the creation of the Silver Hand. Her relic is a book of refugee prayers though.",
["time"] = 1774670418,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 21,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4166,
["message"] = "Uther was the first and greatest of the Silver Hand Paladins. I'm surprised not to find his hammer, but a healing kit.",
["time"] = 1774670427,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 24,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4167,
["message"] = "I forgot that statue was here.",
["time"] = 1774670428,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 25,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4169,
["message"] = "Lena led an army against the Legion. Why would her relic be something like this?",
["time"] = 1774670439,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 27,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4171,
["message"] = "I had expected these relics to be powerful weapons.",
["time"] = 1774670449,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 29,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4172,
["message"] = "Instead, they were mostly simple items, unconnected to war.",
["time"] = 1774670454,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 30,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4173,
["message"] = "The Silver Hand was founded to wield the Light in battle. Is that not the measure of a paladin's accomplishments?",
["time"] = 1774670460,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 31,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4177,
["message"] = "The most revered paladins didn't draw their faith in the Light from warfare. They fought to preserve what they valued most.",
["time"] = 1774670481,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 32,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4184,
["message"] = "The Scarlet Crusade? You, of all people, want to spread their Light?",
["time"] = 1774670488,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 38,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4185,
["message"] = "I can scarcely believe that the Light answers their call.",
["time"] = 1774670493,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 39,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4186,
["message"] = "They claimed many relics when they seized my church. Relics that would be better used to our purpose of holding back Xal'atath.",
["time"] = 1774670495,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 40,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4187,
["message"] = "I was always taught that the Light was good. The Crusade is... unconscionable.",
["time"] = 1774670497,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 41,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Unknown",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4192,
["message"] = "The Scarlet Crusade was founded by a paladin I personally anointed. For a long time, I saw them as my own misjudgment made manifest. Perhaps I still do.",
["time"] = 1774670576,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 42,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4193,
["message"] = "However... the relics they possess will do for our purposes of bolstering the Sunwell defenders.",
["time"] = 1774670581,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 43,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4194,
["message"] = "You're here, Tampacks. We should join Arator inside. My sermon to these fanatics is falling on deaf ears.",
["time"] = 1774670582,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 44,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4195,
["message"] = "It... will be good to reclaim them.",
["time"] = 1774670590,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 45,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4205,
["message"] = "This place has all the trappings of the Church of Holy Light, but turned to an evil purpose.",
["time"] = 1774670609,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 52,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Alonsus Faol",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4206,
["message"] = "That is my second lesson. The Light is channeled through belief and conviction. Even if they are misguided.",
["time"] = 1774670615,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 53,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Scarlet Initiate",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4207,
["message"] = "Heretics have no place here!",
["time"] = 1774670617,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 54,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Instructor Meyer",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4208,
["message"] = "I'll show the initiates how one smites an unbeliever!",
["time"] = 1774670618,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 55,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Scarlet Initiate",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4212,
["message"] = "I should... not have left home.",
["time"] = 1774670627,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 57,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Instructor Meyer",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4216,
["message"] = "Who will teach them... the Light's dictates?",
["time"] = 1774670636,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 58,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4219,
["message"] = "Will these initiates forever call forth the Light through hatred?",
["time"] = 1774670640,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 61,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Champion Aelyse",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4220,
["message"] = "Intruders... So the time has come to die for the Crusade.",
["time"] = 1774670648,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 62,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4224,
["message"] = "Go! If you wish to surrender, give us your weapon, leave this accursed place, and never return.",
["time"] = 1774670687,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 64,
["ownerFaction"] = "Alliance",
},
{
["outbound"] = false,
["sender"] = "Arator",
["filterKey"] = "MONSTER",
["event"] = "CHAT_MSG_MONSTER_SAY",
["lineID"] = 4227,
["message"] = "This blade was forged long before the Crusade's hatred. Perhaps it can be returned to a wielder who is truly righteous.",
["time"] = 1774670697,
["bnetIDAccount"] = 0,
["ownerCharKey"] = "Tampacks-Tichondrius",
["ownerRealmKey"] = "Tichondrius",
["seq"] = 67,
["ownerFaction"] = "Alliance",
},
