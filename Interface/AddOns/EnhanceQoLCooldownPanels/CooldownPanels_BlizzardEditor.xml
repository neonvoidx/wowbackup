<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<Frame name="EQOLCooldownPanelsBlizzardEditorDraggedItemTemplate" mixin="EQOLCooldownPanelsBlizzardEditorDraggedItemMixin" frameStrata="TOOLTIP" virtual="true">
		<Size x="38" y="38"/>
		<Layers>
			<Layer level="OVERLAY" textureSubLevel="6">
				<Texture parentKey="Icon" setAllPoints="true"/>
			</Layer>
		</Layers>
		<Scripts>
			<OnUpdate method="OnUpdate"/>
		</Scripts>
	</Frame>

	<Frame name="EQOLCooldownPanelsBlizzardEditorItemTemplate" registerForDrag="LeftButton" ignoreChildrenForBounds="true" virtual="true">
		<Size x="38" y="38"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon" setAllPoints="true"/>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture parentKey="Highlight" setAllPoints="true" file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD"/>
			</Layer>
		</Layers>
	</Frame>

	<Frame name="EQOLCooldownPanelsBlizzardEditorBarItemTemplate" registerForDrag="LeftButton" ignoreChildrenForBounds="true" virtual="true">
		<Size x="317" y="38"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon">
					<Size x="38" y="38"/>
					<Anchors>
						<Anchor point="TOPLEFT"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture parentKey="Highlight" file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Icon"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Icon"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="AlertTarget">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.Icon" relativePoint="TOPLEFT"/>
					<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Icon" relativePoint="BOTTOMRIGHT"/>
				</Anchors>
			</Frame>
			<StatusBar parentKey="Bar" frameLevel="511" frameStrata="LOW">
				<Size y="19"/>
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.Icon" relativePoint="RIGHT" x="5"/>
					<Anchor point="RIGHT"/>
				</Anchors>
				<BarTexture parentKey="FillTexture" atlas="UI-HUD-CoolDownManager-Bar" setAllPoints="true">
					<Color r="1" g="0.5" b="0.25"/>
				</BarTexture>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture atlas="UI-HUD-CoolDownManager-Bar-BG">
							<Size y="30"/>
							<Anchors>
								<Anchor point="LEFT" x="-2" y="-2"/>
								<Anchor point="RIGHT" x="6" y="-2"/>
							</Anchors>
						</Texture>
					</Layer>
					<Layer level="OVERLAY">
						<FontString parentKey="Name" inherits="NumberFontNormal" justifyH="LEFT">
							<Anchors>
								<Anchor point="LEFT" x="5"/>
								<Anchor point="RIGHT" x="-25"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</StatusBar>
		</Frames>
	</Frame>

	<Frame name="EQOLCooldownPanelsBlizzardEditorCategoryTemplate" inherits="ResizeLayoutFrame" virtual="true">
		<KeyValues>
			<KeyValue key="minimumHeight" value="22" type="number"/>
			<KeyValue key="minimumWidth" value="344" type="number"/>
			<KeyValue key="maximumWidth" value="344" type="number"/>
		</KeyValues>
		<Frames>
			<Button parentKey="Header" inherits="ListHeaderThreeSliceTemplate" registerForClicks="LeftButtonUp">
				<Size x="0" y="22"/>
				<Anchors>
					<Anchor point="TOPLEFT"/>
					<Anchor point="TOPRIGHT"/>
				</Anchors>
			</Button>
			<Frame parentKey="Container" inherits="GridLayoutFrame">
				<KeyValues>
					<KeyValue key="childXPadding" value="8" type="number"/>
					<KeyValue key="childYPadding" value="8" type="number"/>
					<KeyValue key="isHorizontal" value="true" type="boolean"/>
					<KeyValue key="stride" value="7" type="number"/>
					<KeyValue key="layoutFramesGoingRight" value="true" type="boolean"/>
					<KeyValue key="layoutFramesGoingUp" value="false" type="boolean"/>
					<KeyValue key="alwaysUpdateLayout" value="true" type="boolean"/>
				</KeyValues>
				<Size x="315" y="70"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.Header" relativePoint="BOTTOMLEFT" x="13" y="-15"/>
				</Anchors>
			</Frame>
		</Frames>
	</Frame>

	<Frame name="EQOLCooldownPanelsBlizzardEditor" inherits="ButtonFrameTemplate" parent="UIParent" toplevel="true" hidden="true">
		<Size x="399" y="609"/>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" atlas="character-panel-background">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Inset"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Inset"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<EditBox parentKey="SearchBox" inherits="SearchBoxTemplate">
				<Size x="290" y="30"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="72" y="-30"/>
				</Anchors>
			</EditBox>
			<DropdownButton parentKey="SettingsDropdown" inherits="UIPanelIconDropdownButtonTemplate">
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.SearchBox" relativePoint="RIGHT" x="5"/>
				</Anchors>
			</DropdownButton>
			<ScrollFrame parentKey="CooldownScroll" inherits="ScrollFrameTemplate">
				<KeyValues>
					<KeyValue key="scrollBarHideIfUnscrollable" value="false" type="boolean"/>
					<KeyValue key="scrollBarHideTrackIfThumbExceedsTrack" value="true" type="boolean"/>
					<KeyValue key="scrollBarTopY" value="0" type="number"/>
					<KeyValue key="scrollBarBottomY" value="0" type="number"/>
				</KeyValues>
				<Anchors>
					<Anchor point="TOPLEFT" x="17" y="-72"/>
					<Anchor point="BOTTOMRIGHT" x="-30" y="29"/>
				</Anchors>
				<ScrollChild>
					<Frame parentKey="Content">
						<Size x="300" y="1"/>
						<Anchors>
							<Anchor point="TOPLEFT"/>
						</Anchors>
					</Frame>
				</ScrollChild>
			</ScrollFrame>
			<DropdownButton parentKey="LayoutDropdown" inherits="WowStyle1DropdownTemplate">
				<KeyValues>
					<KeyValue key="menuPoint" type="string" value="BOTTOMLEFT"/>
					<KeyValue key="menuRelativePoint" type="string" value="TOPLEFT"/>
				</KeyValues>
				<Anchors>
					<Anchor point="BOTTOMLEFT" x="5" y="3"/>
				</Anchors>
			</DropdownButton>
			<Frame parentKey="ReorderMarker" mixin="EQOLCooldownPanelsBlizzardEditorReorderMarkerMixin" hidden="true">
				<Size x="8" y="52"/>
				<Layers>
					<Layer level="ARTWORK">
						<Texture parentKey="Texture" file="Interface\ChatFrame\UI-ChatFrame-DockHighlight" alphaMode="ADD">
							<Size x="52" y="52"/>
							<Anchors>
								<Anchor point="CENTER"/>
							</Anchors>
						</Texture>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
	</Frame>
</Ui>
